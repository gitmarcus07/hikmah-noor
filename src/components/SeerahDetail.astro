---
/* Seerat detail — one SEO page per chapter: full adult-depth story. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import ReadingCard from './hn/ReadingCard.astro';
import SourcesBlock from './hn/SourcesBlock.astro';
import { localizedPath } from '../i18n/utils';
import { SEERAH } from '../data/seerah';

interface Props { chapter: any; locale: string; }
const { chapter, locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const chapterPath = `/seerat/${chapter.slug}/`;

const title = `${chapter.title} — Seerat un Nabi ﷺ (Ch. ${chapter.num})`;
let description = `Chapter ${chapter.num}: ${chapter.summary} References: ${chapter.references}.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = chapter.keywords;

const faq = [
  { q: `What happened in this chapter of the seerah?`, a: `${chapter.summary}` },
  { q: `What are the lessons of this chapter?`, a: chapter.lessons.join(' ') },
  { q: `What are the sources for this chapter?`, a: `References: ${chapter.references} Consult scholars for deeper rulings.` },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Seerat', path: '/seerat/' },
  { name: `Chapter ${chapter.num}`, path: chapterPath },
];
const sIdx = SEERAH.findIndex((s) => s.slug === chapter.slug);
const prevS = sIdx > 0 ? SEERAH[sIdx - 1] : null;
const nextS = sIdx >= 0 && sIdx < SEERAH.length - 1 ? SEERAH[sIdx + 1] : null;
const sameEra = SEERAH.filter((s) => s.era === chapter.era && s.slug !== chapter.slug);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={chapterPath}>
  <div class="hn-read hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">Chapter {chapter.num} of 16</span>
      <span class="hn-badge hn-badge-gold">{chapter.era} era</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{chapter.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{chapter.summary}</p>
    {chapter.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">Also searched as: {chapter.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="mt-5">
      <ReadingCard arabic={chapter.arabic} translit={chapter.translit} translation={chapter.summary} reference={chapter.references} />
    </div>

    <section class="mt-8" aria-label="Key events">
      <SectionHeader eyebrow="Timeline" title="Key events in order" />
      <ol class="mt-3 space-y-3">
        {chapter.events.map((e: string, i: number) => (
          <li class="hn-card hn-card-pad flex gap-3.5 items-start">
            <span class="hn-verse-num shrink-0">{i + 1}</span>
            <span class="text-[15px] leading-7">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-label="Full story">
      <SectionHeader eyebrow="Full story" title="The complete account" />
      <div class="hn-card hn-card-pad mt-3 space-y-4">
        {chapter.narrative.map((p: string) => (
          <p class="text-[15.5px] leading-8" style="color:var(--hn-ink)">{p}</p>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label="Lessons">
      <SectionHeader eyebrow="Lessons" title="Three lessons" />
      <div class="grid gap-3 sm:grid-cols-3 mt-3">
        {chapter.lessons.map((l: string, i: number) => (
          <div class="hn-card hn-card-pad">
            <p class="hn-block-label">Lesson {i + 1}</p>
            <p class="text-[15px] leading-6" style="color:var(--hn-muted)">{l}</p>
          </div>
        ))}
      </div>
    </section>
    <SourcesBlock locale={locale} source={chapter.references} reviewedDate="2026-01-01" />

    <section class="mt-8" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {sameEra.length > 0 && (
      <section class="mt-8" aria-label="Same era">
        <SectionHeader eyebrow={chapter.era} title={`More ${chapter.era}-era chapters`} href={L('/seerat/')} linkLabel="All 16 chapters" />
        <div class="grid gap-3 sm:grid-cols-2">
          {sameEra.map((r) => (
            <a href={L(`/seerat/${r.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">Ch. {r.num}. {r.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.summary}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {(prevS || nextS) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More chapters">
        {prevS ? (
          <a href={L(`/seerat/${prevS.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">← Previous chapter</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">Ch. {prevS.num}. {prevS.title}</span>
          </a>
        ) : <span />}
        {nextS && (
          <a href={L(`/seerat/${nextS.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">Next chapter →</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">Ch. {nextS.num}. {nextS.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
