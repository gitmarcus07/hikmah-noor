---
/* Seerat detail — one SEO page per chapter: full adult-depth story. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import ReadingCard from './hn/ReadingCard.astro';
import SourcesBlock from './hn/SourcesBlock.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { SEERAH } from '../data/seerah';
import { localizeSeerah } from '../lib/content-i18n';
import { secUI2, SEERAH_UI } from '../lib/site-ui-2';
import RelatedContent from './RelatedContent.astro';
import HistoryScript from './hn/HistoryScript.astro';

interface Props { chapter: any; locale: string; }
const { locale } = Astro.props;
const chapter = localizeSeerah((Astro.props as any).chapter, locale);
const dict = getDict(locale);
const T = secUI2(locale, SEERAH_UI);
const L = (p: string) => localizedPath(locale, p);
const chapterPath = `/seerat/${chapter.slug}/`;

const title = `${chapter.title}${T.detSuffix}`;
let description = `${T.chBadge.replace('{n}', String(chapter.num))}: ${chapter.summary}`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = chapter.keywords;

const faq = [
  { q: T.detFaqStory, a: `${chapter.summary}` },
  { q: T.detFaqLes, a: chapter.lessons.join(' ') },
  { q: T.detFaqSrc, a: `${chapter.references}` },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/seerat/' },
  { name: T.chBadge.replace('{n}', String(chapter.num)), path: chapterPath },
];
const sIdx = SEERAH.findIndex((s) => s.slug === chapter.slug);
const prevS = sIdx > 0 ? localizeSeerah(SEERAH[sIdx - 1], locale) : null;
const nextS = sIdx >= 0 && sIdx < SEERAH.length - 1 ? localizeSeerah(SEERAH[sIdx + 1], locale) : null;
const sameEra = SEERAH.filter((s) => s.era === chapter.era && s.slug !== chapter.slug).map((s) => localizeSeerah(s, locale));
const eraL = chapter.era === 'Makkah' ? T.eraM : T.eraD;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={chapterPath}>
  <div class="hn-read hn-section" data-hn-history data-hn-kind="seerah" data-hn-ref={chapterPath} data-hn-title={chapter.title}>
    <HistoryScript />
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{T.chBadge.replace('{n}', String(chapter.num))}</span>
      <span class="hn-badge hn-badge-gold">{eraL} {T.eraWord}</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{chapter.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{chapter.summary}</p>
    {chapter.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">{T.alsoSearched} {chapter.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="mt-5">
      <ReadingCard arabic={chapter.arabic} translit={chapter.translit} translation={chapter.summary} reference={chapter.references} locale={locale} />
    </div>

    <section class="mt-8" aria-label={T.secEvents}>
      <SectionHeader eyebrow={T.secEvents} title={T.secEvents} />
      <ol class="mt-3 space-y-3">
        {chapter.events.map((e: string, i: number) => (
          <li class="hn-card hn-card-pad flex gap-3.5 items-start">
            <span class="hn-verse-num shrink-0">{i + 1}</span>
            <span class="text-[15px] leading-7">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-label={T.secStory}>
      <SectionHeader eyebrow={T.secStory} title={T.secStory} />
      <div class="hn-card hn-card-pad mt-3 space-y-4">
        {chapter.narrative.map((p: string) => (
          <p class="text-[15.5px] leading-8" style="color:var(--hn-ink)">{p}</p>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label={T.secLessons}>
      <SectionHeader eyebrow={T.secLessons} title={T.secLessons} />
      <div class="grid gap-3 sm:grid-cols-3 mt-3">
        {chapter.lessons.map((l: string, i: number) => (
          <div class="hn-card hn-card-pad">
            <p class="hn-block-label">{T.lessonL} {i + 1}</p>
            <p class="text-[15px] leading-6" style="color:var(--hn-muted)">{l}</p>
          </div>
        ))}
      </div>
    </section>
    <SourcesBlock locale={locale} source={chapter.references} reviewedDate="2026-01-01" />

    <section class="mt-8" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedContent type="seerah" slug={chapter.slug} locale={locale} />

    {sameEra.length > 0 && (
      <section class="mt-8" aria-label={eraL}>
        <SectionHeader eyebrow={eraL} title={T.sameEraT.replace('{e}', eraL)} href={L('/seerat/')} linkLabel={T.moreLink} />
        <div class="grid gap-3 sm:grid-cols-2">
          {sameEra.map((r) => (
            <a href={L(`/seerat/${r.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">Ch. {r.num}. {r.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.summary}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {(prevS || nextS) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More chapters">
        {prevS ? (
          <a href={L(`/seerat/${prevS.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.prevL}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{T.chShort} {prevS.num}. {prevS.title}</span>
          </a>
        ) : <span />}
        {nextS && (
          <a href={L(`/seerat/${nextS.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.nextL}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{T.chShort} {nextS.num}. {nextS.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
