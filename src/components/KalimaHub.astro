---
/* Kalimas hub: all 6 kalimas -> detail pages. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { KALIMAS } from '../data/kalimas';
import { localizeKalimaList } from '../lib/content-i18n';
import { gradeLabel as gradeLabelL } from '../lib/dua-ui-i18n';
import { secUI, KALIMA_UI } from '../lib/site-ui-1';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, KALIMA_UI);
const L = (p: string) => localizedPath(locale, p);
const KL = localizeKalimaList(KALIMAS, locale);

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: dict.nav.kalimas ?? 'Kalimas', path: '/kalimas/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath="/kalimas/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badgeN}</span>
        <span class="hn-badge">{dict.article.arabic} + {dict.article.transliteration} + {dict.article.meaning}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secList} title={T.secList} />
      <div class="grid gap-3 md:grid-cols-2">
        {KL.map((k) => (
          <a href={L(`/kalimas/${k.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
            <span class="hn-verse-num shrink-0">{k.num}</span>
            <span class="min-w-0">
              <span class="font-extrabold block leading-6">{k.title}</span>
              <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">{k.use}</span>
              <span class="mt-1.5 flex flex-wrap gap-1.5">
                <span class="hn-badge hn-badge-primary">{gradeLabelL(k.grade, locale) ?? k.grade}</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label={T.faqTitle}>
      <SectionHeader eyebrow="FAQ" title={T.faqTitle} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
