---
/* Kalimas hub: all 6 kalimas -> detail pages. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { localizedPath } from '../i18n/utils';
import { KALIMAS } from '../data/kalimas';

interface Props { locale: string; }
const { locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);

const title = `All 6 Kalimas in Arabic with Transliteration, Meaning & Explanation`;
const description = `All 6 kalimas — Tayyibah, Shahadah, Tamjeed, Tawheed, Astaghfar and Radd-e-Kufr — with Arabic, transliteration, English meaning and source basis.`;
const keywords = '6 kalimas, 6 kalma, all kalimas, kalma in arabic, pehla kalma, dusra kalma, first kalima, second kalima, la ilaha illallah, shahadah';
const faq = [
  { q: 'How many kalimas are there?', a: 'Traditionally six are taught: Tayyibah, Shahadah, Tamjeed, Tawheed, Astaghfar and Radd-e-Kufr. Open each for Arabic, transliteration, meaning and source basis.' },
  { q: 'Does every kalima include transliteration and meaning?', a: 'Yes — Arabic text, easy transliteration, English meaning, virtue and source basis on each kalima’s own page.' },
  { q: 'Are these kalimas from hadith?', a: 'The first two match hadith wordings directly. Kalimas 3–6 are traditional curriculum wordings whose phrases come from the Quran and hadith — each page states its exact basis without invented references.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Kalimas', path: '/kalimas/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/kalimas/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">6 kalimas</span>
        <span class="hn-badge">Arabic + transliteration + meaning</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">All 6 Kalimas</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Learn each kalima with Arabic, transliteration, English meaning, virtue and source basis — from Tayyibah to Radd-e-Kufr.</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder="Search kalimas — e.g. pehla kalma, shahadah…" aria-label="Search kalimas" />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Learn" title="The six kalimas" />
      <div class="grid gap-3 md:grid-cols-2">
        {KALIMAS.map((k) => (
          <a href={L(`/kalimas/${k.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
            <span class="hn-verse-num shrink-0">{k.num}</span>
            <span class="min-w-0">
              <span class="font-extrabold block leading-6">{k.title}</span>
              <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">{k.use}</span>
              <span class="mt-1.5 flex flex-wrap gap-1.5">
                <span class="hn-badge hn-badge-primary">{k.grade}</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
