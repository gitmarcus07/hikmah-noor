---
/* Kalima detail page (EN + locale). Auto FAQ + crumbs + schemas from kalima data. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { KALIMAS, KALIMA_ORIGIN_LABEL } from '../data/kalimas';

interface Props { kalima: any; locale: string; }
const { kalima, locale } = Astro.props;
const dict = getDict(locale);
const isFallback = locale !== 'en';
const kalimaPath = `/kalimas/${kalima.slug}/`;
const originLabel = (KALIMA_ORIGIN_LABEL as any)[kalima.origin] ?? null;

const title = `${kalima.title} in Arabic with Transliteration & Meaning`;
let description = `${kalima.title}: Arabic text, transliteration, English meaning and virtue. Basis: ${kalima.source}.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${kalima.title.toLowerCase()}, kalima in arabic, transliteration, english meaning, ${kalima.source.toLowerCase()}${kalima.aliases?.length ? `, ${kalima.aliases.join(', ')}` : ''}`;

const faq = [
  { q: `What is the ${kalima.title}?`, a: `${kalima.translation} (${kalima.use}.)` },
  { q: `What is the virtue of ${kalima.title}?`, a: kalima.virtue },
  { q: `Where is ${kalima.title} from?`, a: `Basis: ${kalima.source}${kalima.narrator ? ` (narrated by ${kalima.narrator})` : ''}. Grade: ${kalima.grade}. As always, learn the wording from a teacher and consult scholars for rulings.` },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Kalimas', path: '/kalimas/' },
  { name: kalima.title, path: kalimaPath },
];
const others = KALIMAS.filter((k) => k.slug !== kalima.slug);
const sIdx = KALIMAS.findIndex((k) => k.slug === kalima.slug);
const prevK = sIdx > 0 ? KALIMAS[sIdx - 1] : null;
const nextK = sIdx >= 0 && sIdx < KALIMAS.length - 1 ? KALIMAS[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={kalimaPath}>
  <div class="max-w-3xl mx-auto px-4 py-6 md:py-8">
    <nav class="text-xs text-ink-500 mb-3">
      <a href={localizedPath(locale, '/')} class="hover:text-brand-300">{dict.nav.home}</a> /
      <a href={localizedPath(locale, '/kalimas/')} class="hover:text-brand-300"> {dict.nav.kalimas}</a> /
      <span> {kalima.title}</span>
    </nav>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[11px] font-extrabold uppercase tracking-wide text-brand-300 bg-brand-500/15 px-2.5 py-1 rounded-full">🕌 {kalima.num} of 6</span>
      {originLabel && <span class="text-[11px] font-extrabold uppercase tracking-wide text-night-900 bg-gold-300 px-2.5 py-1 rounded-full">{originLabel}</span>}
      <span class="text-[11px] font-extrabold uppercase tracking-wide text-night-900 bg-brand-500 px-2.5 py-1 rounded-full">{kalima.grade}</span>
      {isFallback && <span class="text-[11px] font-extrabold uppercase tracking-wide text-night-900 bg-gold-300 px-2.5 py-1 rounded-full">EN</span>}
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3 text-white">{kalima.title}</h1>
    <p class="mt-2 text-ink-300 leading-7"><b>Use:</b> {kalima.use}</p>
    {kalima.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] text-ink-500 leading-6">Also searched as: {kalima.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold text-ink-300">{a}</em></span>
      ))}</p>
    )}
    {isFallback && <p class="mt-4 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3">English guide — translation coming soon.</p>}

    <div class="bg-night-850 border border-white/10 text-white rounded-3xl p-6 md:p-8 my-6 shadow-xl relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 10%, rgba(139,124,246,.25), transparent 50%), radial-gradient(circle at 10% 90%, rgba(212,175,55,.12), transparent 40%);"></div>
      <div class="relative">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-gold-300 mb-3">Arabic</div>
        <p class="arabic-block leading-[2.2]" lang="ar" dir="rtl">{kalima.arabic}</p>
      </div>
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      <div class="bg-night-850 border border-white/10 rounded-2xl p-5 shadow-lg shadow-black/30">
        <div class="text-[11px] font-extrabold uppercase tracking-widest text-brand-300 mb-2">Transliteration</div>
        <p class="italic leading-7 text-[15px] text-ink-200">{kalima.translit}</p>
      </div>
      <div class="bg-night-850 border border-white/10 rounded-2xl p-5 shadow-lg shadow-black/30">
        <div class="text-[11px] font-extrabold uppercase tracking-widest text-brand-300 mb-2">English Meaning</div>
        <p class="leading-7 text-[15px] text-ink-200">{kalima.translation}</p>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 mt-3">
      <div class="bg-brand-500/10 border border-brand-500/30 rounded-2xl p-4"><div class="text-xs font-extrabold uppercase tracking-wide text-brand-300 mb-1">⏰ When</div><p class="text-sm leading-6 font-semibold text-ink-200">{kalima.when} • {kalima.repeat}</p></div>
      <div class="bg-gold-300/10 border border-gold-300/30 rounded-2xl p-4"><div class="text-xs font-extrabold uppercase tracking-wide text-gold-300 mb-1">✨ Virtue</div><p class="text-sm leading-6 text-ink-200">{kalima.virtue}</p></div>
    </div>
    <p class="mt-3 text-xs text-ink-500">📚 Basis: <b>{kalima.source}</b>{kalima.narrator && <span> • Narrated by <b>{kalima.narrator}</b></span>} • Grade: <b>{kalima.grade}</b></p>
    <p class="mt-2 text-xs text-ink-500">Verify wording with a teacher; rulings differ — consult scholars.</p>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">❓ Frequently asked questions</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/30">
            <summary class="font-bold cursor-pointer leading-6 text-ink-50">{f.q}</summary>
            <p class="mt-2 text-ink-300 leading-7 text-[15px]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">🕌 The other kalimas</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={localizedPath(locale, `/kalimas/${r.slug}/`)} class="group bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/30 hover:shadow-lg hover:border-brand-500/50 hover:bg-white/5 transition">
            <span class="font-bold block text-[15px] leading-6 text-ink-50 group-hover:text-brand-300">{r.num}. {r.title}</span>
            <span class="text-[13px] text-ink-500">{r.use}</span>
          </a>
        ))}
      </div>
      <a href={localizedPath(locale, '/kalimas/')} class="mt-4 inline-flex items-center gap-2 text-sm font-extrabold text-brand-300 hover:text-brand-200">All 6 kalimas →</a>
    </section>

    {(prevK || nextK) && (
      <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="More kalimas">
        {prevK ? (
          <a href={localizedPath(locale, `/kalimas/${prevK.slug}/`)} class="group bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/30 hover:shadow-lg hover:border-brand-500/50 hover:bg-white/5 transition">
            <span class="text-xs font-bold text-ink-500">← Previous kalima</span>
            <span class="font-bold block text-[15px] leading-6 text-ink-50 group-hover:text-brand-300">{prevK.title}</span>
          </a>
        ) : <span />}
        {nextK && (
          <a href={localizedPath(locale, `/kalimas/${nextK.slug}/`)} class="group bg-night-850 border border-white/10 rounded-2xl p-4 text-right shadow-lg shadow-black/30 hover:shadow-lg hover:border-brand-500/50 hover:bg-white/5 transition">
            <span class="text-xs font-bold text-ink-500">Next kalima →</span>
            <span class="font-bold block text-[15px] leading-6 text-ink-50 group-hover:text-brand-300">{nextK.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
