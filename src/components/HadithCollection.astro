---
/* Hadith collection page — canonical browse surface for ONE verified collection.
 * All names/counts derive from the hadith-collections registry (JSON dataset).
 * No Book/Chapter/Hadith data is authored here. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { secUI2, HADEES_UI } from '../lib/site-ui-2';
import { hadithBooksOf, hadithCountOf, collectionPath, bookPath } from '../data/hadith-collections';
import type { HadithCollection } from '../data/hadith-collections';

interface Props { collection: HadithCollection; locale: string; }
const { collection, locale } = Astro.props;
const dict = getDict(locale);
const T = (secUI2(locale, HADEES_UI) as any).coll;
const L = (p: string) => localizedPath(locale, p);
const books = hadithBooksOf(collection.id);
const total = hadithCountOf(collection.id);
const collPath = collectionPath(collection.slug);

const title = T.collTitle.replace('{name}', collection.name);
let description = T.collDesc.replace('{name}', collection.name).replace('{t}', String(total));
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${collection.name.toLowerCase()}, ${collection.slug} hadith collection, ${collection.slug} hadith arabic english`;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: (secUI2(locale, HADEES_UI) as any).crumb, path: '/hadees/' },
  { name: collection.name, path: collPath },
];
const faq = [
  { q: T.faqFullQ, a: T.faqFullA.replace('{t}', String(total)) },
  { q: T.faqLangQ, a: T.faqLangA },
  { q: T.refL, a: collection.provenanceLine },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath={collPath}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.countBadge.replace('{b}', String(books.length)).replace('{t}', String(total))}</span>
        <span class="hn-badge">{T.arabicL} + {T.englishL}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{collection.name}</h1>
      {collection.arabicName && <p class="font-arabic text-2xl mt-1" lang="ar" dir="rtl">{collection.arabicName}</p>}
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{collection.description}</p>
      {collection.compiler && <p class="mt-1 text-sm" style="color:var(--hn-muted)">{T.provL}: {collection.compiler}</p>}
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.bookOf.replace('{n}', '1')} title={T.secT} />
      <div class="grid gap-3 sm:grid-cols-2">
        {books.map((b) => (
          <a href={L(bookPath(collection.slug, b.slug))} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="book" size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block leading-6">{b.title}</span>
              <span class="text-[13px] leading-5 block mt-0.5" style="color:var(--hn-muted)">{T.hadithOf.replace('{n}', `${b.first}–${b.last}`).replace('{t}', String(total))}</span>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>

    <p class="mt-8 text-[12px] leading-6 max-w-3xl" style="color:var(--hn-muted)">{T.provL}: {collection.provenanceLine}</p>

    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
