---
/* Public reader profile — opened from the leaderboard (?u=username).
 * Shows photo, name, @username + only the fields the reader made public.
 * No login required.
 */
import { localizedPath } from '../i18n/utils';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const leaderboardUrl = localizedPath(locale, '/leaderboard/');
const readUrl = localizedPath(locale, '/tools/read/');
---

<div class="max-w-md mx-auto px-4 py-8" data-pub>
  <div data-pub-loading class="animate-pulse space-y-3">
    <div class="h-44 bg-night-850 border border-white/10 rounded-3xl"></div>
    <div class="h-32 bg-night-850 border border-white/10 rounded-3xl"></div>
  </div>

  <div data-pub-error class="hidden text-center bg-night-850 border border-white/10 rounded-3xl p-8">
    <div class="text-5xl">🔍</div>
    <p data-pub-errmsg class="mt-3 font-extrabold text-lg text-white">Reader not found</p>
    <p class="mt-1 text-sm text-ink-300">Usernames are unique — check the spelling, or pick a reader below.</p>
    <a href={leaderboardUrl} class="mt-4 inline-flex items-center justify-center gap-2 bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">🏆 Leaderboard</a>
  </div>

  <div data-pub-live class="hidden space-y-4">
    <section class="bg-night-850 border border-white/10 rounded-3xl p-6 text-center shadow-xl shadow-black/30">
      <div data-pub-avatar class="mx-auto w-24 h-24 grid place-items-center rounded-full overflow-hidden ring-2 ring-brand-500/50 bg-brand-500/15 text-5xl font-extrabold text-white" aria-hidden="true">?</div>
      <h1 data-pub-name class="mt-3 text-2xl font-extrabold text-white">Reader</h1>
      <p data-pub-username class="text-brand-300 font-bold"></p>
      <p data-pub-meta class="mt-1 text-xs text-ink-500"></p>
      <p data-pub-bio class="mt-2 text-sm text-ink-200 leading-6"></p>
      <p data-pub-gender class="mt-2 hidden inline-flex items-center gap-1.5 text-xs font-bold text-ink-300 bg-white/5 border border-white/10 rounded-full px-3 py-1.5"></p>
    </section>

    <section data-pub-stats class="hidden bg-night-850 border border-white/10 rounded-3xl p-5 shadow-xl shadow-black/30">
      <p data-pub-rank class="hidden text-center text-sm font-extrabold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-full px-4 py-2"></p>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <div class="bg-night-800 border border-white/10 rounded-2xl px-2 py-3"><div class="text-xl">📖</div><div data-pub-verses class="font-extrabold text-lg text-white">0</div><div class="text-[11px] font-bold text-ink-500">verses</div></div>
        <div class="bg-night-800 border border-white/10 rounded-2xl px-2 py-3"><div class="text-xl">💗</div><div data-pub-hasanat class="font-extrabold text-lg text-white">0</div><div class="text-[11px] font-bold text-ink-500">hasanat</div></div>
        <div class="bg-night-800 border border-white/10 rounded-2xl px-2 py-3"><div class="text-xl">🔥</div><div data-pub-streak class="font-extrabold text-lg text-white">0</div><div class="text-[11px] font-bold text-ink-500">streak</div></div>
      </div>
    </section>

    <div class="flex flex-col sm:flex-row gap-2">
      <a data-pub-read href={readUrl} class="flex-1 inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-5 py-3 min-h-[52px]">📖 Read Quran</a>
      <a href={leaderboardUrl} class="flex-1 inline-flex items-center justify-center gap-2 border-2 border-white/15 hover:border-brand-400 text-ink-50 font-extrabold rounded-full px-5 py-3 min-h-[52px]">🏆 Leaderboard</a>
    </div>
  </div>
</div>

<script define:vars={{ locale }}>
  (() => {
    const root = document.querySelector('[data-pub]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    void locale;
    const $ = (s) => root.querySelector(s);
    const GENDERS = { male: 'Male', female: 'Female', other: 'Other' };

    (async () => {
      const u = new URLSearchParams(window.location.search).get('u') || '';
      if (!u) {
        $('[data-pub-loading]')?.classList.add('hidden');
        $('[data-pub-error]')?.classList.remove('hidden');
        return;
      }
      let H = null;
      try { H = await import('/habits/habit.js?v=4'); } catch {}
      let d = null;
      try {
        const r = await fetch(`/api/user?u=${encodeURIComponent(u)}`, { credentials: 'same-origin' });
        d = await r.json();
        if (!r.ok) throw new Error(d?.error || 'not_found');
      } catch {
        $('[data-pub-loading]')?.classList.add('hidden');
        $('[data-pub-error]')?.classList.remove('hidden');
        return;
      }
      const usr = d.user || {};
      $('[data-pub-loading]')?.classList.add('hidden');
      $('[data-pub-live]')?.classList.remove('hidden');
      const av = $('[data-pub-avatar]');
      if (av) {
        try {
          if (H?.faceFor) {
            const html = H.faceFor({ avatar: usr.avatar, avatar_emoji: usr.avatar_emoji, name: usr.name || usr.username });
            if (String(html).trim().startsWith('<')) av.innerHTML = html;
            else av.textContent = html;
          } else {
            av.textContent = (usr.name || usr.username || 'R').charAt(0).toUpperCase();
          }
        } catch {
          av.textContent = (usr.name || usr.username || 'R').charAt(0).toUpperCase();
        }
      }
      if ($('[data-pub-name]')) $('[data-pub-name]').textContent = usr.name || 'Reader';
      if ($('[data-pub-username]')) $('[data-pub-username]').textContent = usr.username ? `@${usr.username}` : '';
      const loc = [usr.city, usr.country].filter(Boolean).join(', ');
      const since = usr.member_since ? new Date(usr.member_since * 1000).toLocaleDateString(undefined, { month: 'short', year: 'numeric' }) : '';
      if ($('[data-pub-meta]')) $('[data-pub-meta]').textContent = [loc, since ? `Reading since ${since}` : ''].filter(Boolean).join(' • ');
      if ($('[data-pub-bio]')) {
        $('[data-pub-bio]').textContent = usr.bio || '';
        $('[data-pub-bio]').classList.toggle('hidden', !usr.bio);
      }
      const g = $('[data-pub-gender]');
      if (g) {
        const label = GENDERS[usr.gender];
        if (label) { g.textContent = label; g.classList.remove('hidden'); }
        else g.classList.add('hidden');
      }
      if (d.stats) {
        $('[data-pub-stats]')?.classList.remove('hidden');
        if ($('[data-pub-verses]')) $('[data-pub-verses]').textContent = d.stats.verses ?? 0;
        if ($('[data-pub-hasanat]')) $('[data-pub-hasanat]').textContent = H?.fmtCompact ? H.fmtCompact(d.stats.hasanat ?? 0) : (d.stats.hasanat ?? 0);
        if ($('[data-pub-streak]')) $('[data-pub-streak]').textContent = d.stats.streak ?? 0;
        if (d.rank && $('[data-pub-rank]')) {
          $('[data-pub-rank]').textContent = `🏆 #${d.rank} on the hasanat board`;
          $('[data-pub-rank]').classList.remove('hidden');
        }
      }
    })();
  })();
</script>
