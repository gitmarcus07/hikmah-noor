---
/* Styled confirm/alert dialog (replaces native confirm()/alert()).
 * Global: included once in BaseLayout. Use from any inline script:
 *   const ok = await window.hnConfirm({ title, body, ok, cancel, danger });
 *   await window.hnAlert(body, title);
 */
---

<div data-confirm class="hidden fixed inset-0 z-[100]" role="alertdialog" aria-modal="true" aria-label="Confirm">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div class="absolute inset-x-8 top-[30%] mx-auto max-w-sm bg-[#2e2e33] rounded-[26px] p-7 text-center shadow-2xl shadow-black/60">
    <h2 data-confirm-title class="text-[20px] font-extrabold text-white"></h2>
    <p data-confirm-body class="mt-2 text-[14px] leading-6 text-ink-300"></p>
    <div class="mt-5 grid gap-2">
      <button data-confirm-ok class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] transition">OK</button>
      <button data-confirm-cancel class="w-full text-ink-300 font-bold px-6 py-2.5 min-h-[48px] hover:text-white transition">Cancel</button>
    </div>
  </div>
</div>

<script>
  (() => {
    if (document.body.dataset.hnConfirmWired) return;
    document.body.dataset.hnConfirmWired = '1';
    let pending = null;

    const els = () => ({
      modal: document.querySelector('[data-confirm]'),
      title: document.querySelector('[data-confirm-title]'),
      body: document.querySelector('[data-confirm-body]'),
      ok: document.querySelector('[data-confirm-ok]'),
      cancel: document.querySelector('[data-confirm-cancel]'),
    });

    const close = (value) => {
      const { modal } = els();
      modal?.classList.add('hidden');
      if (!document.querySelector('[data-hub-pmodal]:not(.hidden), [data-hub-amodal]:not(.hidden), [data-hub-rmodal]:not(.hidden), [data-lb-modal]:not(.hidden)')) {
        document.body.style.overflow = '';
      }
      if (pending) { pending(value); pending = null; }
    };

    window.hnConfirm = ({ title = '', body = '', ok = 'OK', cancel = 'Cancel', danger = false } = {}) => {
      const e = els();
      if (!e.modal) return Promise.resolve(false);
      if (e.title) e.title.textContent = title;
      if (e.body) e.body.textContent = body;
      if (e.ok) {
        e.ok.textContent = ok;
        e.ok.className = danger
          ? 'w-full bg-red-500/15 hover:bg-red-500/25 border border-red-400/40 text-red-200 font-extrabold rounded-full px-6 py-3 min-h-[52px] transition'
          : 'w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] transition';
      }
      if (e.cancel) {
        e.cancel.textContent = cancel;
        e.cancel.classList.toggle('hidden', !cancel);
      }
      e.modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      return new Promise((res) => { pending = res; });
    };

    window.hnAlert = (body, title = '') =>
      window.hnConfirm({ title, body, ok: 'OK', cancel: '' });

    document.querySelector('[data-confirm-ok]')?.addEventListener('click', () => close(true));
    document.querySelector('[data-confirm-cancel]')?.addEventListener('click', () => close(false));
  })();
</script>
