---
/* Unified search box with live suggestions. Engine-powered (deterministic tiers). */
import Icon from './Icon.astro';
import { getDict } from '../i18n/utils';
interface Props {
  locale: string;
  /** e.g. `/search-index.json` or `/hi/search-index.json` */
  indexUrl: string;
  /** e.g. `/search/` or `/hi/search/` */
  searchUrl: string;
  placeholder: string;
  id?: string;
  /** Allow the suggest popup on phones too (e.g. homepage hero). Default false. */
  mobileSuggest?: boolean;
}
const { locale, indexUrl, searchUrl, placeholder, id = 'q', mobileSuggest = false } = Astro.props;
const S = (getDict(locale) as any).search || {};
const T = { viewAll: S.viewAll || 'See all {n} results →', noMatches: S.noMatches || 'No matches — press Enter to search anyway.' };
---
<div class="relative min-w-0 flex-1" data-searchbox data-locale={locale} data-t={JSON.stringify(T)}>
  <form action={searchUrl} method="get" class="hn-searchwrap" role="search">
    <Icon name="search" size={19} />
    <input id={id} name="q" placeholder={placeholder} autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" role="combobox" aria-expanded="false" aria-controls={`${id}-suggest`} aria-autocomplete="list" />
    <button class="hn-btn hn-btn-primary !rounded-[10px] !min-h-[44px]" aria-label="Search"><Icon name="search" size={18} /></button>
  </form>
  <div id={`${id}-suggest`} class="hidden absolute inset-x-0 top-full mt-2 z-40 hn-card overflow-hidden max-h-[60vh] overflow-y-auto" role="listbox"></div>
</div>
<script define:vars={{ indexUrl, searchUrl, inputId: id, mobileSuggest }}>
  import { createIndex, search, suggest, ayahNeeded, escHtml, highlight } from '../lib/search-engine.js';
  (() => {
    const box = document.querySelector(`[data-searchbox] #${CSS.escape(inputId)}`);
    if (!box) return;
    const host = box.closest('[data-searchbox]');
    const ayahUrl = String(indexUrl).replace('search-index.json', 'search-ayahs.json');
    const T = JSON.parse(host?.dataset.t || '{}');
    const panel = document.getElementById(`${inputId}-suggest`);
    const form = box.closest('form');
    let corePayload = null;
    let core = null;
    let ayahsLoaded = false;
    let ayahsLoading = null;
    let active = -1;
    let rows = [];
    const loadCore = async () => {
      if (!core) {
        try { corePayload = await (await fetch(indexUrl)).json(); }
        catch { corePayload = null; }
        if (!corePayload) corePayload = { v: 1, locale: 'en', cats: [], docs: [], surahs: [], aliases: {} };
        core = createIndex(corePayload, null);
      }
      return core;
    };
    const ensureAyahs = async (q) => {
      const idx = await loadCore();
      if (ayahsLoaded || !ayahNeeded(idx, q)) return;
      if (!ayahsLoading) {
        ayahsLoading = (async () => {
          try {
            const payload = await (await fetch(ayahUrl)).json();
            core = createIndex(corePayload, payload);
          } catch { /* keep core-only */ }
          ayahsLoaded = true;
          ayahsLoading = null;
        })();
      }
      await ayahsLoading;
    };
    const fill = (tpl, m) => String(tpl || '').replace(/\{(\w+)\}/g, (_, k) => m[k] ?? '');
    const close = () => {
      panel.classList.add('hidden');
      box.setAttribute('aria-expanded', 'false');
      active = -1;
    };
    /* On phones the suggest popup would cover the live results below —
       so suggestions only appear on larger screens. */
    const allowSuggest = () => window.matchMedia('(min-width: 768px)').matches;
    const render = (list, q, total) => {
      rows = list;
      if (!list.length) {
        panel.innerHTML = `<p class="px-4 py-3.5 text-sm">${escHtml(T.noMatches)}</p>`;
      } else {
        panel.innerHTML = list.map((it, i) =>
          `<a href="${escHtml(it.u)}" role="option" data-i="${i}" class="sugrow flex items-center gap-3 px-3.5 py-2.5 hover:opacity-80 ${i > 0 ? 'border-t' : ''}" style="border-color:var(--hn-border)">` +
          `<span class="hn-badge hn-badge-primary">${escHtml(it.c)}</span>` +
          `<span class="min-w-0"><span class="font-semibold text-[14px] leading-5 block truncate">${highlight(it.t, q)}</span></span>` +
          `</a>`
        ).join('') + (total > list.length
          ? `<a href="${searchUrl}?q=${encodeURIComponent(q)}" class="block px-3.5 py-3 text-sm font-bold" style="color:var(--hn-primary);border-top:1px solid var(--hn-border)">${escHtml(fill(T.viewAll, { n: total }))}</a>`
          : '');
      }
      panel.classList.remove('hidden');
      box.setAttribute('aria-expanded', 'true');
    };
    let t = null;
    box.addEventListener('input', () => {
      clearTimeout(t);
      t = setTimeout(async () => {
        const q = box.value.trim();
        if (q.length < 1 || (!allowSuggest() && !mobileSuggest)) { close(); return; }
        await loadCore();
        await ensureAyahs(q);
        const ranked = search(core, q, { limit: 60 });
        render(ranked.slice(0, 6).map((r) => r.d), q, ranked.length);
      }, 120);
    });
    box.addEventListener('focus', async () => {
      if (box.value.trim().length >= 1) box.dispatchEvent(new Event('input'));
      else load();
    });
    box.addEventListener('keydown', (e) => {
      const links = [...panel.querySelectorAll('.sugrow')];
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (panel.classList.contains('hidden') || !links.length) return;
        e.preventDefault();
        active = e.key === 'ArrowDown' ? (active + 1) % links.length : (active - 1 + links.length) % links.length;
        links.forEach((a, i) => a.classList.toggle('hn-active-sug', i === active));
        links[active]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && active >= 0 && links[active]) {
        e.preventDefault();
        window.location.href = links[active].href;
      } else if (e.key === 'Escape') close();
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('[data-searchbox]')) close();
    });
    /* Dismiss suggestions on scroll so results stay visible (esp. mobile). */
    document.addEventListener('scroll', () => close(), { passive: true, capture: true });
    form?.addEventListener('submit', () => close());
  })();
</script>
<style>
  .hn-active-sug { background: var(--hn-primary-soft); }
</style>
