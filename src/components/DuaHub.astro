---
/* Duas hub: all categories -> category -> dua. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { DUA_CATS, duasByCat, DUAS } from '../data/duas';
import { localizeList } from '../lib/duas-i18n';
import { localizeDuaCat, duaUI } from '../lib/dua-ui-i18n';

interface Props { locale: string; guides: { title: string; desc: string; href: string }[]; popularSlugs?: string[]; }
const { locale, guides, popularSlugs = [] } = Astro.props;
const dict = getDict(locale);
const T = duaUI(locale);
const L = (p: string) => localizedPath(locale, p);
const counts = DUA_CATS.map((c) => ({ ...localizeDuaCat(c, locale), slug: c.slug, icon: c.icon, n: duasByCat(c.slug).length }));
const DL = localizeList(DUAS, locale);
const popular = popularSlugs.length
  ? popularSlugs.map((s) => DL.find((d) => d.slug === s)).filter(Boolean)
  : DL.slice(0, 8);
const originOf = (d: any): string => d.origin ?? (String(d.source || '').startsWith('Quran') ? 'quran' : 'hadith');
const nQuran = DL.filter((d: any) => originOf(d) === 'quran').length;
const nHadith = DL.filter((d: any) => originOf(d) === 'hadith').length;
const hisnList = DL.filter((d: any) => (d as any).hisnNo).sort((a: any, b: any) => (a as any).hisnNo - (b as any).hisnNo);

const title = T.hubTitle.replace('{n}', String(DL.length));
const catNames = counts.map((c) => c.title).join(', ');
let description = T.hubDesc.replace('{n}', String(DL.length)).replace('{m}', String(counts.length)).replace('{cats}', catNames);
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${catNames.toLowerCase()}, hisn al muslim${DL.slice(0, 4).map((d: any) => `, ${d.title.toLowerCase()}`).join('')}`;
const faq = [
  { q: T.hubFaqOrg, a: T.hubFaqOrgA.replace('{n}', String(counts.length)).replace('{cats}', catNames) },
  { q: T.hubFaqTr, a: T.hubFaqTrA },
  { q: T.hubFaqAuth, a: T.hubFaqAuthA },
  { q: T.hubFaqFind, a: T.hubFaqFindA },
  { q: T.hubFaqHisn, a: T.hubFaqHisnA },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: dict.nav.duas, path: '/duas/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath="/duas/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{DL.length} {T.badges.duas}</span>
        <span class="hn-badge">{counts.length} {T.badges.cats}</span>
        <span class="hn-badge">{nQuran} {T.badges.quran}</span>
        <span class="hn-badge">{nHadith}+ {T.badges.prophetic}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.hubSearchPh} aria-label={T.hubSearchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secCategories} title={T.secCategories} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {counts.map((c) => (
          <a href={L(`/duas/${c.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any || 'duas'} size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block leading-6">{c.title} <span class="text-xs font-bold" style="color:var(--hn-muted)">({c.n})</span></span>
              <span class="text-[13px] leading-5 block mt-0.5 line-clamp-2" style="color:var(--hn-muted)">{c.desc}</span>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secPopular} title={T.secPopular} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {popular.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{T.forPrefix} {d.use}</span>
          </a>
        ))}
      </div>
    </div>

    {hisnList.length > 0 && (
      <div class="mt-8">
        <SectionHeader eyebrow={T.filter.hisn} title={T.secHisn} sub={T.hisnSub} />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {hisnList.slice(0, 8).map((d: any) => (
            <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="hn-badge hn-badge-gold">Hisn #{(d as any).hisnNo}</span>
              <span class="font-bold block text-[15px] leading-6 mt-2">{d.title}</span>
              <span class="text-[13px]" style="color:var(--hn-muted)">{T.forPrefix} {d.use}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {guides.length > 0 && (
      <div class="mt-8">
        <SectionHeader eyebrow={T.secGuides} title={T.secGuides} />
        <div class="grid gap-3 sm:grid-cols-2">
          {guides.map((g) => (
            <a href={g.href} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-extrabold block leading-6">{g.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.desc}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-8">
      <SectionHeader eyebrow={T.secAll} title={T.secAll} sub={T.allSub} />
      <div class="flex flex-col sm:flex-row gap-2 mb-3">
        <input id="duafilter" placeholder={T.filterPh} class="hn-input flex-1" aria-label={T.filterPh} />
        <select id="duacat" class="hn-input sm:max-w-[240px]" aria-label={T.filterCatLabel}>
          <option value="">{T.filterCatLabel}</option>
          {counts.map((c) => <option value={c.slug}>{c.title}</option>)}
        </select>
      </div>
      <div class="flex flex-wrap gap-2 mb-4" id="duaorigin">
        <button data-origin="" class="dua-origin-btn hn-btn hn-btn-primary !min-h-[40px] !py-2 !px-4 text-sm">{T.filter.all}</button>
        <button data-origin="quran" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">{T.filter.quran}</button>
        <button data-origin="hadith" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">{T.filter.hadith}</button>
        <button data-origin="sahaba" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">{T.filter.sahaba}</button>
        <button data-origin="scholarly" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">{T.filter.scholarly}</button>
        <button id="hisnbtn" class="hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm" aria-pressed="false">{T.filter.hisn} ({hisnList.length})</button>
      </div>
      <p id="duacount" class="text-sm mb-3" data-many={T.countMany} data-one={T.countOne} style="color:var(--hn-muted)">{DL.length} {T.countMany}</p>
      <div id="duagrid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {DL.map((d: any) => {
          const cat = counts.find((c) => c.slug === d.cat);
          return (
            <a href={L(`/duas/${d.cat}/${d.slug}/`)} data-search={`${d.title} ${d.use} ${cat?.title ?? ''} ${((d as any).aliases || []).join(' ')}${(d as any).hisnNo ? ` hisn ${(d as any).hisnNo} hisn al muslim` : ''}`.toLowerCase()} data-cat={d.cat} data-origin={originOf(d)} data-hisn={(d as any).hisnNo ? '1' : ''} class="duarow hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">{d.title}</span>
              <span class="text-[13px]" style="color:var(--hn-muted)">{T.forPrefix} {d.use}</span>
              <span class="mt-2 flex flex-wrap gap-1.5">
                <span class="hn-badge hn-badge-primary">{cat?.title ?? d.cat}</span>
                {d.grade && <span class="hn-badge">{d.grade}</span>}
                {(d as any).hisnNo && <span class="hn-badge hn-badge-gold">Hisn #{(d as any).hisnNo}</span>}
              </span>
            </a>
          );
        })}
      </div>
      <script is:inline>
        (() => {
          const input = document.getElementById('duafilter');
          const catSel = document.getElementById('duacat');
          const count = document.getElementById('duacount');
          const rows = [...document.querySelectorAll('.duarow')];
          const btns = [...document.querySelectorAll('.dua-origin-btn')];
          const hisnBtn = document.getElementById('hisnbtn');
          const setBtn = (b, on) => {
            b.classList.toggle('hn-btn-primary', on);
            b.classList.toggle('hn-btn-secondary', !on);
          };
          let origin = '';
          let hisnOnly = false;
          const apply = () => {
            const q = (input.value || '').toLowerCase().trim();
            const cat = catSel.value || '';
            let n = 0;
            rows.forEach((r) => {
              const okQ = !q || (r.dataset.search || '').includes(q);
              const okC = !cat || r.dataset.cat === cat;
              const okO = !origin || r.dataset.origin === origin;
              const okH = !hisnOnly || r.dataset.hisn === '1';
              const show = okQ && okC && okO && okH;
              r.classList.toggle('hidden', !show);
              if (show) n++;
            });
            if (count) count.textContent = `${n} ${n === 1 ? (count.dataset.one || 'dua') : (count.dataset.many || 'duas')}`;
          };
          input?.addEventListener('input', apply);
          catSel?.addEventListener('change', apply);
          btns.forEach((b) =>
            b.addEventListener('click', () => {
              origin = b.dataset.origin || '';
              btns.forEach((x) => setBtn(x, x === b));
              apply();
            })
          );
          hisnBtn?.addEventListener('click', () => {
            hisnOnly = !hisnOnly;
            hisnBtn.setAttribute('aria-pressed', String(hisnOnly));
            setBtn(hisnBtn, hisnOnly);
            apply();
          });
        })();
      </script>
    </div>
    <section class="mt-8 max-w-3xl" aria-label={T.faqTitle}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">{T.faqTitle}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
