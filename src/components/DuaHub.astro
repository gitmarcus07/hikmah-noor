---
/* Duas hub: all categories -> category -> dua. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { DUA_CATS, duasByCat, DUAS } from '../data/duas';

interface Props { locale: string; guides: { title: string; desc: string; href: string }[]; popularSlugs?: string[]; }
const { locale, guides, popularSlugs = [] } = Astro.props;
const dict = getDict(locale);
const L = (p: string) => localizedPath(locale, p);
const counts = DUA_CATS.map((c) => ({ ...c, n: duasByCat(c.slug).length }));
const popular = popularSlugs.length
  ? popularSlugs.map((s) => DUAS.find((d) => d.slug === s)).filter(Boolean)
  : DUAS.slice(0, 8);
const originOf = (d: any): string => d.origin ?? (String(d.source || '').startsWith('Quran') ? 'quran' : 'hadith');
const nQuran = DUAS.filter((d: any) => originOf(d) === 'quran').length;
const nHadith = DUAS.filter((d: any) => originOf(d) === 'hadith').length;

const title = `All Duas in Arabic with Transliteration, Meaning & Sources (${DUAS.length}+ duas)`;
const description = `All ${DUAS.length} authentic duas by category — morning, salah, Ramadan, Hajj, prophets’ duas, marriage, children, death, hereafter and more. Arabic, transliteration, meaning, narrator and authenticity grade.`;
const keywords = 'all duas, dua in arabic, masnoon duas, transliteration, meaning, rabbana duas, morning evening duas, duas for protection, prophets duas, ramadan duas, funeral dua';
const faq = [
  { q: 'How are the duas organized?', a: 'By life moment and source: morning & evening, salah, Ramadan, travel, food, home, marriage, children, sleep, health, forgiveness, hardship & rizq, purity, worship & knowledge, Hajj, prophets’ duas, death & funeral, hereafter and daily life. Every dua page names its source, narrator (when known) and authenticity grade.' },
  { q: 'Does every dua include transliteration and meaning?', a: 'Yes — Arabic text, easy transliteration, English meaning, when to recite, virtue, source, narrator and grade on each dua’s own page.' },
  { q: 'Are these duas authentic?', a: 'Only well-known duas are included. Quranic duas are marked Quranic; hadith duas name their collection (e.g. Sahih al-Bukhari, Sahih Muslim) without invented numbers, plus a Sahih/Hasan/Daif grade where established. Learn wording from a teacher; consult scholars for rulings.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Duas', path: '/duas/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/duas/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{DUAS.length} duas</span>
        <span class="hn-badge">{DUA_CATS.length} categories</span>
        <span class="hn-badge">{nQuran} Quranic</span>
        <span class="hn-badge">{nHadith}+ Prophetic</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">All Duas</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Pick a category, find the dua for your moment, open its page for Arabic, transliteration, meaning, narrator, authenticity grade and source.</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder="Search duas — e.g. travel, parents, Laylatul Qadr…" aria-label="Search duas" />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Categories" title="Browse by category" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {counts.map((c) => (
          <a href={L(`/duas/${c.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any || 'duas'} size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block leading-6">{c.title} <span class="text-xs font-bold" style="color:var(--hn-muted)">({c.n})</span></span>
              <span class="text-[13px] leading-5 block mt-0.5 line-clamp-2" style="color:var(--hn-muted)">{c.desc}</span>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Popular" title="Most-searched duas" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {popular.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">For: {d.use}</span>
          </a>
        ))}
      </div>
    </div>

    {guides.length > 0 && (
      <div class="mt-8">
        <SectionHeader eyebrow="Guides" title="In-depth dua guides" />
        <div class="grid gap-3 sm:grid-cols-2">
          {guides.map((g) => (
            <a href={g.href} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-extrabold block leading-6">{g.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.desc}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-8">
      <SectionHeader eyebrow="All" title="All duas — search & filter" sub="Type to filter by title or purpose. Filter by source or category." />
      <div class="flex flex-col sm:flex-row gap-2 mb-3">
        <input id="duafilter" placeholder="Filter duas — e.g. rain, debt, parents, Jannah…" class="hn-input flex-1" aria-label="Filter duas" />
        <select id="duacat" class="hn-input sm:max-w-[240px]" aria-label="Category">
          <option value="">All categories</option>
          {DUA_CATS.map((c) => <option value={c.slug}>{c.title}</option>)}
        </select>
      </div>
      <div class="flex flex-wrap gap-2 mb-4" id="duaorigin">
        <button data-origin="" class="dua-origin-btn hn-btn hn-btn-primary !min-h-[40px] !py-2 !px-4 text-sm">All sources</button>
        <button data-origin="quran" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">Quranic</button>
        <button data-origin="hadith" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">Prophetic</button>
        <button data-origin="sahaba" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">Companion</button>
        <button data-origin="scholarly" class="dua-origin-btn hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm">Scholarly</button>
      </div>
      <p id="duacount" class="text-sm mb-3" style="color:var(--hn-muted)">{DUAS.length} duas</p>
      <div id="duagrid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {DUAS.map((d: any) => {
          const cat = DUA_CATS.find((c) => c.slug === d.cat);
          return (
            <a href={L(`/duas/${d.cat}/${d.slug}/`)} data-search={`${d.title} ${d.use} ${cat?.title ?? ''} ${((d as any).aliases || []).join(' ')}`.toLowerCase()} data-cat={d.cat} data-origin={originOf(d)} class="duarow hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">{d.title}</span>
              <span class="text-[13px]" style="color:var(--hn-muted)">For: {d.use}</span>
              <span class="mt-2 flex flex-wrap gap-1.5">
                <span class="hn-badge hn-badge-primary">{cat?.title ?? d.cat}</span>
                {d.grade && <span class="hn-badge">{d.grade}</span>}
              </span>
            </a>
          );
        })}
      </div>
      <script is:inline>
        (() => {
          const input = document.getElementById('duafilter');
          const catSel = document.getElementById('duacat');
          const count = document.getElementById('duacount');
          const rows = [...document.querySelectorAll('.duarow')];
          const btns = [...document.querySelectorAll('.dua-origin-btn')];
          let origin = '';
          const apply = () => {
            const q = (input.value || '').toLowerCase().trim();
            const cat = catSel.value || '';
            let n = 0;
            rows.forEach((r) => {
              const okQ = !q || (r.dataset.search || '').includes(q);
              const okC = !cat || r.dataset.cat === cat;
              const okO = !origin || r.dataset.origin === origin;
              const show = okQ && okC && okO;
              r.classList.toggle('hidden', !show);
              if (show) n++;
            });
            if (count) count.textContent = `${n} dua${n === 1 ? '' : 's'}`;
          };
          input?.addEventListener('input', apply);
          catSel?.addEventListener('change', apply);
          btns.forEach((b) =>
            b.addEventListener('click', () => {
              origin = b.dataset.origin || '';
              apply();
            })
          );
        })();
      </script>
    </div>
  </div>
</BaseLayout>
