---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from './SearchBox.astro';
import Icon from './Icon.astro';
import SiteArt from './SiteArt.astro';
import HabitHub from './HabitHub.astro';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: string;
  dict: any;
  latest: any[];
  catGroups: Record<string, any[]>;
  fallbackCount?: number;
}
const { locale, dict } = Astro.props;
const library = [
  { icon: 'surahs', label: dict.nav.surahs, href: localizedPath(locale, '/surahs/'), pill: '114' },
  { icon: 'quran', label: dict.nav.quran, href: localizedPath(locale, '/quran/'), pill: '30' },
  { icon: 'duas', label: dict.nav.duas, href: localizedPath(locale, '/duas/'), pill: '' },
  { icon: 'kalimas', label: dict.nav.kalimas, href: localizedPath(locale, '/kalimas/'), pill: '6' },
  { icon: 'meanings', label: dict.nav.meanings, href: localizedPath(locale, '/meanings/'), pill: '' },
  { icon: 'waqiat', label: dict.nav.waqiat, href: localizedPath(locale, '/waqiat/'), pill: '' },
] as const;
---
<BaseLayout title={dict.home.heroTitle} description={dict.home.heroSub} locale={locale} canonicalPath="/" faq={dict.home.faq} type="website">
  <!-- 1. HERO -->
  <section class="relative overflow-hidden bg-night-900">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 10%, rgba(139,124,246,.25), transparent 50%), radial-gradient(circle at 10% 90%, rgba(212,175,55,.12), transparent 40%);"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-10 sm:pt-14 md:pt-16 pb-4 sm:pb-5 text-center">
      <div class="min-w-0">
        <p class="font-arabic text-4xl sm:text-5xl text-gold-300 leading-[1.8]" lang="ar" dir="rtl">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
        <div class="mt-4"><span class="inline-block text-[12px] sm:text-[13px] font-semibold bg-white/5 border border-white/10 text-brand-300 rounded-full px-4 py-1.5">📖 {dict.home.heroBadge}</span></div>
        <h1 class="text-[28px] leading-[1.2] sm:text-4xl md:text-5xl font-extrabold md:leading-tight text-white mt-4 break-words">{dict.home.heroTitle}</h1>
        <p class="text-lg sm:text-2xl md:text-3xl font-extrabold text-gold-300 mt-2">Arabic • Hindi • English • Urdu</p>
        <p class="mt-3 text-ink-300 text-[15px] md:text-base leading-7 max-w-xl mx-auto">{dict.home.heroSub}</p>
        <div class="mt-5 max-w-xl mx-auto">
          <SearchBox locale={locale} indexUrl={localizedPath(locale, '/search-index.json')} searchUrl={localizedPath(locale, '/search/')} placeholder={dict.nav.search} id="hero-q" />
        </div>
        <div class="mt-4 flex flex-col sm:flex-row sm:flex-wrap justify-center gap-3">
          <a href={localizedPath(locale, '/tools/habit-start/')} class="bg-brand-500 hover:bg-brand-400 text-night-900 font-bold rounded-full px-6 py-3 min-h-[48px] shadow-lg shadow-brand-500/25 inline-flex items-center justify-center gap-2"><Icon name="quran" size={19} />{dict.home.heroCta1}</a>
          <a href={localizedPath(locale, '/tools/read/')} class="bg-white/10 hover:bg-white/15 border border-white/15 text-white font-bold rounded-full px-6 py-3 min-h-[48px] inline-flex items-center justify-center gap-2"><Icon name="duas" size={19} />{dict.home.heroCta2}</a>
        </div>
        <a href={localizedPath(locale, '/tools/')} class="mt-3 sm:hidden inline-flex items-center justify-center gap-2 w-full bg-gold-300 hover:bg-gold-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] shadow">🧰 {dict.nav.tools} • 20 →</a>
      </div>
      <div class="relative mt-8 rounded-3xl shadow-xl border border-white/10 overflow-hidden h-44 sm:h-56">
        <SiteArt name="hero-quran" title="Holy Quran placed on a wooden rehal" />
        <span class="absolute top-3 start-3 bg-night-900/95 backdrop-blur border border-white/10 text-white text-xs font-extrabold rounded-full px-3.5 py-2 shadow">114 {dict.nav.surahs}</span>
        <span class="absolute bottom-3 end-3 bg-brand-500/95 backdrop-blur text-night-900 text-xs font-extrabold rounded-full px-3.5 py-2 shadow">30 {dict.nav.quran}</span>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4">
    <!-- 1b. QURAN HABIT (login-gated trackers) -->
    <HabitHub locale={locale} />

    <!-- 2. CHALLENGES -->
    <section class="py-6 sm:py-8" aria-label={dict.home.challengesTitle}>
      <div class="flex items-center justify-between mb-1 gap-3">
        <h2 class="text-xl md:text-2xl font-extrabold truncate text-white">{dict.home.challengesTitle}</h2>
        <a href={localizedPath(locale, '/tools/my-progress/')} class="shrink-0 text-sm font-bold text-brand-300 hover:text-brand-200">{dict.home.seeAll} →</a>
      </div>
      <p class="text-sm text-ink-300 leading-6 mb-4">{dict.home.challengesSub}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={localizedPath(locale, '/tools/read/18/')} class="group bg-night-850 border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-lg shadow-black/30 hover:border-brand-500/50 transition">
          <span class="text-3xl" aria-hidden="true">🌙</span>
          <span class="font-extrabold text-lg text-white group-hover:text-brand-300">{dict.home.chFridayT}</span>
          <span class="text-sm text-ink-300">{dict.home.chFridayD}</span>
          <span class="text-xs font-extrabold text-brand-300 mt-1">110 verses →</span>
        </a>
        <a href={localizedPath(locale, '/tools/my-progress/')} class="group bg-night-850 border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-lg shadow-black/30 hover:border-brand-500/50 transition">
          <span class="text-3xl" aria-hidden="true">🔍</span>
          <span class="font-extrabold text-lg text-white group-hover:text-brand-300">{dict.home.chMeaningT}</span>
          <span class="text-sm text-ink-300">{dict.home.chMeaningD}</span>
          <span class="text-xs font-extrabold text-brand-300 mt-1">30 days →</span>
        </a>
        <a href={localizedPath(locale, '/tools/my-progress/')} class="group bg-night-850 border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-lg shadow-black/30 hover:border-brand-500/50 transition">
          <span class="text-3xl" aria-hidden="true">🌌</span>
          <span class="font-extrabold text-lg text-white group-hover:text-brand-300">{dict.home.chNightT}</span>
          <span class="text-sm text-ink-300">{dict.home.chNightD}</span>
          <span class="text-xs font-extrabold text-brand-300 mt-1">Every night →</span>
        </a>
        <a href={localizedPath(locale, '/tools/my-progress/')} class="group bg-night-850 border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-lg shadow-black/30 hover:border-brand-500/50 transition">
          <span class="text-3xl" aria-hidden="true">☪️</span>
          <span class="font-extrabold text-lg text-white group-hover:text-brand-300">{dict.home.chKhatmT}</span>
          <span class="text-sm text-ink-300">{dict.home.chKhatmD}</span>
          <span class="text-xs font-extrabold text-brand-300 mt-1">30 Juz →</span>
        </a>
      </div>
    </section>

    <!-- 3. HOW IT WORKS -->
    <section class="py-4 sm:py-6" aria-label={dict.home.howTitle}>
      <div class="bg-night-850 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-lg shadow-black/30">
        <h2 class="text-xl md:text-2xl font-extrabold text-white">{dict.home.howTitle}</h2>
        <p class="mt-2 text-ink-300 leading-7 text-[15px]">{dict.home.howSub}</p>
        <ol class="mt-5 grid gap-3 sm:grid-cols-3">
          <li class="bg-white/5 border border-white/10 rounded-2xl p-5">
            <span class="w-10 h-10 grid place-items-center rounded-xl bg-brand-500/15 text-brand-300 font-extrabold">1</span>
            <p class="font-extrabold text-white mt-3 leading-6">{dict.home.step1T}</p>
            <p class="text-sm text-ink-300 leading-6 mt-1">{dict.home.step1D}</p>
          </li>
          <li class="bg-white/5 border border-white/10 rounded-2xl p-5">
            <span class="w-10 h-10 grid place-items-center rounded-xl bg-brand-500/15 text-brand-300 font-extrabold">2</span>
            <p class="font-extrabold text-white mt-3 leading-6">{dict.home.step2T}</p>
            <p class="text-sm text-ink-300 leading-6 mt-1">{dict.home.step2D}</p>
          </li>
          <li class="bg-white/5 border border-white/10 rounded-2xl p-5">
            <span class="w-10 h-10 grid place-items-center rounded-xl bg-brand-500/15 text-brand-300 font-extrabold">3</span>
            <p class="font-extrabold text-white mt-3 leading-6">{dict.home.step3T}</p>
            <p class="text-sm text-ink-300 leading-6 mt-1">{dict.home.step3D}</p>
          </li>
        </ol>
        <a href={localizedPath(locale, '/tools/habit-start/')} class="mt-5 w-full sm:w-auto bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center gap-2">{dict.home.howCta}</a>
      </div>
    </section>

    <!-- 4. LIBRARY STRIP (keeps every section one tap away) -->
    <section class="py-4 sm:py-6" aria-label={dict.home.libStripTitle}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-4 text-white">📚 {dict.home.libStripTitle}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {library.map((t) => (
          <a href={t.href} class="group min-w-0 bg-night-850 hover:bg-white/5 border border-white/10 hover:border-brand-500/50 rounded-2xl p-3.5 flex items-center gap-2.5 transition min-h-[64px]">
            <span class="w-9 h-9 shrink-0 grid place-items-center rounded-xl bg-brand-500/15 border border-white/10 text-gold-300 group-hover:bg-brand-500 group-hover:text-night-900 group-hover:border-brand-500 transition"><Icon name={t.icon} size={19} /></span>
            <span class="min-w-0 font-bold text-[14px] leading-5 text-white truncate">{t.label}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-5 sm:py-6">
      <h2 class="text-xl md:text-2xl font-extrabold mb-4 text-white">❓ {dict.home.faqTitle}</h2>
      <div class="space-y-3">
        {dict.home.faq.map((f: any) => (
          <details class="bg-night-850 border border-white/10 rounded-2xl p-4 sm:p-5">
            <summary class="font-bold cursor-pointer leading-6 text-ink-50">{f.q}</summary>
            <p class="mt-2 text-ink-300 leading-7 text-[15px]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
