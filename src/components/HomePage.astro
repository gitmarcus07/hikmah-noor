---
/* Hikmah Noor homepage — compact discovery hero + curated library.
 * Fully dict-driven (en/hi/ur/ar) via dict.mag + dict.home. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from './hn/SectionHeader.astro';
import SearchBox from './SearchBox.astro';
import Icon from './Icon.astro';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: string;
  dict: any;
  latest: any[];
  catGroups: Record<string, any[]>;
  fallbackCount?: number;
}
const { locale, dict, latest, catGroups } = Astro.props;
const m = dict.mag ?? {};
const L = (p: string) => localizedPath(locale, p);

function slugOf(id: string) { return id.split('/').pop()!.replace(/\.mdx?$/, ''); }
function artHref(a: any) {
  const rl = a.data.locale ?? locale;
  return localizedPath(rl, `/${a.data.category}/${slugOf(a.id)}/`);
}
function fmtDate(d: any) {
  if (!d) return '';
  try {
    const tag = locale === 'hi' ? 'hi-IN' : locale === 'ur' ? 'ur-PK' : locale === 'ar' ? 'ar-SA' : 'en-US';
    return new Date(d).toLocaleDateString(tag, { year: 'numeric', month: 'short', day: 'numeric' });
  } catch { return ''; }
}

const searchUrl = L('/search/');
const searchIndex = locale === 'en' ? '/search-index.json' : `/${locale}/search-index.json`;
const quranUrl = L('/quran/');
const surahsUrl = L('/surahs/');
const duasUrl = L('/duas/');
const waqiatUrl = L('/waqiat/');
const adhkarUrl = L('/duas/morning-evening/');
const kalimasUrl = L('/kalimas/');
const hadeesUrl = L('/hadees/');
const seeratUrl = L('/seerat/');
const prophetsUrl = L('/prophets/');
const sahabaUrl = L('/sahaba/');
const womenUrl = L('/women/');
const meaningsUrl = L('/meanings/');
const namesAllahUrl = L('/names-of-allah/');
const namesMuhammadUrl = L('/names-muhammad/');
const learnUrl = L('/learn/');
const historyUrl = L('/history/');
const ramadanHubUrl = L('/ramadan/');
const hajjHubUrl = L('/hajj/');
const eidHubUrl = L('/eid/');
const toolsUrl = L('/tools/');
const zakatUrl = L('/tools/zakat/zakat-calculator/');
const ramadanUrl = L('/tools/ramadan-countdown/');
const tasbihUrl = L('/tools/tasbih/');
const prayerUrl = L('/tools/prayer-times/');
const qiblaUrl = L('/tools/qibla/');
const trackerUrl = L('/tools/prayer-tracker/');
const quizUrl = L('/quiz/');
const mirathUrl = L('/tools/family-finance/mirath-calculator/');

const shortcuts = [
  { label: 'Morning Dua', href: L('/duas/morning-evening/morning-remembrance/') },
  { label: 'Ayatul Kursi', href: L('/duas/salah-prayer/ayatul-kursi-salah/') },
  { label: 'Dua for Anxiety', href: L('/duas/hardship-rizq/anxiety-grief/') },
  { label: 'Laylatul Qadr', href: L('/duas/worship-knowledge/laylatul-qadr/') },
];

const libraryGroups = [
  { id: 'read', chip: 'Read', title: 'Read the Quran', sub: 'Text, translation and meaning.', cards: [
    { icon: 'quran', title: 'Quran', desc: '114 surahs + 30 paras with translation', href: quranUrl },
    { icon: 'surahs', title: 'Surahs', desc: 'Browse surahs by number and name', href: surahsUrl },
    { icon: 'meanings', title: 'Meanings', desc: '40 key terms explained simply', href: meaningsUrl },
  ] },
  { id: 'worship', chip: 'Worship', title: 'Duas & worship', sub: 'Supplicate, remember, learn.', cards: [
    { icon: 'duas', title: 'Duas', desc: 'Authentic supplications for everyday life', href: duasUrl },
    { icon: 'shield', title: 'Adhkar', desc: 'Morning and evening remembrances', href: adhkarUrl },
    { icon: 'kalimas', title: 'Kalimas', desc: 'The six kalimas with meaning', href: kalimasUrl },
    { icon: 'book', title: 'Hadees', desc: '120 hadees: kids, Nawawi + Sahih selections', href: hadeesUrl },
  ] },
  { id: 'learn', chip: 'Learn', title: 'Stories & guides', sub: 'Lives, history and how-tos.', cards: [
    { icon: 'book', title: 'Learn', desc: 'Step-by-step guides: namaz, wudu, fasting', href: learnUrl },
    { icon: 'star', title: 'Aqeedah', desc: 'Six pillars, Tawhid, Qadr & Last Day', href: L('/aqeedah/') },
    { icon: 'heart', title: 'Kids Zone', desc: 'Short hadees, prayer steps & quiz', href: L('/kids/') },
    { icon: 'star', title: 'Seerat un Nabi ﷺ', desc: 'Full biography in 16 chapters', href: seeratUrl },
    { icon: 'star', title: 'Prophets', desc: 'All 25 prophets in order with lessons', href: prophetsUrl },
    { icon: 'book', title: 'Sahaba', desc: 'Lives of the 24 popular companions', href: sahabaUrl },
    { icon: 'heart', title: 'Women in Islam', desc: 'Stories of 12 noble figures', href: womenUrl },
    { icon: 'book', title: 'Islamic History', desc: '20 landmark events from Hijrah onward', href: historyUrl },
    { icon: 'star', title: 'Names of Allah', desc: 'All 99 names with meaning', href: namesAllahUrl },
    { icon: 'heart', title: 'Names of Muhammad ﷺ', desc: 'His 99 names and titles', href: namesMuhammadUrl },
  ] },
  { id: 'seasonal', chip: 'Seasonal', title: 'Ramadan, Hajj & Eid', sub: 'Fasting, pilgrimage, festivals and sacrifice.', cards: [
    { icon: 'moon', title: 'Ramadan Guide', desc: 'Fasting rules, duas, Taraweeh & countdown', href: ramadanHubUrl },
    { icon: 'moon', title: 'Hajj & Umrah Guide', desc: 'Ihram, tawaf, sai, Arafah & day-by-day', href: hajjHubUrl },
    { icon: 'moon', title: 'Eid & Qurbani', desc: 'Both Eids, takbeer, Qurbani shares & Tashriq', href: eidHubUrl },
  ] },
] as const;

const tools = [
  { icon: 'tools', name: m.zakatT ?? 'Zakat Calculator', desc: m.zakatD ?? 'Zakat on cash and gold', href: zakatUrl },
  { icon: 'moon', name: m.ramadanT ?? 'Ramadan Countdown', desc: m.ramadanD ?? 'Days left to Ramadan', href: ramadanUrl },
  { icon: 'clock', name: 'Tasbih Counter', desc: 'Dhikr with daily totals', href: tasbihUrl },
  { icon: 'sun', name: 'Prayer Times', desc: 'Namaz times, Qibla & Hijri date', href: prayerUrl },
  { icon: 'book', name: 'Islamic Quiz', desc: '10 questions with answers', href: quizUrl },
  { icon: 'quran', name: 'Qibla Finder', desc: 'Exact Qibla direction & compass', href: qiblaUrl },
  { icon: 'quran', name: 'Mosque Finder', desc: 'Nearby masjids & directions', href: L('/tools/mosque-finder/') },
  { icon: 'clock', name: 'Prayer Tracker', desc: 'Daily salah log with streaks', href: trackerUrl },
  { icon: 'heart', name: 'Mirath Calculator', desc: 'Inheritance shares (Sunni)', href: mirathUrl },
  { icon: 'tools', name: 'All tools', desc: 'Qibla, khatm planner, Hijri & more', href: toolsUrl },
] as const;

const duas = (catGroups.duas ?? []).slice(0, 4);
const recent = (latest ?? []).slice(0, 3);
---
<BaseLayout title={dict.home.heroTitle} description={dict.home.heroSub} locale={locale} canonicalPath="/" faq={dict.home.faq} type="website">
  <div class="hn-discover">
    {/* ===== Compact hero ===== */}
    <section class="hn-section hn-pattern" aria-label="Hikmah Noor" style="border-radius:16px">
      <div class="max-w-2xl mx-auto text-center px-1">
        <h1 class="text-[28px] leading-tight sm:text-4xl font-extrabold tracking-tight">Hikmah Noor</h1>
        <p class="mt-1 font-bold" style="color:var(--hn-primary)">Islamic Knowledge, Made Simple</p>
        <p class="mt-3 text-[15px] sm:text-base leading-7" style="color:var(--hn-muted)">
          {m.heroSub ?? 'Explore the Quran, duas, adhkar, kalimas and trusted Islamic resources — with Arabic text, translation and sources.'}
        </p>
        <div class="mt-5">
          <SearchBox locale={locale} indexUrl={searchIndex} searchUrl={searchUrl} placeholder={m.searchPh ?? 'Search duas, surahs, topics...'} id="hn-hero-q" mobileSuggest={true} />
        </div>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {shortcuts.map(s => (
            <a href={s.href} class="hn-badge hn-card-hover" style="padding:0.45rem 0.9rem;font-size:0.83rem">{s.label}</a>
          ))}
        </div>
      </div>
    </section>

    {/* ===== Explore library (grouped) ===== */}
    <section class="hn-section" style="padding-top:0.5rem" aria-label="Explore" data-libnav>
      <SectionHeader eyebrow="Library" title="Explore" sub="Start with a collection — every page includes sources and translation." href={L('/explore/')} linkLabel={m.viewAll ?? 'View all'} />
      <div class="mt-3 flex gap-2 overflow-x-auto pb-1" role="navigation" aria-label="Library groups" data-libchips>
        {libraryGroups.map((g) => (
          <a href={`#lib-${g.id}`} data-libchip={g.id} class="hn-badge hn-card-hover shrink-0" style="padding:0.55rem 1.1rem;font-size:0.85rem" data-active="false">{g.chip}</a>
        ))}
      </div>
      {libraryGroups.map((g) => (
        <div id={`lib-${g.id}`} class="mt-6 scroll-mt-24" data-libgroup={g.id}>
          <SectionHeader eyebrow={g.chip} title={g.title} sub={g.sub} />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mt-3">
            {g.cards.map(c => (
              <a href={c.href} class="hn-card hn-card-hover hn-card-pad flex gap-3 items-start">
                <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any} size={22} /></span>
                <span class="min-w-0">
                  <span class="font-extrabold block leading-6">{c.title}</span>
                  <span class="text-[13.5px] leading-5 block mt-0.5" style="color:var(--hn-muted)">{c.desc}</span>
                  <span class="text-[13px] font-bold mt-1.5 inline-flex items-center gap-1" style="color:var(--hn-primary)">Explore <Icon name="arrow" size={14} /></span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <script is:inline>
        (() => {
          const root = document.querySelector('[data-libnav]');
          if (!root || root.dataset.wired) return;
          root.dataset.wired = '1';
          const chips = [...root.querySelectorAll('[data-libchip]')];
          const setActive = (id) => chips.forEach((c) => {
            const on = c.dataset.libchip === id;
            c.dataset.active = String(on);
            c.classList.toggle('hn-badge-primary', on);
          });
          const groups = [...root.querySelectorAll('[data-libgroup]')];
          if (!('IntersectionObserver' in window) || !groups.length) return;
          const io = new IntersectionObserver((es) => {
            es.forEach((e) => { if (e.isIntersecting) setActive(e.target.dataset.libgroup); });
          }, { rootMargin: '-30% 0px -55% 0px' });
          groups.forEach((g) => io.observe(g));
        })();
      </script>
    </section>

    {/* ===== Popular duas ===== */}
    {duas.length > 0 && (
      <section class="hn-section" style="padding-top:0" aria-label={m.dailyDuas ?? 'Popular duas'}>
        <SectionHeader eyebrow="Duas" title={m.dailyDuas ?? 'Popular duas'} href={duasUrl} linkLabel={m.allDuas ?? 'All duas'} />
        <div class="grid gap-3 sm:grid-cols-2">
          {duas.map((a: any) => (
            <a href={artHref(a)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold text-[15px] leading-6 block">{a.data.title}</span>
              <span class="mt-0.5 text-[13.5px] leading-5 line-clamp-2 block" style="color:var(--hn-muted)">{a.data.description ?? ''}</span>
              <span class="mt-2 text-xs font-semibold" style="color:var(--hn-muted)">{fmtDate(a.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* ===== Quran + Tools ===== */}
    <section class="hn-section" style="padding-top:0" aria-label="Quran and tools">
      <div class="grid gap-3 lg:grid-cols-2">
        <div class="hn-card hn-card-pad">
          <p class="hn-eyebrow">Quran</p>
          <h2 class="text-xl font-extrabold mt-1">Continue your reading</h2>
          <p class="text-[14.5px] mt-1" style="color:var(--hn-muted)">All 114 surahs and 30 paras with Urdu, English and Hindi meaning — plus audio.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={surahsUrl} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">All 114 surahs</a>
            <a href={quranUrl} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">30 paras</a>
          </div>
          <p class="font-arabic text-xl mt-4 leading-[2]" lang="ar" dir="rtl" data-aotd-ar>رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ</p>
          <p class="text-[13.5px] mt-1" style="color:var(--hn-muted)" data-aotd-wrap><span data-aotd-en>“{m.ayahTr ?? 'Our Lord, give us good in this world and good in the Hereafter.'}” — {m.ayahRef ?? 'Quran 2:201'}</span></p>
          <script is:inline define:vars={{ readBase: L('/tools/read/') }}>
            (() => {
              const en = document.querySelector('[data-aotd-en]');
              if (!en || en.dataset.wired) return;
              en.dataset.wired = '1';
              fetch('/habits/ayahs.json').then((r) => r.json()).then((list) => {
                if (!list || !list.length) return;
                const a = list[Math.floor(Date.now() / 864e5) % list.length];
                const ar = document.querySelector('[data-aotd-ar]');
                if (ar && a.ar) ar.textContent = a.ar;
                en.innerHTML = '';
                const q = document.createElement('span');
                q.textContent = '\u201C' + (a.en || '') + '\u201D \u2014 ';
                const link = document.createElement('a');
                link.href = `${String(readBase).replace(/\/$/, '')}/${a.surah}/?verse=${a.verse}`;
                link.textContent = `Quran ${a.surah}:${a.verse}${a.surahName ? ` (${a.surahName})` : ''} \u2192`;
                link.style.fontWeight = '800';
                link.style.color = 'var(--hn-primary)';
                en.append(q, link);
              }).catch(() => {});
            })();
          </script>
        </div>
        <div>
          <SectionHeader eyebrow="Tools" title={m.usefulTools ?? 'Islamic tools'} href={toolsUrl} linkLabel="All tools" />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            {tools.map(t => (
              <a href={t.href} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3">
                <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={t.icon as any} size={22} /></span>
                <span class="min-w-0">
                  <span class="block font-extrabold text-[15px]">{t.name}</span>
                  <span class="block text-[13px]" style="color:var(--hn-muted)">{t.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ===== Recently added ===== */}
    {recent.length > 0 && (
      <section class="hn-section" style="padding-top:0" aria-label={m.latestArticles ?? 'Recently added'}>
        <SectionHeader eyebrow="Fresh" title={m.latestArticles ?? 'Recently added'} href={L('/explore/')} linkLabel={m.viewAll ?? 'View all'} />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((a: any) => (
            <a href={artHref(a)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="hn-badge">{a.data.category}</span>
              <span class="font-bold text-[15px] leading-6 mt-2 block line-clamp-2">{a.data.title}</span>
              <span class="mt-1 text-xs font-semibold" style="color:var(--hn-muted)">{fmtDate(a.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
