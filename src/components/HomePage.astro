---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import SearchBox from './SearchBox.astro';
import Icon from './Icon.astro';
import SiteArt from './SiteArt.astro';
import HabitHub from './HabitHub.astro';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: string;
  dict: any;
  latest: any[];
  catGroups: Record<string, any[]>;
  fallbackCount?: number;
}
const { locale, dict, latest, catGroups, fallbackCount = 0 } = Astro.props;
function slugOf(id: string) { return id.split('/').pop()!.replace(/\.mdx?$/, ''); }

const h = dict.home ?? {};
const library = [
  { icon: 'surahs', label: dict.nav.surahs, href: localizedPath(locale, '/surahs/'), pill: '114' },
  { icon: 'quran', label: dict.nav.quran, href: localizedPath(locale, '/quran/'), pill: '30' },
  { icon: 'duas', label: dict.nav.duas, href: localizedPath(locale, '/duas/'), pill: '' },
  { icon: 'kalimas', label: dict.nav.kalimas, href: localizedPath(locale, '/kalimas/'), pill: '6' },
  { icon: 'meanings', label: dict.nav.meanings, href: localizedPath(locale, '/meanings/'), pill: '' },
  { icon: 'waqiat', label: dict.nav.waqiat, href: localizedPath(locale, '/waqiat/'), pill: '' },
] as const;
---
<BaseLayout title={dict.home.heroTitle} description={dict.home.heroSub} locale={locale} canonicalPath="/" faq={dict.home.faq} type="website">
  <!-- 1. HERO -->
  <section class="relative overflow-hidden bg-night-900">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 10%, rgba(139,124,246,.25), transparent 50%), radial-gradient(circle at 10% 90%, rgba(212,175,55,.12), transparent 40%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 pt-8 sm:pt-10 md:pt-14 pb-4 sm:pb-5 grid gap-8 md:grid-cols-2 md:items-center">
      <div class="min-w-0">
        <span class="inline-block text-[12px] sm:text-[13px] font-semibold bg-white/5 border border-white/10 text-brand-300 rounded-full px-4 py-1.5">📖 {dict.home.heroBadge}</span>
        <h1 class="text-[28px] leading-[1.2] sm:text-4xl md:text-5xl font-extrabold md:leading-tight text-white mt-4 break-words">{dict.home.heroTitle}</h1>
        <p class="text-lg sm:text-2xl md:text-3xl font-extrabold text-gold-300 mt-2">Arabic • Hindi • English • Urdu</p>
        <p class="mt-3 text-ink-300 text-[15px] md:text-base leading-7 max-w-xl">{dict.home.heroSub}</p>
        <div class="mt-5 max-w-xl">
          <SearchBox locale={locale} indexUrl={localizedPath(locale, '/search-index.json')} searchUrl={localizedPath(locale, '/search/')} placeholder={dict.nav.search} id="hero-q" />
        </div>
        <div class="mt-4 flex flex-col sm:flex-row sm:flex-wrap gap-3">
          <a href={localizedPath(locale, '/tools/habit-start/')} class="bg-brand-500 hover:bg-brand-400 text-night-900 font-bold rounded-full px-6 py-3 min-h-[48px] shadow-lg shadow-brand-500/25 inline-flex items-center justify-center gap-2"><Icon name="quran" size={19} />{dict.home.heroCta1}</a>
          <a href={localizedPath(locale, '/tools/read/')} class="bg-white/10 hover:bg-white/15 border border-white/15 text-white font-bold rounded-full px-6 py-3 min-h-[48px] inline-flex items-center justify-center gap-2"><Icon name="duas" size={19} />{dict.home.heroCta2}</a>
        </div>
        <a href={localizedPath(locale, '/tools/')} class="mt-3 sm:hidden inline-flex items-center justify-center gap-2 w-full bg-gold-300 hover:bg-gold-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] shadow">🧰 {dict.nav.tools} • 20 →</a>
      </div>
      <div class="relative flex justify-center md:justify-end">
        <div class="w-full max-w-[480px] rounded-3xl shadow-xl border border-white/10 overflow-hidden"><SiteArt name="hero-quran" title="Holy Quran placed on a wooden rehal" /></div>
        <span class="absolute top-3 start-3 sm:start-auto sm:end-6 bg-night-900/95 backdrop-blur border border-white/10 text-white text-xs font-extrabold rounded-full px-3.5 py-2 shadow">114 {dict.nav.surahs}</span>
        <span class="absolute bottom-3 end-3 sm:end-6 bg-brand-500/95 backdrop-blur text-night-900 text-xs font-extrabold rounded-full px-3.5 py-2 shadow">30 {dict.nav.quran}</span>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4">
    <!-- 1b. QURAN HABIT (login-gated trackers) -->
    <HabitHub locale={locale} />

    <!-- 2. LIBRARY BAND -->
    <section class="py-6 sm:py-8" aria-label={h.libraryTitle ?? 'Library'}>
      <div class="relative overflow-hidden bg-gradient-to-br from-night-800 to-[#151130] rounded-3xl p-6 sm:p-8 md:p-10 text-white shadow-xl shadow-black/40 border border-white/10">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 90% 10%, rgba(139,124,246,.35), transparent 45%), radial-gradient(circle at 5% 95%, rgba(212,175,55,.12), transparent 40%);"></div>
        <div class="relative">
          <p class="inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.18em] text-night-900 bg-gold-300 rounded-full px-3.5 py-1.5">📚 {h.libraryBadge ?? 'Library'}</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold leading-snug mt-3 break-words">{h.libraryTitle ?? 'A complete Islamic library'}</h2>
          <p class="mt-2 text-ink-300 leading-7 max-w-2xl text-[15px] md:text-base">{h.librarySub ?? ''}</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mt-6">
            {library.map((t) => (
              <a href={t.href} class="group min-w-0 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-400/60 rounded-2xl p-3.5 sm:p-4 flex flex-col gap-2.5 transition min-h-[104px]">
                <span class="w-10 h-10 grid place-items-center rounded-xl bg-brand-500/15 border border-white/10 text-gold-300 group-hover:bg-brand-500 group-hover:text-night-900 group-hover:border-brand-500 transition"><Icon name={t.icon} size={20} /></span>
                <span class="flex items-center gap-1 min-w-0 font-bold text-[14px] sm:text-[15px] leading-6 text-white">
                  <span class="truncate">{t.label}</span>
                  {t.pill && <span class="ms-auto shrink-0 text-[11px] font-extrabold bg-gold-300 text-night-900 rounded-full px-2 py-0.5">{t.pill}</span>}
                </span>
              </a>
            ))}
          </div>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href={localizedPath(locale, '/surahs/')} class="bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[48px] inline-flex items-center justify-center gap-2">{h.libraryCta ?? dict.home.seeAll} →</a>
            <a href={localizedPath(locale, '/quran/')} class="bg-white/10 hover:bg-white/20 border border-white/15 text-white font-bold rounded-full px-6 py-3 min-h-[48px] inline-flex items-center justify-center gap-2">{dict.nav.quran} →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. TOOLS + LIVE COUNTDOWN -->
    <section class="py-4 sm:py-6" aria-label={dict.home.toolsTitle}>
      <div class="bg-night-850 border border-white/10 rounded-3xl p-5 sm:p-6 shadow-lg shadow-black/30 flex flex-col sm:flex-row sm:items-center gap-4 mb-4">
        <div class="min-w-0 flex-1">
          <p class="inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.18em] text-night-900 bg-brand-500 rounded-full px-3.5 py-1.5">🧰 {dict.nav.tools}</p>
          <h2 class="text-xl md:text-2xl font-extrabold mt-2.5 break-words text-white">{dict.home.toolsTitle}</h2>
          <p class="text-sm text-ink-500 mt-1 leading-6">{h.toolsSub ?? ''}</p>
        </div>
        <a href={localizedPath(locale, '/tools/')} class="w-full sm:w-auto shrink-0 text-sm font-extrabold text-night-900 bg-brand-500 hover:bg-brand-400 rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center shadow-lg shadow-brand-500/25">{dict.home.allTools} →</a>
      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        <a href={localizedPath(locale, '/tools/zakat/zakat-calculator/')} class="group bg-night-850 border-2 border-brand-500/30 rounded-3xl p-6 sm:p-8 flex flex-col gap-3 shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-400 hover:-translate-y-0.5 transition min-h-[220px]">
          <span class="w-14 h-14 grid place-items-center rounded-2xl bg-brand-500/15 text-gold-300 shadow"><Icon name="surahs" size={28} /></span>
          <span class="font-extrabold text-xl leading-8 group-hover:text-brand-300 break-words text-white">{dict.home.zakatTitle}</span>
          <span class="text-[15px] text-ink-300 leading-7">{dict.home.zakatDesc}</span>
          <span class="mt-auto pt-3 text-[15px] font-extrabold text-brand-300">2.5% →</span>
        </a>
        <div class="bg-gradient-to-br from-night-800 to-[#171233] border border-white/10 text-white rounded-3xl p-5 sm:p-6 shadow-xl shadow-black/40 relative overflow-hidden flex flex-col" id="home-countdown">
          <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 88% 8%, rgba(139,124,246,.35), transparent 45%), radial-gradient(circle at 5% 95%, rgba(212,175,55,.1), transparent 40%);"></div>
          <div class="relative flex flex-col flex-1">
            <p class="flex items-center gap-2 flex-wrap text-[11px] font-extrabold uppercase tracking-[0.18em]">
              <span class="inline-flex items-center gap-1.5 bg-gold-300 text-night-900 rounded-full px-3 py-1.5"><span class="w-2 h-2 rounded-full bg-brand-600 animate-pulse" aria-hidden="true"></span>{h.countdownBadge ?? 'Live'}</span>
              <span class="text-gold-300 break-words">🌙 {h.countdownTitle ?? dict.home.ramadanTitle}</span>
            </p>
            <p class="mt-3 font-extrabold text-lg leading-7 break-words" id="hc-status">Loading…</p>
            <p class="text-[13px] text-ink-300 mt-1 leading-6">{h.countdownSub ?? ''}</p>
            <div class="grid grid-cols-4 gap-1.5 sm:gap-3 mt-4" role="timer" aria-live="off" aria-label={h.countdownTitle ?? 'Countdown'}>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-2 sm:p-3 text-center min-w-0"><div id="hc-d" class="text-[22px] sm:text-3xl font-extrabold text-gold-300 tabular-nums">0</div><div class="text-[11px] sm:text-xs text-ink-300 mt-1 truncate">{h.days ?? 'Days'}</div></div>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-2 sm:p-3 text-center min-w-0"><div id="hc-h" class="text-[22px] sm:text-3xl font-extrabold text-gold-300 tabular-nums">0</div><div class="text-[11px] sm:text-xs text-ink-300 mt-1 truncate">{h.hours ?? 'Hours'}</div></div>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-2 sm:p-3 text-center min-w-0"><div id="hc-m" class="text-[22px] sm:text-3xl font-extrabold text-gold-300 tabular-nums">0</div><div class="text-[11px] sm:text-xs text-ink-300 mt-1 truncate">{h.mins ?? 'Mins'}</div></div>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-2 sm:p-3 text-center min-w-0"><div id="hc-s" class="text-[22px] sm:text-3xl font-extrabold text-gold-300 tabular-nums">0</div><div class="text-[11px] sm:text-xs text-ink-300 mt-1 truncate">{h.secs ?? 'Secs'}</div></div>
            </div>
            <p class="text-[12px] text-ink-500 mt-3 break-words">Hijri today: <b id="hc-hijri" class="text-ink-200">…</b></p>
            <a href={localizedPath(locale, '/tools/ramadan-countdown/')} class="mt-4 bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center gap-2">{h.countdownCta ?? dict.home.seeAll} →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. ARTICLES -->
    <section class="py-4 sm:py-6">
      <div class="flex items-center justify-between mb-4 gap-3">
        <h2 class="text-xl md:text-2xl font-extrabold truncate text-white">📚 {dict.home.latest}</h2>
        <a href={localizedPath(locale, '/quran/')} class="shrink-0 text-sm font-bold text-brand-300 hover:text-brand-200">{dict.home.seeAll} →</a>
      </div>
      {fallbackCount > 0 && locale !== 'en' && (
        <p class="mb-4 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3">Showing English guides with <span class="font-extrabold uppercase text-[11px] text-night-900 bg-gold-300 rounded-full px-2 py-0.5">EN</span> badge — translation coming soon.</p>
      )}
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {latest.map(a => <ArticleCard locale={locale} category={a.data.category} slug={slugOf(a.id)} title={a.data.title} description={a.data.description} date={a.data.pubDate} image={a.data.image} entryLocale={a.data.locale} />)}
      </div>
    </section>

    <!-- CATEGORY SECTIONS -->
    {Object.entries(catGroups).map(([cat, list]) => (
      <section class="py-5 sm:py-6">
        <div class="flex items-center justify-between mb-4 gap-3">
          <h2 class="text-xl md:text-2xl font-extrabold capitalize truncate text-white">✨ {cat}</h2>
          <a href={localizedPath(locale, `/${cat}/`)} class="shrink-0 text-sm font-bold text-brand-300 hover:text-brand-200">{dict.home.seeAll} →</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {list.slice(0, 3).map(a => <ArticleCard locale={locale} category={a.data.category} slug={slugOf(a.id)} title={a.data.title} description={a.data.description} date={a.data.pubDate} image={a.data.image} entryLocale={a.data.locale} />)}
        </div>
      </section>
    ))}

    <!-- ABOUT / SEO -->
    <section class="py-5 sm:py-6">
      <div class="bg-night-850 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-lg shadow-black/30">
        <h2 class="text-xl md:text-2xl font-extrabold text-white">☪ {dict.home.infoTitle}</h2>
        <p class="mt-3 text-ink-300 leading-7 text-[15px]">{dict.home.infoText}</p>
        <ul class="mt-4 grid gap-2.5 sm:grid-cols-2 text-[15px]">
          {dict.home.infoPoints.map((pt: string) => (
            <li class="flex items-start gap-2.5 bg-white/5 border border-white/10 rounded-2xl px-4 py-3"><span class="text-brand-300 font-extrabold">✓</span><span class="leading-6 text-ink-200">{pt}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-5 sm:py-6">
      <h2 class="text-xl md:text-2xl font-extrabold mb-4 text-white">❓ {dict.home.faqTitle}</h2>
      <div class="space-y-3">
        {dict.home.faq.map((f: any) => (
          <details class="bg-night-850 border border-white/10 rounded-2xl p-4 sm:p-5">
            <summary class="font-bold cursor-pointer leading-6 text-ink-50">{f.q}</summary>
            <p class="mt-2 text-ink-300 leading-7 text-[15px]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <script define:vars={{ locale }}>
    (() => {
      const starts = ['2026-02-18','2027-02-08','2028-01-28','2029-01-16','2030-01-05','2030-12-26','2031-12-15','2032-12-04','2033-11-23'].map((s) => new Date(s + 'T00:00:00Z').getTime());
      const DAY = 864e5, LUNAR_YEAR = 354.37 * DAY, RAMADAN_LEN = 30 * DAY;
      const fmt = (t) => new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
      function resolve() {
        const now = Date.now();
        const past = [...starts].reverse().find((t) => t <= now);
        if (past && now - past < RAMADAN_LEN) {
          return { target: past + RAMADAN_LEN, label: '🌙 Ramadan Mubarak! Estimated Eid al-Fitr: ' + fmt(past + RAMADAN_LEN) };
        }
        let target = starts.find((t) => t > now);
        if (target === undefined) { target = starts[starts.length - 1]; while (target <= now) target += LUNAR_YEAR; }
        return { target, label: 'Estimated start: ' + fmt(target) };
      }
      let state = resolve();
      function tick() {
        const elD = document.getElementById('hc-d'), elH = document.getElementById('hc-h'),
          elM = document.getElementById('hc-m'), elS = document.getElementById('hc-s'),
          elSt = document.getElementById('hc-status');
        if (!elD || !elH || !elM || !elS) return;
        if (Date.now() >= state.target) state = resolve();
        const diff = Math.max(0, state.target - Date.now());
        elD.textContent = Math.floor(diff / DAY);
        elH.textContent = Math.floor(diff / 36e5) % 24;
        elM.textContent = Math.floor(diff / 6e4) % 60;
        elS.textContent = Math.floor(diff / 1e3) % 60;
        if (elSt) elSt.textContent = state.label;
      }
      tick(); setInterval(tick, 1000);
      try {
        const map = { en: 'en-SA-u-ca-islamic', hi: 'hi-IN-u-ca-islamic', ur: 'ur-PK-u-ca-islamic', ar: 'ar-SA-u-ca-islamic' };
        const tag = map[locale] || map.en;
        const el = document.getElementById('hc-hijri');
        if (el) el.textContent = new Intl.DateTimeFormat(tag, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
      } catch {}
    })();
  </script>
</BaseLayout>
