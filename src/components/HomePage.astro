---
/* Hikmah Noor homepage — compact discovery hero + curated library.
 * Fully dict-driven (en/hi/ur/ar) via dict.mag + dict.home. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: string;
  dict: any;
  latest: any[];
  catGroups: Record<string, any[]>;
  fallbackCount?: number;
}
const { locale, dict, latest, catGroups } = Astro.props;
const m = dict.mag ?? {};
const L = (p: string) => localizedPath(locale, p);

function slugOf(id: string) { return id.split('/').pop()!.replace(/\.mdx?$/, ''); }
function artHref(a: any) {
  const rl = a.data.locale ?? locale;
  return localizedPath(rl, `/${a.data.category}/${slugOf(a.id)}/`);
}
function fmtDate(d: any) {
  if (!d) return '';
  try {
    const tag = locale === 'hi' ? 'hi-IN' : locale === 'ur' ? 'ur-PK' : locale === 'ar' ? 'ar-SA' : 'en-US';
    return new Date(d).toLocaleDateString(tag, { year: 'numeric', month: 'short', day: 'numeric' });
  } catch { return ''; }
}

const searchUrl = L('/search/');
const quranUrl = L('/quran/');
const surahsUrl = L('/surahs/');
const duasUrl = L('/duas/');
const adhkarUrl = L('/duas/morning-evening/');
const kalimasUrl = L('/kalimas/');
const meaningsUrl = L('/meanings/');
const toolsUrl = L('/tools/');
const zakatUrl = L('/tools/zakat/zakat-calculator/');
const ramadanUrl = L('/tools/ramadan-countdown/');

const shortcuts = [
  { label: 'Morning Dua', href: L('/duas/morning-evening/morning-remembrance/') },
  { label: 'Ayatul Kursi', href: L('/duas/salah-prayer/ayatul-kursi-salah/') },
  { label: 'Dua for Anxiety', href: L('/duas/hardship-rizq/anxiety-grief/') },
  { label: 'Laylatul Qadr', href: L('/duas/worship-knowledge/laylatul-qadr/') },
];

const library = [
  { icon: 'quran', title: 'Quran', desc: 'Read all 114 surahs with translation', href: quranUrl },
  { icon: 'duas', title: 'Duas', desc: 'Authentic supplications for everyday life', href: duasUrl },
  { icon: 'surahs', title: 'Surahs', desc: 'Browse surahs by number and name', href: surahsUrl },
  { icon: 'shield', title: 'Adhkar', desc: 'Morning and evening remembrances', href: adhkarUrl },
  { icon: 'kalimas', title: 'Kalimas', desc: 'The six kalimas with meaning', href: kalimasUrl },
  { icon: 'book', title: 'Paras', desc: 'The Quran in 30 parts (Juz)', href: quranUrl },
  { icon: 'star', title: 'Names of Allah', desc: 'Meanings and explanations', href: meaningsUrl },
  { icon: 'meanings', title: 'Guides', desc: 'Simple Islamic learning articles', href: meaningsUrl },
] as const;

const tools = [
  { icon: 'tools', name: m.zakatT ?? 'Zakat Calculator', desc: m.zakatD ?? 'Zakat on cash and gold', href: zakatUrl },
  { icon: 'moon', name: m.ramadanT ?? 'Ramadan Countdown', desc: m.ramadanD ?? 'Days left to Ramadan', href: ramadanUrl },
  { icon: 'quran', name: m.quranIndexT ?? 'Quran Index', desc: m.quranIndexD ?? 'All surahs with translation', href: quranUrl },
  { icon: 'duas', name: m.duaCollT ?? 'Dua Collection', desc: m.duaCollD ?? 'Masnoon duas with translation', href: duasUrl },
] as const;

const duas = (catGroups.duas ?? []).slice(0, 4);
const recent = (latest ?? []).slice(0, 3);
---
<BaseLayout title={dict.home.heroTitle} description={dict.home.heroSub} locale={locale} canonicalPath="/" faq={dict.home.faq} type="website">
  <div class="hn-discover">
    {/* ===== Compact hero ===== */}
    <section class="hn-section hn-pattern" aria-label="Hikmah Noor" style="border-radius:16px">
      <div class="max-w-2xl mx-auto text-center px-1">
        <h1 class="text-[28px] leading-tight sm:text-4xl font-extrabold tracking-tight">Hikmah Noor</h1>
        <p class="mt-1 font-bold" style="color:var(--hn-primary)">Islamic Knowledge, Made Simple</p>
        <p class="mt-3 text-[15px] sm:text-base leading-7" style="color:var(--hn-muted)">
          {m.heroSub ?? 'Explore the Quran, duas, adhkar, kalimas and trusted Islamic resources — with Arabic text, translation and sources.'}
        </p>
        <form action={searchUrl} method="get" class="mt-5" role="search">
          <div class="hn-searchwrap">
            <Icon name="search" size={20} />
            <input type="search" name="q" autocomplete="off" maxlength="100" aria-label="Search"
              placeholder={m.searchPh ?? 'Search duas, surahs, topics...'} />
            <button type="submit" class="hn-btn hn-btn-primary !rounded-[10px]">{m.searchBtn ?? 'Search'}</button>
          </div>
        </form>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {shortcuts.map(s => (
            <a href={s.href} class="hn-badge hn-card-hover" style="padding:0.45rem 0.9rem;font-size:0.83rem">{s.label}</a>
          ))}
        </div>
      </div>
    </section>

    {/* ===== Explore library ===== */}
    <section class="hn-section" style="padding-top:0.5rem" aria-label="Explore">
      <SectionHeader eyebrow="Library" title="Explore" sub="Start with a collection — every page includes sources and translation." href={toolsUrl} linkLabel={m.viewAll ?? 'View all'} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {library.map(c => (
          <a href={c.href} class="hn-card hn-card-hover hn-card-pad flex gap-3 items-start">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any} size={22} /></span>
            <span class="min-w-0">
              <span class="font-extrabold block leading-6">{c.title}</span>
              <span class="text-[13.5px] leading-5 block mt-0.5" style="color:var(--hn-muted)">{c.desc}</span>
              <span class="text-[13px] font-bold mt-1.5 inline-flex items-center gap-1" style="color:var(--hn-primary)">Explore <Icon name="arrow" size={14} /></span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* ===== Popular duas ===== */}
    {duas.length > 0 && (
      <section class="hn-section" style="padding-top:0" aria-label={m.dailyDuas ?? 'Popular duas'}>
        <SectionHeader eyebrow="Duas" title={m.dailyDuas ?? 'Popular duas'} href={duasUrl} linkLabel={m.allDuas ?? 'All duas'} />
        <div class="grid gap-3 sm:grid-cols-2">
          {duas.map((a: any) => (
            <a href={artHref(a)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold text-[15px] leading-6 block">{a.data.title}</span>
              <span class="mt-0.5 text-[13.5px] leading-5 line-clamp-2 block" style="color:var(--hn-muted)">{a.data.description ?? ''}</span>
              <span class="mt-2 text-xs font-semibold" style="color:var(--hn-muted)">{fmtDate(a.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* ===== Quran + Tools ===== */}
    <section class="hn-section" style="padding-top:0" aria-label="Quran and tools">
      <div class="grid gap-3 lg:grid-cols-2">
        <div class="hn-card hn-card-pad">
          <p class="hn-eyebrow">Quran</p>
          <h2 class="text-xl font-extrabold mt-1">Continue your reading</h2>
          <p class="text-[14.5px] mt-1" style="color:var(--hn-muted)">All 114 surahs and 30 paras with Urdu, English and Hindi meaning — plus audio.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={surahsUrl} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">All 114 surahs</a>
            <a href={quranUrl} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">30 paras</a>
          </div>
          <p class="font-arabic text-xl mt-4 leading-[2]" lang="ar" dir="rtl">رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ</p>
          <p class="text-[13.5px] mt-1" style="color:var(--hn-muted)">“{m.ayahTr ?? 'Our Lord, give us good in this world and good in the Hereafter.'}” — {m.ayahRef ?? 'Quran 2:201'}</p>
        </div>
        <div>
          <SectionHeader eyebrow="Tools" title={m.usefulTools ?? 'Islamic tools'} href={toolsUrl} linkLabel="All tools" />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            {tools.map(t => (
              <a href={t.href} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3">
                <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={t.icon as any} size={22} /></span>
                <span class="min-w-0">
                  <span class="block font-extrabold text-[15px]">{t.name}</span>
                  <span class="block text-[13px]" style="color:var(--hn-muted)">{t.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ===== Recently added ===== */}
    {recent.length > 0 && (
      <section class="hn-section" style="padding-top:0" aria-label={m.latestArticles ?? 'Recently added'}>
        <SectionHeader eyebrow="Fresh" title={m.latestArticles ?? 'Recently added'} href={quranUrl} linkLabel={m.viewAll ?? 'View all'} />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((a: any) => (
            <a href={artHref(a)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="hn-badge">{a.data.category}</span>
              <span class="font-bold text-[15px] leading-6 mt-2 block line-clamp-2">{a.data.title}</span>
              <span class="mt-1 text-xs font-semibold" style="color:var(--hn-muted)">{fmtDate(a.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
