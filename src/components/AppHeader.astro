---
/* In-app header: optional back button + centered screen title.
 * Content site — no accounts, no avatar.
 */
import { localizedPath } from '../i18n/utils';

interface Props {
  locale?: string;
  title: string;
  /** When set, the top-left shows a ← back link. */
  backHref?: string;
  /** Set false on pages that render their own <h1> (keeps exactly one h1). */
  h1?: boolean;
}
const { locale = 'en', title, backHref = '', h1 = true } = Astro.props;
const backUrl = backHref ? localizedPath(locale, backHref) : '';
---
<div data-appheader class="sticky top-14 z-40 bg-qg-bg/90 backdrop-blur-md border-b border-qg-line">
  <div class="max-w-md mx-auto px-4 py-2.5 grid grid-cols-[44px_1fr_44px] items-center gap-2">
    {backUrl ? (
      <a href={backUrl} aria-label="Back" class="w-11 h-11 grid place-items-center rounded-full border border-qg-line text-qg-green text-xl hover:bg-qg-soft transition">←</a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    {h1 ? (
      <h1 class="text-center text-[22px] leading-7 font-extrabold text-qg-ink truncate">{title}</h1>
    ) : (
      <p class="text-center text-[22px] leading-7 font-extrabold text-qg-ink truncate" aria-hidden="true">{title}</p>
    )}
    <span aria-hidden="true"></span>
  </div>
</div>
