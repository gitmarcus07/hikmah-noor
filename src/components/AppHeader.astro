---
/* Sticky in-app header: avatar (links to profile) + centered screen title.
 * Full-bleed bar that sticks under the site header (top-14) while scrolling.
 * Place directly under BaseLayout on app screens.
 */
import { localizedPath } from '../i18n/utils';

interface Props {
  locale?: string;
  title: string;
}
const { locale = 'en', title } = Astro.props;
const profileUrl = localizedPath(locale, '/profile/');
---
<div data-appheader class="sticky top-14 z-40 bg-night-950/90 backdrop-blur-md border-b border-white/5">
  <div class="max-w-md mx-auto px-4 py-2.5 grid grid-cols-[44px_1fr_44px] items-center gap-2">
    <a href={profileUrl} aria-label="My profile" data-ah-avatar class="w-11 h-11 grid place-items-center rounded-full overflow-hidden ring-2 ring-white/20 bg-gradient-to-br from-emerald-300 to-teal-500 text-lg font-extrabold text-night-900">👤</a>
    <h1 class="text-center text-[22px] leading-7 font-extrabold text-white truncate">{title}</h1>
    <span aria-hidden="true"></span>
  </div>
</div>

<script define:vars={{ profileUrl }}>
  (() => {
    const roots = document.querySelectorAll('[data-appheader]');
    if (!roots.length || document.body.dataset.ahWired) return;
    document.body.dataset.ahWired = '1';
    (async () => {
      try {
        const H = await import('/habits/habit.js?v=4');
        const { user } = await H.Auth.session().catch(() => ({ user: null }));
        if (!user) return;
        roots.forEach((r) => {
          const el = r.querySelector('[data-ah-avatar]');
          if (!el) return;
          try {
            const html = H.faceFor(user);
            if (String(html).trim().startsWith('<')) el.innerHTML = html;
            else el.textContent = html;
          } catch { /* keep fallback */ }
        });
      } catch { /* guest: keep generic avatar */ }
    })();
  })();
</script>
