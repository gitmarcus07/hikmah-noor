---
/* Public reading session — verse-by-verse with audio, translation and
 * share. No accounts: arrows move between verses, audio plays, that is all.
 */
import { localizedPath, getDict } from '../i18n/utils';
import BookmarkScript from './hn/BookmarkScript.astro';

interface Props {
  locale: string;
  surah: any;
  juzTotals: { num: number; verses: number }[];
  juzOfSurah: number | null;
}
const { locale, surah, juzTotals, juzOfSurah } = Astro.props;
const t = getDict(locale).app;
const progressUrl = localizedPath(locale, '/tools/my-progress/');
const pad = (n: number) => String(n).padStart(3, '0');
---
<div class="max-w-2xl mx-auto px-4 py-6" data-session data-surah={surah.num} data-versecount={surah.verseCount} data-juz={juzOfSurah ?? ''}>
  <div class="flex items-center gap-2">
    <a href={localizedPath(locale, '/tools/read/')} class="w-11 h-11 shrink-0 grid place-items-center rounded-full border border-qg-line text-qg-green bg-white hover:bg-qg-soft" aria-label="Back">←</a>
    <div class="flex-1 text-center min-w-0">
      <h1 class="font-extrabold text-lg leading-6 text-qg-ink" data-s-title></h1>
      <p class="text-sm text-qg-muted" data-s-pos></p>
    </div>
    <span class="w-11 shrink-0" aria-hidden="true"></span>
  </div>

  {/* verse card */}
  <article class="mt-4 bg-white text-[#17352F] rounded-3xl p-5 shadow-xl border border-qg-line">
    <div class="flex items-center gap-2">
      <button data-s-play class="w-11 h-11 grid place-items-center rounded-full bg-qg-soft text-qg-green font-extrabold hover:bg-qg-deep hover:text-white transition" aria-label="Play verse">▶</button>
      <button data-s-repeat class="w-11 h-11 grid place-items-center rounded-full bg-qg-soft text-qg-green font-extrabold hover:bg-qg-deep hover:text-white transition" aria-label="Repeat" aria-pressed="false" style="opacity:0.55">🔁</button>
      <div class="flex-1"></div>
      <button data-s-share class="w-10 h-10 grid place-items-center rounded-full bg-qg-soft text-qg-green font-bold" aria-label="Share">↗</button>
      <button data-s-bm data-bm data-bm-kind="verse" data-bm-ref="1:1" data-bm-title="" class="w-10 h-10 grid place-items-center rounded-full bg-qg-soft text-qg-green font-bold" style="font-size:18px" aria-label="Bookmark" aria-pressed="false">♡</button>
    </div>
    <BookmarkScript />
    <p data-s-ar class="font-arabic text-center leading-[2.2] mt-4" style="font-size:2rem" lang="ar" dir="rtl"></p>
    <p data-s-tr class="mt-4 text-xl md:text-2xl leading-9 text-[#17352F] font-medium"></p>
    <div class="flex items-center justify-between mt-4">
      <button data-s-prev class="w-14 h-14 shrink-0 grid place-items-center rounded-2xl border-2 border-qg-green/50 text-qg-green text-2xl hover:bg-qg-soft" aria-label="Previous">←</button>
      <p class="text-center text-sm font-bold text-qg-muted"><span data-s-juzlabel></span> <span data-s-left></span></p>
      <button data-s-next class="w-14 h-14 shrink-0 grid place-items-center rounded-2xl bg-qg-deep text-white text-2xl font-extrabold hover:bg-[#084337]" aria-label="Next">→</button>
    </div>
    <div class="h-2 bg-qg-line rounded-full overflow-hidden mt-3"><div data-s-juzbar class="h-full bg-qg-deep rounded-full transition-all" style="width:0%"></div></div>
    <button data-s-done class="mt-3 w-full rounded-2xl bg-qg-deep text-white font-extrabold px-6 py-3.5 min-h-[56px] text-[17px] hover:bg-[#084337] active:scale-[0.99] transition">✓ I'm Done</button>
    <a data-s-progress href={progressUrl} class="hidden mt-2 text-center block text-sm font-bold text-qg-green">Saved ✓ · View my progress →</a>
  </article>
</div>

<script define:vars={{ surah, juzTotals, pad3: pad(surah.num), tApp: t }}>
  (() => {
    const root = document.querySelector('[data-session]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);
    const S = surah.num;
    const verses = surah.verses || [];
    const params = new URLSearchParams(window.location.search);
    let idx = Math.max(0, Math.min(verses.length - 1, (parseInt(params.get('verse') || '1', 10) - 1) || 0));
    const trKey = document.documentElement.lang === 'en' ? 'en' : document.documentElement.lang === 'hi' ? 'hi' : 'ur';
    let repeat = false, audio = null;

    /* --- device-local progress (hn.progress.v1 / hn.challenges.v1) --- */
    const PKEY = 'hn.progress.v1';
    const CKEY = 'hn.challenges.v1';
    // Local calendar day — "today" must flip at local midnight, never UTC.
    const dayKey = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const todayKey = () => dayKey(new Date());
    const pload = () => { try { const v = JSON.parse(localStorage.getItem(PKEY) || '{}'); return v && typeof v === 'object' ? v : {}; } catch { return {}; } };
    const psave = (v) => { try { localStorage.setItem(PKEY, JSON.stringify(v)); } catch {} };
    const cload = () => { try { const v = JSON.parse(localStorage.getItem(CKEY) || '{}'); return v && typeof v === 'object' ? v : {}; } catch { return {}; } };
    const csave = (v) => { try { localStorage.setItem(CKEY, JSON.stringify(v)); } catch {} };
    const letters = (t) => {
      let n = 0;
      const s = String(t || '');
      for (const ch of s) { const c = ch.codePointAt(0); if (c >= 0x0621 && c <= 0x064a && ch !== 'ـ') n += 1; }
      return n;
    };
    const JUZ = root.dataset.juz ? Number(root.dataset.juz) : 0;
    let sessionStart = idx;
    const touchSpot = () => {
      const cur = verses[idx];
      if (!cur) return;
      const p = pload();
      p.lastSpot = { surah: S, verse: cur.v };
      const k = String(S);
      p.perSurah = p.perSurah || {};
      p.perSurah[k] = Math.max(Number(p.perSurah[k]) || 0, cur.v);
      psave(p);
    };

    const paintVerse = () => {
      const v = verses[idx];
      if (!v) return;
      $('[data-s-title]').textContent = `${idx + 1}. ${surah.name}`;
      $('[data-s-pos]').textContent = `${v.v}/${surah.verseCount}`;
      const ar = $('[data-s-ar]');
      ar.textContent = v.ar;
      const tr = $('[data-s-tr]');
      tr.textContent = trKey === 'en' ? v.en : trKey === 'hi' ? v.hi : v.ur;
      const url = new URL(window.location.href);
      url.searchParams.set('verse', v.v);
      history.replaceState(null, '', url.search);
      const bm = $('[data-s-bm]');
      if (bm) {
        bm.setAttribute('data-bm-ref', `${S}:${v.v}`);
        bm.setAttribute('data-bm-title', `Surah ${surah.name} ${S}:${v.v}`);
      }
      if (window.__hnBmPaint) window.__hnBmPaint();
      touchSpot();
    };

    const paintJuz = () => {
      const jt = (juzTotals || []).find((j) => j.num === +(root.dataset.juz || 0));
      if (jt) {
        const left = Math.max(0, jt.verses - idx - 1);
        $('[data-s-juzlabel]').textContent = `${tApp.dash.juz} ${jt.num}: ${jt.verses} ${tApp.dash.verses}`;
        $('[data-s-left]').textContent = `• ${left} ${tApp.read.left}`;
        $('[data-s-juzbar]').style.width = `${Math.round(((idx + 1) / jt.verses) * 100)}%`;
      } else {
        $('[data-s-juzlabel]').textContent = `Surah ${surah.name} • ${surah.verseCount} ${tApp.dash.verses}`;
        $('[data-s-left]').textContent = `• ${verses.length - idx - 1} ${tApp.read.left}`;
        $('[data-s-juzbar]').style.width = `${Math.round(((idx + 1) / verses.length) * 100)}%`;
      }
    };

    const playCurrent = () => {
      const v = verses[idx];
      if (!v) return;
      if (!audio) audio = new Audio();
      audio.loop = repeat;
      audio.src = `https://everyayah.com/data/Alafasy_128kbps/${pad3}${String(v.v).padStart(3, '0')}.mp3`;
      audio.play().catch(() => {});
    };

    $('[data-s-play]')?.addEventListener('click', playCurrent);
    $('[data-s-repeat]')?.addEventListener('click', (e) => {
      repeat = !repeat;
      e.currentTarget.setAttribute('aria-pressed', String(repeat));
      e.currentTarget.style.opacity = repeat ? '1' : '0.55';
    });
    $('[data-s-next]')?.addEventListener('click', () => { if (idx < verses.length - 1) { idx += 1; paintVerse(); paintJuz(); } });
    $('[data-s-prev]')?.addEventListener('click', () => { if (idx > 0) { idx -= 1; paintVerse(); paintJuz(); } });
    $('[data-s-done]')?.addEventListener('click', () => {
      const end = idx;
      const from = Math.max(0, Math.min(sessionStart, end));
      const to = Math.max(sessionStart, end);
      let vv = 0, hs = 0;
      for (let i = from; i <= to; i += 1) {
        const x = verses[i];
        if (!x) continue;
        vv += 1;
        hs += letters(x.ar) * 10;
      }
      const t = todayKey();
      const p = pload();
      p.activeDays = Array.isArray(p.activeDays) ? p.activeDays : [];
      if (!p.activeDays.includes(t)) p.activeDays.push(t);
      p.versesTotal = (Number(p.versesTotal) || 0) + vv;
      p.hasanatTotal = (Number(p.hasanatTotal) || 0) + hs;
      psave(p);
      const c = cload();
      if (S === 18) {
        const [wy, wm, wd] = t.split('-').map(Number);
        const d = new Date(wy, wm - 1, wd);
        const back = (d.getDay() - 5 + 7) % 7; // Friday-start week
        d.setDate(d.getDate() - back);
        const wk = dayKey(d);
        c.kahf = (c.kahf && c.kahf.week === wk) ? c.kahf : { week: wk, n: 0 };
        c.kahf.n = (Number(c.kahf.n) || 0) + vv;
      }
      if (JUZ > 0) {
        c.khatm = Array.isArray(c.khatm) ? c.khatm : [];
        if (!c.khatm.includes(JUZ)) c.khatm.push(JUZ);
      }
      csave(c);
      sessionStart = end;
      touchSpot();
      const doneBtn = $('[data-s-done]');
      const progLink = $('[data-s-progress]');
      if (doneBtn) doneBtn.classList.add('hidden');
      if (progLink) {
        progLink.classList.remove('hidden');
        progLink.textContent = `Saved ✓ ${vv} verse${vv === 1 ? '' : 's'} · View my progress →`;
      }
    });
    $('[data-s-share]')?.addEventListener('click', async () => {
      const v = verses[idx];
      const text = `${v.ar}\n— Surah ${surah.name} ${S}:${v.v} (Hikmah Noor)`;
      try {
        if (navigator.share) await navigator.share({ text });
        else { await navigator.clipboard.writeText(text); }
      } catch {}
    });

    paintVerse(); paintJuz();
  })();
</script>
