---
/* Hadith book page — lists every hadith of ONE book in source order.
 * Entries derive from the hadith-collections registry; cards show a short
 * English preview with a link to the full entry page. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { secUI2, HADEES_UI } from '../lib/site-ui-2';
import { hadithEntriesOf, collectionPath, bookPath, entryPath } from '../data/hadith-collections';
import type { HadithCollection, HadithBook } from '../data/hadith-collections';

interface Props { collection: HadithCollection; book: HadithBook; locale: string; }
const { collection, book, locale } = Astro.props;
const dict = getDict(locale);
const T = (secUI2(locale, HADEES_UI) as any).coll;
const L = (p: string) => localizedPath(locale, p);
const entries = hadithEntriesOf(collection.id, book.num);
const total = entries.length;
const collPath = collectionPath(collection.slug);
const bPath = bookPath(collection.slug, book.slug);
const preview = (s: string) => (s.length > 140 ? s.slice(0, 137) + '…' : s);

const title = T.bookTitle.replace('{name}', collection.name).replace('{t}', String(total));
let description = T.bookDesc.replace('{name}', collection.name).replace('{t}', String(total));
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${collection.name.toLowerCase()}, ${book.slug.replace(/-/g, ' ')}, ${collection.slug} book ${book.num}`;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: (secUI2(locale, HADEES_UI) as any).crumb, path: '/hadees/' },
  { name: collection.name, path: collPath },
  { name: book.title, path: bPath },
];
const faq = [
  { q: T.faqFullQ, a: T.faqFullA.replace('{t}', String(total)) },
  { q: T.faqLangQ, a: T.faqLangA },
  { q: T.refL, a: collection.provenanceLine },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath={bPath}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.hadithOf.replace('{n}', `${book.first}–${book.last}`).replace('{t}', String(total))}</span>
        <span class="hn-badge">{T.arabicL} + {T.englishL}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{book.title}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{collection.name} · {T.bookOf.replace('{n}', String(book.num))}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L(collPath)} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">{T.backCollL}</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={collection.short} title={book.title} />
      <div class="grid gap-3 sm:grid-cols-2">
        {entries.map((h) => (
          <a href={L(entryPath(collection.slug, book.slug, h.num))} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
            <span class="hn-verse-num shrink-0">{h.num}</span>
            <span class="min-w-0">
              <span class="font-extrabold block leading-6">{T.readL.replace('{n}', String(h.num))}</span>
              <span class="text-[13px] leading-6 block mt-0.5 line-clamp-3" style="color:var(--hn-muted)" lang="en">{preview(h.english)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <p class="mt-8 text-[12px] leading-6 max-w-3xl" style="color:var(--hn-muted)">{T.provL}: {collection.provenanceLine}</p>

    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
