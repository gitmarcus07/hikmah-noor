---
/* Meanings hub: all core Islamic terms -> detail pages. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import MeaningArt from './MeaningArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { MEANINGS } from '../data/meanings';

interface Props { locale: string; guides: { title: string; desc: string; href: string }[]; }
const { locale, guides } = Astro.props;
const dict = getDict(locale);
const isFallback = locale !== 'en';

const title = `Islamic Terms & Meanings — Tawakkul, Sabr, Taqwa and More (${MEANINGS.length} terms)`;
const description = `All ${MEANINGS.length} core Islamic terms explained — tawakkul, sabr, shukr, taqwa, iman, ihsan and more — with Arabic, Quran and hadith proof, misconceptions and daily practice.`;
const keywords = 'islamic terms, islamic words meaning, tawakkul meaning, sabr meaning, taqwa meaning, iman meaning, sabar ka matlab, shukar ka matlab';
const faq = [
  { q: 'What will I learn on each meaning page?', a: 'A precise definition, the Arabic word, Quran and hadith proof, the most common misconception corrected, and three daily practices.' },
  { q: 'Are these meanings authentic?', a: 'Every term cites its Quran verse or hadith collection without invented references. Learn details from a teacher; consult scholars for rulings.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Meanings', path: '/meanings/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/meanings/">
  <section class="relative overflow-hidden bg-night-900 text-white">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 10%, rgba(139,124,246,.25), transparent 50%), radial-gradient(circle at 10% 90%, rgba(212,175,55,.12), transparent 40%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 pt-8 pb-9 md:pt-12 md:pb-12">
      <nav class="text-xs text-ink-500 mb-4"><a href={localizedPath(locale, '/')} class="hover:text-brand-300">{dict.nav.home}</a> / <span>{dict.nav.meanings}</span></nav>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="text-[11px] font-extrabold uppercase tracking-widest bg-gold-300 text-night-900 rounded-full px-3 py-1.5">{MEANINGS.length} terms</span>
        {isFallback && <span class="text-[11px] font-extrabold uppercase tracking-widest bg-white/10 border border-white/15 text-white rounded-full px-3 py-1.5">EN</span>}
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">Islamic Meanings 📖</h1>
      <p class="mt-3 text-ink-300 leading-7 max-w-2xl md:text-lg">Core concepts of Islam, each with Arabic, Quran and hadith proof, common misconceptions corrected, and daily practice.</p>
      <form action={localizedPath(locale, '/search/')} method="get" class="mt-5 flex gap-2 max-w-xl" role="search">
        <input name="q" placeholder="Search meanings — e.g. sabr, taqwa, shukr…" class="flex-1 min-w-0 bg-night-800 text-ink-50 border border-white/10 rounded-2xl px-5 py-3.5 min-h-[52px] outline-none focus:ring-2 ring-amber-300 placeholder:text-ink-500" />
        <button class="bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-2xl px-6 min-h-[52px]">Go</button>
      </form>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <h2 class="text-xl md:text-2xl font-extrabold mb-4 text-white">📖 Browse all terms</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {MEANINGS.map((m) => (
        <a href={localizedPath(locale, `/meanings/${m.slug}/`)} class="group bg-night-850 border border-white/10 rounded-3xl overflow-hidden shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 hover:-translate-y-1 transition">
          <span class="block overflow-hidden"><MeaningArt motif={m.motif} arabic={m.arabic} term={m.term} translit={m.translit} accent={m.accent} /></span>
          <span class="block p-5">
            <span class="font-extrabold block text-lg leading-7 text-ink-50 group-hover:text-brand-300">{m.term} <span class="text-xs font-extrabold text-ink-500">• {m.translit}</span></span>
            <span class="text-sm text-ink-300 leading-6 block mt-1 line-clamp-2">{m.definition}</span>
            <span class="text-xs font-bold text-brand-300 mt-2 block">Proof + practice →</span>
          </span>
        </a>
      ))}
    </div>

    {guides.length > 0 && (
      <>
        <h2 class="text-xl md:text-2xl font-extrabold mt-9 mb-4 text-white">📚 In-depth guides</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {guides.map((g) => (
            <a href={g.href} class="group bg-night-850 border border-white/10 rounded-2xl p-5 shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 transition">
              <span class="font-extrabold block leading-6 text-ink-50 group-hover:text-brand-300">{g.title}</span>
              <span class="text-sm text-ink-300 leading-6 block mt-1 line-clamp-2">{g.desc}</span>
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
