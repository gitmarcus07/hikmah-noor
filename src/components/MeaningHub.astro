---
/* Meanings hub: all core Islamic terms -> detail pages. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import MeaningArt from './MeaningArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { MEANINGS } from '../data/meanings';

interface Props { locale: string; guides: { title: string; desc: string; href: string }[]; }
const { locale, guides } = Astro.props;
const dict = getDict(locale);
const isFallback = locale !== 'en';

const title = `Islamic Terms & Meanings — Tawakkul, Sabr, Taqwa and More (${MEANINGS.length} terms)`;
const description = `All ${MEANINGS.length} core Islamic terms explained — tawakkul, sabr, shukr, taqwa, iman, ihsan and more — with Arabic, Quran and hadith proof, misconceptions and daily practice.`;
const keywords = 'islamic terms, islamic words meaning, tawakkul meaning, sabr meaning, taqwa meaning, iman meaning, sabar ka matlab, shukar ka matlab';
const faq = [
  { q: 'What will I learn on each meaning page?', a: 'A precise definition, the Arabic word, Quran and hadith proof, the most common misconception corrected, and three daily practices.' },
  { q: 'Are these meanings authentic?', a: 'Every term cites its Quran verse or hadith collection without invented references. Learn details from a teacher; consult scholars for rulings.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Meanings', path: '/meanings/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/meanings/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{MEANINGS.length} terms</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Islamic Meanings</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Core concepts of Islam, each with Arabic, Quran and hadith proof, common misconceptions corrected, and daily practice.</p>
      <form action={localizedPath(locale, '/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" placeholder="Search meanings — e.g. sabr, taqwa, shukr…" aria-label="Search meanings" />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Learn" title="Browse all terms" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {MEANINGS.map((m) => (
          <a href={localizedPath(locale, `/meanings/${m.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <span class="block overflow-hidden"><MeaningArt motif={m.motif} arabic={m.arabic} term={m.term} translit={m.translit} accent={m.accent} /></span>
            <span class="block hn-card-pad">
              <span class="font-extrabold block text-[17px] leading-7">{m.term} <span class="text-xs font-extrabold" style="color:var(--hn-muted)">• {m.translit}</span></span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{m.definition}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    {guides.length > 0 && (
      <div class="mt-8">
        <SectionHeader eyebrow="Guides" title="In-depth guides" />
        <div class="grid gap-3 sm:grid-cols-2">
          {guides.map((g) => (
            <a href={g.href} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-extrabold block leading-6">{g.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.desc}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
