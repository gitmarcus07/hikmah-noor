---
/* Meanings hub: all core Islamic terms -> detail pages. Plus article guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import MeaningArt from './MeaningArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { MEANINGS } from '../data/meanings';
import { localizeMeaningList } from '../lib/content-i18n';
import { secUI2, MEANING_UI } from '../lib/site-ui-2';

interface Props { locale: string; guides: { title: string; desc: string; href: string }[]; }
const { locale, guides } = Astro.props;
const dict = getDict(locale);
const T = secUI2(locale, MEANING_UI);
const L = (p: string) => localizedPath(locale, p);
const ML = localizeMeaningList(MEANINGS, locale);

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/meanings/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/meanings/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{ML.length} {T.badgeN}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secTerms} title={T.secTerms} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {ML.map((m) => (
          <a href={localizedPath(locale, `/meanings/${m.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <span class="block overflow-hidden"><MeaningArt motif={m.motif} arabic={m.arabic} term={m.term} translit={m.translit} accent={m.accent} /></span>
            <span class="block hn-card-pad">
              <span class="font-extrabold block text-[17px] leading-7">{m.term} <span class="text-xs font-extrabold" style="color:var(--hn-muted)">• {m.translit}</span></span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{m.definition}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    {guides.length > 0 && (
      <div class="mt-8">
        <SectionHeader eyebrow={T.secGuides} title={T.secGuides} />
        <div class="grid gap-3 sm:grid-cols-2">
          {guides.map((g) => (
            <a href={g.href} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-extrabold block leading-6">{g.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.desc}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">{dict.article.faq}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
