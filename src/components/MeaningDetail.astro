---
/* Meaning detail — reference/article reading page in the unified system. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import MeaningArt from './MeaningArt.astro';
import { localizedPath } from '../i18n/utils';
import { MEANINGS } from '../data/meanings';

interface Props { meaning: any; locale: string; }
const { meaning, locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const meaningPath = `/meanings/${meaning.slug}/`;

const title = `${meaning.term} Meaning in Islam — ${meaning.translit}`;
let description = `What does ${meaning.term.toLowerCase()} mean? ${meaning.definition} Proof: ${meaning.proofRef}.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${meaning.term.toLowerCase()} meaning, ${meaning.translit.toLowerCase()}, ${meaning.term.toLowerCase()} in islam, ${meaning.term.toLowerCase()} in quran${meaning.aliases?.length ? `, ${meaning.aliases.join(', ')}` : ''}`;

const faq = [
  { q: `What is the meaning of ${meaning.term}?`, a: meaning.definition },
  { q: `What is the proof for ${meaning.term}?`, a: `${meaning.proofRef}${meaning.hadithRef ? ` and ${meaning.hadithRef}` : ''}. ${meaning.misconception}` },
  { q: `How do I practice ${meaning.term} daily?`, a: meaning.practice.map((p: string, i: number) => `${i + 1}. ${p}`).join(' ') },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Meanings', path: '/meanings/' },
  { name: meaning.term, path: meaningPath },
];
const others = MEANINGS.filter((m) => m.slug !== meaning.slug).slice(0, 4);
const sIdx = MEANINGS.findIndex((m) => m.slug === meaning.slug);
const prevM = sIdx > 0 ? MEANINGS[sIdx - 1] : null;
const nextM = sIdx >= 0 && sIdx < MEANINGS.length - 1 ? MEANINGS[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={meaningPath}>
  <div class="hn-article hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">Meaning</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{meaning.term} <span class="font-bold" style="color:var(--hn-muted)">— {meaning.translit}</span></h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{meaning.definition}</p>
    {meaning.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">Also searched as: {meaning.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="hn-card overflow-hidden my-6">
      <MeaningArt motif={meaning.motif} arabic={meaning.arabic} term={meaning.term} translit={meaning.translit} accent={meaning.accent} />
    </div>

    <div class="hn-reading-card">
      <p class="hn-block-label">Proof • {meaning.proofRef}</p>
      <p class="arabic-block" lang="ar" dir="rtl">{meaning.proofArabic}</p>
      {meaning.hadithArabic && (
        <>
          <hr class="hn-divider" />
          <p class="hn-block-label">Hadith • {meaning.hadithRef}</p>
          <p class="arabic-block" lang="ar" dir="rtl">{meaning.hadithArabic}</p>
        </>
      )}
    </div>

    <div class="grid gap-3 mt-3">
      <div class="hn-card hn-card-pad">
        <p class="hn-block-label">Common misconception</p>
        <p class="leading-7 text-[15px]">{meaning.misconception}</p>
      </div>
      <div class="hn-card hn-card-pad">
        <p class="hn-block-label">Practice in 3 steps</p>
        <ol class="list-decimal ms-5 space-y-1.5 leading-7 text-[15px]">
          {meaning.practice.map((p: string) => <li>{p}</li>)}
        </ol>
      </div>
    </div>
    <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">Proof: <strong style="color:var(--hn-ink)">{meaning.proofRef}</strong>{meaning.hadithRef && <span> • <strong style="color:var(--hn-ink)">{meaning.hadithRef}</strong></span>}</p>
    <p class="mt-1 text-[13px]" style="color:var(--hn-muted)">Learn details from a teacher; consult scholars for rulings.</p>

    <section class="mt-8" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label="More meanings">
      <SectionHeader eyebrow="Learn" title="More meanings" href={L('/meanings/')} linkLabel="All meanings" />
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={L(`/meanings/${r.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <MeaningArt motif={r.motif} arabic={r.arabic} term={r.term} translit={r.translit} accent={r.accent} />
            <span class="block hn-card-pad">
              <span class="font-bold block text-[15px] leading-6">{r.term}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.definition}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {(prevM || nextM) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More meanings">
        {prevM ? (
          <a href={L(`/meanings/${prevM.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">← Previous</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevM.term}</span>
          </a>
        ) : <span />}
        {nextM && (
          <a href={L(`/meanings/${nextM.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">Next →</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextM.term}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
