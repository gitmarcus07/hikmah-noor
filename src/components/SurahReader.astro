---
/* Dedicated Quran reading layout — calm, focused, same design language as Juz. */
import Icon from './Icon.astro';
import ReviewedBadge from './hn/ReviewedBadge.astro';
import RelatedContent from './RelatedContent.astro';
import { VERSE_TAFSIR } from '../data/tafsir';
interface Verse { v: number; ar: string; ur: string; en: string; hi: string; tr: string }
interface SurahMeta { num: number; slug: string; name: string; englishName: string; arabicName: string; revelation: string; verseCount: number }
interface Props {
  surah: { num: number; slug: string; name: string; englishName: string; arabicName: string; revelation: string; verseCount: number; verses: Verse[] };
  prev: SurahMeta | null;
  next: SurahMeta | null;
  locale: string;
}
import { localizedPath } from '../i18n/utils';
const { surah, prev, next, locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const makki = surah.revelation.toLowerCase().startsWith('mecca');
const BISMILLAH = 'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ';
---
<nav class="hn-crumbs mb-4" aria-label="Breadcrumb">
  <a href={L('/')}>Home</a><span aria-hidden="true">›</span>
  <a href={L('/surahs/')}>Surahs</a><span aria-hidden="true">›</span>
  <span aria-current="page">Surah {surah.name}</span>
</nav>

<div class="hn-card hn-card-pad text-center mb-5">
  <span class="hn-badge hn-badge-primary">Surah {surah.num} of 114 • {surah.verseCount} verses • {makki ? 'Makki' : 'Madani'}</span>
  <p class="font-arabic text-3xl md:text-4xl mt-3" lang="ar" dir="rtl">{surah.arabicName}</p>
  <h1 class="text-xl md:text-2xl font-extrabold mt-2">Surah {surah.name} ({surah.englishName})</h1>
  <p class="text-sm mt-1" style="color:var(--hn-muted)">Read with Urdu, English & Hindi meaning, transliteration and audio</p>
</div>

{surah.num !== 1 && surah.num !== 9 && (
  <p class="hn-card font-arabic text-xl md:text-2xl text-center py-4 px-4 mb-5" lang="ar" dir="rtl">{BISMILLAH}</p>
)}

<div class="hn-card px-3 py-2 mb-5 flex flex-wrap items-center gap-2 sticky top-[3.75rem] z-30" id="readerbar">
  <div class="flex rounded-[10px] overflow-hidden text-sm font-bold" style="border:1px solid var(--hn-border)" role="group" aria-label="Translation language">
    <button data-langbtn="ur" aria-pressed="true" class="px-3.5 py-2.5 min-h-[44px]" style="background:var(--hn-primary);color:#fff">اردو</button>
    <button data-langbtn="en" aria-pressed="false" class="px-3.5 py-2.5 min-h-[44px]" style="color:var(--hn-muted)">English</button>
    <button data-langbtn="hi" aria-pressed="false" class="px-3.5 py-2.5 min-h-[44px]" style="color:var(--hn-muted)">हिन्दी</button>
  </div>
  <button id="trbtn" class="hn-btn hn-btn-secondary !min-h-[44px] !py-2 !px-3.5 text-sm" aria-pressed="false">Transliteration</button>
  <div class="relative" data-trwrap>
    <button type="button" id="trmodebtn" class="hn-btn hn-btn-secondary !min-h-[44px] !py-2 !px-3 text-sm" aria-haspopup="listbox" aria-expanded="false" title="Play translation audio after each verse">
      <Icon name="audio" size={16} />
      <span data-trlabel>No translation audio</span>
      <span aria-hidden="true" class="text-xs opacity-70">▾</span>
    </button>
    <div data-trmenu hidden role="listbox" aria-label="Translation audio language" class="absolute start-0 z-40 mt-1.5 min-w-[230px] hn-card p-1.5" style="box-shadow:var(--hn-shadow-lg)">
      <button type="button" role="option" aria-selected="true" data-tropt="off" class="tropt is-on"><span class="tropt-tick" aria-hidden="true">✓</span><span>No translation audio</span></button>
      <button type="button" role="option" aria-selected="false" data-tropt="ur" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>+ اردو audio</span></button>
      <button type="button" role="option" aria-selected="false" data-tropt="en" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>+ English audio</span></button>
      <button type="button" role="option" aria-selected="false" data-tropt="hi" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>+ हिन्दी voice</span></button>
    </div>
  </div>
  <div class="relative" data-recwrap>
    <button type="button" id="recbtn" class="hn-btn hn-btn-secondary !min-h-[44px] !py-2 !px-3 text-sm" aria-haspopup="listbox" aria-expanded="false" title="Choose reciter">
      <span aria-hidden="true">🎙</span>
      <span data-reclabel>Mishary Alafasy</span>
      <span aria-hidden="true" class="text-xs opacity-70">▾</span>
    </button>
    <div data-recmenu hidden role="listbox" aria-label="Reciter" class="absolute start-0 z-40 mt-1.5 min-w-[230px] hn-card p-1.5" style="box-shadow:var(--hn-shadow-lg)">
      <button type="button" role="option" aria-selected="true" data-recopt="alafasy" class="tropt is-on"><span class="tropt-tick" aria-hidden="true">✓</span><span>Mishary Alafasy</span></button>
      <button type="button" role="option" aria-selected="false" data-recopt="basit" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>Abdul Basit (Mujawwad)</span></button>
      <button type="button" role="option" aria-selected="false" data-recopt="husary" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>Mahmoud Al-Husary</span></button>
      <button type="button" role="option" aria-selected="false" data-recopt="muaiqly" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>Maher Al-Muaiqly</span></button>
      <button type="button" role="option" aria-selected="false" data-recopt="minshawi" class="tropt"><span class="tropt-tick" aria-hidden="true">✓</span><span>Al-Minshawi (Murattal)</span></button>
    </div>
  </div>
  <span data-playstatus class="text-xs font-bold order-last w-full sm:order-none sm:w-auto" style="color:var(--hn-muted)" aria-live="polite"></span>
  <div class="ms-auto flex items-center gap-1.5">
    <button id="prevbtn" type="button" class="hn-icon-btn !w-10 !h-10 !rounded-full" aria-label="Previous verse">⏮</button>
    <button id="playall" type="button" class="hn-btn hn-btn-primary !min-h-[44px] !py-2 !px-4 text-sm"><span data-playicon aria-hidden="true">▶</span><span data-playlabel>Play surah</span></button>
    <button id="nextbtn" type="button" class="hn-icon-btn !w-10 !h-10 !rounded-full" aria-label="Next verse">⏭</button>
  </div>
</div>

<div id="verses" data-tr="ur" data-showtr="0" data-surah={surah.num} data-surahname={surah.name}>
  {surah.verses.map((verse) => (
    <article id={`v${verse.v}`} data-verse={verse.v} class="verse hn-verse">
      <div class="flex items-center gap-2 mb-2">
        <span class="hn-verse-num">{verse.v}</span>
        <button class="vplay hn-icon-btn !w-10 !h-10 !rounded-full" data-v={verse.v} aria-label={`Play verse ${verse.v}`}>
          <Icon name="play" size={15} />
        </button>
      </div>
      <p class="hn-verse-ar" lang="ar" dir="rtl">{verse.ar} <span style="color:var(--hn-gold);font-size:0.8em">﴿{verse.v}﴾</span></p>
      <p class="m-tr translit-block mt-2 hidden" data-trtext>{verse.tr}</p>
      <p class="m-ur leading-8 mt-2" dir={locale === 'en' ? 'rtl' : undefined} lang="ur">{verse.ur}</p>
      <p class="m-en leading-7 mt-2 hidden" style="color:var(--hn-muted)">{verse.en}</p>
      <p class="m-hi leading-8 mt-2 hidden" style="color:var(--hn-muted)" lang="hi">{verse.hi}</p>
      {VERSE_TAFSIR[surah.num]?.[verse.v] && (
        <details class="mt-2 text-[14px]">
          <summary class="font-bold cursor-pointer" style="color:var(--hn-primary)">Tafsir — verse {verse.v}</summary>
          <p class="mt-1 leading-7" style="color:var(--hn-muted)">{VERSE_TAFSIR[surah.num][verse.v]}</p>
        </details>
      )}
    </article>
  ))}
</div>

<p class="text-xs mt-6 leading-6" style="color:var(--hn-muted)">
  Arabic: Uthmani script. Urdu meaning: Fateh Muhammad Jalandhry • English: The Clear Quran, Dr. Mustafa Khattab •
  Hindi: Suhel Farooq Khan • Text via quran-api (fawazahmed0) • Recitation: Mishary Alafasy, Abdul Basit, Mahmoud Al-Husary, Maher Al-Muaiqly &amp; Muhammad Al-Minshawi via EveryAyah — choose your reciter above.
  Translation audio: English (Sahih International, Ibrahim Walk) & Urdu (Shamshad Ali Khan) via EveryAyah;
  Hindi uses your device's voice reader and needs internet voices on some phones.
  Spoken translation wording may differ slightly from the displayed text.
  Educational content — not a fatwa. See <a href={L('/methodology/')} class="font-bold underline underline-offset-2" style="color:var(--hn-primary)">methodology</a>.
</p>
<ReviewedBadge locale={locale} date="2026-01-01" />

<div class="grid gap-3 mt-6 sm:grid-cols-2">
  {prev ? (
    <a href={L(`/surahs/${prev.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">← <span class="text-xs font-bold" style="color:var(--hn-muted)">Previous</span><span class="font-bold block">{prev.num}. Surah {prev.name}</span></a>
  ) : <span />}
  {next ? (
    <a href={L(`/surahs/${next.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right"><span class="text-xs font-bold" style="color:var(--hn-muted)">Next</span> →<span class="font-bold block">{next.num}. Surah {next.name}</span></a>
  ) : <span />}
</div>

<RelatedContent type="surah" slug={surah.slug} locale={locale} />

<script>
  import {
    RECITERS,
    TR_LABELS,
    getReciter,
    setReciter,
    getTrMode,
    setTrMode,
    getQuranAudio,
    setTextResolver,
    type ReciterKey,
    type TrMode,
    type QueueItem,
    type PlayerState,
  } from '../scripts/quran-audio';

  // Runs on first load and again after every client-side navigation. Guards on
  // the Surah-specific marker so the Para reader's script can never wire this
  // DOM, and on a per-DOM flag so the same page is never wired twice.
  function initSurahReader() {
    const box = document.getElementById('verses') as HTMLElement | null;
    if (!box || !box.dataset.surah) return;
    const playAll = document.getElementById('playall') as HTMLButtonElement | null;
    if (!playAll || box.dataset.hnReaderWired === '1') return;
    box.dataset.hnReaderWired = '1';
    const langBtns = [...document.querySelectorAll<HTMLElement>('[data-langbtn]')];
    const trBtn = document.getElementById('trbtn');
    const prevBtn = document.getElementById('prevbtn');
    const nextBtn = document.getElementById('nextbtn');
    const playIcon = playAll.querySelector<HTMLElement>('[data-playicon]');
    const playLabel = playAll.querySelector<HTMLElement>('[data-playlabel]');
    const statusEl = document.querySelector<HTMLElement>('[data-playstatus]');

    const SURAH = Number(box.dataset.surah);
    const SURAH_NAME = box.dataset.surahname || String(SURAH);
    const player = getQuranAudio();

    function setLang(l: string) {
      box.dataset.tr = l;
      box.querySelectorAll('.verse').forEach(v => {
        v.querySelector('.m-ur')?.classList.toggle('hidden', l !== 'ur');
        v.querySelector('.m-en')?.classList.toggle('hidden', l !== 'en');
        v.querySelector('.m-hi')?.classList.toggle('hidden', l !== 'hi');
      });
      for (const b of langBtns) {
        const on = b.dataset.langbtn === l;
        b.style.background = on ? 'var(--hn-primary)' : 'transparent';
        b.style.color = on ? '#fff' : 'var(--hn-muted)';
        b.setAttribute('aria-pressed', String(on));
      }
    }
    langBtns.forEach(b => b.addEventListener('click', () => setLang(b.dataset.langbtn || 'ur')));
    trBtn?.addEventListener('click', () => {
      const on = box.dataset.showtr !== '1';
      box.dataset.showtr = on ? '1' : '0';
      trBtn.setAttribute('aria-pressed', String(on));
      trBtn.style.background = on ? 'var(--hn-primary)' : '';
      trBtn.style.color = on ? '#fff' : '';
      trBtn.style.borderColor = on ? 'var(--hn-primary)' : '';
      box.querySelectorAll('[data-trtext]').forEach(el => el.classList.toggle('hidden', !on));
    });

    /* ---- translation-audio dropdown (shared player setting) ---- */
    const trWrap = document.querySelector('[data-trwrap]') as HTMLElement;
    const trModeBtn = document.getElementById('trmodebtn') as HTMLButtonElement;
    const trLabel = trWrap.querySelector('[data-trlabel]')!;
    const trMenu = trWrap.querySelector<HTMLElement>('[data-trmenu]')!;
    function paintTrMode() {
      const m = getTrMode();
      trLabel.textContent = TR_LABELS[m];
      trMenu.querySelectorAll('[data-tropt]').forEach(o => {
        const on = o.getAttribute('data-tropt') === m;
        o.classList.toggle('is-on', on);
        o.setAttribute('aria-selected', String(on));
      });
    }
    function closeTr(refocus: boolean) {
      trMenu.hidden = true;
      trModeBtn.setAttribute('aria-expanded', 'false');
      if (refocus) trModeBtn.focus();
    }
    trModeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = trMenu.hidden;
      trMenu.hidden = !open;
      trModeBtn.setAttribute('aria-expanded', String(open));
    });
    trMenu.querySelectorAll('[data-tropt]').forEach(o => o.addEventListener('click', () => {
      setTrMode(o.getAttribute('data-tropt') as TrMode);
      paintTrMode();
      closeTr(false);
    }));
    paintTrMode();

    /* ---- reciter dropdown (shared player setting) ---- */
    const recWrap = document.querySelector('[data-recwrap]') as HTMLElement;
    const recBtn = document.getElementById('recbtn') as HTMLButtonElement;
    const recLabel = recWrap.querySelector('[data-reclabel]')!;
    const recMenu = recWrap.querySelector<HTMLElement>('[data-recmenu]')!;
    function paintReciter() {
      const r = getReciter();
      recLabel.textContent = RECITERS[r].label;
      recMenu.querySelectorAll('[data-recopt]').forEach(o => {
        const on = o.getAttribute('data-recopt') === r;
        o.classList.toggle('is-on', on);
        o.setAttribute('aria-selected', String(on));
      });
    }
    function chooseReciter(m: ReciterKey, refocus: boolean) {
      const st = player.getState();
      setReciter(m);
      paintReciter();
      recMenu.hidden = true;
      recBtn.setAttribute('aria-expanded', 'false');
      if (st.meta && st.meta.type === 'surah' && st.meta.surah === SURAH && st.total > 0) {
        player.playQueue(items, st.index, meta);
      }
      if (refocus) recBtn.focus();
    }
    recBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = recMenu.hidden;
      recMenu.hidden = !open;
      recBtn.setAttribute('aria-expanded', String(open));
    });
    recMenu.querySelectorAll('[data-recopt]').forEach(o => o.addEventListener('click', () => chooseReciter(o.getAttribute('data-recopt') as ReciterKey, false)));
    paintReciter();

    // Document-level handlers are stored so they can be removed before a
    // client-side swap; otherwise repeated navigations would duplicate them.
    const onDocClick = (e: Event) => {
      const t = e.target as Node;
      if (!trWrap.contains(t) && !trMenu.hidden) closeTr(false);
      if (!recWrap.contains(t) && !recMenu.hidden) { recMenu.hidden = true; recBtn.setAttribute('aria-expanded', 'false'); }
    };
    const onDocKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      if (!trMenu.hidden) closeTr(true);
      if (!recMenu.hidden) { recMenu.hidden = true; recBtn.setAttribute('aria-expanded', 'false'); recBtn.focus(); }
    };
    document.addEventListener('click', onDocClick);
    document.addEventListener('keydown', onDocKey);

    /* ---- queue + shared player wiring ---- */
    const cards = [...box.querySelectorAll<HTMLElement>('.verse')];
    const items: QueueItem[] = cards.map(c => ({ surah: SURAH, verse: Number(c.dataset.verse) }));
    const meta = { type: 'surah' as const, surah: SURAH, label: `Surah ${SURAH_NAME}`, href: window.location.pathname, surahNames: { [String(SURAH)]: SURAH_NAME } };
    const sameQueue = (st: PlayerState) => !!(st.meta && st.meta.type === 'surah' && st.meta.surah === SURAH);

    setTextResolver((s, v, lang) => {
      const card = cards.find(c => Number(c.dataset.verse) === v);
      if (!card) return '';
      const cls = lang === 'ur' ? '.m-ur' : lang === 'en' ? '.m-en' : '.m-hi';
      return card.querySelector(cls)?.textContent?.trim() || '';
    });

    let lastActive: HTMLElement | null = null;
    function highlight(card: HTMLElement | null) {
      if (card === lastActive) return;
      lastActive = card;
      cards.forEach(c => c.classList.toggle('hn-active', c === card));
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    let lastTrEl: Element | null = null;
    function markTr(el: Element | null) {
      if (el === lastTrEl) return;
      lastTrEl = el;
      box.querySelectorAll('.tr-on').forEach(x => x.classList.remove('tr-on'));
      if (el) el.classList.add('tr-on');
    }
    function cardFor(item: QueueItem | null): HTMLElement | null {
      return item ? cards.find(c => Number(c.dataset.verse) === item.verse) || null : null;
    }

    function paint(st: PlayerState) {
      const active = sameQueue(st) ? cardFor(st.current) : null;
      highlight(active);
      if (active && st.phase === 'translation') {
        const m = getTrMode();
        const cls = m === 'ur' ? '.m-ur' : m === 'en' ? '.m-en' : '.m-hi';
        markTr(active.querySelector(cls));
      } else markTr(null);

      let icon = '▶', label = 'Play surah', aria = 'Play surah';
      if (sameQueue(st)) {
        if (st.status === 'loading') {
          icon = '⏳';
          label = `Preparing… ${Math.round(st.progress * 100)}%`;
          aria = 'Preparing audio';
        } else if (st.status === 'playing') {
          icon = '⏸';
          label = st.phase === 'translation' ? 'Translation…' : 'Playing…';
          aria = 'Pause surah';
        } else if (st.status === 'paused') {
          icon = '▶';
          label = 'Resume';
          aria = 'Resume surah';
        } else if (st.status === 'ended') {
          icon = '↻';
          label = 'Play surah';
          aria = 'Replay surah';
        }
      }
      if (playIcon) playIcon.textContent = icon;
      if (playLabel) playLabel.textContent = label;
      playAll.setAttribute('aria-label', aria);
      if (statusEl) {
        statusEl.textContent = sameQueue(st) && st.current
          ? st.status === 'loading'
            ? `Preparing audio… ${Math.round(st.progress * 100)}%`
            : st.status === 'playing'
              ? `Playing ${st.current.surah}:${st.current.verse}`
              : st.status === 'paused'
                ? `Paused ${st.current.surah}:${st.current.verse}`
                : st.status === 'ended'
                  ? 'Playback complete'
                  : ''
          : '';
      }
    }
    player.subscribe(paint);

    function startFromCard(card: Element | null) {
      if (!card) return;
      const i = cards.indexOf(card as HTMLElement);
      if (i < 0) return;
      const st = player.getState();
      if (sameQueue(st) && st.current && Number((card as HTMLElement).dataset.verse) === st.current.verse) {
        player.toggle();
        return;
      }
      player.playQueue(items, i, meta);
    }
    playAll.addEventListener('click', () => {
      const st = player.getState();
      if (sameQueue(st) && st.total > 0) player.toggle();
      else player.playQueue(items, 0, meta);
    });
    prevBtn?.addEventListener('click', () => player.prev());
    nextBtn?.addEventListener('click', () => player.next());
    box.querySelectorAll('.vplay').forEach(b => b.addEventListener('click', () => startFromCard(b.closest('.verse'))));

    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('click', onDocClick);
      document.removeEventListener('keydown', onDocKey);
    }, { once: true });
  }

  initSurahReader();
  document.addEventListener('astro:page-load', initSurahReader);
</script>
<style>
  .tr-on { background: var(--hn-gold-soft); border-radius: 0.5rem; padding-inline: 0.25rem; }
  .hn-active { background: var(--hn-primary-soft); border-radius: 12px; }
  .tropt { display: flex; align-items: center; gap: 0.6rem; width: 100%; text-align: start; min-height: 48px; padding: 0.65rem 0.8rem; border-radius: 12px; font-size: 0.9rem; font-weight: 700; color: var(--hn-ink); }
  .tropt:hover { background: var(--hn-primary-soft); }
  .tropt.is-on { background: var(--hn-primary-soft); color: var(--hn-primary); }
  .tropt-tick { width: 1.25rem; flex-shrink: 0; visibility: hidden; font-weight: 800; }
  .tropt.is-on .tropt-tick { visibility: visible; }
</style>
