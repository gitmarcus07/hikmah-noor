---
/* Hadees hub: all 40 short hadees for children -> per-hadees SEO detail pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { HADEES, HADEES_CATS } from '../data/hadees';
import { NAWAWI } from '../data/hadees-nawawi';
import { SAHIH, SAHIH_CATS } from '../data/hadees-sahih';
import { localizeHadees, localizeHadeesCat, localizeSahihCat } from '../lib/content-i18n';
import { gradeLabel as gradeLabelL } from '../lib/dua-ui-i18n';
import { secUI2, HADEES_UI } from '../lib/site-ui-2';
import { HADITH_COLLECTIONS, hadithCountOf, hadithBooksOf, collectionPath } from '../data/hadith-collections';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI2(locale, HADEES_UI);
const L = (p: string) => localizedPath(locale, p);
const HC = HADEES_CATS.map((c) => localizeHadeesCat(c, locale));
const SC = SAHIH_CATS.map((c) => localizeSahihCat(c, locale));
const C = (secUI2(locale, HADEES_UI) as any).coll;

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/hadees/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath="/hadees/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{HADEES.length + NAWAWI.length + SAHIH.length} {T.badgeN}</span>
        <span class="hn-badge">{T.badge2}</span>
        <span class="hn-badge">{T.badge3}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-6 max-w-3xl">
      <input id="hadeesfilter" class="hn-input" placeholder={T.filterPh} aria-label={T.filterPh} />
    </div>

    {HC.map((c) => {
      const list = HADEES.filter((h) => h.sabaq === c.num).map((h) => localizeHadees(h, locale, 'kids'));
      return (
        <div class="mt-8">
          <SectionHeader eyebrow={T.sabaqL.replace('{n}', String(c.num))} title={c.title} sub={c.desc} />
          <div class="grid gap-3 md:grid-cols-2" data-sabaq={c.num}>
            {list.map((h) => (
              <a href={L(`/hadees/${h.slug}/`)} data-search={`${h.num} ${h.title} ${h.urdu} ${h.translation} ${h.arabic} ${(h.aliases || []).join(' ')}`.toLowerCase()} class="hadeesrow hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
                <span class="hn-verse-num shrink-0">{h.num}</span>
                <span class="min-w-0">
                  <span class="font-arabic text-xl block leading-9" lang="ar" dir="rtl">{h.arabic}</span>
                  <span class="font-extrabold block leading-6 mt-1">{h.title}</span>
                  <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">{h.urdu}</span>
                  <span class="mt-1.5 flex flex-wrap gap-1.5">
                    <span class="hn-badge hn-badge-primary">{gradeLabelL(h.grade, locale) ?? h.grade}</span>
                    <span class="hn-badge">{h.source.split(',')[0]}</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <div class="mt-8">
      <SectionHeader eyebrow="Nawawi" title={T.secNawawi} sub={T.secNawawiSub} />
      <div class="grid gap-3 md:grid-cols-2">
        {NAWAWI.map((hx) => { const h = localizeHadees(hx, locale, 'nawawi'); return (
          <a href={L(`/hadees/${h.slug}/`)} data-search={`${h.num} ${h.title} ${h.urdu} ${h.translation} ${h.arabic} ${(h.aliases || []).join(' ')}`.toLowerCase()} class="hadeesrow hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
            <span class="hn-verse-num shrink-0">{h.num}</span>
            <span class="min-w-0">
              <span class="font-arabic text-xl block leading-9" lang="ar" dir="rtl">{h.arabic}</span>
              <span class="font-extrabold block leading-6 mt-1">{h.title}</span>
              <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">{h.urdu}</span>
              <span class="mt-1.5 flex flex-wrap gap-1.5">
                <span class="hn-badge hn-badge-primary">{gradeLabelL(h.grade, locale) ?? h.grade}</span>
                <span class="hn-badge">{h.source.split(',')[0]}</span>
              </span>
            </span>
          </a>
        ); })}
      </div>
    </div>

    {SC.map((c) => {
      const list = SAHIH.filter((h) => h.sabaq === c.num).map((h) => localizeHadees(h, locale, 'sahih'));
      return (
        <div class="mt-8">
          <SectionHeader eyebrow={T.partL.replace('{n}', String(c.num))} title={c.title} sub={c.desc} />
          <div class="grid gap-3 md:grid-cols-2">
            {list.map((h) => (
              <a href={L(`/hadees/${h.slug}/`)} data-search={`${h.num} ${h.title} ${h.urdu} ${h.translation} ${h.arabic} ${(h.aliases || []).join(' ')}`.toLowerCase()} class="hadeesrow hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
                <span class="hn-verse-num shrink-0">{h.num}</span>
                <span class="min-w-0">
                  <span class="font-arabic text-xl block leading-9" lang="ar" dir="rtl">{h.arabic}</span>
                  <span class="font-extrabold block leading-6 mt-1">{h.title}</span>
                  <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">{h.urdu}</span>
                  <span class="mt-1.5 flex flex-wrap gap-1.5">
                    <span class="hn-badge hn-badge-primary">{gradeLabelL(h.grade, locale) ?? h.grade}</span>
                    <span class="hn-badge">{h.source.split(',')[0]}</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <div class="mt-8">
      <SectionHeader eyebrow={C.secT} title={C.secT} sub={C.secSub} />
      <div class="grid gap-3 sm:grid-cols-2">
        {HADITH_COLLECTIONS.map((coll) => {
          const total = hadithCountOf(coll.id);
          const nb = hadithBooksOf(coll.id).length;
          return (
            <a href={L(collectionPath(coll.slug))} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
              <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="book" size={22} /></span>
              <span class="min-w-0 flex-1">
                <span class="font-extrabold block leading-6">{coll.name}</span>
                <span class="text-[13px] leading-5 block mt-0.5" style="color:var(--hn-muted)">{C.countBadge.replace('{b}', String(nb)).replace('{t}', String(total))} · {C.arabicL} + {C.englishL}</span>
              </span>
              <Icon name="arrow" size={18} />
            </a>
          );
        })}
      </div>
    </div>

    <script is:inline>
      (() => {
        const input = document.getElementById('hadeesfilter');
        const rows = [...document.querySelectorAll('.hadeesrow')];
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          rows.forEach((r) => r.classList.toggle('hidden', !!q && !(r.dataset.search || '').includes(q)));
        });
      })();
    </script>

    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
