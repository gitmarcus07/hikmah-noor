---
/* New-Muslim starter hub — an ordered 7-step path plus first daily duas.
 * Every step links an existing verified guide/kalima page; no content
 * authored here. Slug lists verified by content:topics. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { GUIDES } from '../data/guides';
import { localizeGuide } from '../lib/guides-i18n';
import { kalimaBySlug } from '../data/kalimas';
import { localizeKalima } from '../lib/content-i18n';
import { DUA_CATS, duasByCat } from '../data/duas';
import { localizeDuaCat } from '../lib/dua-ui-i18n';
import { secUI } from '../lib/site-ui-1';
import { NEWMUSLIM_UI } from '../lib/site-ui-4';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, NEWMUSLIM_UI);
const L = (p: string) => localizedPath(locale, p);

const steps: any[] = [
  { kind: 'guide', slug: 'new-muslim-starter-guide' },
  { kind: 'kalima', slug: 'second-kalimah-shahadah' },
  { kind: 'guide', slug: 'wudu-ablution' },
  { kind: 'guide', slug: 'how-to-pray-namaz' },
  { kind: 'guide', slug: 'arabic-alphabet-makharij' },
  { kind: 'guide', slug: 'roza-fasting' },
  { kind: 'guide', slug: 'what-is-aqeedah-basics' },
].map((s) => {
  if (s.kind === 'kalima') {
    const k: any = localizeKalima(kalimaBySlug(s.slug), locale);
    return { n: 0, title: k.title, sub: k.use, href: `/kalimas/${k.slug}/` };
  }
  const g: any = localizeGuide(GUIDES.find((x) => x.slug === s.slug), locale);
  return { n: 0, title: g.title, sub: g.intro, href: `/learn/${g.cat}/${g.slug}/` };
}).map((s, i) => ({ ...s, n: i + 1 }));
const duaCatSlugs = ['morning-evening', 'food-drink', 'sleep-rest'];
const duaCats = duaCatSlugs
  .map((s) => DUA_CATS.find((c) => c.slug === s))
  .filter(Boolean)
  .map((c: any) => ({ ...localizeDuaCat(c, locale), slug: c.slug, n: duasByCat(c.slug).length }));
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/new-muslim/' },
];
---
<BaseLayout title={T.hubTitle} description={T.hubDesc} keywords={T.hubKw} locale={locale} type="collection" faq={T.hubFaq} crumbs={crumbs} canonicalPath="/new-muslim/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badge1}</span>
        <span class="hn-badge">{T.badge2}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secSteps} title={T.secStepsT} href={L('/learn/')} linkLabel={T.allGuides} />
      <ol class="space-y-3">
        {steps.map((s) => (
          <li>
            <a href={L(s.href)} class="hn-card hn-card-hover hn-card-pad flex gap-3">
              <span class="hn-verse-num shrink-0">{s.n}</span>
              <span class="min-w-0">
                <span class="font-extrabold block leading-6">{s.title}</span>
                <span class="text-sm leading-6 block mt-0.5 line-clamp-2" style="color:var(--hn-muted)">{s.sub}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secDuas} title={T.secDuasT} href={L('/duas/')} linkLabel={T.allDuas} />
      <div class="grid gap-3 sm:grid-cols-2">
        {duaCats.map((c: any) => (
          <a href={L(`/duas/${c.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="duas" size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block leading-6">{c.title} <span class="text-xs font-bold" style="color:var(--hn-muted)">({c.n})</span></span>
              <span class="text-[13px] leading-5 block mt-0.5 line-clamp-2" style="color:var(--hn-muted)">{c.desc}</span>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secNext} title={T.secNextT} />
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={L('/learn/')} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="book" size={22} /></span>
          <span class="font-extrabold block leading-6">{T.learnL}</span>
        </a>
        <a href={L('/quran/')} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="quran" size={22} /></span>
          <span class="font-extrabold block leading-6">{T.quranL}</span>
        </a>
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {T.hubFaq.map((f: any) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
