---
/* Waqiat hub: prophet stories -> detail pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import WaqiahArt from './WaqiahArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { WAQIAT } from '../data/waqiat';
import { localizeStoryList } from '../lib/stories-i18n';
import { storyUI } from '../lib/dua-ui-i18n';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const S = storyUI(locale);

const storyNames = WAQIAT.map((w) => w.title).join('; ');
const title = S.hubTitle.replace('{n}', String(WAQIAT.length));
const WL = localizeStoryList(WAQIAT, 'waqiat', locale);
const description = `${WAQIAT.length} — ${WL.map((w) => w.title).join(', ')}`.slice(0, 157) + '…';
const keywords = `${WL.map((w) => w.prophet.toLowerCase()).slice(0, 8).join(', ')}, quran stories with lessons`;
const faq = [
  { q: S.hubFaq1, a: S.hubFaq1A },
  { q: S.hubFaq2, a: S.hubFaq2A },
  { q: S.hubFaq3.replace('{n}', String(WAQIAT.length)), a: storyNames },
  { q: S.hubFaq4, a: S.hubFaq4A },
  { q: S.hubFaq5, a: S.hubFaq5A },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: dict.nav.waqiat, path: '/waqiat/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/waqiat/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{WAQIAT.length} {S.badgeStories}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{S.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{S.hubSub}</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{S.prophetsLine} <a href={localizedPath(locale, '/prophets/')} class="font-bold" style="color:var(--hn-primary)">{S.prophetsLink}</a></p>
      <form action={localizedPath(locale, '/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={S.hubSearchPh} aria-label={S.hubSearchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={S.secStories} title={S.secStories} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {localizeStoryList(WAQIAT, 'waqiat', locale).map((w) => (
          <a href={localizedPath(locale, `/waqiat/${w.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <span class="block overflow-hidden"><WaqiahArt motif={w.motif} arabic={w.arabic} prophet={w.prophet} accent={w.accent} /></span>
            <span class="block hn-card-pad">
              <span class="hn-badge hn-badge-primary">{w.prophet}</span>
              <span class="font-extrabold block text-[17px] leading-7 mt-2">{w.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{w.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <section class="mt-8 max-w-3xl" aria-label={S.faqTitle}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">{S.faqTitle}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
