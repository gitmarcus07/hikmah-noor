---
/* Waqiat hub: prophet stories -> detail pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import WaqiahArt from './WaqiahArt.astro';
import { localizedPath } from '../i18n/utils';
import { WAQIAT } from '../data/waqiat';
import { localizeStoryList } from '../lib/stories-i18n';

interface Props { locale: string; }
const { locale } = Astro.props;

const storyNames = WAQIAT.map((w) => w.title).join('; ');
const title = `Stories of the Prophets in Islam — Qisse with Lessons (${WAQIAT.length} stories)`;
const description = `All ${WAQIAT.length} prophet & seerah stories with events in order, lessons and Quran references — from Yusuf, Ibrahim and Musa to Uhud, Khandaq, Hudaybiyyah and Fath Makkah.`;
const keywords = `prophet stories islam, qisse ambiya, seerah stories, ${WAQIAT.map((w) => w.prophet.toLowerCase()).slice(0, 8).join(', ')}, quran stories with lessons, ${WAQIAT.map((w) => w.slug.replace(/-/g, ' ')).slice(0, 4).join(', ')}`;
const faq = [
  { q: 'Where do these stories come from?', a: 'Each story cites its Quran surahs or seerah sources — no invented details. Lessons are drawn plainly from the verses; consult scholars for deeper rulings.' },
  { q: 'What will I learn on each story page?', a: 'A summary, the key events in order, the full narrative in sections, lessons, the Quran references, the emblematic verse in Arabic with transliteration, FAQs and links to 4 more stories plus previous/next.' },
  { q: `Which ${WAQIAT.length} stories are included?`, a: storyNames },
  { q: 'Are these suitable for kids and new Muslims?', a: 'Yes — summaries first, then events in order, then the full story in short sections. Start with Yusuf, Ibrahim, Musa, Maryam or the Hijrah, then continue through Uhud, Khandaq and the Conquest.' },
  { q: 'How should I study them?', a: 'Read one story fully, note its 3–5 lessons, read the cited Quran passages with translation, and share one lesson with family. Use previous/next links to continue in order.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Waqiat', path: '/waqiat/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/waqiat/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{WAQIAT.length} stories</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Prophet Stories</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Quranic narratives with events in order, lessons, and references — from the well of Yusuf to the cave of Thawr.</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">Want every prophet in order, from Adam to Muhammad ﷺ? <a href={localizedPath(locale, '/prophets/')} class="font-bold" style="color:var(--hn-primary)">Browse the 25 Prophets →</a></p>
      <form action={localizedPath(locale, '/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder="Search stories — e.g. yusuf, ibrahim, hijrah…" aria-label="Search stories" />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Stories" title="Browse all stories" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {localizeStoryList(WAQIAT, 'waqiat', locale).map((w) => (
          <a href={localizedPath(locale, `/waqiat/${w.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <span class="block overflow-hidden"><WaqiahArt motif={w.motif} arabic={w.arabic} prophet={w.prophet} accent={w.accent} /></span>
            <span class="block hn-card-pad">
              <span class="hn-badge hn-badge-primary">{w.prophet}</span>
              <span class="font-extrabold block text-[17px] leading-7 mt-2">{w.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{w.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">Frequently asked questions</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
