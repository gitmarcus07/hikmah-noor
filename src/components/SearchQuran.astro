---
/* In-app Quran search — translation & ayaat, backed by /api/quran-search.
 * Public (content discovery). Language pill cycles EN → UR → HI;
 * scope dropdown picks Translation vs Arabic text.
 */
import { localizedPath, getDict } from '../i18n/utils';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = getDict(locale).app;
const exploreUrl = localizedPath(locale, '/explore/');
const gemsBase = localizedPath(locale, '/tools/gems/');
const gemsTitle = t.explore.gemsT;
const readBase = localizedPath(locale, '/tools/read/');

const LANGS = [
  ['en', 'ENG'],
  ['ur', 'URD'],
  ['hi', 'HIN'],
] as const;
---

<div class="sticky top-14 z-40 border-b" style="background:var(--hn-header);backdrop-filter:blur(12px);border-color:var(--hn-border)">
  <div class="max-w-md mx-auto px-4 py-2.5 grid grid-cols-[52px_1fr_auto] items-center gap-2">
    <a data-sq-back href={exploreUrl} class="hn-icon-btn !rounded-full text-xl" aria-label="Back">←</a>
    <h1 data-sq-title class="text-center text-[22px] leading-7 font-extrabold truncate">{t.search.title}</h1>
    <button data-sq-lang class="h-[44px] px-3 flex items-center justify-center gap-1 rounded-full text-[15px] font-extrabold min-w-[76px]" style="background:var(--hn-card);border:1px solid var(--hn-border);color:var(--hn-ink)" aria-label="Translation language">ENG <span class="text-lg leading-none" style="color:var(--hn-primary)">›</span></button>
  </div>
</div>

<div class="max-w-md mx-auto px-4 py-4" data-searchq>
  <div class="flex flex-col min-[420px]:flex-row gap-2">
    <div class="flex-[3] min-w-0 flex items-center gap-2 rounded-full px-4 transition" style="border:1px solid var(--hn-border);background:var(--hn-card)">
      <span class="text-xl" style="color:var(--hn-muted)" aria-hidden="true">🔍</span>
      <input data-sq-q type="search" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={t.search.ph} maxlength="100"
        class="w-full bg-transparent py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none text-[16px]" />
    </div>
    <select data-sq-scope aria-label="Search in"
      class="flex-[2] min-w-0 rounded-full px-3 min-h-[52px] text-[15px] font-semibold outline-none" style="background:var(--hn-card);border:1px solid var(--hn-border);color:var(--hn-ink)">
      <option value="tr">{t.account.translation}</option>
      <option value="ar">العربية</option>
    </select>
  </div>

  <p data-sq-hint class="mt-6 text-center text-sm text-ink-500 leading-6">{t.search.hintA}<br />{t.search.hintB} <b class="text-ink-300">mercy</b>, <b class="text-ink-300">patience</b> or <b class="text-ink-300">light</b>.</p>
  <p data-sq-status class="hidden mt-4 text-center text-sm font-bold text-ink-300"></p>
  <div data-sq-list class="mt-3 space-y-3"></div>
</div>

<script define:vars={{ readBase, gemsBase, gemsTitle, tSq: t }}>
  (() => {
    const root = document.querySelector('[data-searchq]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);
    const LANG_CYCLE = ['en', 'ur', 'hi'];
    const LANG_LABEL = { en: 'ENG', ur: 'URD', hi: 'HIN' };
    let lang = 'en', timer = null, seq = 0;

    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const trunc = (s, n = 180) => {
      s = String(s || '');
      return s.length > n ? `${s.slice(0, n).trim()}…` : s;
    };

    const paintLang = () => {
      // Pill lives in the page header, outside [data-searchq].
      const b = document.querySelector('[data-sq-lang]');
      if (b) b.innerHTML = `${LANG_LABEL[lang]} <span class="text-lg leading-none" style="color:var(--hn-primary)">›</span>`;
    };
    // Header pill lives outside [data-searchq] root.
    const langBtn = document.querySelector('[data-sq-lang]');
    langBtn?.addEventListener('click', () => {
      lang = LANG_CYCLE[(LANG_CYCLE.indexOf(lang) + 1) % LANG_CYCLE.length];
      paintLang();
      run(true);
    });

    const run = async (now = false) => {
      clearTimeout(timer);
      const go = async () => {
        const q = String($('[data-sq-q]')?.value || '').trim();
        const scope = $('[data-sq-scope]')?.value === 'ar' ? 'ar' : 'tr';
        const hint = $('[data-sq-hint]');
        const status = $('[data-sq-status]');
        const list = $('[data-sq-list]');
        const my = ++seq;
        if (q.length < 2) {
          if (hint) hint.classList.remove('hidden');
          if (status) status.classList.add('hidden');
          if (list) list.innerHTML = '';
          return;
        }
        if (hint) hint.classList.add('hidden');
        if (status) { status.classList.remove('hidden'); status.textContent = tSq.search.searching; }
        try {
          const effLang = scope === 'ar' ? 'ar' : lang;
          const r = await fetch(`/api/quran-search?q=${encodeURIComponent(q)}&lang=${effLang}&limit=15`, { credentials: 'same-origin' });
          const d = await r.json();
          if (my !== seq) return;
          const results = d.results || [];
          if (status) {
            status.textContent = results.length ? `${results.length} ${results.length > 1 ? tSq.search.results : tSq.search.result}` : '';
            if (!results.length) status.classList.add('hidden');
          }
          if (list) {
            list.innerHTML = results.length ? results.map((v) => `
              <article class="bg-night-850 border border-white/10 rounded-3xl p-5">
                <p class="font-arabic text-2xl leading-[2] text-right text-white" lang="ar" dir="rtl">${esc(v.ar)}</p>
                <p class="mt-2 text-[15px] leading-7 text-ink-200">${esc(trunc(v.text))}</p>
                <div class="mt-3 flex items-center gap-2">
                  <span class="text-xs font-extrabold text-brand-300 bg-brand-500/15 rounded-full px-3 py-1.5">Surah ${esc(v.sname)} ${v.surah}:${v.verse}</span>
                  <a href="${String(readBase).replace(/\/$/, '')}/${v.surah}/?verse=${v.verse}" class="ms-auto text-sm font-extrabold text-gold-300 hover:text-amber-200 min-h-[44px] inline-flex items-center">${tSq.search.open}</a>
                </div>
              </article>`).join('')
              : `<div class="text-center bg-night-850 border border-white/10 rounded-3xl p-8">
                   <div class="text-5xl">🔍</div>
                   <p class="mt-3 font-extrabold text-lg text-white">No verses found</p>
                   <p class="mt-1 text-sm text-ink-300">Try another word — e.g. mercy, patience, light.</p>
                 </div>`;
          }
        } catch {
          if (my !== seq) return;
          if (status) status.textContent = 'Search failed — check connection and retry.';
        }
      };
      if (now) go();
      else timer = setTimeout(go, 400);
    };

    $('[data-sq-q]')?.addEventListener('input', () => run(false));
    $('[data-sq-q]')?.addEventListener('keydown', (e) => { if (e.key === 'Enter') run(true); });
    $('[data-sq-scope]')?.addEventListener('change', () => run(true));

    // Deep link from Gems: ?q=…&lang=…&from=gems
    try {
      const params = new URLSearchParams(window.location.search);
      const q0 = (params.get('q') || '').slice(0, 100);
      const l0 = (params.get('lang') || '').toLowerCase();
      if (['en', 'ur', 'hi'].includes(l0)) lang = l0;
      if (params.get('from') === 'gems') {
        const back = document.querySelector('[data-sq-back]');
        if (back) back.setAttribute('href', gemsBase);
        const heading = document.querySelector('[data-sq-title]');
        if (heading) heading.textContent = gemsTitle;
        document.title = `${gemsTitle} | Hikmah Noor`;
      }
      if (q0) {
        const input = $('[data-sq-q]');
        if (input) input.value = q0;
      }
      paintLang();
      if (q0 && q0.trim().length >= 2) run(true);
    } catch { paintLang(); }
  })();
</script>
