---
/* Adab (manners & ethics) hub — aggregator over existing dua categories,
 * character terms, supporting hadith and family guides. No content authored:
 * every card links an existing verified page. Slug lists verified by
 * content:topics. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { DUA_CATS, duasByCat } from '../data/duas';
import { localizeDuaCat } from '../lib/dua-ui-i18n';
import { GUIDES } from '../data/guides';
import { localizeGuide } from '../lib/guides-i18n';
import { meaningBySlug } from '../data/meanings';
import { localizeMeaning, localizeHadees } from '../lib/content-i18n';
import { sahihBySlug } from '../data/hadees-sahih';
import { secUI } from '../lib/site-ui-1';
import { ADAB_UI } from '../lib/site-ui-4';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, ADAB_UI);
const L = (p: string) => localizedPath(locale, p);

const duaCatSlugs = ['social-manners', 'marriage', 'children', 'family-milestones'];
const duaCats = duaCatSlugs
  .map((s) => DUA_CATS.find((c) => c.slug === s))
  .filter(Boolean)
  .map((c: any) => ({ ...localizeDuaCat(c, locale), slug: c.slug, n: duasByCat(c.slug).length }));
const meaningSlugs = ['sidq', 'amanah', 'hilm', 'haya', 'ukhuwwah', 'karam', 'tawaduh', 'shukr'];
const meanings = meaningSlugs.map((s) => meaningBySlug(s)).filter(Boolean).map((m: any) => localizeMeaning(m, locale));
const hadithSlugs = ['hospitality-three-days', 'salam-spread-peace', 'gifts-bring-love', 'support-brother-oppressed', 'mothers-thrice-right', 'orphan-paradise-neighbour', 'sabr-best-gift', 'richness-of-soul'];
const hadith = hadithSlugs.map((s) => sahihBySlug(s)).filter(Boolean).map((h: any) => localizeHadees(h, locale, 'sahih'));
const guideSlugs = ['parenting-tarbiyah-guide', 'marital-rights-conflict', 'hijab-ruling-evidence'];
const guides = guideSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean).map((g: any) => localizeGuide(g, locale));
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/adab/' },
];
---
<BaseLayout title={T.hubTitle} description={T.hubDesc} keywords={T.hubKw} locale={locale} type="collection" faq={T.hubFaq} crumbs={crumbs} canonicalPath="/adab/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badge1}</span>
        <span class="hn-badge">{T.badge2}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secDuas} title={T.secDuasT} href={L('/duas/')} linkLabel={T.allDuas} />
      <div class="grid gap-3 sm:grid-cols-2">
        {duaCats.map((c: any) => (
          <a href={L(`/duas/${c.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="duas" size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block leading-6">{c.title} <span class="text-xs font-bold" style="color:var(--hn-muted)">({c.n})</span></span>
              <span class="text-[13px] leading-5 block mt-0.5 line-clamp-2" style="color:var(--hn-muted)">{c.desc}</span>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secMean} title={T.secMeanT} href={L('/meanings/')} linkLabel={T.allMean} />
      <div class="grid gap-3 sm:grid-cols-2">
        {meanings.map((m: any) => (
          <a href={L(`/meanings/${m.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{m.term}</span>
            <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{m.definition}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secHadith} title={T.secHadithT} href={L('/hadees/')} linkLabel={T.allHadees} />
      <div class="grid gap-3 sm:grid-cols-2">
        {hadith.map((h: any) => (
          <a href={L(`/hadees/${h.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{h.title}</span>
            <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{h.translation}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secGuides} title={T.secGuidesT} href={L('/learn/')} linkLabel={T.allGuides} />
      <div class="grid gap-3 sm:grid-cols-2">
        {guides.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {T.hubFaq.map((f: any) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
