---
/* Onboarding wizard — Quranly screens 8–15 adapted, 100% free.
 * Requires login (opens AuthModal for guests). Saves to
 * /api/me/prefs with onboarded=1, then goes to /tools/read/.
 */
import AuthModal from './AuthModal.astro';
import { localizedPath } from '../i18n/utils';

interface Props { locale: string; }
const { locale } = Astro.props;
const readUrl = localizedPath(locale, '/tools/read/');
---
<div class="max-w-2xl mx-auto px-4 py-8" data-onboard>
  <div class="text-center">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-brand-300">🌱 Build your Quran habit</p>
    <h1 class="text-3xl md:text-4xl font-extrabold text-white mt-2">Let's set up your plan</h1>
    <p class="mt-2 text-ink-300 text-[15px]">Free forever. Takes a minute.</p>
    <div class="h-2 bg-white/10 rounded-full overflow-hidden mt-5"><div data-ob-bar class="h-full bg-gradient-to-r from-brand-500 to-gold-300 rounded-full transition-all" style="width:14%"></div></div>
    <p data-ob-step class="mt-2 text-xs font-bold text-ink-500">Step 1 of 7</p>
  </div>

  {/* STEP 1 — daily goal */}
  <section data-ob-step-pane="0" class="mt-6">
    <h2 class="text-xl font-extrabold text-white text-center">Your daily goal</h2>
    <div class="grid grid-cols-2 gap-3 mt-4" data-ob-goal>
      {[1, 3, 5, 10].map((n) => (
        <button data-val={n} class={`rounded-2xl p-5 text-center border-2 transition min-h-[96px] ${n === 1 ? 'bg-brand-500/20 border-brand-500 text-white' : 'bg-night-850 border-white/10 text-white hover:border-brand-400/60'}`}>
          <span class="block text-3xl font-extrabold">{n}</span>
          <span class="block text-sm text-ink-300 mt-1">{n === 1 ? 'Verse per day' : 'Verses per day'}</span>
        </button>
      ))}
    </div>
    <div class="mt-4 border-2 border-dashed border-brand-500/60 rounded-2xl p-5 text-center">
      <div class="text-3xl">💗</div>
      <p class="mt-2 text-[15px] text-ink-200 leading-7">The <b>most</b> beloved deed to Allah is that which is <b>regular and constant even if it is little</b>.</p>
    </div>
  </section>

  {/* STEP 2 — streak goal */}
  <section data-ob-step-pane="1" class="mt-6 hidden">
    <h2 class="text-xl font-extrabold text-white">Set a streak goal!</h2>
    <p class="mt-1 text-ink-300 text-[15px]">Challenge yourself — miss one day and grace saves you; miss two and it resets.</p>
    <div class="mt-4 space-y-3" data-ob-streak>
      {[[3, 'Baby steps'], [7, 'Strong start'], [14, 'Clearly committed'], [30, 'Unstoppable streak']].map(([n, label]) => (
        <button data-val={n} class={`w-full flex items-center justify-between rounded-2xl px-5 py-4 min-h-[60px] border-2 transition font-bold ${n === 7 ? 'bg-brand-500/20 border-brand-500 text-white' : 'bg-night-850 border-white/10 text-white hover:border-brand-400/60'}`}>
          <span class="text-lg">{n} days</span><span class="text-sm text-ink-300">{label}</span>
        </button>
      ))}
    </div>
  </section>

  {/* STEP 3 — font sizes */}
  <section data-ob-step-pane="2" class="mt-6 hidden">
    <h2 class="text-xl font-extrabold text-white text-center">Font size</h2>
    <p class="text-center text-sm font-bold text-ink-300 mt-3">Quranic Script</p>
    <p data-ob-prev-ar class="font-arabic text-center mt-2 text-white" style="font-size:2rem" lang="ar" dir="rtl">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
    <input data-ob-fs="font_size_script" type="range" min="1.25" max="3.5" step="0.25" value="2" class="w-full accent-brand-500 mt-2" aria-label="Quranic script size" />
    <p class="text-center text-sm font-bold text-ink-300 mt-5">Translation</p>
    <p data-ob-prev-en class="text-center mt-2 text-ink-200" style="font-size:1rem">In the Name of Allah — the Most Compassionate, Most Merciful.</p>
    <input data-ob-fs="font_size_translation" type="range" min="0.875" max="1.5" step="0.125" value="1" class="w-full accent-brand-500 mt-2" aria-label="Translation size" />
    <p class="text-center text-sm font-bold text-ink-300 mt-5">Transliteration</p>
    <p data-ob-prev-tr class="text-center mt-2 text-ink-300 italic" style="font-size:1rem">Bismi Allahi arrahmani arraheem</p>
    <input data-ob-fs="font_size_translit" type="range" min="0.875" max="1.5" step="0.125" value="1" class="w-full accent-brand-500 mt-2" aria-label="Transliteration size" />
  </section>

  {/* STEP 4 — reciter */}
  <section data-ob-step-pane="3" class="mt-6 hidden">
    <h2 class="text-xl font-extrabold text-white text-center">Choose a voice</h2>
    <p class="text-center text-ink-300 text-sm mt-1">Speed of reciter</p>
    <input data-ob-speed type="range" min="0.5" max="1.5" step="0.25" value="1" class="w-full accent-brand-500 mt-3" aria-label="Recitation speed" />
    <p class="text-center text-sm font-bold text-ink-200"><span data-ob-speedval>1×</span> speed</p>
    <div class="mt-4 space-y-2.5" data-ob-reciter>
      <button data-val="Alafasy_128kbps" class="w-full text-left rounded-2xl px-5 py-4 min-h-[60px] bg-brand-500/20 border-2 border-brand-500 font-bold text-white">Sheikh Mishary Al Afasy <span class="block text-xs font-normal text-ink-300">Word-by-word audio • default</span></button>
    </div>
    <p class="mt-3 text-xs text-ink-500 leading-5">More reciters (Maher Muaiqly, Sudais, Shuraym…) unlock after we verify their audio feeds — your choice here applies everywhere automatically.</p>
  </section>

  {/* STEP 5 — translation */}
  <section data-ob-step-pane="4" class="mt-6 hidden">
    <h2 class="text-xl font-extrabold text-white text-center">Choose a translation</h2>
    <div class="mt-4 space-y-2.5" data-ob-trans>
      {[['ur', 'Urdu — Fateh Muhammad Jalandhry'], ['en', 'English — Dr. Mustafa Khattab'], ['hi', 'Hindi — Suhel Farooq Khan']].map(([v, label]) => (
        <button data-val={v} class={`w-full text-left rounded-2xl px-5 py-4 min-h-[60px] border-2 transition font-bold text-white ${v === 'ur' ? 'bg-brand-500/20 border-brand-500' : 'bg-night-850 border-white/10 hover:border-brand-400/60'}`}>{label}</button>
      ))}
    </div>
  </section>

  {/* STEP 6 — reminders */}
  <section data-ob-step-pane="5" class="mt-6 hidden">
    <h2 class="text-xl font-extrabold text-white text-center">Daily reminder</h2>
    <p class="text-center text-ink-300 text-sm mt-1">People with reminders are 3× more likely to read daily.</p>
    <div class="grid grid-cols-2 gap-3 mt-4" data-ob-time>
      {['09:00', '12:00', '15:00', '18:00'].map((t) => (
        <button data-val={t} class="rounded-2xl px-4 py-4 min-h-[60px] bg-night-850 border-2 border-white/10 hover:border-brand-400/60 font-extrabold text-white transition">{t}</button>
      ))}
    </div>
    <label class="mt-4 flex items-center gap-3 bg-night-850 border border-white/10 rounded-2xl px-4 py-3.5 cursor-pointer">
      <input data-ob-second type="checkbox" class="w-5 h-5 accent-brand-500" />
      <span class="text-sm font-bold text-ink-200">Second reminder if I forget?</span>
    </label>
    <label class="mt-3 flex items-center gap-3 bg-night-850 border border-white/10 rounded-2xl px-4 py-3.5 cursor-pointer">
      <input data-ob-alerts type="checkbox" checked class="w-5 h-5 accent-brand-500" />
      <span class="text-sm font-bold text-ink-200">Allow reading alerts on this device</span>
    </label>
  </section>

  {/* STEP 7 — done */}
  <section data-ob-step-pane="6" class="mt-6 hidden text-center">
    <div class="text-6xl">🎉</div>
    <h2 class="text-2xl font-extrabold text-white mt-3">Your plan is ready!</h2>
    <p data-ob-summary class="mt-2 text-ink-300 leading-7 text-[15px]"></p>
    <p class="mt-3 text-xs text-ink-500">Sit tight — saving your personalised Quran plan…</p>
  </section>

  <div class="mt-6 flex gap-3">
    <button data-ob-back class="px-5 rounded-2xl border-2 border-white/15 text-ink-200 font-bold min-h-[56px] hover:border-brand-400 invisible">← Back</button>
    <button data-ob-next class="flex-1 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl py-3.5 min-h-[56px]">Continue →</button>
  </div>
</div>

<AuthModal />

<script define:vars={{ readUrl }}>
  (() => {
    const root = document.querySelector('[data-onboard]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const panes = [...root.querySelectorAll('[data-ob-step-pane]')];
    const bar = root.querySelector('[data-ob-bar]');
    const stepLbl = root.querySelector('[data-ob-step]');
    const backBtn = root.querySelector('[data-ob-back]');
    const nextBtn = root.querySelector('[data-ob-next]');
    let step = 0;
    const state = { daily_goal: 1, streak_goal: 7, reciter: 'Alafasy_128kbps' };

    const pick = (sel, key) => {
      const box = root.querySelector(sel);
      box?.querySelectorAll('[data-val]').forEach((b) => b.addEventListener('click', () => {
        box.querySelectorAll('[data-val]').forEach((x) => {
          x.classList.remove('bg-brand-500/20', 'border-brand-500');
          if (!x.classList.contains('border-white/10')) x.classList.add('bg-night-850', 'border-white/10');
        });
        b.classList.add('bg-brand-500/20', 'border-brand-500');
        b.classList.remove('bg-night-850', 'border-white/10');
        state[key] = isNaN(+b.dataset.val) ? b.dataset.val : +b.dataset.val;
      }));
    };
    pick('[data-ob-goal]', 'daily_goal');
    pick('[data-ob-streak]', 'streak_goal');
    pick('[data-ob-reciter]', 'reciter');
    pick('[data-ob-trans]', 'translation');
    pick('[data-ob-time]', 'reminder_time');

    root.querySelectorAll('[data-ob-fs]').forEach((r) => r.addEventListener('input', () => {
      const map = { font_size_script: '[data-ob-prev-ar]', font_size_translation: '[data-ob-prev-en]', font_size_translit: '[data-ob-prev-tr]' };
      const el = root.querySelector(map[r.dataset.obFs]);
      if (el) el.style.fontSize = `${r.value}rem`;
    }));
    const speed = root.querySelector('[data-ob-speed]');
    speed?.addEventListener('input', () => {
      const v = root.querySelector('[data-ob-speedval]');
      if (v) v.textContent = `${speed.value}×`;
    });

    const paint = () => {
      panes.forEach((p, i) => p.classList.toggle('hidden', i !== step));
      if (bar) bar.style.width = `${((step + 1) / panes.length) * 100}%`;
      if (stepLbl) stepLbl.textContent = `Step ${step + 1} of ${panes.length}`;
      backBtn?.classList.toggle('invisible', step === 0 || step === panes.length - 1);
      if (nextBtn) nextBtn.textContent = step === panes.length - 2 ? 'Build my plan →' : step === panes.length - 1 ? 'Saving…' : 'Continue →';
      if (step === panes.length - 1) finish();
    };

    const collect = () => ({
      daily_goal: state.daily_goal || 1,
      streak_goal: state.streak_goal || 7,
      font_size_script: +(root.querySelector('[data-ob-fs="font_size_script"]')?.value || 2),
      font_size_translation: +(root.querySelector('[data-ob-fs="font_size_translation"]')?.value || 1),
      font_size_translit: +(root.querySelector('[data-ob-fs="font_size_translit"]')?.value || 1),
      reciter: state.reciter || 'Alafasy_128kbps',
      reciter_speed: +(speed?.value || 1),
      translation: root.querySelector('[data-ob-trans] .border-brand-500')?.dataset.val || 'ur',
      reminder_time: root.querySelector('[data-ob-time] .border-brand-500')?.dataset.val || null,
      second_reminder: root.querySelector('[data-ob-second]')?.checked ? 1 : 0,
      alerts_on: root.querySelector('[data-ob-alerts]')?.checked ? 1 : 0,
      onboarded: 1,
    });

    const finish = async () => {
      if (nextBtn) nextBtn.disabled = true;
      const prefs = collect();
      const sum = root.querySelector('[data-ob-summary]');
      if (sum) sum.textContent = `${prefs.daily_goal} verse${prefs.daily_goal > 1 ? 's' : ''} a day • ${prefs.streak_goal}-day streak goal${prefs.reminder_time ? ` • reminder at ${prefs.reminder_time}` : ''}.`;
      try {
        const { Auth, Me } = await import('/habits/habit.js?v=3');
        const { user } = await Auth.session();
        if (!user) { window.hnAuthModal?.open(); if (nextBtn) nextBtn.disabled = false; step = panes.length - 2; paint(); return; }
        if (prefs.alerts_on && 'Notification' in window && Notification.permission === 'default') {
          try { await Notification.requestPermission(); } catch {}
        }
        await Me.savePrefs(prefs);
        window.location.href = readUrl;
      } catch {
        if (nextBtn) { nextBtn.disabled = false; nextBtn.textContent = 'Retry →'; }
        step = panes.length - 2; paint();
      }
    };

    backBtn?.addEventListener('click', () => { if (step > 0) { step -= 1; paint(); } });
    nextBtn?.addEventListener('click', async () => {
      if (step === panes.length - 1) return;
      // Gate every step behind login (compulsory).
      try {
        const { Auth } = await import('/habits/habit.js?v=3');
        const { user } = await Auth.session();
        if (!user) { window.hnAuthModal?.open(); return; }
      } catch { window.hnAuthModal?.open(); return; }
      step += 1; paint();
      if (step < panes.length) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.addEventListener('hn:auth', () => { step += 1; paint(); });
    paint();
  })();
</script>
