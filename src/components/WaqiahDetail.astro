---
/* Waqiah detail — narrative reading page in the unified system. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import WaqiahArt from './WaqiahArt.astro';
import BookmarkButton from './hn/BookmarkButton.astro';
import ShareButtons from './hn/ShareButtons.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { WAQIAT } from '../data/waqiat';
import { localizeStory, localizeStoryList } from '../lib/stories-i18n';
import { storyUI } from '../lib/dua-ui-i18n';

interface Props { waqiah: any; locale: string; }
const { locale } = Astro.props;
const waqiah = localizeStory((Astro.props as any).waqiah, 'waqiat', locale);
const dict = getDict(locale);
const S = storyUI(locale);
const L = (p: string) => localizedPath(locale, p);
const waqiahPath = `/waqiat/${waqiah.slug}/`;

const title = `${waqiah.title}${S.detailSuffix}`;
let description = `${waqiah.title}: ${waqiah.summary}`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${waqiah.title.toLowerCase()}, ${waqiah.prophet.toLowerCase()}, ${waqiah.quranRef.toLowerCase()}${waqiah.aliases?.length ? `, ${waqiah.aliases.join(', ')}` : ''}`;

const faq = [
  { q: S.whatQ.replace('{p}', waqiah.prophet), a: waqiah.summary },
  { q: S.lessonQ.replace('{p}', waqiah.prophet), a: waqiah.lessons.map((l: string, i: number) => `${i + 1}. ${l}`).join(' ') },
  { q: S.whereQ, a: S.whereA.replace('{r}', waqiah.quranRef) },
  { q: S.structQ, a: S.structA.replace('{e}', String(waqiah.events.length)).replace('{l}', String(waqiah.lessons.length)) },
  { q: S.nextQ, a: S.nextA },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: dict.nav.waqiat, path: '/waqiat/' },
  { name: waqiah.title, path: waqiahPath },
];
const WL = localizeStoryList(WAQIAT, 'waqiat', locale);
const others = WL.filter((w) => w.slug !== waqiah.slug).slice(0, 4);
const sIdx = WL.findIndex((w) => w.slug === waqiah.slug);
const prevW = sIdx > 0 ? WL[sIdx - 1] : null;
const nextW = sIdx >= 0 && sIdx < WL.length - 1 ? WL[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={waqiahPath}>
  <div class="hn-article hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{waqiah.prophet}</span>
      <span class="ms-auto"><BookmarkButton kind="waqiah" bmRef={waqiahPath} title={waqiah.title} locale={locale} /></span>
      <ShareButtons title={waqiah.title} path={waqiahPath} locale={locale} />
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{waqiah.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{waqiah.summary}</p>
    {waqiah.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">{S.alsoSearched} {waqiah.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="hn-card overflow-hidden my-6">
      <WaqiahArt motif={waqiah.motif} arabic={waqiah.arabic} prophet={waqiah.prophet} accent={waqiah.accent} />
    </div>

    <div class="hn-reading-card">
      <p class="hn-block-label">{S.emblemLabel}</p>
      <p class="arabic-block" lang="ar" dir="rtl">{waqiah.arabic}</p>
      {waqiah.translit && (
        <>
          <hr class="hn-divider" />
          <p class="hn-block-label">{S.translitLabel}</p>
          <p class="translit-block">{waqiah.translit}</p>
        </>
      )}
    </div>

    <section class="mt-8" aria-label={S.secStory}>
      <SectionHeader eyebrow={S.secStory} title={S.secStoryTitle} />
      <div class="space-y-4">
        {(waqiah.narrative || []).map((p: string) => (
          <p class="hn-card hn-card-pad leading-8 text-[15px]">{p}</p>
        ))}
      </div>
      <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">{S.narratedNote.replace('{r}', waqiah.quranRef)}</p>
    </section>

    <section class="mt-8" aria-label={S.secTimeline}>
      <SectionHeader eyebrow={S.secTimeline} title={S.timelineTitle} />
      <ol class="space-y-3">
        {waqiah.events.map((e: string, i: number) => (
          <li class="hn-card hn-card-pad flex gap-3">
            <span class="hn-verse-num shrink-0">{i + 1}</span>
            <span class="leading-7 text-[15px]">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-label={S.lessonsTitle}>
      <SectionHeader eyebrow={S.secReflect} title={S.lessonsTitle} />
      <div class="hn-card hn-card-pad">
        <ul class="space-y-2.5 leading-7 text-[15px]">
          {waqiah.lessons.map((l: string) => <li class="flex items-start gap-2.5"><span style="color:var(--hn-gold)" class="font-extrabold">✦</span><span>{l}</span></li>)}
        </ul>
      </div>
    </section>
    <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">{S.refLabel} <strong style="color:var(--hn-ink)">{waqiah.quranRef}</strong></p>
    <p class="mt-1 text-[13px]" style="color:var(--hn-muted)">{S.consultNote}</p>

    <section class="mt-8" aria-label={S.faqTitle2}>
      <SectionHeader eyebrow={S.secFaq} title={S.faqTitle2} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label={S.moreTitle}>
      <SectionHeader eyebrow={S.secStories2} title={S.moreTitle} href={L('/waqiat/')} linkLabel={S.moreLink} />
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={L(`/waqiat/${r.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <WaqiahArt motif={r.motif} arabic={r.arabic} prophet={r.prophet} accent={r.accent} />
            <span class="block hn-card-pad">
              <span class="font-bold block text-[15px] leading-6">{r.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {(prevW || nextW) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More stories">
        {prevW ? (
          <a href={L(`/waqiat/${prevW.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{S.prevLabel}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevW.title}</span>
          </a>
        ) : <span />}
        {nextW && (
          <a href={L(`/waqiat/${nextW.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{S.nextLabel}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextW.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
