---
/* Waqiah detail — narrative reading page in the unified system. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import WaqiahArt from './WaqiahArt.astro';
import BookmarkButton from './hn/BookmarkButton.astro';
import ShareButtons from './hn/ShareButtons.astro';
import { localizedPath } from '../i18n/utils';
import { WAQIAT } from '../data/waqiat';

interface Props { waqiah: any; locale: string; }
const { waqiah, locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const waqiahPath = `/waqiat/${waqiah.slug}/`;

const title = `${waqiah.title} — Story & Lessons`;
let description = `${waqiah.title}: ${waqiah.summary} References: ${waqiah.quranRef}.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${waqiah.title.toLowerCase()}, ${waqiah.prophet.toLowerCase()} story, prophet stories islam${waqiah.aliases?.length ? `, ${waqiah.aliases.join(', ')}` : ''}`;

const faq = [
  { q: `What happened in the story of ${waqiah.prophet}?`, a: waqiah.summary },
  { q: `What are the lessons from ${waqiah.prophet}’s story?`, a: waqiah.lessons.map((l: string, i: number) => `${i + 1}. ${l}`).join(' ') },
  { q: `Where is this story in the Quran?`, a: `References: ${waqiah.quranRef}. Read the verses with translation; consult scholars for deeper rulings.` },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Waqiat', path: '/waqiat/' },
  { name: waqiah.title, path: waqiahPath },
];
const others = WAQIAT.filter((w) => w.slug !== waqiah.slug).slice(0, 4);
const sIdx = WAQIAT.findIndex((w) => w.slug === waqiah.slug);
const prevW = sIdx > 0 ? WAQIAT[sIdx - 1] : null;
const nextW = sIdx >= 0 && sIdx < WAQIAT.length - 1 ? WAQIAT[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={waqiahPath}>
  <div class="hn-article hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{waqiah.prophet}</span>
      <span class="ms-auto"><BookmarkButton kind="waqiah" bmRef={waqiahPath} title={waqiah.title} /></span>
      <ShareButtons title={waqiah.title} path={waqiahPath} locale={locale} />
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{waqiah.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{waqiah.summary}</p>
    {waqiah.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">Also searched as: {waqiah.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="hn-card overflow-hidden my-6">
      <WaqiahArt motif={waqiah.motif} arabic={waqiah.arabic} prophet={waqiah.prophet} accent={waqiah.accent} />
    </div>

    <div class="hn-reading-card">
      <p class="hn-block-label">Emblematic verse</p>
      <p class="arabic-block" lang="ar" dir="rtl">{waqiah.arabic}</p>
      {waqiah.translit && (
        <>
          <hr class="hn-divider" />
          <p class="hn-block-label">Transliteration</p>
          <p class="translit-block">{waqiah.translit}</p>
        </>
      )}
    </div>

    <section class="mt-8" aria-label="The full story">
      <SectionHeader eyebrow="Story" title="The full story" />
      <div class="space-y-4">
        {(waqiah.narrative || []).map((p: string) => (
          <p class="hn-card hn-card-pad leading-8 text-[15px]">{p}</p>
        ))}
      </div>
      <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">Narrated strictly from the Quran ({waqiah.quranRef}) without invented details.</p>
    </section>

    <section class="mt-8" aria-label="The story in order">
      <SectionHeader eyebrow="Timeline" title="The story in order" />
      <ol class="space-y-3">
        {waqiah.events.map((e: string, i: number) => (
          <li class="hn-card hn-card-pad flex gap-3">
            <span class="hn-verse-num shrink-0">{i + 1}</span>
            <span class="leading-7 text-[15px]">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-label="Lessons">
      <SectionHeader eyebrow="Reflect" title="Lessons" />
      <div class="hn-card hn-card-pad">
        <ul class="space-y-2.5 leading-7 text-[15px]">
          {waqiah.lessons.map((l: string) => <li class="flex items-start gap-2.5"><span style="color:var(--hn-gold)" class="font-extrabold">✦</span><span>{l}</span></li>)}
        </ul>
      </div>
    </section>
    <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">References: <strong style="color:var(--hn-ink)">{waqiah.quranRef}</strong></p>
    <p class="mt-1 text-[13px]" style="color:var(--hn-muted)">Narrated from the Quran without invented details; consult scholars for rulings.</p>

    <section class="mt-8" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label="More stories">
      <SectionHeader eyebrow="Stories" title="More stories" href={L('/waqiat/')} linkLabel="All stories" />
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={L(`/waqiat/${r.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <WaqiahArt motif={r.motif} arabic={r.arabic} prophet={r.prophet} accent={r.accent} />
            <span class="block hn-card-pad">
              <span class="font-bold block text-[15px] leading-6">{r.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {(prevW || nextW) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More stories">
        {prevW ? (
          <a href={L(`/waqiat/${prevW.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">← Previous story</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevW.title}</span>
          </a>
        ) : <span />}
        {nextW && (
          <a href={L(`/waqiat/${nextW.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">Next story →</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextW.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
