---
/* Waqiah detail page (EN + locale). Narrative + lessons. Auto FAQ + crumbs. */
import BaseLayout from '../layouts/BaseLayout.astro';
import WaqiahArt from './WaqiahArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { WAQIAT } from '../data/waqiat';

interface Props { waqiah: any; locale: string; }
const { waqiah, locale } = Astro.props;
const dict = getDict(locale);
const isFallback = locale !== 'en';
const waqiahPath = `/waqiat/${waqiah.slug}/`;

const title = `${waqiah.title} — Story & Lessons`;
let description = `${waqiah.title}: ${waqiah.summary} References: ${waqiah.quranRef}.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${waqiah.title.toLowerCase()}, ${waqiah.prophet.toLowerCase()} story, prophet stories islam${waqiah.aliases?.length ? `, ${waqiah.aliases.join(', ')}` : ''}`;

const faq = [
  { q: `What happened in the story of ${waqiah.prophet}?`, a: waqiah.summary },
  { q: `What are the lessons from ${waqiah.prophet}’s story?`, a: waqiah.lessons.map((l: string, i: number) => `${i + 1}. ${l}`).join(' ') },
  { q: `Where is this story in the Quran?`, a: `References: ${waqiah.quranRef}. Read the verses with translation; consult scholars for deeper rulings.` },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Waqiat', path: '/waqiat/' },
  { name: waqiah.title, path: waqiahPath },
];
const others = WAQIAT.filter((w) => w.slug !== waqiah.slug).slice(0, 4);
const sIdx = WAQIAT.findIndex((w) => w.slug === waqiah.slug);
const prevW = sIdx > 0 ? WAQIAT[sIdx - 1] : null;
const nextW = sIdx >= 0 && sIdx < WAQIAT.length - 1 ? WAQIAT[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={waqiahPath}>
  <div class="max-w-3xl mx-auto px-4 py-6 md:py-8">
    <nav class="text-xs text-ink-500 mb-3">
      <a href={localizedPath(locale, '/')} class="hover:text-brand-300">{dict.nav.home}</a> /
      <a href={localizedPath(locale, '/waqiat/')} class="hover:text-brand-300"> {dict.nav.waqiat}</a> /
      <span> {waqiah.title}</span>
    </nav>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[11px] font-extrabold uppercase tracking-wide text-brand-300 bg-brand-500/15 px-2.5 py-1 rounded-full">📜 {waqiah.prophet}</span>
      {isFallback && <span class="text-[11px] font-extrabold uppercase tracking-wide text-night-900 bg-gold-300 px-2.5 py-1 rounded-full">EN</span>}
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3 text-white">{waqiah.title}</h1>
    <p class="mt-2 text-ink-300 leading-7">{waqiah.summary}</p>
    {waqiah.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] text-ink-500 leading-6">Also searched as: {waqiah.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold text-ink-300">{a}</em></span>
      ))}</p>
    )}
    {isFallback && <p class="mt-4 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3">English guide — translation coming soon.</p>}

    <div class="rounded-3xl overflow-hidden my-6 shadow-xl shadow-black/30 border border-white/10">
      <WaqiahArt motif={waqiah.motif} arabic={waqiah.arabic} prophet={waqiah.prophet} accent={waqiah.accent} />
    </div>

    <div class="bg-night-850 border border-white/10 text-white rounded-3xl p-6 md:p-8 shadow-xl shadow-black/30 relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 88% 8%, rgba(139,124,246,.3), transparent 45%), radial-gradient(circle at 5% 95%, rgba(212,175,55,.12), transparent 40%);"></div>
      <div class="relative">
        <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-gold-300 mb-3">Emblematic verse</div>
        <p class="arabic-block leading-[2.2]" lang="ar" dir="rtl">{waqiah.arabic}</p>
        <p class="mt-4 text-ink-200 italic leading-7 text-[15px]">{waqiah.translit}</p>
      </div>
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">📜 The full story</h2>
      <div class="space-y-4">
        {(waqiah.narrative || []).map((p: string) => (
          <p class="bg-night-850 border border-white/10 rounded-2xl p-5 shadow-lg shadow-black/20 leading-8 text-[15px] text-ink-200">{p}</p>
        ))}
      </div>
      <p class="mt-3 text-xs text-ink-500">📚 Narrated strictly from the Quran ({waqiah.quranRef}) without invented details.</p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">🗂️ The story in order</h2>
      <ol class="space-y-3">
        {waqiah.events.map((e: string, i: number) => (
          <li class="bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/20 flex gap-3">
            <span class="w-8 h-8 shrink-0 grid place-items-center rounded-xl bg-brand-500/15 text-brand-300 font-extrabold text-sm">{i + 1}</span>
            <span class="leading-7 text-[15px] text-ink-200">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">💡 Lessons</h2>
      <div class="bg-night-850 border border-gold-300/30 rounded-2xl p-5 shadow-lg shadow-black/20">
        <ul class="space-y-2.5 leading-7 text-[15px] text-ink-200">
          {waqiah.lessons.map((l: string) => <li class="flex items-start gap-2.5"><span class="text-gold-300 font-extrabold">✦</span><span>{l}</span></li>)}
        </ul>
      </div>
    </section>
    <p class="mt-3 text-xs text-ink-500">📚 References: <b>{waqiah.quranRef}</b></p>
    <p class="mt-2 text-xs text-ink-500">Narrated from the Quran without invented details; consult scholars for rulings.</p>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">❓ Frequently asked questions</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/30">
            <summary class="font-bold cursor-pointer leading-6 text-ink-50">{f.q}</summary>
            <p class="mt-2 text-ink-300 leading-7 text-[15px]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold mb-3 text-white">📜 More stories</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={localizedPath(locale, `/waqiat/${r.slug}/`)} class="group bg-night-850 border border-white/10 rounded-2xl overflow-hidden shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 transition">
            <WaqiahArt motif={r.motif} arabic={r.arabic} prophet={r.prophet} accent={r.accent} />
            <span class="block p-4">
              <span class="font-bold block text-[15px] leading-6 text-ink-50 group-hover:text-brand-300">{r.title}</span>
              <span class="text-[13px] text-ink-300 line-clamp-2">{r.summary}</span>
            </span>
          </a>
        ))}
      </div>
      <a href={localizedPath(locale, '/waqiat/')} class="mt-4 inline-flex items-center gap-2 text-sm font-extrabold text-brand-300 hover:text-brand-200">All stories →</a>
    </section>

    {(prevW || nextW) && (
      <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="More stories">
        {prevW ? (
          <a href={localizedPath(locale, `/waqiat/${prevW.slug}/`)} class="group bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 transition">
            <span class="text-xs font-bold text-ink-500">← Previous story</span>
            <span class="font-bold block text-[15px] leading-6 text-ink-50 group-hover:text-brand-300">{prevW.title}</span>
          </a>
        ) : <span />}
        {nextW && (
          <a href={localizedPath(locale, `/waqiat/${nextW.slug}/`)} class="group bg-night-850 border border-white/10 rounded-2xl p-4 text-right shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 transition">
            <span class="text-xs font-bold text-ink-500">Next story →</span>
            <span class="font-bold block text-[15px] leading-6 text-ink-50 group-hover:text-brand-300">{nextW.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
