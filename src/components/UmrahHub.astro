---
/* Umrah hub — dedicated Umrah gateway: steps, duas, Ramadan-Umrah hadith,
 * quiz and cross-links (EN + locale). All content verified in-repo. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { GUIDES } from '../data/guides';
import { DUAS } from '../data/duas';
import { quizBySlug } from '../data/quizzes';
import { sahihBySlug } from '../data/hadees-sahih';
import { localizeGuide } from '../lib/guides-i18n';
import { localizeDua } from '../lib/duas-i18n';
import { localizeQuiz, localizeHadees } from '../lib/content-i18n';
import { secUI } from '../lib/site-ui-1';
import { UMRAH_UI } from '../lib/site-ui-4';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, UMRAH_UI);
const L = (p: string) => localizedPath(locale, p);

const stepSlugs = ['umrah-day-plan', 'ihram-how-to', 'tawaf-how-to', 'sai-how-to', 'hajj-umrah-basics', 'umrah-kids-elderly-nusuk', 'hajj-umrah-badal-deceased'];
const steps = stepSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean).map((g: any) => localizeGuide(g, locale));
const duas = ['talbiyah', 'ihram-niyyah', 'tawaf-corner', 'safa-marwa-dhikr', 'zamzam-dua', 'kaaba-sight-dua'].map((s) => DUAS.find((d) => d.slug === s)).filter(Boolean).map((d: any) => localizeDua(d, locale));
const quiz = (() => { const q = quizBySlug('hajj-quiz'); return q ? localizeQuiz(q, locale) : null; })();
const hadees = (() => { const h = sahihBySlug('umrah-ramadan-hajj'); return h ? localizeHadees(h, locale, 'sahih') : null; })();
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/umrah/' },
];
---
<BaseLayout title={T.hubTitle} description={T.hubDesc} keywords={T.hubKw} locale={locale} type="article" faq={T.hubFaq} crumbs={crumbs} canonicalPath="/umrah/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badge1}</span>
        <span class="hn-badge">{T.badge2}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{T.crossHajjL} <a href={L('/hajj/')} class="font-bold" style="color:var(--hn-primary)">{T.crossHajj}</a></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/learn/duties/umrah-day-plan/')} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">{T.btnPlan}</a>
        <a href={L('/hajj/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">{T.btnHajj}</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secSteps} title={T.secStepsT} href={L('/learn/')} linkLabel={T.allGuides} />
      <div class="grid gap-3 sm:grid-cols-2">
        {steps.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secDuas} title={T.secDuasT} href={L('/duas/hajj-umrah/')} linkLabel={T.duasLink} />
      <div class="grid gap-3 sm:grid-cols-2">
        {duas.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{d.use}</span>
          </a>
        ))}
      </div>
    </div>

    {hadees && (
      <div class="mt-8">
        <SectionHeader eyebrow={T.secHadith} title={T.secHadithT} href={L('/hadees/')} linkLabel={T.secHadith} />
        <div class="grid gap-3 sm:grid-cols-2">
          <a href={L(`/hadees/${hadees.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{hadees.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{hadees.translation}</span>
          </a>
        </div>
      </div>
    )}

    {quiz && (
      <div class="mt-8">
        <SectionHeader eyebrow={T.secQuiz} title={T.secQuizT} href={L('/quiz/')} linkLabel={T.quizLink} />
        <div class="grid gap-3 sm:grid-cols-2">
          <a href={L(`/quiz/${quiz.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{quiz.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{quiz.desc}</span>
          </a>
        </div>
      </div>
    )}

    <section class="mt-8 max-w-3xl" aria-label={T.faqTitle}>
      <SectionHeader eyebrow="FAQ" title={T.faqTitle} />
      <div class="space-y-3">
        {T.hubFaq.map((f: any) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
