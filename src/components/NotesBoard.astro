---
/* Personal Notes — private per-user notes (text + optional reference).
 * Uses /api/me/notes directly (no habit.js change needed).
 */
import { localizedPath, getDict } from '../i18n/utils';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = getDict(locale).app;
const n = t.notes;
const profileUrl = localizedPath(locale, '/profile/');
---

<div class="max-w-md mx-auto px-4 py-5" data-notes>
  <div data-n-loading class="animate-pulse space-y-3">
    <div class="h-32 bg-night-850 border border-white/10 rounded-3xl"></div>
    <div class="h-24 bg-night-850 border border-white/10 rounded-3xl"></div>
  </div>

  <div data-n-gate class="hidden text-center bg-night-850 border border-white/10 rounded-3xl p-8">
    <div class="text-5xl">📝</div>
    <h1 class="text-2xl font-extrabold text-white mt-3">{n.title}</h1>
    <p class="mt-1 text-ink-300 text-[15px]">{n.emptyD}</p>
    <a href={profileUrl} class="mt-5 inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">{n.needLogin}</a>
  </div>

  <div data-n-live class="hidden space-y-3">
    <div class="bg-night-850 border border-white/10 rounded-3xl p-4">
      <textarea data-n-text rows="3" maxlength="2000" placeholder={n.addPh}
        class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[88px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 resize-y"></textarea>
      <div class="mt-2 flex gap-2">
        <input data-n-ref maxlength="40" placeholder={n.refPh}
          class="flex-1 min-w-0 bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 text-sm" />
        <button data-n-add class="shrink-0 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{n.add}</button>
      </div>
      <p data-n-formmsg class="hidden mt-2 text-xs font-bold leading-5" role="status"></p>
    </div>
    <div data-n-empty class="hidden text-center bg-night-850 border border-white/10 rounded-3xl p-8">
      <div class="text-5xl">📝</div>
      <p class="mt-3 font-extrabold text-lg text-white">{n.emptyT}</p>
      <p class="mt-1 text-sm text-ink-300">{n.emptyD}</p>
    </div>
    <div data-n-list class="space-y-2.5"></div>
    <p data-n-err class="hidden text-center text-sm font-bold text-red-300"></p>
  </div>
</div>

<script define:vars={{ tN: n, tNOk: t.settings.ok, tNCancel: t.settings.cancel, tNDel: t.settings.deleteBtn }}>
  (() => {
    const root = document.querySelector('[data-notes]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);
    let editing = 0;

    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const api = async (path, opts = {}) => {
      const res = await fetch(path, {
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        ...opts,
      });
      let data = null;
      try { data = await res.json(); } catch { /* non-JSON */ }
      if (!res.ok) {
        const err = new Error(data?.error || `request_failed_${res.status}`);
        err.code = data?.error;
        err.hint = data?.hint;
        throw err;
      }
      return data || {};
    };

    const paint = (notes) => {
      const list = $('[data-n-list]');
      const empty = $('[data-n-empty]');
      if (!list) return;
      if (!notes.length) {
        list.innerHTML = '';
        empty?.classList.remove('hidden');
        return;
      }
      empty?.classList.add('hidden');
      list.innerHTML = notes.map((x) => {
        if (x.id === editing) {
          return `
          <div class="bg-night-850 border border-brand-500/50 rounded-3xl p-4" data-n-card="${x.id}">
            <textarea data-n-etext rows="3" maxlength="2000" class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[88px] text-ink-50 outline-none focus:ring-2 ring-brand-400 resize-y">${esc(x.text)}</textarea>
            <input data-n-eref maxlength="40" value="${esc(x.ref || '')}" placeholder="${esc(tN.refPh)}" class="mt-2 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 text-sm outline-none focus:ring-2 ring-brand-400" />
            <div class="mt-2 flex gap-2">
              <button data-n-esave="${x.id}" class="flex-1 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-4 py-3 min-h-[52px]">${esc(tN.save)}</button>
              <button data-n-ecancel class="flex-1 bg-white/5 hover:bg-white/10 border border-white/15 text-ink-50 font-bold rounded-2xl px-4 py-3 min-h-[52px]">✕</button>
            </div>
          </div>`;
        }
        const when = x.updated_at ? new Date(x.updated_at * 1000).toLocaleDateString(undefined, { day: 'numeric', month: 'short' }) : '';
        return `
        <div class="bg-night-850 border border-white/10 rounded-3xl p-4" data-n-card="${x.id}">
          ${x.ref ? `<p class="inline-block text-[11px] font-extrabold text-brand-300 bg-brand-500/15 rounded-full px-2.5 py-1">${esc(x.ref)}</p>` : ''}
          <p class="mt-1.5 text-[15px] leading-7 text-ink-50 whitespace-pre-wrap">${esc(x.text)}</p>
          <div class="mt-2.5 flex items-center gap-2">
            <span class="text-[11px] font-bold text-ink-500">${esc(when)}</span>
            <span class="ms-auto flex gap-2">
              <button data-n-edit="${x.id}" class="text-xs font-extrabold text-brand-300 hover:text-brand-200 min-h-[44px] px-2">✏️</button>
              <button data-n-del="${x.id}" class="text-xs font-extrabold text-red-300 hover:text-red-200 min-h-[44px] px-2">${esc(tN.delete)}</button>
            </span>
          </div>
        </div>`;
      }).join('');
    };

    const load = async () => {
      const err = $('[data-n-err]');
      err?.classList.add('hidden');
      try {
        const d = await api('/api/me/notes');
        paint(d.notes || []);
      } catch (e) {
        if (e.code === 'notes_unavailable' || e.status === 501) {
          if (err) { err.textContent = e.hint || tN.loadFail; err.classList.remove('hidden'); }
        } else throw e;
      }
    };

    const formMsg = (ok, text) => {
      const el = $('[data-n-formmsg]');
      if (!el) return;
      el.textContent = text;
      el.classList.remove('hidden', 'text-emerald-300', 'text-red-300');
      el.classList.add(ok ? 'text-emerald-300' : 'text-red-300');
      if (ok) setTimeout(() => el.classList.add('hidden'), 2500);
    };

    $('[data-n-add]')?.addEventListener('click', async () => {
      const text = String($('[data-n-text]')?.value || '').trim();
      const ref = String($('[data-n-ref]')?.value || '').trim();
      if (!text) { formMsg(false, tN.needText); return; }
      try {
        await api('/api/me/notes', { method: 'POST', body: JSON.stringify({ text, ref }) });
        if ($('[data-n-text]')) $('[data-n-text]').value = '';
        if ($('[data-n-ref]')) $('[data-n-ref]').value = '';
        formMsg(true, tN.saved);
        await load();
      } catch (e) {
        formMsg(false, e.hint || e.message || tN.loadFail);
      }
    });

    $('[data-n-list]')?.addEventListener('click', async (e) => {
      const editBtn = e.target.closest('[data-n-edit]');
      const delBtn = e.target.closest('[data-n-del]');
      const saveBtn = e.target.closest('[data-n-esave]');
      const cancelBtn = e.target.closest('[data-n-ecancel]');
      if (editBtn) {
        editing = Number(editBtn.dataset.nEdit) || 0;
        await load();
        return;
      }
      if (cancelBtn) {
        editing = 0;
        await load();
        return;
      }
      if (saveBtn) {
        const id = Number(saveBtn.dataset.nEsave) || 0;
        const card = saveBtn.closest('[data-n-card]');
        const text = String(card?.querySelector('[data-n-etext]')?.value || '').trim();
        const ref = String(card?.querySelector('[data-n-eref]')?.value || '').trim();
        if (!text) return;
        try {
          await api('/api/me/notes', { method: 'PUT', body: JSON.stringify({ id, text, ref }) });
          editing = 0;
          await load();
        } catch {
          editing = 0;
          await load();
        }
        return;
      }
      if (delBtn) {
        const ok = window.hnConfirm
          ? await window.hnConfirm({ title: tNDel, body: tN.confirmDelete, ok: tNDel, cancel: tNCancel, danger: true })
          : confirm(tN.confirmDelete);
        if (!ok) return;
        try {
          await api(`/api/me/notes?id=${encodeURIComponent(delBtn.dataset.nDel)}`, { method: 'DELETE' });
          await load();
        } catch { /* retry silently */ }
      }
    });

    (async () => {
      try {
        const { Auth } = await import('/habits/habit.js?v=5');
        const { user } = await Auth.session().catch(() => ({ user: null }));
        $('[data-n-loading]')?.classList.add('hidden');
        if (!user) { $('[data-n-gate]')?.classList.remove('hidden'); return; }
        $('[data-n-live]')?.classList.remove('hidden');
        await load();
      } catch {
        $('[data-n-loading]')?.classList.add('hidden');
        $('[data-n-gate]')?.classList.remove('hidden');
      }
    })();
  })();
</script>
