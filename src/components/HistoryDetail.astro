---
/* History event detail — chronological reading page with own branding.
 * Prev/next by order; cross-links to Seerat for prophetic-era events. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import HistoryArt from './HistoryArt.astro';
import BookmarkButton from './hn/BookmarkButton.astro';
import ShareButtons from './hn/ShareButtons.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { HISTORY, prevHistory, nextHistory } from '../data/history';
import { localizeHistory } from '../lib/content-i18n';
import { secUI2, HISTORY_UI } from '../lib/site-ui-2';
import { secE } from '../lib/site-ui-1';
import RelatedContent from './RelatedContent.astro';
import HistoryScript from './hn/HistoryScript.astro';

interface Props { event: any; locale: string; }
const { locale } = Astro.props;
const event = localizeHistory((Astro.props as any).event, locale);
const dict = getDict(locale);
const T = secUI2(locale, HISTORY_UI);
const E = secE(locale);
const L = (p: string) => localizedPath(locale, p);
const eventPath = `/history/${event.slug}/`;

const title = `${event.title}${T.detSuffix}`;
let description = `${event.title} (${event.year}): ${event.summary}`;
if (description.length > 160) description = description.slice(0, 157) + '...';
const keywords = `${event.title.toLowerCase()}, ${event.name.toLowerCase()} islamic history, ${event.year.toLowerCase()}${event.aliases?.length ? `, ${event.aliases.join(', ')}` : ''}`;

const faq = [
  { q: T.detFaqWhat.replace('{p}', event.name), a: event.summary },
  { q: T.detFaqWhen, a: `${event.year}.` },
  { q: T.detFaqLes, a: event.lessons.map((l: string, i: number) => `${i + 1}. ${l}`).join(' ') },
  { q: T.detFaqSrc, a: `${event.references}.` },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/history/' },
  { name: event.title, path: eventPath },
];
const ERA_IDX = ['Prophetic', 'Rashidun', 'Classical', 'Later'].indexOf(event.era);
const eraL = ERA_IDX >= 0 ? T.eraNames[ERA_IDX] : event.era;
const others = HISTORY.filter((w) => w.slug !== event.slug && w.era === event.era).concat(HISTORY.filter((w) => w.slug !== event.slug && w.era !== event.era)).slice(0, 4).map((x) => localizeHistory(x, locale));
const prevP = localizeHistory(prevHistory(event.order), locale);
const nextP = localizeHistory(nextHistory(event.order), locale);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={eventPath}>
  <div class="hn-article hn-section" data-hn-history data-hn-kind="history" data-hn-ref={eventPath} data-hn-title={event.title}>
    <HistoryScript />
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{T.detPrefix.replace('{n}', String(event.order))}</span>
      <span class="hn-badge">{event.year}</span>
      <span class="hn-badge hn-badge-gold">{eraL}</span>
      <span class="ms-auto"><BookmarkButton kind="history" bmRef={eventPath} title={event.title} locale={locale} /></span>
      <ShareButtons title={event.title} path={eventPath} locale={locale} />
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{event.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{event.summary}</p>
    {event.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">{T.alsoSearched} {event.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="hn-card overflow-hidden my-6">
      <HistoryArt motif={event.motif} arabic={event.arabic} name={event.name} accent={event.accent} />
    </div>

    <div class="hn-reading-card">
      <p class="hn-block-label">{T.emblemL}</p>
      <p class="arabic-block" lang="ar" dir="rtl">{event.arabic}</p>
    </div>

    <section class="mt-8" aria-label={T.secStory}>
      <SectionHeader eyebrow={E.story} title={T.secStory} />
      <div class="space-y-4">
        {(event.narrative || []).map((p: string) => (
          <p class="hn-card hn-card-pad leading-8 text-[15px]">{p}</p>
        ))}
      </div>
      <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">{T.narratedL}</p>
    </section>

    <section class="mt-8" aria-label={T.timelineL}>
      <SectionHeader eyebrow={E.time} title={T.timelineL} />
      <ol class="space-y-3">
        {event.events.map((e: string, i: number) => (
          <li class="hn-card hn-card-pad flex gap-3">
            <span class="hn-verse-num shrink-0">{i + 1}</span>
            <span class="leading-7 text-[15px]">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-label={T.reflectL}>
      <SectionHeader eyebrow={E.refl} title={T.reflectL} />
      <div class="hn-card hn-card-pad">
        <ul class="space-y-2.5 leading-7 text-[15px]">
          {event.lessons.map((l: string) => <li class="flex items-start gap-2.5"><span style="color:var(--hn-gold)" class="font-extrabold">✦</span><span>{l}</span></li>)}
        </ul>
      </div>
    </section>
    <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">{T.refL} <strong style="color:var(--hn-ink)">{event.references}</strong></p>
    <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{T.seeratQ} <a href={L('/seerat/')} class="font-bold" style="color:var(--hn-primary)">{T.seeratA}</a></p>

    <section class="mt-8" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedContent type="history" slug={event.slug} locale={locale} />

    <section class="mt-8" aria-label={T.moreTitle}>
      <SectionHeader eyebrow={T.moreTitle} title={T.moreTitle} href={L('/history/')} linkLabel={T.moreLink} />
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={L(`/history/${r.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <HistoryArt motif={r.motif} arabic={r.arabic} name={r.name} accent={r.accent} />
            <span class="block hn-card-pad">
              <span class="font-bold block text-[15px] leading-6">{r.order}. {r.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {(prevP || nextP) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More events">
        {prevP ? (
          <a href={L(`/history/${prevP.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)}>{T.prevL.replace('{n}', String(prevP.order))}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevP.title}</span>
          </a>
        ) : <span />}
        {nextP && (
          <a href={L(`/history/${nextP.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.nextL.replace('{n}', String(nextP.order))}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextP.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
