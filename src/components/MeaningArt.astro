---
/* Premium inline-SVG artwork for Islamic meanings — zero image requests.
 * Deep-emerald geometric pattern + gold medallion + Arabic calligraphy +
 * a per-meaning line motif. Props: motif, arabic, term, translit, accent. */
interface Props {
  motif: string;
  arabic: string;
  term: string;
  translit: string;
  accent?: string;
}
const { motif, arabic, term, translit, accent = '#E3B94E' } = Astro.props;
const label = `${term} — ${translit}`;
const uid = `${(term ?? motif ?? 'art').toLowerCase().replace(/[^a-z0-9]+/g, '')}-${String(arabic ?? '').length}-${(translit ?? '').length}`;
---
<svg viewBox="0 0 800 450" class="w-full h-auto block" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`mbg-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B3B2E" />
      <stop offset="0.55" stop-color="#07352A" />
      <stop offset="1" stop-color="#04241C" />
    </linearGradient>
    <radialGradient id={`mglow-${uid}`} cx="0.5" cy="0.42" r="0.55">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.10" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`mvig-${uid}`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.6" stop-color="#000000" stop-opacity="0" />
      <stop offset="1" stop-color="#000000" stop-opacity="0.45" />
    </radialGradient>
    <linearGradient id={`mgold-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F7E08B" />
      <stop offset="0.5" stop-color="#D4AF37" />
      <stop offset="1" stop-color="#9A7B1E" />
    </linearGradient>
    <pattern id={`mpat-${uid}`} width="96" height="96" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#D4AF37" stroke-opacity="0.15" stroke-width="1.2">
        <g transform="translate(48,48)">
          <rect x="-15" y="-15" width="30" height="30" />
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45)" />
          <circle r="2.2" fill="#D4AF37" fill-opacity="0.5" stroke="none" />
        </g>
      </g>
    </pattern>
  </defs>

  <rect width="800" height="450" fill={`url(#mbg-${uid})`} />
  <rect width="800" height="450" fill={`url(#mpat-${uid})`} />
  <rect width="800" height="450" fill={`url(#mglow-${uid})`} />

  {/* corner ornaments */}
  <g fill="none" stroke="#D4AF37" stroke-opacity="0.55" stroke-width="1.6">
    <g transform="translate(40,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(40,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
  </g>

  {/* scattered sparkles */}
  <g fill="#F7E08B">
    <circle cx="150" cy="120" r="2.4" opacity="0.6" />
    <circle cx="650" cy="110" r="2" opacity="0.5" />
    <circle cx="120" cy="320" r="2" opacity="0.5" />
    <circle cx="680" cy="330" r="2.4" opacity="0.6" />
    <circle cx="240" cy="70" r="1.6" opacity="0.4" />
    <circle cx="560" cy="380" r="1.6" opacity="0.4" />
  </g>

  {/* motif icon */}
  <g transform="translate(355,28)" fill="none" stroke={accent} stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    {motif === 'shield' && (
      <g>
        <path d="M45 8 L74 19 V46 C74 64 62 76 45 84 C28 76 16 64 16 46 V19 Z" />
        <path d="M45 38 L53 47 L45 56 L37 47 Z" />
      </g>
    )}
    {motif === 'lamp' && (
      <g>
        <path d="M45 20 C50 28 53 32 53 38 A8 8 0 1 1 37 38 C37 32 40 28 45 20 Z" />
        <path d="M28 54 H62" />
        <path d="M33 54 C33 66 38 70 45 70 C52 70 57 66 57 54" />
        <path d="M45 70 V76 M37 76 H53" />
      </g>
    )}
    {motif === 'leaf' && (
      <g>
        <path d="M45 8 C66 28 66 58 45 80 C24 58 24 28 45 8 Z" />
        <path d="M45 22 V66 M45 40 L56 33 M45 52 L34 45" />
      </g>
    )}
    {motif === 'heart' && (
      <g>
        <path d="M45 78 C30 64 18 54 18 40 C18 29 26 22 35 22 C40 22 44 25 45 29 C46 25 50 22 55 22 C64 22 72 29 72 40 C72 54 60 64 45 78 Z" />
      </g>
    )}
    {motif === 'star' && (
      <g>
        <rect x="30" y="30" width="30" height="30" />
        <rect x="30" y="30" width="30" height="30" transform="rotate(45 45 45)" />
        <circle r="5" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'crown' && (
      <g>
        <polygon points="22,66 22,32 34,44 45,26 56,44 68,32 68,66" />
        <path d="M22 72 H68" />
        <circle cx="22" cy="27" r="3.4" fill={accent} stroke="none" />
        <circle cx="45" cy="21" r="3.4" fill={accent} stroke="none" />
        <circle cx="68" cy="27" r="3.4" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'gem' && (
      <g>
        <polygon points="45,8 68,34 45,82 22,34" />
        <path d="M22 34 H68 M45 8 L37 34 L45 82 M45 8 L53 34 L45 82" stroke-width="3" />
      </g>
    )}
    {motif === 'arch' && (
      <g>
        <path d="M28 80 V48 C28 32 38 24 45 18 C52 24 62 32 62 48 V80" />
        <path d="M22 80 H68" />
        <path d="M36 80 V54 C36 44 40 38 45 34 C50 38 54 44 54 54 V80" stroke-width="3" />
      </g>
    )}
    {motif === 'drop' && (
      <g>
        <path d="M45 8 C56 28 64 40 64 54 A19 19 0 1 1 26 54 C26 40 34 28 45 8 Z" />
      </g>
    )}
    {motif === 'scales' && (
      <g>
        <path d="M45 10 V76 M20 24 H70 M37 76 H53" />
        <path d="M28 24 L22 50 M28 24 L34 50" stroke-width="3" />
        <path d="M20 50 A8 8 0 0 0 36 50" stroke-width="3" />
        <path d="M62 24 L56 50 M62 24 L68 50" stroke-width="3" />
        <path d="M54 50 A8 8 0 0 0 70 50" stroke-width="3" />
      </g>
    )}
    {motif === 'wheat' && (
      <g>
        <path d="M45 82 V28" />
        <ellipse cx="36" cy="42" rx="6" ry="10" transform="rotate(-28 36 42)" />
        <ellipse cx="54" cy="42" rx="6" ry="10" transform="rotate(28 54 42)" />
        <ellipse cx="36" cy="58" rx="6" ry="10" transform="rotate(-28 36 58)" />
        <ellipse cx="54" cy="58" rx="6" ry="10" transform="rotate(28 54 58)" />
        <ellipse cx="45" cy="22" rx="6" ry="10" />
      </g>
    )}
    {motif === 'pen' && (
      <g transform="rotate(45 45 50)">
        <rect x="39" y="14" width="12" height="44" rx="2" />
        <polygon points="39,58 51,58 45,80" />
        <path d="M45 58 V72" stroke-width="3" />
      </g>
    )}
    {motif === 'bowl' && (
      <g>
        <path d="M20 52 H70" />
        <path d="M23 52 C23 70 33 78 45 78 C57 78 67 70 67 52" />
        <path d="M39 78 V83 M51 78 V83 M34 83 H56" stroke-width="3" />
        <path d="M38 44 C34 38 42 34 38 28" stroke-width="3" />
        <path d="M53 44 C49 38 57 34 53 28" stroke-width="3" />
      </g>
    )}
    {motif === 'moon' && (
      <g>
        <path d="M58 14 A36 36 0 1 0 58 76 A28 28 0 1 1 58 14 Z" />
        <path d="M64 50 L66.5 56.5 L73 59 L66.5 61.5 L64 68 L61.5 61.5 L55 59 L61.5 56.5 Z" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'target' && (
      <g>
        <circle cx="45" cy="48" r="28" />
        <circle cx="45" cy="48" r="16" stroke-width="3" />
        <circle cx="45" cy="48" r="4" fill={accent} stroke="none" />
        <path d="M45 48 L70 22" stroke-width="3" />
      </g>
    )}
    {motif === 'stamp' && (
      <g>
        <circle cx="45" cy="48" r="26" />
        <path d="M34 48 L43 57 L58 39" stroke-width="4" />
      </g>
    )}
    {motif === 'barrier' && (
      <g>
        <circle cx="45" cy="48" r="28" />
        <path d="M25 68 L65 28" stroke-width="4" />
      </g>
    )}
    {motif === 'chest' && (
      <g>
        <rect x="20" y="38" width="50" height="32" rx="3" />
        <path d="M20 48 H70" stroke-width="3" />
        <rect x="40" y="44" width="10" height="10" stroke-width="3" />
      </g>
    )}
    {motif === 'speech' && (
      <g>
        <path d="M20 26 H70 V54 H44 L32 68 V54 H20 Z" />
        <path d="M30 38 H60 M30 46 H52" stroke-width="3" />
      </g>
    )}
    {motif === 'satchel' && (
      <g>
        <rect x="26" y="34" width="38" height="32" rx="4" />
        <path d="M26 44 H64" stroke-width="3" />
        <path d="M45 44 V54" stroke-width="3" />
        <path d="M36 34 C36 24 54 24 54 34" stroke-width="3" />
      </g>
    )}
    {motif === 'curtain' && (
      <g>
        <path d="M20 14 H70" stroke-width="4" />
        <path d="M28 14 C28 40 30 60 26 76 M62 14 C62 40 60 60 64 76" />
        <path d="M45 14 V50" stroke-width="3" opacity="0.6" />
      </g>
    )}
    {motif === 'anchor' && (
      <g>
        <circle cx="45" cy="20" r="7" stroke-width="4" />
        <path d="M45 27 V76 M28 56 C28 68 36 74 45 74 C54 74 62 68 62 56" />
        <path d="M32 44 H58" stroke-width="3" />
      </g>
    )}
    {motif === 'flame' && (
      <g>
        <path d="M45 10 C54 24 62 32 62 48 A17 17 0 1 1 28 48 C28 38 34 32 37 26 C39 32 42 34 42 34 C42 26 43 16 45 10 Z" />
      </g>
    )}
    {motif === 'pitcher' && (
      <g>
        <path d="M36 30 H54 V44 C60 50 60 62 52 70 C48 74 42 74 38 70 C30 62 30 50 36 44 Z" />
        <path d="M54 40 C62 38 64 46 60 52" stroke-width="3" />
      </g>
    )}
    {motif === 'veil' && (
      <g>
        <path d="M45 12 C30 12 24 28 26 44 C27 58 30 70 34 78 M45 12 C60 12 66 28 64 44 C63 58 60 70 56 78" />
      </g>
    )}
    {motif === 'link' && (
      <g>
        <circle cx="33" cy="48" r="14" />
        <circle cx="57" cy="48" r="14" />
      </g>
    )}
    {motif === 'peak' && (
      <g>
        <polygon points="10,74 34,26 58,74" />
        <polygon points="46,74 62,44 78,74" stroke-width="4" />
        <circle cx="66" cy="18" r="5" stroke-width="3" />
      </g>
    )}
    {motif === 'world' && (
      <g>
        <circle cx="45" cy="48" r="28" />
        <ellipse cx="45" cy="48" rx="12" ry="28" stroke-width="3" />
        <path d="M17 48 H73" stroke-width="3" />
      </g>
    )}
    {motif === 'horizon' && (
      <g>
        <circle cx="45" cy="52" r="16" />
        <path d="M10 62 H80" stroke-width="4" />
        <path d="M20 72 H70" stroke-width="3" />
      </g>
    )}
    {motif === 'basket' && (
      <g>
        <path d="M28 40 H62 L57 72 H33 Z" />
        <path d="M32 40 C32 26 58 26 58 40" stroke-width="3" />
      </g>
    )}
    {motif === 'palms' && (
      <g>
        <path d="M25 38 C30 56 37 66 45 66 C53 66 60 56 65 38" stroke-width="4" />
        <path d="M33 38 C36 50 40 55 45 55 C50 55 54 50 57 38" stroke-width="3" />
      </g>
    )}
    {motif === 'beads' && (
      <g>
        <circle cx="45" cy="22" r="33" stroke-dasharray="1 9" stroke-linecap="round" stroke-width="6" />
        <rect x="38" y="52" width="14" height="20" rx="3" stroke-width="4" />
      </g>
    )}
    {motif === 'open-book' && (
      <g>
        <path d="M45 30 C35 24 25 24 15 28 V66 C25 62 35 62 45 68 C55 62 65 62 75 66 V28 C65 24 55 24 45 30 Z" />
        <path d="M45 30 V68" stroke-width="3" />
      </g>
    )}
    {motif === 'mat' && (
      <g>
        <rect x="25" y="30" width="40" height="44" rx="3" />
        <path d="M25 42 H65 M25 54 H65" stroke-width="3" />
        <path d="M38 30 V22 M52 30 V22" stroke-width="3" />
      </g>
    )}
    {motif === 'crescent' && (
      <g>
        <path d="M60 12 A30 30 0 1 0 60 72 A24 24 0 1 1 60 12 Z" />
        <circle cx="64" cy="24" r="3" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'inkpot' && (
      <g>
        <path d="M32 48 H58 L54 76 H36 Z" />
        <path d="M28 48 H62" stroke-width="4" />
        <path d="M52 48 L66 18" />
      </g>
    )}
    {motif === 'lantern' && (
      <g>
        <circle cx="45" cy="12" r="4" stroke-width="3" />
        <path d="M45 16 V24 M32 24 H58 L52 66 H38 Z" />
        <path d="M34 72 H56" stroke-width="4" />
      </g>
    )}
    {motif === 'snow' && (
      <g>
        <path d="M45 14 V74 M16 31 L74 65 M74 31 L16 65" stroke-width="4" />
        <path d="M38 22 L45 30 L52 22 M38 66 L45 58 L52 66" stroke-width="3" />
      </g>
    )}
    {motif === 'bubble-x' && (
      <g>
        <path d="M20 24 H70 V52 H44 L32 66 V52 H20 Z" />
        <path d="M39 38 L51 50 M51 38 L39 50" stroke-width="3" />
      </g>
    )}
    {motif === 'reed' && (
      <g>
        <path d="M45 78 C43 60 43 48 45 36" />
        <path d="M45 52 C36 46 28 46 20 50" stroke-width="3" />
        <path d="M45 44 C54 38 62 38 70 42" stroke-width="3" />
        <circle cx="45" cy="28" r="5" stroke-width="3" />
      </g>
    )}
  </g>

  {/* medallion rings */}
  <circle cx="400" cy="248" r="112" fill="#000000" fill-opacity="0.22" stroke={`url(#mgold-${uid})`} stroke-width="3" />
  <circle cx="400" cy="248" r="100" fill="none" stroke="#D4AF37" stroke-opacity="0.45" stroke-width="1" />

  {/* calligraphy + labels */}
  <text x="400" y="248" text-anchor="middle" dominant-baseline="central" font-size="54" fill="#F7F3E3" font-family="'Amiri Quran','Noto Naskh Arabic',serif">{arabic}</text>
  <text x="400" y="330" text-anchor="middle" font-size="24" letter-spacing="8" fill={accent} font-family="Inter,sans-serif" font-weight="800">{term.toUpperCase()}</text>
  <g stroke={accent} stroke-width="1.4" opacity="0.9">
    <line x1="290" y1="356" x2="378" y2="356" />
    <line x1="422" y1="356" x2="510" y2="356" />
    <rect x="394" y="350" width="12" height="12" transform="rotate(45 400 356)" fill={accent} stroke="none" />
  </g>
  <text x="400" y="390" text-anchor="middle" font-size="20" font-style="italic" fill="#ffffff" fill-opacity="0.78" font-family="Inter,sans-serif">{translit}</text>

  <rect width="800" height="450" fill={`url(#mvig-${uid})`} />
</svg>
