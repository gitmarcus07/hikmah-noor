---
/* Eid hub — aggregator for Eid al-Fitr, Eid al-Adha and Qurbani (EN + locale). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { GUIDES } from '../data/guides';
import { DUAS } from '../data/duas';
import { localizeGuide } from '../lib/guides-i18n';
import { localizeDua } from '../lib/duas-i18n';
import { secUI } from '../lib/site-ui-1';
import { EID_UI } from '../lib/site-ui-4';
import { monthDesc } from '../lib/site-ui-4';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, EID_UI);
const L = (p: string) => localizedPath(locale, p);

const fitrSlugs = ['eid-prayer-method', 'eid-day-sunnahs', 'eid-takbeer-wording', 'eid-khutbah-rulings', 'moon-sighting-hilal', 'zakat-al-fitr', 'shawwal-six-fasts'];
const adhaSlugs = ['qurbani-rules', 'qurbani-shares-who', 'qurbani-meat-distribution', 'tashriq-days-takbeer', 'qurbani-mistakes', 'hajj-day-by-day', 'mina-arafah-muzdalifah'];
const fitr = fitrSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean).map((g: any) => localizeGuide(g, locale));
const adha = adhaSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean).map((g: any) => localizeGuide(g, locale));
const duas = ['eid-greeting-taqabbal', 'eid-takbir', 'qurbani-slaughter-dua', 'qurbani-intention', 'eat-feed-qurbani-verse', 'gathering-expiation-dua', 'new-clothes', 'ibrahim-taqabbal-minna'].map((s) => DUAS.find((d) => d.slug === s)).filter(Boolean).map((d: any) => localizeDua(d, locale));
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/eid/' },
];
---
<BaseLayout title={T.hubTitle} description={T.hubDesc} keywords={T.hubKw} locale={locale} type="collection" faq={T.hubFaq} crumbs={crumbs} canonicalPath="/eid/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badge1}</span>
        <span class="hn-badge">{T.badge2}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{T.crossHajjL} <a href={L('/hajj/')} class="font-bold" style="color:var(--hn-primary)">{T.crossHajj}</a></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/tools/qurbani-eid/qurbani-splitter/')} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">{T.btnQurbani}</a>
        <a href={L('/tools/qurbani-eid/eid-day-checklist/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">{T.btnChecklist}</a>
        <a href={L('/tools/eid-takbeer/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">Takbeer studio + audio</a>
        <a href={L('/tools/shawwal-tracker/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">Shawwal 6 tracker</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secFitr} title={T.secFitrT} href={L('/learn/')} linkLabel={T.allGuides} />
      <div class="grid gap-3 sm:grid-cols-2">
        {fitr.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secAdha} title={T.secAdhaT} href={L('/learn/')} linkLabel={T.allGuides} />
      <div class="grid gap-3 sm:grid-cols-2">
        {adha.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secDuas} title={T.secDuasT} href={L('/duas/hajj-umrah/')} linkLabel={T.duasLink} />
      <div class="grid gap-3 sm:grid-cols-2">
        {duas.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{d.use}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secTools} title={T.secToolsT} href={L('/tools/')} linkLabel={T.allTools} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { t: 'Qurbani Share Splitter', d: '7-way cost & meat split', h: '/tools/qurbani-eid/qurbani-splitter/', i: 'moon' },
          { t: 'Eid-Day Checklist', d: 'Fitr & Adha hour by hour', h: '/tools/qurbani-eid/eid-day-checklist/', i: 'tools' },
          { t: 'Zakat al-Fitr', d: 'Fitrana per-person amount', h: '/tools/zakat/zakat-al-fitr/', i: 'tools' },
          { t: 'Prayer Times', d: 'Eid prayer time for your city', h: '/tools/prayer-times/', i: 'sun' },
        ].map((c) => (
          <a href={L(c.h)} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.i as any} size={22} /></span>
            <span class="min-w-0">
              <span class="block font-extrabold text-[16px] leading-6">{c.t}</span>
              <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">{c.d}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secMonths} title={T.secMonthsT} href={L('/calendar/')} linkLabel={T.secMonths} />
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={L('/calendar/shawwal/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-bold block text-[15px] leading-6">{T.fitrMonth}</span>
          <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{monthDesc('shawwal', locale)}</span>
        </a>
        <a href={L('/calendar/dhul-hijjah/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-bold block text-[15px] leading-6">{T.adhaMonth}</span>
          <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{monthDesc('dhul-hijjah', locale)}</span>
        </a>
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label={T.faqTitle}>
      <SectionHeader eyebrow="FAQ" title={T.faqTitle} />
      <div class="space-y-3">
        {T.hubFaq.map((f: any) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
