---
/* Guide topic page - one SEO page per topic with steps, evidence, FAQs. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import ReadingCard from './hn/ReadingCard.astro';
import ShareButtons from './hn/ShareButtons.astro';
import SourcesBlock from './hn/SourcesBlock.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { guidesByCat, GUIDES } from '../data/guides';
import { localizeGuide, localizeGuideList, localizeGuideCat } from '../lib/guides-i18n';
import { localizeDua } from '../lib/duas-i18n';
import { secUI3, GUIDE_UI } from '../lib/site-ui-3';
import { getDua, duaCat } from '../data/duas';
import { getRelatedEntities } from '../data/relations';
import RelatedContent from './RelatedContent.astro';

interface Props { guide: any; cat: any; locale: string; }
const { locale } = Astro.props;
const guide = localizeGuide((Astro.props as any).guide, locale);
const cat = localizeGuideCat((Astro.props as any).cat, locale);
const dict = getDict(locale);
const T = secUI3(locale, GUIDE_UI);
const L = (p: string) => localizedPath(locale, p);
const guidePath = '/learn/' + guide.cat + '/' + guide.slug + '/';
const catPath = '/learn/' + guide.cat + '/';

/* Guide -> dua links now live in the relationship data layer
 * (src/data/relations.ts, migrated from the map that was here).
 * Rendered below with the same cards; other kinds via RelatedContent. */
const duaLinks = getRelatedEntities('guide', guide.slug, guide.cat)
  .filter((r) => r.kind === 'related-duas')
  .slice(0, 3)
  .map((r) => {
    const hit = r.category ? getDua(r.category, r.slug) : null;
    return hit ? localizeDua(hit, locale) : null;
  })
  .filter(Boolean);

const title = guide.title + T.detSuffix;
let description = guide.intro;
if (description.length > 160) description = description.slice(0, 157) + '...';
const keywords = guide.title.toLowerCase() + ', ' + (guide.aliases || []).join(', ');
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/learn/' },
  { name: cat.title, path: catPath },
  { name: guide.title, path: guidePath },
];
const relatedRaw = guidesByCat(guide.cat).filter((g) => g.slug !== guide.slug);
const moreGuides = localizeGuideList([...relatedRaw, ...GUIDES.filter((g) => g.cat !== guide.cat)].slice(0, 4), locale);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={guide.faq} crumbs={crumbs} canonicalPath={guidePath}>
  <div class="hn-article hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 3)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{T.detPrefix}</span>
      <span class="hn-badge">{cat.title}</span>
      <span class="ms-auto flex gap-2 items-center no-print"><button onclick="window.print()" class="hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-3.5 text-sm">{T.printL}</button><ShareButtons title={guide.title} path={guidePath} locale={locale} /></span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{guide.title}</h1>
    <p class="mt-2 text-[16px] leading-8" style="color:var(--hn-muted)">{guide.intro}</p>
    {(guide.aliases || []).length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">{T.alsoSearched} {(guide.aliases || []).map((a: string, i: number) => (
        <span>{i > 0 && ' | '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    {guide.steps && guide.steps.length > 0 && (
      <section class="mt-6" aria-label={T.stepsL}>
        <SectionHeader eyebrow={T.stepsL} title={T.stepsL} />
        <ol class="space-y-3">
          {guide.steps.map((s: string, i: number) => (
            <li class="hn-card hn-card-pad flex gap-3">
              <span class="hn-verse-num shrink-0">{i + 1}</span>
              <span class="leading-7 text-[15px]">{s}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {(guide.sections || []).map((sec: any) => (
      <section class="mt-6" aria-label={sec.h}>
        <h2 class="text-xl font-extrabold mb-3">{sec.h}</h2>
        {(sec.ps || []).map((p: string) => (
          <p class="hn-card hn-card-pad leading-8 text-[15px] mb-3">{p}</p>
        ))}
      </section>
    ))}

    <SourcesBlock locale={locale} source={guide.ref} reviewedDate="2026-01-01" />

    {guide.faq && guide.faq.length > 0 && (
      <section class="mt-8" aria-label={dict.article.faq}>
        <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
        <div class="space-y-3">
          {guide.faq.map((f: any) => (
            <details class="hn-faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {duaLinks.length > 0 && (
      <section class="mt-8" aria-label={T.relDua}>
        <SectionHeader eyebrow={T.relDua} title={T.relDua} href={L('/duas/')} linkLabel={T.relDuaLink} />
        <div class="grid gap-3 sm:grid-cols-2">
          {duaLinks.map((d: any) => (
            <a href={L('/duas/' + d.cat + '/' + d.slug + '/')} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">{d.title}</span>
              <span class="text-[13px]" style="color:var(--hn-muted)">{d.use}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <RelatedContent type="guide" slug={guide.slug} category={guide.cat} locale={locale} exclude={['related-duas']} />

    {moreGuides.length > 0 && (
      <section class="mt-8" aria-label={T.relMore}>
        <SectionHeader eyebrow={T.relMore} title={T.relMore} href={L('/learn/')} linkLabel={T.relMoreLink} />
        <div class="grid gap-3 sm:grid-cols-2">
          {moreGuides.map((g: any) => (
            <a href={L('/learn/' + g.cat + '/' + g.slug + '/')} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">{g.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
