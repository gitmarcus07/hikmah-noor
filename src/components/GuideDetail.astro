---
/* Guide topic page - one SEO page per topic with steps, evidence, FAQs. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import ReadingCard from './hn/ReadingCard.astro';
import ShareButtons from './hn/ShareButtons.astro';
import SourcesBlock from './hn/SourcesBlock.astro';
import { localizedPath } from '../i18n/utils';
import { guidesByCat, GUIDES } from '../data/guides';
import { localizeGuide, localizeGuideList, localizeGuideCat } from '../lib/guides-i18n';
import { getDua, duaCat } from '../data/duas';

interface Props { guide: any; cat: any; locale: string; }
const { locale } = Astro.props;
const guide = localizeGuide((Astro.props as any).guide, locale);
const cat = localizeGuideCat((Astro.props as any).cat, locale);
const L = (p: string) => localizedPath(locale, p);
const guidePath = '/learn/' + guide.cat + '/' + guide.slug + '/';
const catPath = '/learn/' + guide.cat + '/';

/* Closely related dua pages for internal linking (verified slugs). */
