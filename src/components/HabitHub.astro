---
/* Home habit hub — Quranly features on the main screen.
 * Locked preview for guests (login compulsory to use);
 * live dashboard for logged-in users. Includes Ayah of the
 * Day + quick surahs (public, deep-link to existing readers).
 */
import AuthModal from './AuthModal.astro';
import { localizedPath } from '../i18n/utils';

interface Props { locale: string; }
const { locale } = Astro.props;

const quickSurahs = [
  { label: 'Al-Mulk', href: localizedPath(locale, '/surahs/67-al-mulk/') },
  { label: 'Ya-sin', href: localizedPath(locale, '/surahs/36-yaseen/') },
  { label: 'Ar-Rahman', href: localizedPath(locale, '/surahs/55-ar-rahmaan/') },
  { label: 'Al-Waqiah', href: localizedPath(locale, '/surahs/56-al-waaqia/') },
  { label: 'As-Sajdah', href: localizedPath(locale, '/surahs/32-as-sajda/') },
  { label: 'Al-Muzzammil', href: localizedPath(locale, '/surahs/73-al-muzzammil/') },
  { label: 'Ayat al-Kursi', href: localizedPath(locale, '/surahs/2-al-baqara/') + '#v255' },
];
const readUrl = localizedPath(locale, '/tools/read/');
const progressUrl = localizedPath(locale, '/tools/my-progress/');
const startUrl = localizedPath(locale, '/tools/habit-start/');
---
<section class="pt-2 sm:pt-3 pb-4 sm:pb-6" aria-label="Your Quran habit" id="habit">
  <div class="relative overflow-hidden bg-gradient-to-br from-night-800 to-[#151130] rounded-3xl p-6 sm:p-8 text-white shadow-xl shadow-black/40 border border-white/10">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 90% 8%, rgba(139,124,246,.35), transparent 45%), radial-gradient(circle at 5% 95%, rgba(212,175,55,.12), transparent 40%);"></div>
    <div class="relative">
      <p class="inline-flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.18em] text-night-900 bg-gold-300 rounded-full px-3.5 py-1.5">🌱 Your Quran habit</p>
      <h2 class="text-2xl sm:text-3xl font-extrabold leading-snug mt-3">Read a little every day — we track the rest</h2>
      <p class="mt-2 text-ink-300 leading-7 max-w-2xl text-[15px]">Daily goal, streaks, hasanat counter, timers, challenges and reminders. Free forever — login to save your progress and continue where you left off.</p>

      {/* LOCKED (guest) */}
      <div data-habit-locked class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['💗', 'Hasanat', 'Every letter ×10'],
          ['📄', 'Verses', 'Daily goal tracking'],
          ['⏱️', 'Time', 'Auto timer'],
          ['🔥', 'Streak', 'Never miss twice'],
        ].map(([icon, t, d]) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
            <div class="text-3xl" aria-hidden="true">{icon}</div>
            <div class="font-extrabold mt-2">{t}</div>
            <div class="text-xs text-ink-300 mt-0.5">{d}</div>
          </div>
        ))}
      </div>
      <div data-habit-locked class="mt-5 flex flex-col sm:flex-row gap-3">
        <button data-habit-login class="bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center gap-2">Login to start →</button>
        <a href={startUrl} class="bg-white/10 hover:bg-white/20 border border-white/15 text-white font-bold rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center gap-2">See how it works</a>
      </div>

      {/* LIVE (logged in) */}
      <div data-habit-live class="hidden mt-6">
        <div class="bg-white/5 border border-white/10 rounded-3xl p-5 sm:p-6">
          <div class="flex flex-wrap items-center gap-3">
            <p class="font-extrabold text-lg" data-habit-hello>Asalam Alaykum</p>
            <span class="ms-auto inline-flex items-center gap-1.5 text-sm font-extrabold text-gold-300">🔥 <span data-habit-streak>0</span> day streak</span>
          </div>
          <div data-habit-week class="mt-3 flex gap-1.5" aria-label="This week"></div>
          <div class="mt-4">
            <div class="flex justify-between text-sm font-bold"><span>Today's goal: <b data-habit-goaltext>0/1</b> verses</span><span data-habit-goalpct>0%</span></div>
            <div class="h-2.5 bg-white/10 rounded-full overflow-hidden mt-2"><div data-habit-goalbar class="h-full bg-gradient-to-r from-brand-500 to-gold-300 rounded-full transition-all" style="width:0%"></div></div>
          </div>
          <div class="mt-4 flex flex-col sm:flex-row gap-3">
            <a data-habit-continue href={readUrl} class="flex-1 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center gap-2">📖 Read Quran</a>
            <a href={progressUrl} class="flex-1 bg-white/10 hover:bg-white/20 border border-white/15 text-white font-bold rounded-full px-6 py-3 min-h-[52px] inline-flex items-center justify-center gap-2">My progress →</a>
          </div>
          <button data-habit-logout class="mt-3 text-xs font-bold text-ink-500 hover:text-brand-300">Logout</button>
        </div>
        <div data-habit-stats class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
      </div>

      {/* AYAH OF THE DAY (public) */}
      <div class="mt-6 bg-gradient-to-br from-brand-500/25 to-gold-300/15 border border-white/10 rounded-3xl p-5 sm:p-6">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-gold-300">☀️ Ayah of the Day</p>
        <p data-aod-ar class="font-arabic text-2xl md:text-3xl leading-[2] text-right mt-2" lang="ar" dir="rtl">…</p>
        <p data-aod-en class="mt-2 text-ink-200 leading-7 text-[15px]">…</p>
        <p data-aod-ref class="mt-1 text-xs font-bold text-ink-500"></p>
      </div>

      {/* QUICK SURAHS (public) */}
      <div class="mt-4 flex flex-wrap gap-2">
        {quickSurahs.map((q) => (
          <a href={q.href} class="text-sm font-bold bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-400/60 rounded-full px-4 py-2.5 min-h-[44px] inline-flex items-center text-ink-200">{q.label}</a>
        ))}
      </div>
    </div>
  </div>
</section>

<AuthModal />

<script define:vars={{ readUrl }}>
  (() => {
    const root = document.getElementById('habit');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);
    const $$ = (s) => [...root.querySelectorAll(s)];
    const locked = $$('[data-habit-locked]');
    const live = $('[data-habit-live]');

    const paintWeek = (activeDates) => {
      const box = $('[data-habit-week]');
      if (!box) return;
      const set = new Set(activeDates || []);
      const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
      const now = new Date();
      const monday = new Date(now);
      monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));
      box.innerHTML = days.map((d, i) => {
        const dt = new Date(monday);
        dt.setDate(monday.getDate() + i);
        const key = dt.toISOString().slice(0, 10);
        const on = set.has(key);
        return `<span class="w-9 h-9 grid place-items-center rounded-full text-xs font-extrabold border ${on ? 'bg-brand-500 text-night-900 border-brand-500' : 'bg-white/5 text-ink-300 border-white/10'}">${d}</span>`;
      }).join('');
    };

    const renderLive = async (H, user) => {
      locked.forEach((el) => el.classList.add('hidden'));
      live?.classList.remove('hidden');
      const [prefs, streak, stats, resume] = await Promise.all([
        H.Me.prefs().catch(() => ({ prefs: {} })),
        H.Me.streak().catch(() => ({ streak: { current: 0 } })),
        H.Me.stats('today').catch(() => ({ stats: { verses: 0, seconds: 0, hasanat: 0, pages: 0 } })),
        H.Me.resume().catch(() => ({ resume: null })),
      ]);
      const p = prefs.prefs || {};
      const st = streak.streak || { current: 0 };
      const s = stats.stats || { verses: 0, seconds: 0, hasanat: 0, pages: 0 };
      const goal = p.daily_goal || 1;
      const pct = Math.min(100, Math.round(((s.verses || 0) / goal) * 100));
      const hello = $('[data-habit-hello]');
      if (hello) hello.textContent = `Asalam Alaykum, ${(user.name || 'Reader').split(' ')[0]}`;
      const sk = $('[data-habit-streak]');
      if (sk) sk.textContent = st.current || 0;
      const gt = $('[data-habit-goaltext]');
      if (gt) gt.textContent = `${s.verses || 0}/${goal}`;
      const gp = $('[data-habit-goalpct]');
      if (gp) gp.textContent = `${pct}%`;
      const gb = $('[data-habit-goalbar]');
      if (gb) gb.style.width = `${pct}%`;
      const cont = $('[data-habit-continue]');
      if (cont && resume.resume) cont.href = `${readUrl}?surah=${resume.resume.surah}&verse=${resume.resume.verse}`;
      paintWeek((await H.Me.stats('week').catch(() => ({ days: [] }))).days?.map((d) => d.date));
      const tiles = $('[data-habit-stats]');
      if (tiles) {
        tiles.innerHTML = [
          ['💗', 'Hasanat', H.fmtCompact(s.hasanat || 0)],
          ['📄', 'Verses', String(s.verses || 0)],
          ['⏱️', 'Time', H.fmtTime(s.seconds || 0)],
          ['📑', 'Pages', String(s.pages || 0)],
        ].map(([i, t, v]) => `<div class="bg-white/5 border border-white/10 rounded-2xl p-3 text-center"><div class="text-2xl">${i}</div><div class="text-xs text-ink-300 mt-1">${t}</div><div class="font-extrabold text-lg">${v}</div></div>`).join('');
      }
    };

    const boot = async () => {
      // Ayah of the Day — public, no login.
      try {
        const H = await import('/habits/habit.js?v=3');
        const list = await (await fetch('/habits/ayahs.json')).json();
        const a = list[H.ayahOfDayIndex(new Date().toISOString().slice(0, 10), list.length) % list.length];
        if (a) {
          const ar = $('[data-aod-ar]'); if (ar) ar.textContent = a.ar;
          const en = $('[data-aod-en]'); if (en) en.textContent = a.en;
          const rf = $('[data-aod-ref]'); if (rf) rf.textContent = `Surah ${a.surahName} ${a.surah}:${a.verse}`;
        }
      } catch {}
      // Session → locked or live.
      try {
        const { Auth } = await import('/habits/habit.js?v=3');
        const { user } = await Auth.session();
        if (user) {
          const H = await import('/habits/habit.js?v=3');
          await renderLive(H, user);
        }
      } catch {}
    };

    $$('[data-habit-login]').forEach((b) => b.addEventListener('click', () => window.hnAuthModal?.open()));
    $('[data-habit-logout]')?.addEventListener('click', async () => {
      try {
        const { Auth } = await import('/habits/habit.js?v=3');
        await Auth.logout();
      } finally { window.location.reload(); }
    });
    document.addEventListener('hn:auth', async (e) => {
      const H = await import('/habits/habit.js?v=3');
      if (e.detail?.isNew) { window.location.href = root.querySelector('[data-habit-continue]')?.href || readUrl; return; }
      const { Auth } = H;
      const { user } = await Auth.session();
      if (user) await renderLive(H, user);
    });
    boot();
  })();
</script>
