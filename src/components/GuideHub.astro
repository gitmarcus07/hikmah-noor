---
/* Learn hub: Islamic guides by category - one SEO page per topic. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { localizedPath } from '../i18n/utils';
import { GUIDE_CATS, guidesByCat, GUIDES } from '../data/guides';
import { localizeGuideList, localizeGuideCat } from '../lib/guides-i18n';

interface Props { locale: string; }
const { locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const counts = GUIDE_CATS.map((c) => ({ ...localizeGuideCat(c, locale), n: guidesByCat(c.slug).length }));

const title = 'Islamic Guides - How to Pray, Wudu, Fasting, Zakat, Hajj and More';
const description = 'Step-by-step Islamic guides: how to pray namaz, wudu, ghusl, fasting, zakat, Hajj, nikah and janaza - simple, sourced, with FAQs.';
const keywords = 'how to pray namaz, wudu steps, ghusl, fasting rules, zakat, hajj, islamic guides, namaz ka tarika';
const faq = [
  { q: 'What will I learn in each guide?', a: 'Plain steps in order, the conditions before you start, what breaks the act, and answers to the most asked questions - each with its Quran or hadith basis.' },
  { q: 'Which school of thought is followed?', a: 'Guides teach the widely agreed essentials; where schools differ (raising hands, wali, wiping socks), it is noted - learn personal details from a qualified teacher.' },
  { q: 'Are these guides a fatwa?', a: 'No. They are educational summaries for learning. For real cases and differences, consult qualified scholars.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Learn', path: '/learn/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/learn/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{GUIDES.length} guides</span>
        <span class="hn-badge">{GUIDE_CATS.length} categories</span>
        <span class="hn-badge">Step by step</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Islamic Guides</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Learn how to pray, purify, fast and fulfill each duty - every topic on its own page with steps, evidence and answers.</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder="Search guides - e.g. wudu, namaz, roza..." aria-label="Search guides" />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Categories" title="Browse by category" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {counts.map((c) => (
          <a href={L('/learn/' + c.slug + '/')} class="hn-card hn-card-hover hn-card-pad flex gap-3.5 items-center">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any || 'book'} size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block leading-6">{c.title} <span class="text-xs font-bold" style="color:var(--hn-muted)">({c.n})</span></span>
              <span class="text-[13px] leading-5 block mt-0.5 line-clamp-2" style="color:var(--hn-muted)">{c.desc}</span>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="All topics" title="Every guide" sub="One page per topic - built to answer exactly what you searched." />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {localizeGuideList(GUIDES, locale).map((g: any) => (
          <a href={L('/learn/' + g.cat + '/' + g.slug + '/')} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{g.title}</span>
            <span class="text-[13px] line-clamp-2 mt-0.5" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
