---
/* Prophet artwork — own branding for the /prophets/ hub.
 * Same premium inline-SVG language as WaqiahArt, distinct indigo-night
 * background, gold accents, per-prophet motifs + emblem calligraphy. */
interface Props {
  motif: string;
  arabic: string;
  prophet: string;
  accent?: string;
}
const { motif, arabic, prophet, accent = '#E3B94E' } = Astro.props;
const label = `Prophet ${prophet}`;
const uid = `${(prophet ?? motif ?? 'art').toLowerCase().replace(/[^a-z0-9]+/g, '')}-${String(arabic ?? '').length}-${String(prophet ?? '').length}`;
---
<svg viewBox="0 0 800 450" class="w-full h-auto block" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`pbg-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#101B3C" />
      <stop offset="0.55" stop-color="#0C1630" />
      <stop offset="1" stop-color="#060B1D" />
    </linearGradient>
    <radialGradient id={`pglow-${uid}`} cx="0.5" cy="0.4" r="0.55">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.10" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`pvig-${uid}`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.6" stop-color="#000000" stop-opacity="0" />
      <stop offset="1" stop-color="#000000" stop-opacity="0.45" />
    </radialGradient>
    <linearGradient id={`pgold-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F7E08B" />
      <stop offset="0.5" stop-color="#D4AF37" />
      <stop offset="1" stop-color="#9A7B1E" />
    </linearGradient>
    <pattern id={`ppat-${uid}`} width="96" height="96" patternUnits="userSpaceOnUse" patternTransform="rotate(12)">
      <g fill="none" stroke="#D4AF37" stroke-opacity="0.15" stroke-width="1.2">
        <g transform="translate(48,48)">
          <rect x="-15" y="-15" width="30" height="30" />
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45)" />
          <circle r="2.2" fill="#D4AF37" fill-opacity="0.5" stroke="none" />
        </g>
      </g>
    </pattern>
  </defs>

  <rect width="800" height="450" fill={`url(#pbg-${uid})`} />
  <rect width="800" height="450" fill={`url(#ppat-${uid})`} />
  <rect width="800" height="450" fill={`url(#pglow-${uid})`} />

  <g fill="none" stroke="#D4AF37" stroke-opacity="0.55" stroke-width="1.6">
    <g transform="translate(40,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(40,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
  </g>

  <g fill="#F7E08B">
    <circle cx="150" cy="130" r="2.4" opacity="0.6" />
    <circle cx="650" cy="120" r="2" opacity="0.5" />
    <circle cx="120" cy="330" r="2" opacity="0.5" />
    <circle cx="680" cy="340" r="2.4" opacity="0.6" />
  </g>

  {/* prophet motif */}
  <g transform="translate(350,36)" fill="none" stroke={accent} stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    {motif === 'clay' && (
      <g>
        <ellipse cx="45" cy="72" rx="30" ry="7" stroke-width="3" />
        <path d="M28 70 C28 50 36 44 45 44 C54 44 62 50 62 70" />
        <path d="M38 44 C38 34 42 30 45 26 C48 30 52 34 52 44" stroke-width="3" />
        <circle cx="45" cy="18" r="4" stroke-width="3" />
      </g>
    )}
    {motif === 'stairs' && (
      <g>
        <path d="M10 78 H32 V60 H50 V42 H68 V24" />
        <circle cx="68" cy="16" r="4" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'ark' && (
      <g>
        <path d="M45 58 V22" />
        <polygon points="45,22 45,50 66,50" />
        <path d="M20 58 H70 M28 58 L34 72 H56 L62 58" />
        <path d="M12 78 Q20 72 28 78 T44 78 T60 78 T76 78" stroke-width="3" />
      </g>
    )}
    {motif === 'wind' && (
      <g>
        <path d="M8 34 H60 C68 34 68 24 60 24 H40" stroke-width="4" />
        <path d="M8 50 H72 C80 50 80 40 72 40" stroke-width="4" />
        <path d="M8 66 H54 C62 66 62 56 54 56" stroke-width="4" />
      </g>
    )}
    {motif === 'camel' && (
      <g>
        <path d="M20 66 C26 50 34 46 40 52 C44 44 52 44 56 52 C62 46 68 50 70 60" />
        <path d="M28 66 V80 M40 62 V80 M58 60 V80 M68 62 V80" stroke-width="3" />
        <circle cx="74" cy="44" r="4" stroke-width="3" />
      </g>
    )}
    {motif === 'fire' && (
      <g>
        <path d="M45 6 C56 22 66 32 66 48 A21 21 0 1 1 24 48 C24 36 32 28 36 22 C38 30 42 32 42 32 C42 24 43 14 45 6 Z" />
        <path d="M45 44 C50 50 53 54 53 59 A8 8 0 1 1 37 59 C37 54 40 50 45 44 Z" stroke-width="3" />
      </g>
    )}
    {motif === 'pillars' && (
      <g>
        <path d="M14 78 V30 M30 78 V30 M14 30 H30" stroke-width="4" />
        <path d="M60 78 V30 M76 78 V30 M60 30 H76" stroke-width="4" />
        <path d="M8 24 H82" />
      </g>
    )}
    {motif === 'kaaba' && (
      <g>
        <polygon points="25,38 45,30 65,38 65,70 45,78 25,70" />
        <path d="M25 46 L65 46" stroke-width="3" />
        <path d="M45 30 V78" stroke-width="3" />
      </g>
    )}
    {motif === 'moon' && (
      <g>
        <path d="M60 10 A30 30 0 1 0 60 70 A24 24 0 1 1 60 10 Z" />
        <circle cx="66" cy="20" r="3" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'ladder' && (
      <g>
        <path d="M32 10 V80 M58 10 V80" />
        <path d="M32 26 H58 M32 45 H58 M32 64 H58" stroke-width="3" />
      </g>
    )}
    {motif === 'well' && (
      <g>
        <ellipse cx="45" cy="26" rx="26" ry="9" />
        <path d="M19 26 V64 M71 26 V64" />
        <ellipse cx="45" cy="64" rx="26" ry="9" />
        <path d="M45 4 V32" stroke-width="3" />
        <rect x="36" y="32" width="18" height="12" />
      </g>
    )}
    {motif === 'scales' && (
      <g>
        <path d="M45 10 V70 M20 70 H70" />
        <path d="M45 18 L20 26 M45 18 L70 26" stroke-width="3" />
        <path d="M12 26 L20 44 L28 26 M62 26 L70 44 L78 26" stroke-width="3" />
      </g>
    )}
    {motif === 'knot' && (
      <g>
        <rect x="25" y="25" width="40" height="40" />
        <rect x="25" y="25" width="40" height="40" transform="rotate(45 45 45)" stroke-width="3" />
        <circle cx="45" cy="45" r="5" stroke-width="3" />
      </g>
    )}
    {motif === 'ring' && (
      <g>
        <circle cx="45" cy="52" r="22" />
        <polygon points="45,14 53,26 45,38 37,26" stroke-width="3" />
      </g>
    )}
    {motif === 'staff' && (
      <g>
        <path d="M45 80 V26" />
        <path d="M45 26 C45 16 52 14 58 16 C62 18 62 24 58 26" stroke-width="4" />
        <path d="M20 80 H70" stroke-width="3" />
      </g>
    )}
    {motif === 'voice' && (
      <g>
        <circle cx="30" cy="50" r="5" fill={accent} stroke="none" />
        <path d="M44 36 C54 44 54 56 44 64" stroke-width="4" />
        <path d="M56 28 C72 42 72 58 56 72" stroke-width="4" />
      </g>
    )}
    {motif === 'armor' && (
      <g>
        <path d="M45 8 L68 18 V44 C68 60 58 70 45 78 C32 70 22 60 22 44 V18 Z" />
        <path d="M32 40 H58 M32 52 H58" stroke-width="3" />
      </g>
    )}
    {motif === 'seal' && (
      <g>
        <circle cx="45" cy="48" r="26" />
        <polygon points="45,30 50,43 64,43 53,52 57,66 45,57 33,66 37,52 26,43 40,43" stroke-width="3" />
      </g>
    )}
    {motif === 'cloud' && (
      <g>
        <path d="M25 52 C18 52 14 46 18 40 C20 34 28 32 32 36 C36 28 48 28 52 36 C58 34 64 38 62 44 C66 46 64 52 58 52 Z" />
        <path d="M32 62 L28 72 M45 62 L41 72 M58 62 L54 72" stroke-width="3" />
      </g>
    )}
    {motif === 'spring' && (
      <g>
        <path d="M45 12 C52 26 58 32 58 42 A13 13 0 1 1 32 42 C32 32 38 26 45 12 Z" />
        <path d="M20 70 Q28 65 36 70 T52 70 T68 70 T84 70" stroke-width="3" />
      </g>
    )}
    {motif === 'whale' && (
      <g>
        <path d="M10 48 C22 34 44 32 58 42 L74 32 L70 46 L74 60 L58 52 C44 62 22 60 10 48 Z" />
        <circle cx="24" cy="45" r="2.6" fill={accent} stroke="none" />
        <path d="M8 70 Q16 65 24 70 T40 70 T56 70 T72 70 T84 70" stroke-width="3" />
      </g>
    )}
    {motif === 'scroll' && (
      <g>
        <rect x="22" y="24" width="46" height="40" rx="4" />
        <path d="M30 34 H60 M30 44 H60 M30 54 H50" stroke-width="3" />
      </g>
    )}
    {motif === 'branch' && (
      <g>
        <path d="M45 82 C43 64 43 52 45 40" />
        <path d="M45 58 C36 52 28 52 20 56" stroke-width="3" />
        <path d="M45 48 C54 42 62 42 70 46" stroke-width="3" />
        <circle cx="45" cy="30" r="5" stroke-width="3" />
      </g>
    )}
    {motif === 'cradle' && (
      <g>
        <path d="M18 40 H72 L64 62 H26 Z" />
        <path d="M30 62 L24 78 M60 62 L66 78" stroke-width="3" />
        <circle cx="45" cy="28" r="5" stroke-width="3" />
      </g>
    )}
    {motif === 'light' && (
      <g>
        <circle cx="45" cy="48" r="12" />
        <path d="M45 14 V24 M45 72 V82 M11 48 H21 M69 48 H79 M21 24 L28 31 M62 65 L69 72 M69 24 L62 31 M28 65 L21 72" stroke-width="3" />
      </g>
    )}
  </g>

  {/* emblem calligraphy */}
  <text x="400" y="218" text-anchor="middle" dominant-baseline="central" font-size="30" fill="#F7F3E3" font-family="'Amiri Quran','Noto Naskh Arabic',serif">{arabic}</text>
  <text x="400" y="292" text-anchor="middle" font-size="24" letter-spacing="8" fill={accent} font-family="Inter,sans-serif" font-weight="800">{prophet.toUpperCase()}</text>
  <g stroke={accent} stroke-width="1.4" opacity="0.9">
    <line x1="300" y1="322" x2="388" y2="322" />
    <line x1="412" y1="322" x2="500" y2="322" />
    <rect x="394" y="316" width="12" height="12" transform="rotate(45 400 322)" fill={accent} stroke="none" />
  </g>
  <text x="400" y="360" text-anchor="middle" font-size="15" letter-spacing="4" fill="#ffffff" fill-opacity="0.7" font-family="Inter,sans-serif" font-weight="600">PROPHET • NABI</text>

  <rect width="800" height="450" fill={`url(#pvig-${uid})`} />
</svg>
