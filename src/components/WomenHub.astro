---
/* Women hub: 12 noble figures -> per-figure SEO detail pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import WomenArt from './WomenArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { WOMEN, womenByEra } from '../data/women';
import { localizeStoryList } from '../lib/stories-i18n';
import { secUI, WOMEN_UI } from '../lib/site-ui-1';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, WOMEN_UI);
const L = (p: string) => localizedPath(locale, p);

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/women/' },
];
const eras = ['Before Islam', 'Makkah', 'Madinah'] as const;
const eraTitle: Record<string, string> = {
  'Before Islam': T.eraTitles[0], 'Makkah': T.eraTitles[1], 'Madinah': T.eraTitles[2],
};
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/women/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{WOMEN.length} {T.badgeN}</span>
        <span class="hn-badge">{T.badge2}</span>
        <span class="hn-badge">{T.badge3}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    {eras.map((era) => {
      const list = localizeStoryList(womenByEra(era), 'women', locale);
      return (
      <div class="mt-8">
        <SectionHeader eyebrow={era} title={eraTitle[era]} />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((w) => (
            <a href={L(`/women/${w.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
              <span class="block overflow-hidden"><WomenArt motif={w.motif} arabic={w.arabic} prophet={w.name} accent={w.accent} /></span>
              <span class="block hn-card-pad">
                <span class="flex items-center gap-1.5">
                  <span class="hn-verse-num shrink-0">{w.order}</span>
                  <span class="hn-badge hn-badge-primary">{w.name}</span>
                </span>
                <span class="font-extrabold block text-[17px] leading-7 mt-2">{w.title}</span>
                <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{w.summary}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
      );
    })}
    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">{dict.article.faq}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
