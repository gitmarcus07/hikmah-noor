---
/* Site-wide premium SVG artwork — replaces all JPG photos.
 * Abstract, geometric, no animate depictions. Usage:
 *   <SiteArt name="card-duas" title="..." />
 * IDs are prefixed per design so repeated cards never clash.
 * Palette follows the light design system: ivory parchment skies,
 * emerald greens, restrained gold. One night scene (article-desert)
 * uses deep emerald instead of the old purple.
 */
import type { ArtName } from '../lib/art';

interface Props { name: ArtName; title?: string; }
const { name, title } = Astro.props;
const p = name.replace(/-/g, '');
const label = title ?? name.replace(/-/g, ' ');
const night = name === 'article-desert' || name === 'hero-quran';
---
<svg viewBox="0 0 800 450" class="w-full h-full block" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`${p}-sky`} x1="0" y1="0" x2="0" y2="1">
      {(name === 'article-desert') ? (<><stop offset="0" stop-color="#071C14" /><stop offset="0.6" stop-color="#0C3325" /><stop offset="1" stop-color="#13503A" /></>) : null}
      {(name === 'hero-quran') ? (<><stop offset="0" stop-color="#08241A" /><stop offset="0.62" stop-color="#0F5132" /><stop offset="1" stop-color="#177A5C" /></>) : null}
      {(name === 'card-duas') ? (<><stop offset="0" stop-color="#FDF8EA" /><stop offset="0.65" stop-color="#F6ECD4" /><stop offset="1" stop-color="#EBDCB8" /></>) : null}
      {(name === 'article-istiqlal') ? (<><stop offset="0" stop-color="#FDF9EE" /><stop offset="0.6" stop-color="#F4EAD0" /><stop offset="1" stop-color="#E4D3A8" /></>) : null}
      {(name === 'article-kaaba') ? (<><stop offset="0" stop-color="#F8F4E9" /><stop offset="0.7" stop-color="#EFE8D5" /><stop offset="1" stop-color="#E2D6B8" /></>) : null}
      {(!night && name !== 'card-duas' && name !== 'article-istiqlal' && name !== 'article-kaaba') ? (<><stop offset="0" stop-color="#FBF7EC" /><stop offset="0.62" stop-color="#F3ECDA" /><stop offset="1" stop-color="#E6D9BC" /></>) : null}
    </linearGradient>
    <linearGradient id={`${p}-gold`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFD88F" />
      <stop offset="0.52" stop-color="#C9A84C" />
      <stop offset="1" stop-color="#8C6D1F" />
    </linearGradient>
    <linearGradient id={`${p}-emer`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#177A5C" />
      <stop offset="0.55" stop-color="#0F5132" />
      <stop offset="1" stop-color="#093B25" />
    </linearGradient>
    <radialGradient id={`${p}-glow`} cx="0.5" cy="0.34" r="0.55">
      {night
        ? (<><stop offset="0" stop-color="#EFD88F" stop-opacity="0.20" /><stop offset="1" stop-color="#EFD88F" stop-opacity="0" /></>)
        : (<><stop offset="0" stop-color="#B8944A" stop-opacity="0.20" /><stop offset="1" stop-color="#B8944A" stop-opacity="0" /></>)}
    </radialGradient>
    <radialGradient id={`${p}-vig`} cx="0.5" cy="0.5" r="0.78">
      <stop offset="0.72" stop-color="#000000" stop-opacity="0" />
      <stop offset="1" stop-color={night ? '#000000' : '#3A2E12'} stop-opacity={night ? 0.35 : 0.12} />
    </radialGradient>
    <pattern id={`${p}-pat`} width="120" height="120" patternUnits="userSpaceOnUse">
      <g fill="none" stroke={night ? '#EFD88F' : '#0F5132'} stroke-opacity={night ? 0.10 : 0.07} stroke-width="1.2">
        <g transform="translate(60,60)">
          <rect x="-15" y="-15" width="30" height="30" />
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45)" />
          <circle r="2.2" fill={night ? '#EFD88F' : '#0F5132'} stroke="none" opacity="0.8" />
        </g>
      </g>
    </pattern>
  </defs>

  <rect width="800" height="450" fill={`url(#${p}-sky)`} />
  <rect width="800" height="450" fill={`url(#${p}-pat)`} />
  <rect width="800" height="450" fill={`url(#${p}-glow)`} />

