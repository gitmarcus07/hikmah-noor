---
/* Site-wide premium SVG artwork — replaces all JPG photos.
 * Abstract, geometric, no animate depictions. Usage:
 *   <SiteArt name="card-duas" title="..." />
 * IDs are prefixed per design so repeated cards never clash.
 */
import type { ArtName } from '../lib/art';

interface Props { name: ArtName; title?: string; }
const { name, title } = Astro.props;
const p = name.replace(/-/g, '');
const label = title ?? name.replace(/-/g, ' ');
---
<svg viewBox="0 0 800 450" class="w-full h-full block" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`${p}-bg`} x1="0" y1="0" x2="0" y2="1">
      {(name === 'article-desert') ? (<><stop offset="0" stop-color="#141233" /><stop offset="0.62" stop-color="#1C1650" /><stop offset="1" stop-color="#2A2160" /></>) : null}
      {(name === 'card-duas') ? (<><stop offset="0" stop-color="#12102A" /><stop offset="1" stop-color="#0C0A1E" /></>) : null}
      {(name !== 'article-desert' && name !== 'card-duas') ? (<><stop offset="0" stop-color="#1B1440" /><stop offset="0.55" stop-color="#171233" /><stop offset="1" stop-color="#100C26" /></>) : null}
    </linearGradient>
    <linearGradient id={`${p}-gold`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F7E08B" />
      <stop offset="0.5" stop-color="#D4AF37" />
      <stop offset="1" stop-color="#9A7B1E" />
    </linearGradient>
    <radialGradient id={`${p}-glow`} cx="0.5" cy="0.38" r="0.55">
      <stop offset="0" stop-color="#F7E08B" stop-opacity="0.16" />
      <stop offset="1" stop-color="#F7E08B" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`${p}-vig`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.62" stop-color="#000000" stop-opacity="0" />
      <stop offset="1" stop-color="#000000" stop-opacity="0.42" />
    </radialGradient>
    <pattern id={`${p}-pat`} width="96" height="96" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#D4AF37" stroke-opacity="0.14" stroke-width="1.2">
        <g transform="translate(48,48)">
          <rect x="-14" y="-14" width="28" height="28" />
          <rect x="-14" y="-14" width="28" height="28" transform="rotate(45)" />
        </g>
      </g>
    </pattern>
  </defs>

  <rect width="800" height="450" fill={`url(#${p}-bg)`} />
  <rect width="800" height="450" fill={`url(#${p}-pat)`} />
  <rect width="800" height="450" fill={`url(#${p}-glow)`} />

  {name === 'hero-quran' && (
    <g>
      <g stroke={`url(#${p}-gold)`} stroke-width="3" opacity="0.5">
        <line x1="400" y1="290" x2="250" y2="110" />
        <line x1="400" y1="290" x2="330" y2="90" />
        <line x1="400" y1="290" x2="400" y2="80" />
        <line x1="400" y1="290" x2="470" y2="90" />
        <line x1="400" y1="290" x2="550" y2="110" />
      </g>
      <g transform="translate(400,120)" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3">
        <rect x="-20" y="-20" width="40" height="40" />
        <rect x="-20" y="-20" width="40" height="40" transform="rotate(45)" />
      </g>
      <g stroke-linecap="round">
        <line x1="315" y1="375" x2="485" y2="235" stroke="#7A5A2E" stroke-width="16" />
        <line x1="485" y1="375" x2="315" y2="235" stroke="#7A5A2E" stroke-width="16" />
      </g>
      <g stroke={`url(#${p}-gold)`} stroke-width="4">
        <polygon points="255,215 390,188 390,318 255,345" fill="#F5EFDC" />
        <polygon points="545,215 410,188 410,318 545,345" fill="#EFE3C8" />
      </g>
      <g stroke="#2A2160" stroke-width="5" stroke-linecap="round" opacity="0.65">
        <line x1="280" y1="232" x2="368" y2="216" />
        <line x1="280" y1="256" x2="368" y2="240" />
        <line x1="280" y1="280" x2="368" y2="264" />
        <line x1="432" y1="216" x2="520" y2="232" />
        <line x1="432" y1="240" x2="520" y2="256" />
        <line x1="432" y1="264" x2="520" y2="280" />
      </g>
    </g>
  )}

  {name === 'card-quran' && (
    <g>
      <rect x="330" y="105" width="140" height="240" rx="10" fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="5" />
      <line x1="358" y1="105" x2="358" y2="345" stroke={`url(#${p}-gold)`} stroke-width="3" opacity="0.7" />
      <g transform="translate(414,225)" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3.5">
        <rect x="-30" y="-30" width="60" height="60" />
        <rect x="-30" y="-30" width="60" height="60" transform="rotate(45)" />
        <circle r="8" fill={`url(#${p}-gold)`} stroke="none" />
      </g>
      <polygon points="428,105 446,105 446,168 437,156 428,168" fill="#8E2F3C" stroke={`url(#${p}-gold)`} stroke-width="2" />
    </g>
  )}

  {name === 'card-surahs' && (
    <g fill="none" stroke={`url(#${p}-gold)`} stroke-width="4">
      <path d="M200 300 C240 190 320 130 400 130 C480 130 560 190 600 300" stroke-dasharray="1 14" stroke-linecap="round" stroke-width="6" opacity="0.5" />
      <circle cx="212" cy="282" r="13" /><circle cx="252" cy="228" r="13" /><circle cx="304" cy="188" r="13" />
      <circle cx="364" cy="166" r="13" /><circle cx="428" cy="164" r="13" /><circle cx="488" cy="182" r="13" />
      <circle cx="540" cy="216" r="13" /><circle cx="578" cy="260" r="13" />
      <path d="M578 260 L596 340 M590 340 L586 372 M602 340 L606 372 M578 340 L574 372" stroke-width="4" />
      <rect x="582" y="330" width="28" height="12" rx="3" />
      <path d="M330 340 C330 300 365 285 400 268 C435 285 470 300 470 340" stroke-width="3" opacity="0.8" />
      <line x1="330" y1="340" x2="470" y2="340" stroke-width="3" opacity="0.8" />
    </g>
  )}

  {name === 'card-duas' && (
    <g fill="none">
      <circle cx="150" cy="90" r="26" stroke={`url(#${p}-gold)`} stroke-width="3" opacity="0.8" />
      <path d="M176 90 A26 26 0 1 0 150 116 A21 21 0 1 1 176 90 Z" fill={`url(#${p}-gold)`} opacity="0.85" stroke="none" />
      <g stroke={`url(#${p}-gold)`} stroke-width="6" stroke-linecap="round">
        <path d="M282 330 C320 368 480 368 518 330" />
        <path d="M282 330 L248 282 M518 330 L552 282" stroke-width="12" />
      </g>
      <g stroke={`url(#${p}-gold)`} stroke-width="3" opacity="0.6">
        <line x1="400" y1="300" x2="400" y2="230" />
        <line x1="360" y1="300" x2="335" y2="240" />
        <line x1="440" y1="300" x2="465" y2="240" />
      </g>
      <g transform="translate(400,190)" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3">
        <rect x="-22" y="-22" width="44" height="44" />
        <rect x="-22" y="-22" width="44" height="44" transform="rotate(45)" />
      </g>
    </g>
  )}

  {name === 'card-kalimas' && (
    <g>
      <rect x="170" y="350" width="460" height="16" rx="4" fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <path d="M285 350 C285 260 340 222 400 192 C460 222 515 260 515 350" fill="#EFE7D2" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <line x1="400" y1="192" x2="400" y2="168" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <circle cx="400" cy="158" r="9" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <g fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="3">
        <rect x="216" y="230" width="30" height="120" />
        <rect x="208" y="262" width="46" height="10" />
        <polygon points="216,230 231,200 246,230" />
        <rect x="554" y="230" width="30" height="120" />
        <rect x="546" y="262" width="46" height="10" />
        <polygon points="554,230 569,200 584,230" />
      </g>
      <path d="M372 350 V300 C372 282 388 274 400 266 C412 274 428 282 428 300 V350" fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="3" />
    </g>
  )}

  {name === 'card-meanings' && (
    <g>
      <g stroke={`url(#${p}-gold)`} stroke-width="4">
        <polygon points="230,230 390,200 390,330 230,360" fill="#F5EFDC" />
        <polygon points="570,230 410,200 410,330 570,360" fill="#EFE3C8" />
      </g>
      <g stroke="#2A2160" stroke-width="5" stroke-linecap="round" opacity="0.65">
        <line x1="258" y1="248" x2="362" y2="230" />
        <line x1="258" y1="272" x2="362" y2="254" />
        <line x1="438" y1="230" x2="542" y2="248" />
        <line x1="438" y1="254" x2="542" y2="272" />
      </g>
      <g transform="translate(400,130)" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3.5">
        <rect x="-26" y="-26" width="52" height="52" />
        <rect x="-26" y="-26" width="52" height="52" transform="rotate(45)" />
        <circle r="7" fill={`url(#${p}-gold)`} stroke="none" />
      </g>
    </g>
  )}

  {name === 'card-waqiat' && (
    <g>
      <rect x="190" y="185" width="420" height="100" rx="10" fill="#EFE3C8" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <circle cx="190" cy="235" r="30" fill="#D9C89A" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <circle cx="610" cy="235" r="30" fill="#D9C89A" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <g stroke="#241C56" stroke-width="5" stroke-linecap="round" opacity="0.6">
        <line x1="250" y1="215" x2="480" y2="215" />
        <line x1="250" y1="238" x2="540" y2="238" />
        <line x1="250" y1="261" x2="430" y2="261" />
      </g>
      <circle cx="545" cy="315" r="28" fill="#8E2F3C" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <g transform="translate(545,315) scale(0.55)" fill="none" stroke="#F7E08B" stroke-width="4">
        <rect x="-22" y="-22" width="44" height="44" />
        <rect x="-22" y="-22" width="44" height="44" transform="rotate(45)" />
      </g>
    </g>
  )}

  {name === 'article-kaaba' && (
    <g>
      <g fill="#F7E08B">
        <circle cx="140" cy="90" r="2.4" opacity="0.7" /><circle cx="660" cy="70" r="2" opacity="0.6" />
        <circle cx="600" cy="150" r="1.8" opacity="0.5" /><circle cx="200" cy="160" r="1.8" opacity="0.5" />
      </g>
      <ellipse cx="400" cy="392" rx="190" ry="16" fill="#000000" opacity="0.5" />
      <polygon points="310,190 358,148 542,148 494,190" fill="#1E1E1E" stroke="#3A3A3A" stroke-width="2" />
      <polygon points="494,190 542,148 542,328 494,370" fill="#050505" stroke="#2A2A2A" stroke-width="2" />
      <rect x="310" y="190" width="184" height="180" fill="#101010" stroke="#2E2E2E" stroke-width="2" />
      <polygon points="494,242 542,200 542,228 494,270" fill={`url(#${p}-gold)`} opacity="0.95" />
      <rect x="310" y="242" width="184" height="28" fill={`url(#${p}-gold)`} opacity="0.95" />
      <rect x="452" y="288" width="30" height="82" fill={`url(#${p}-gold)`} opacity="0.8" />
    </g>
  )}

  {name === 'article-prayer' && (
    <g>
      <rect x="288" y="70" width="224" height="320" rx="16" fill="#7A2E3A" stroke={`url(#${p}-gold)`} stroke-width="5" />
      <rect x="310" y="92" width="180" height="276" rx="8" fill="none" stroke={`url(#${p}-gold)`} stroke-width="2" opacity="0.8" />
      <path d="M332 236 V176 C332 146 368 134 400 114 C432 134 468 146 468 176 V236" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3.5" />
      <line x1="400" y1="60" x2="400" y2="30" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <g transform="translate(400,20)" fill="none" stroke={`url(#${p}-gold)`} stroke-width="2.5">
        <rect x="-8" y="-8" width="16" height="16" />
        <rect x="-8" y="-8" width="16" height="16" transform="rotate(45)" />
      </g>
      <g stroke={`url(#${p}-gold)`} stroke-width="3" opacity="0.85">
        <line x1="300" y1="390" x2="300" y2="408" /><line x1="320" y1="390" x2="320" y2="408" />
        <line x1="340" y1="390" x2="340" y2="408" /><line x1="360" y1="390" x2="360" y2="408" />
        <line x1="380" y1="390" x2="380" y2="408" /><line x1="400" y1="390" x2="400" y2="408" />
        <line x1="420" y1="390" x2="420" y2="408" /><line x1="440" y1="390" x2="440" y2="408" />
        <line x1="460" y1="390" x2="460" y2="408" /><line x1="480" y1="390" x2="480" y2="408" />
        <line x1="500" y1="390" x2="500" y2="408" />
      </g>
    </g>
  )}

  {name === 'article-istiqlal' && (
    <g>
      <rect x="150" y="360" width="500" height="14" rx="4" fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <path d="M255 360 C255 240 320 195 400 160 C480 195 545 240 545 360" fill="#EFE7D2" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <line x1="400" y1="160" x2="400" y2="128" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <circle cx="400" cy="118" r="10" fill="none" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <path d="M410 118 A10 10 0 1 0 400 128 A8 8 0 1 1 410 118 Z" fill={`url(#${p}-gold)`} opacity="0.9" stroke="none" />
      <g fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="3">
        <rect x="196" y="200" width="30" height="160" />
        <rect x="188" y="238" width="46" height="10" />
        <rect x="188" y="292" width="46" height="10" />
        <polygon points="196,200 211,168 226,200" />
        <rect x="574" y="200" width="30" height="160" />
        <rect x="566" y="238" width="46" height="10" />
        <rect x="566" y="292" width="46" height="10" />
        <polygon points="574,200 589,168 604,200" />
      </g>
      <path d="M368 360 V316 C368 300 386 294 400 286 C414 294 432 300 432 316 V360" fill="#241C56" stroke={`url(#${p}-gold)`} stroke-width="3" />
      <g fill="#F7E08B">
        <circle cx="140" cy="110" r="2.2" opacity="0.6" /><circle cx="660" cy="100" r="2.2" opacity="0.6" />
        <circle cx="600" cy="170" r="1.8" opacity="0.5" /><circle cx="200" cy="150" r="1.8" opacity="0.5" />
      </g>
    </g>
  )}

  {name === 'article-dates' && (
    <g>
      <g fill="none" stroke="#5EC8B4" stroke-width="5" stroke-linecap="round" opacity="0.9">
        <path d="M400 150 C360 120 310 115 270 130" />
        <path d="M400 150 C440 120 490 115 530 130" />
        <path d="M400 150 C400 125 400 115 400 100" />
      </g>
      <path d="M270 250 C270 320 330 345 400 345 C470 345 530 320 530 250" fill="#6B4423" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <ellipse cx="400" cy="250" rx="130" ry="24" fill="#3A2412" stroke={`url(#${p}-gold)`} stroke-width="4" />
      <g fill="#2E1A0E" stroke="#A9763B" stroke-width="3">
        <ellipse cx="350" cy="232" rx="17" ry="25" />
        <ellipse cx="400" cy="222" rx="17" ry="25" />
        <ellipse cx="450" cy="232" rx="17" ry="25" />
        <ellipse cx="375" cy="252" rx="17" ry="22" />
        <ellipse cx="425" cy="252" rx="17" ry="22" />
      </g>
      <path d="M320 345 H480" stroke={`url(#${p}-gold)`} stroke-width="4" stroke-linecap="round" />
    </g>
  )}

  {name === 'article-desert' && (
    <g>
      <circle cx="560" cy="235" r="64" fill={`url(#${p}-gold)`} opacity="0.22" />
      <circle cx="560" cy="235" r="38" fill={`url(#${p}-gold)`} opacity="0.95" />
      <g fill="#F7E08B">
        <circle cx="150" cy="80" r="2.2" opacity="0.7" /><circle cx="300" cy="55" r="1.8" opacity="0.6" />
        <circle cx="680" cy="70" r="2.2" opacity="0.7" /><circle cx="480" cy="45" r="1.6" opacity="0.5" />
      </g>
      <path d="M0 330 Q200 278 400 318 T800 308 V450 H0 Z" fill="#0C4A38" />
      <path d="M0 372 Q220 330 430 366 T800 356 V450 H0 Z" fill="#10604A" />
      <path d="M0 412 Q250 382 500 406 T800 400 V450 H0 Z" fill="#177A5C" />
    </g>
  )}

  <rect width="800" height="450" fill={`url(#${p}-vig)`} />
</svg>
