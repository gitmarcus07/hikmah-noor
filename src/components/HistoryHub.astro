---
/* History hub: 20 landmark events in chronological order -> per-event SEO detail pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import HistoryArt from './HistoryArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { HISTORY, historyByEra } from '../data/history';
import { localizeHistoryList } from '../lib/content-i18n';
import { secUI2, HISTORY_UI } from '../lib/site-ui-2';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI2(locale, HISTORY_UI);
const L = (p: string) => localizedPath(locale, p);

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/history/' },
];
const ERAS = T.hubEras;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath="/history/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{HISTORY.length} {T.badgeN}</span>
        <span class="hn-badge">{T.badge2}</span>
        <span class="hn-badge">{T.badge3}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{T.seeratLine} <a href={L('/seerat/')} class="font-bold" style="color:var(--hn-primary)">{T.seeratLink}</a></p>
    </div>

    <div class="mt-6 max-w-3xl">
      <input id="historyfilter" class="hn-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
    </div>
    <p id="historycount" class="text-sm mt-4" style="color:var(--hn-muted)"></p>

    {ERAS.map((e: any) => {
      const list = localizeHistoryList(historyByEra(e.era), locale);
      return (
        <div class="mt-8" data-era-block>
          <SectionHeader eyebrow={e.eyebrow} title={e.title} sub={e.sub} />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((h) => (
              <a href={L(`/history/${h.slug}/`)} data-search={`${h.order} ${h.title} ${h.name} ${h.year} ${h.summary} ${(h.aliases || []).join(' ')}`.toLowerCase()} class="hn-filterrow hn-card hn-card-hover overflow-hidden block">
                <span class="block overflow-hidden"><HistoryArt motif={h.motif} arabic={h.arabic} name={h.name} accent={h.accent} /></span>
                <span class="block hn-card-pad">
                  <span class="flex items-center gap-1.5">
                    <span class="hn-verse-num shrink-0">{h.order}</span>
                    <span class="hn-badge hn-badge-primary">{h.year}</span>
                  </span>
                  <span class="font-extrabold block text-[17px] leading-7 mt-2">{h.title}</span>
                  <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{h.summary}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      );
    })}
    <script is:inline>
      (() => {
        const input = document.getElementById('historyfilter');
        const count = document.getElementById('historycount');
        const rows = [...document.querySelectorAll('.hn-filterrow')];
        const blocks = [...document.querySelectorAll('[data-era-block]')];
        if (count) count.textContent = `${rows.length} events`;
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          let n = 0;
          rows.forEach((r) => {
            const show = !q || (r.dataset.search || '').includes(q);
            r.classList.toggle('hidden', !show);
            if (show) n++;
          });
          blocks.forEach((b) => {
            const visible = [...b.querySelectorAll('.hn-filterrow')].some((r) => !r.classList.contains('hidden'));
            b.classList.toggle('hidden', !visible);
          });
          if (count) count.textContent = `${n} ${n === 1 ? 'event' : 'events'}`;
        });
      })();
    </script>
    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">{dict.article.faq}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
