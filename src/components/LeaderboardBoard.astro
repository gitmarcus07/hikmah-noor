---
/* Global leaderboard — top readers by hasanat, verses or streak.
 * Only readers with a @username appear (public, no emails/names).
 */
import { localizedPath } from '../i18n/utils';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const readUrl = localizedPath(locale, '/tools/read/');
const profileUrl = localizedPath(locale, '/profile/');
const userBase = localizedPath(locale, '/user/');

const TABS = [
  ['hasanat', '💗 Hasanat'],
  ['verses', '📖 Verses'],
  ['streak', '🔥 Streak'],
] as const;
---

<div class="max-w-3xl mx-auto px-4 py-8" data-lb>
  <div class="text-center">
    <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-gold-300">🏆 Global leaderboard</p>
    <h1 class="text-3xl md:text-4xl font-extrabold text-white mt-1">Top readers</h1>
    <p class="mt-2 text-ink-300 text-[15px]">Readers around the world, ranked by their Quran habit. Updated live.</p>
  </div>

  <div class="mt-5 flex gap-2" role="tablist" aria-label="Ranking">
    {TABS.map(([v, label], i) => (
      <button data-lb-by={v} role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={`flex-1 rounded-full px-4 py-2.5 text-sm font-extrabold transition min-h-[44px] ${i === 0 ? 'bg-gold-300 text-night-900' : 'bg-night-850 border border-white/10 text-ink-300'}`}>{label}</button>
    ))}
  </div>

  <div data-lb-me class="hidden mt-4 flex items-center gap-3 bg-brand-500/10 border border-brand-500/40 rounded-2xl px-4 py-3">
    <span class="text-2xl">⭐</span>
    <p class="text-sm font-bold text-ink-50">You rank <b data-lb-merank class="text-gold-300">#–</b> <span data-lb-meval class="text-ink-300"></span></p>
    <a href={readUrl} class="ms-auto text-sm font-extrabold text-brand-300 hover:text-brand-200 shrink-0">Read →</a>
  </div>

  <div data-lb-loading class="mt-4 space-y-2.5 animate-pulse">
    <div class="h-20 bg-night-850 border border-white/10 rounded-2xl"></div>
    <div class="h-16 bg-night-850 border border-white/10 rounded-2xl"></div>
    <div class="h-16 bg-night-850 border border-white/10 rounded-2xl"></div>
  </div>

  <div data-lb-empty class="hidden mt-4 text-center bg-night-850 border border-white/10 rounded-3xl p-8">
    <div class="text-5xl">🌱</div>
    <p class="mt-3 font-extrabold text-lg text-white">No readers on this board yet</p>
    <p class="mt-1 text-sm text-ink-300">Be the first — read a verse today and claim the top spot.</p>
    <a data-lb-read href={readUrl} class="mt-4 inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">📖 Start reading</a>
  </div>

  <div data-lb-podium class="hidden mt-4 grid grid-cols-3 gap-2"></div>
  <div data-lb-list class="mt-3 space-y-2.5"></div>

  <p class="mt-5 text-center text-xs text-ink-500 leading-5">Only readers with a <b>@username</b> appear here — emails and real names stay private.<br /><a href={profileUrl} class="font-bold text-gold-300 hover:text-amber-200">Set your username on your profile →</a></p>
</div>

<script define:vars={{ readUrl, userBase }}>
  (() => {
    const root = document.querySelector('[data-lb]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);
    let H = null, by = 'hasanat';

    const UNITS = { hasanat: 'hasanat', verses: 'verses', streak: 'day streak' };
    const MEDALS = ['🥇', '🥈', '🥉'];
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const fmt = (v) => by === 'streak' ? String(v) : (H?.fmtCompact ? H.fmtCompact(v) : String(v));
    const face = (l) => {
      try {
        if (H?.faceFor) return H.faceFor({ avatar: l.avatar, avatar_emoji: l.avatar_emoji, name: l.username });
      } catch { /* fallback below */ }
      return esc((l.username || '?').charAt(0).toUpperCase());
    };

    const row = (l) => `
      <a href="${userBase}?u=${encodeURIComponent(l.username)}" class="flex items-center gap-3 bg-night-850 border border-white/10 hover:border-brand-500/50 rounded-2xl px-4 py-3 transition">
        <span class="w-8 text-center font-extrabold ${l.rank <= 3 ? 'text-gold-300' : 'text-ink-500'}">${l.rank}</span>
        <span class="w-10 h-10 shrink-0 grid place-items-center rounded-full bg-brand-500/15 border border-white/10 overflow-hidden text-lg font-extrabold text-white">${face(l)}</span>
        <span class="min-w-0">
          <span class="block font-bold text-ink-50 truncate">@${esc(l.username)}</span>
          <span class="block text-xs text-ink-500 truncate">${esc(l.country) || '🌍 Global reader'}</span>
        </span>
        <span class="ms-auto text-end shrink-0">
          <span class="block font-extrabold text-lg text-white">${fmt(l.value)}</span>
          <span class="block text-[11px] font-bold text-ink-500">${UNITS[by]}</span>
        </span>
      </a>`;

    const podiumCard = (l, i) => `
      <a href="${userBase}?u=${encodeURIComponent(l.username)}" class="bg-night-850 border ${i === 0 ? 'border-gold-300/50' : 'border-white/10'} hover:border-brand-500/50 rounded-3xl p-4 text-center transition">
        <div class="text-2xl">${MEDALS[i]}</div>
        <div class="mx-auto mt-2 w-14 h-14 grid place-items-center rounded-full bg-brand-500/15 border border-white/10 overflow-hidden text-xl font-extrabold text-white">${face(l)}</div>
        <p class="mt-2 font-bold text-sm text-ink-50 truncate">@${esc(l.username)}</p>
        <p class="font-extrabold text-gold-300">${fmt(l.value)}</p>
        <p class="text-[11px] font-bold text-ink-500">${UNITS[by]}</p>
      </a>`;

    const paint = (d) => {
      const leaders = d.leaders || [];
      $('[data-lb-loading]')?.classList.add('hidden');
      const me = $('[data-lb-me]');
      if (d.me) {
        me?.classList.remove('hidden');
        const r = me?.querySelector('[data-lb-merank]');
        const v = me?.querySelector('[data-lb-meval]');
        if (r) r.textContent = `#${d.me.rank}`;
        if (v) v.textContent = `• ${fmt(d.me.value)} ${UNITS[by]}`;
      } else {
        me?.classList.add('hidden');
      }
      if (!leaders.length) {
        $('[data-lb-empty]')?.classList.remove('hidden');
        $('[data-lb-podium]')?.classList.add('hidden');
        const list = $('[data-lb-list]');
        if (list) list.innerHTML = '';
        return;
      }
      $('[data-lb-empty]')?.classList.add('hidden');
      const pod = $('[data-lb-podium]');
      if (pod) {
        pod.classList.remove('hidden');
        pod.innerHTML = leaders.slice(0, 3).map(podiumCard).join('');
      }
      const list = $('[data-lb-list]');
      if (list) list.innerHTML = leaders.slice(3).map(row).join('');
    };

    const load = async () => {
      $('[data-lb-loading]')?.classList.remove('hidden');
      $('[data-lb-empty]')?.classList.add('hidden');
      try {
        const d = await H.Me.leaderboard(by, 30);
        paint(d);
      } catch {
        $('[data-lb-loading]')?.classList.add('hidden');
        $('[data-lb-empty]')?.classList.remove('hidden');
      }
    };

    root.querySelectorAll('[data-lb-by]').forEach((btn) => btn.addEventListener('click', async () => {
      by = btn.dataset.lbBy;
      root.querySelectorAll('[data-lb-by]').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('bg-gold-300', on);
        b.classList.toggle('text-night-900', on);
        b.classList.toggle('bg-night-850', !on);
        b.classList.toggle('text-ink-300', !on);
        b.setAttribute('aria-selected', String(on));
      });
      await load();
    }));

    (async () => {
      H = await import('/habits/habit.js?v=4');
      await load();
      try {
        const { resume } = await H.Me.resume().catch(() => ({ resume: null }));
        if (resume) {
          const a = $('[data-lb-read]');
          if (a) { const base = String(readUrl).replace(/\/$/, ''); a.href = `${base}/${resume.surah}/?verse=${resume.verse}`; }
        }
      } catch {}
    })();
  })();
</script>
