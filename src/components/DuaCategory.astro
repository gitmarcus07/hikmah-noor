---
/* Dua category landing: intro + count + list + related categories + FAQ. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { DUA_CATS } from '../data/duas';
import { localizeList } from '../lib/duas-i18n';
import { localizeDuaCat, duaUI } from '../lib/dua-ui-i18n';

interface Props { cat: any; duas: any[]; locale: string; }
const { cat, duas: duasRaw, locale } = Astro.props;
const catL = localizeDuaCat(cat, locale);
const duas = localizeList(duasRaw, locale);
const dict = getDict(locale);
const T = duaUI(locale);
const L = (p: string) => localizedPath(locale, p);
const catPath = `/duas/${cat.slug}/`;

const title = T.catTitle.replace('{c}', catL.title).replace('{n}', String(duas.length));
const topNames = duas.slice(0, 3).map((d: any) => d.title).join(', ');
let description = `${duas.length} — ${catL.title}: ${topNames}. ${catL.desc}`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const sourceNames = [...new Set(duas.map((d: any) => String(d.source || '').split(';')[0].trim()).filter(Boolean))].slice(0, 4).join(', ');
const keywords = `${catL.title.toLowerCase()}, ${duas.map((d: any) => d.title.toLowerCase()).slice(0, 6).join(', ')}${sourceNames ? `, ${sourceNames.toLowerCase()}` : ''}`;

const faq = [
  { q: T.faqCatWhich.replace('{c}', catL.title), a: `${duas.map((d: any) => d.title).join('; ')}.` },
  { q: T.faqCatAuth.replace('{c}', catL.title), a: T.faqCatAuthA },
  { q: T.faqCatHow.replace('{c}', catL.title), a: T.faqCatHowA },
  { q: T.faqCatTr, a: T.faqCatTrA.replace('{c}', catL.title) },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: dict.nav.duas, path: '/duas/' },
  { name: catL.title, path: catPath },
];
const siblings = DUA_CATS.filter((c) => c.slug !== cat.slug).map((c) => localizeDuaCat(c, locale));
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath={catPath}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 flex items-start gap-3.5 max-w-3xl">
      <span class="w-12 h-12 shrink-0 grid place-items-center rounded-[12px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={cat.icon as any || 'duas'} size={26} /></span>
      <div class="min-w-0">
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">{catL.title}</h1>
        <p class="mt-2 leading-7" style="color:var(--hn-muted)">{catL.desc}</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="hn-badge hn-badge-primary">{duas.length} {T.badges.duas}</span>
          <span class="hn-badge">{dict.article.arabic} + {dict.article.transliteration} + {dict.article.meaning}</span>
        </div>
      </div>
    </div>

    <div class="mt-6 max-w-3xl">
      <input id="catfilter" class="hn-input" placeholder={T.catFilterPh} aria-label={T.catFilterPh} />
    </div>

    <section class="mt-6 max-w-3xl hn-card hn-card-pad" aria-label={T.howTitle.replace('{c}', catL.title)}>
      <h2 class="font-extrabold text-lg leading-7">{T.howTitle.replace('{c}', catL.title)}</h2>
      <p class="mt-2 text-[15px] leading-7" style="color:var(--hn-muted)">{T.howBody.replace('{d}', catL.desc).replace('{t}', topNames).replace('{s}', sourceNames ? ` (${sourceNames})` : '')}</p>
    </section>

    <div class="mt-4 grid gap-3 md:grid-cols-2" id="catgrid">
      {duas.map((d: any, i: number) => (
        <a href={L(`/duas/${d.cat}/${d.slug}/`)} data-search={`${d.title} ${d.use}${(d as any).hisnNo ? ` hisn ${(d as any).hisnNo}` : ''}`.toLowerCase()} class="catrow hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
          <span class="hn-verse-num shrink-0">{i + 1}</span>
          <span class="min-w-0">
            <span class="font-extrabold block leading-6">{d.title}</span>
            <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">{T.forPrefix} {d.use}</span>
            <span class="mt-1.5 flex flex-wrap gap-1.5">
              {d.grade && <span class="hn-badge hn-badge-primary">{d.grade}</span>}
              <span class="hn-badge">{d.source}</span>
              {(d as any).hisnNo && <span class="hn-badge hn-badge-gold">Hisn #{(d as any).hisnNo}</span>}
            </span>
          </span>
        </a>
      ))}
    </div>
    <script is:inline>
      (() => {
        const input = document.getElementById('catfilter');
        const rows = [...document.querySelectorAll('.catrow')];
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          rows.forEach((r) => r.classList.toggle('hidden', !!q && !(r.dataset.search || '').includes(q)));
        });
      })();
    </script>

    <section class="mt-8 max-w-3xl" aria-label={T.faqTitle}>
      <SectionHeader eyebrow="FAQ" title={T.faqTitle} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label={T.secCategories}>
      <SectionHeader eyebrow={T.relatedEyebrow} title={T.secCategories} href={L('/duas/')} linkLabel={dict.nav.duas} />
      <div class="flex flex-wrap gap-2">
        {siblings.map((s) => (
          <a href={L(`/duas/${s.slug}/`)} class="hn-badge hn-card-hover" style="padding:0.55rem 1rem;font-size:0.85rem">{s.title}</a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
