---
/* Dua category landing: intro + count + list + related categories + FAQ. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { localizedPath } from '../i18n/utils';
import { DUA_CATS } from '../data/duas';

interface Props { cat: any; duas: any[]; locale: string; }
const { cat, duas, locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const catPath = `/duas/${cat.slug}/`;

const title = `${cat.title} Duas in Arabic with Meaning (${duas.length} duas)`;
let description = `${duas.length} authentic ${cat.title.toLowerCase()} duas: ${duas.slice(0, 3).map((d: any) => d.title).join(', ')} and more — Arabic, transliteration, meaning, virtue.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${cat.title.toLowerCase()} duas, dua in arabic, transliteration, meaning, ${duas.map((d: any) => d.title.toLowerCase()).slice(0, 5).join(', ')}`;

const faq = [
  { q: `Which ${cat.title.toLowerCase()} duas are included?`, a: `${duas.map((d: any) => d.title).join('; ')}. Open any dua for Arabic text, transliteration, meaning, narrator, grade and source.` },
  { q: `Are these ${cat.title.toLowerCase()} duas authentic?`, a: `Every dua names its source (Quran passage or hadith collection) without invented numbers, plus narrator where known and a Sahih/Hasan/Daif or Quranic grade. Learn wording from a teacher; consult scholars for rulings.` },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Duas', path: '/duas/' },
  { name: cat.title, path: catPath },
];
const siblings = DUA_CATS.filter((c) => c.slug !== cat.slug);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={catPath}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 flex items-start gap-3.5 max-w-3xl">
      <span class="w-12 h-12 shrink-0 grid place-items-center rounded-[12px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={cat.icon as any || 'duas'} size={26} /></span>
      <div class="min-w-0">
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">{cat.title} Duas</h1>
        <p class="mt-2 leading-7" style="color:var(--hn-muted)">{cat.desc}</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="hn-badge hn-badge-primary">{duas.length} duas</span>
          <span class="hn-badge">Arabic + transliteration + meaning</span>
        </div>
      </div>
    </div>

    <div class="mt-6 max-w-3xl">
      <input id="catfilter" class="hn-input" placeholder="Filter in this category — e.g. rain, debt, parents…" aria-label="Filter duas" />
    </div>

    <div class="mt-4 grid gap-3 md:grid-cols-2" id="catgrid">
      {duas.map((d: any, i: number) => (
        <a href={L(`/duas/${d.cat}/${d.slug}/`)} data-search={`${d.title} ${d.use}`.toLowerCase()} class="catrow hn-card hn-card-hover hn-card-pad flex gap-3.5 items-start">
          <span class="hn-verse-num shrink-0">{i + 1}</span>
          <span class="min-w-0">
            <span class="font-extrabold block leading-6">{d.title}</span>
            <span class="text-sm leading-6 block mt-0.5" style="color:var(--hn-muted)">For: {d.use}</span>
            <span class="mt-1.5 flex flex-wrap gap-1.5">
              {d.grade && <span class="hn-badge hn-badge-primary">{d.grade}</span>}
              <span class="hn-badge">{d.source}</span>
            </span>
          </span>
        </a>
      ))}
    </div>
    <script is:inline>
      (() => {
        const input = document.getElementById('catfilter');
        const rows = [...document.querySelectorAll('.catrow')];
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          rows.forEach((r) => r.classList.toggle('hidden', !!q && !(r.dataset.search || '').includes(q)));
        });
      })();
    </script>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label="All dua categories">
      <SectionHeader eyebrow="More" title="All dua categories" href={L('/duas/')} linkLabel="All duas" />
      <div class="flex flex-wrap gap-2">
        {siblings.map((s) => (
          <a href={L(`/duas/${s.slug}/`)} class="hn-badge hn-card-hover" style="padding:0.55rem 1rem;font-size:0.85rem">{s.title}</a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
