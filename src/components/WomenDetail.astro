---
/* Woman-figure detail — reading page with own branding. Prev/next by order. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import WomenArt from './WomenArt.astro';
import BookmarkButton from './hn/BookmarkButton.astro';
import ShareButtons from './hn/ShareButtons.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { WOMEN, prevWoman, nextWoman } from '../data/women';
import { localizeStory, localizeStoryList } from '../lib/stories-i18n';
import { secUI, secE, WOMEN_UI } from '../lib/site-ui-1';
import RelatedContent from './RelatedContent.astro';

interface Props { woman: any; locale: string; }
const { locale } = Astro.props;
const woman = localizeStory((Astro.props as any).woman, 'women', locale);
const dict = getDict(locale);
const T = secUI(locale, WOMEN_UI);
const E = secE(locale);
const L = (p: string) => localizedPath(locale, p);
const womanPath = `/women/${woman.slug}/`;

const title = `${woman.title}${T.detSuffix}`;
let description = `${woman.title}: ${woman.summary}`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${woman.title.toLowerCase()}, hazrat ${woman.name.toLowerCase()} story, women in islam${woman.aliases?.length ? `, ${woman.aliases.join(', ')}` : ''}`;

const faq = [
  { q: T.detFaqWho.replace('{p}', woman.name), a: woman.summary },
  { q: T.detFaqLes.replace('{p}', woman.name), a: woman.lessons.map((l: string, i: number) => `${i + 1}. ${l}`).join(' ') },
  { q: T.detFaqWhere, a: `${woman.references}.` },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/women/' },
  { name: woman.title, path: womanPath },
];
const others = localizeStoryList(WOMEN.filter((w) => w.slug !== woman.slug && w.era === woman.era).concat(WOMEN.filter((w) => w.slug !== woman.slug && w.era !== woman.era)).slice(0, 4), 'women', locale);
const prevP = localizeStory(prevWoman(woman.order), 'women', locale);
const nextP = localizeStory(nextWoman(woman.order), 'women', locale);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={womanPath}>
  <div class="hn-article hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 2)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{T.badgeFig.replace('{o}', String(woman.order))}</span>
      <span class="hn-badge">{woman.era}</span>
      <span class="hn-badge hn-badge-gold">{woman.name}</span>
      <span class="ms-auto"><BookmarkButton kind="women" bmRef={womanPath} title={woman.title} locale={locale} /></span>
      <ShareButtons title={woman.title} path={womanPath} locale={locale} />
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{woman.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{woman.summary}</p>
    {woman.aliases?.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">{T.alsoSearched} {woman.aliases.map((a: string, i: number) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="hn-card overflow-hidden my-6">
      <WomenArt motif={woman.motif} arabic={woman.arabic} prophet={woman.name} accent={woman.accent} />
    </div>

    <div class="hn-reading-card">
      <p class="hn-block-label">{T.emblemL}</p>
      <p class="arabic-block" lang="ar" dir="rtl">{woman.arabic}</p>
      {woman.translit && (
        <>
          <hr class="hn-divider" />
          <p class="hn-block-label">{T.translitL}</p>
          <p class="translit-block">{woman.translit}</p>
        </>
      )}
    </div>

    <section class="mt-8" aria-label={T.secStory}>
      <SectionHeader eyebrow={E.story} title={T.secStory} />
      <div class="space-y-4">
        {(woman.narrative || []).map((p: string) => (
          <p class="hn-card hn-card-pad leading-8 text-[15px]">{p}</p>
        ))}
      </div>
      <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">{T.narratedL}</p>
    </section>

    <section class="mt-8" aria-label={T.timelineL}>
      <SectionHeader eyebrow={E.time} title={T.timelineL} />
      <ol class="space-y-3">
        {woman.events.map((e: string, i: number) => (
          <li class="hn-card hn-card-pad flex gap-3">
            <span class="hn-verse-num shrink-0">{i + 1}</span>
            <span class="leading-7 text-[15px]">{e}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-8" aria-label={T.reflectL}>
      <SectionHeader eyebrow={E.refl} title={T.reflectL} />
      <div class="hn-card hn-card-pad">
        <ul class="space-y-2.5 leading-7 text-[15px]">
          {woman.lessons.map((l: string) => <li class="flex items-start gap-2.5"><span style="color:var(--hn-gold)" class="font-extrabold">✦</span><span>{l}</span></li>)}
        </ul>
      </div>
    </section>
    <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">{T.refL} <strong style="color:var(--hn-ink)">{woman.references}</strong></p>
    <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{T.sahabaQ} <a href={L('/sahaba/')} class="font-bold" style="color:var(--hn-primary)">{T.sahabaA}</a></p>

    <section class="mt-8" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedContent type="women" slug={woman.slug} locale={locale} />

    <section class="mt-8" aria-label={T.moreTitle}>
      <SectionHeader eyebrow={T.moreTitle} title={T.moreTitle} href={L('/women/')} linkLabel={T.moreLink} />
      <div class="grid gap-3 sm:grid-cols-2">
        {others.map((r) => (
          <a href={L(`/women/${r.slug}/`)} class="hn-card hn-card-hover overflow-hidden block">
            <WomenArt motif={r.motif} arabic={r.arabic} prophet={r.name} accent={r.accent} />
            <span class="block hn-card-pad">
              <span class="font-bold block text-[15px] leading-6">{r.order}. {r.title}</span>
              <span class="text-[13px] line-clamp-2" style="color:var(--hn-muted)">{r.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {(prevP || nextP) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More figures">
        {prevP ? (
          <a href={L(`/women/${prevP.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.prevL.replace('{o}', String(prevP.order))}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevP.title}</span>
          </a>
        ) : <span />}
        {nextP && (
          <a href={L(`/women/${nextP.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.nextL.replace('{o}', String(nextP.order))}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextP.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
