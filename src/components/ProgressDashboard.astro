---
/* Home dashboard (Quranly-style) — greeting + streak pill, week dots,
 * purple Goal card (daily verses, live readers, resume, Juz bar),
 * Meaning Challenge hero (countdown, participants, progress),
 * Today/Week/All tabs, stat tiles, more challenges, bookmarks.
 * Login compulsory (auth gate). Mobile-first, max-w-md app column.
 */
import AuthModal from './AuthModal.astro';
import { localizedPath, getDict } from '../i18n/utils';
import surahsMeta from '../data/surahs-meta.json';
import parasMeta from '../data/paras-meta.json';

interface Props { locale: string; }
const { locale } = Astro.props;
const t = getDict(locale).app;
const readUrl = localizedPath(locale, '/tools/read/');
const habitUrl = localizedPath(locale, '/tools/habit-start/');
const profileUrl = localizedPath(locale, '/profile/');
// Minimal client lookups (kept tiny for inline script).
const surahShort = (surahsMeta as any[]).map((s) => [s.name, s.verseCount]);
const juzStarts = (parasMeta as any[]).map((p) => [p.start.surah, p.start.verse]);
// Primary IANA timezone per profile country (keys must match the profile
// country list). Multi-zone countries use the most populous zone.
const COUNTRY_TZ: Record<string, string> = {
  'Afghanistan': 'Asia/Kabul', 'Algeria': 'Africa/Algiers', 'Australia': 'Australia/Sydney',
  'Austria': 'Europe/Vienna', 'Azerbaijan': 'Asia/Baku', 'Bahrain': 'Asia/Bahrain',
  'Bangladesh': 'Asia/Dhaka', 'Belgium': 'Europe/Brussels', 'Bosnia & Herzegovina': 'Europe/Sarajevo',
  'Brazil': 'America/Sao_Paulo', 'Brunei': 'Asia/Brunei', 'Bulgaria': 'Europe/Sofia',
  'Cambodia': 'Asia/Phnom_Penh', 'Canada': 'America/Toronto', 'Chad': 'Africa/Ndjamena',
  'China': 'Asia/Shanghai', 'Denmark': 'Europe/Copenhagen', 'Djibouti': 'Africa/Djibouti',
  'Egypt': 'Africa/Cairo', 'Ethiopia': 'Africa/Addis_Ababa', 'Fiji': 'Pacific/Fiji',
  'Finland': 'Europe/Helsinki', 'France': 'Europe/Paris', 'Gambia': 'Africa/Banjul',
  'Germany': 'Europe/Berlin', 'Ghana': 'Africa/Accra', 'Greece': 'Europe/Athens',
  'Guinea': 'Africa/Conakry', 'Guyana': 'America/Guyana', 'India': 'Asia/Kolkata',
  'Indonesia': 'Asia/Jakarta', 'Iran': 'Asia/Tehran', 'Iraq': 'Asia/Baghdad',
  'Ireland': 'Europe/Dublin', 'Italy': 'Europe/Rome', 'Japan': 'Asia/Tokyo',
  'Jordan': 'Asia/Amman', 'Kazakhstan': 'Asia/Almaty', 'Kenya': 'Africa/Nairobi',
  'Kosovo': 'Europe/Belgrade', 'Kuwait': 'Asia/Kuwait', 'Kyrgyzstan': 'Asia/Bishkek',
  'Lebanon': 'Asia/Beirut', 'Libya': 'Africa/Tripoli', 'Malaysia': 'Asia/Kuala_Lumpur',
  'Maldives': 'Indian/Maldives', 'Mali': 'Africa/Bamako', 'Malta': 'Europe/Malta',
  'Mauritania': 'Africa/Nouakchott', 'Mauritius': 'Indian/Mauritius', 'Morocco': 'Africa/Casablanca',
  'Mozambique': 'Africa/Maputo', 'Myanmar': 'Asia/Yangon', 'Nepal': 'Asia/Kathmandu',
  'Netherlands': 'Europe/Amsterdam', 'New Zealand': 'Pacific/Auckland', 'Niger': 'Africa/Niamey',
  'Nigeria': 'Africa/Lagos', 'Norway': 'Europe/Oslo', 'Oman': 'Asia/Muscat',
  'Pakistan': 'Asia/Karachi', 'Palestine': 'Asia/Gaza', 'Philippines': 'Asia/Manila',
  'Poland': 'Europe/Warsaw', 'Portugal': 'Europe/Lisbon', 'Qatar': 'Asia/Qatar',
  'Romania': 'Europe/Bucharest', 'Russia': 'Europe/Moscow', 'Saudi Arabia': 'Asia/Riyadh',
  'Senegal': 'Africa/Dakar', 'Singapore': 'Asia/Singapore', 'Somalia': 'Africa/Mogadishu',
  'South Africa': 'Africa/Johannesburg', 'South Korea': 'Asia/Seoul', 'Spain': 'Europe/Madrid',
  'Sri Lanka': 'Asia/Colombo', 'Sudan': 'Africa/Khartoum', 'Suriname': 'America/Paramaribo',
  'Sweden': 'Europe/Stockholm', 'Switzerland': 'Europe/Zurich', 'Syria': 'Asia/Damascus',
  'Taiwan': 'Asia/Taipei', 'Tajikistan': 'Asia/Dushanbe', 'Tanzania': 'Africa/Dar_es_Salaam',
  'Thailand': 'Asia/Bangkok', 'Trinidad & Tobago': 'America/Port_of_Spain', 'Tunisia': 'Africa/Tunis',
  'Turkey': 'Europe/Istanbul', 'Turkmenistan': 'Asia/Ashgabat', 'Uganda': 'Africa/Kampala',
  'Ukraine': 'Europe/Kyiv', 'United Arab Emirates': 'Asia/Dubai', 'United Kingdom': 'Europe/London',
  'United States': 'America/New_York', 'Uzbekistan': 'Asia/Tashkent', 'Yemen': 'Asia/Aden',
  'Zimbabwe': 'Africa/Harare',
};
---
<div class="max-w-md mx-auto px-4 py-5" data-dash>
  <div data-dash-loading class="animate-pulse space-y-3">
    <div class="h-16 bg-night-850 border border-white/10 rounded-3xl"></div>
    <div class="h-64 bg-night-850 border border-white/10 rounded-[28px]"></div>
    <div class="h-40 bg-night-850 border border-white/10 rounded-[28px]"></div>
  </div>

  <div data-dash-gate class="hidden text-center bg-night-850 border border-white/10 rounded-[28px] p-8">
    <div class="text-5xl">🔒</div>
    <h1 class="text-2xl font-extrabold text-white mt-3">{t.dash.gateT}</h1>
    <p class="mt-1 text-ink-300 text-[15px]">{t.dash.gateD}</p>
    <button data-dash-login class="mt-5 w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">{t.dash.gateBtn}</button>
  </div>

  <div data-dash-live class="hidden space-y-4">
    {/* country nudge — challenges follow country time */}
    <a data-dash-countrynudge href={profileUrl} class="hidden items-center gap-2 rounded-2xl border border-gold-300/40 bg-gold-300/10 px-4 py-3 text-sm font-bold text-gold-300 min-h-[52px]">🌍 {t.dash.countryNudge}</a>
    {/* onboarding nudge — fresh accounts finish the 7-step setup */}
    <a data-dash-onboard href={habitUrl} class="hidden items-center gap-2 rounded-2xl border border-brand-500/50 bg-brand-500/15 px-4 py-3 text-sm font-extrabold text-white min-h-[52px]">🌱 {t.dash.onboardNudge}</a>
    {/* header: greeting + streak pill (sticky) */}
    <div class="sticky top-14 z-30 py-2 bg-night-950/90 backdrop-blur-md flex items-center gap-3">
      <div data-dash-avatar class="w-12 h-12 shrink-0 grid place-items-center rounded-full overflow-hidden ring-2 ring-white/25 bg-gradient-to-br from-emerald-300 to-teal-500 text-xl font-extrabold text-night-900" aria-hidden="true">?</div>
      <div class="min-w-0">
        <p class="text-[13px] leading-5 text-ink-300">{t.dash.greeting}</p>
        <h1 class="text-[22px] leading-7 font-extrabold text-white truncate" data-dash-name>Reader</h1>
      </div>
      <div class="ms-auto flex items-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-2.5 py-2 shrink-0">
        <button data-dash-cal aria-label="My Quran journey" title="My Quran journey" class="text-xl leading-none min-w-[28px] min-h-[28px] grid place-items-center hover:scale-110 active:scale-95 transition">🗓️</button>
        <span class="w-px h-6 bg-white/15" aria-hidden="true"></span>
        <button data-dash-streakbtn aria-label="Daily streak" title="Daily streak" class="flex items-center gap-1 hover:scale-105 active:scale-95 transition">
          <span class="text-xl leading-none" aria-hidden="true">🔥</span>
          <span class="font-extrabold text-[17px] text-orange-400"><span data-dash-streak>0</span><span data-dash-sep class="text-ink-500 font-bold">/</span><span data-dash-goal class="text-ink-300">7</span></span>
        </button>
      </div>
    </div>

    {/* week dots */}
    <div data-dash-week class="flex items-center justify-between rounded-full border border-white/10 bg-white/5 px-3 py-2" aria-label="This week"></div>

    {/* goal card */}
    <section class="rounded-[28px] p-5 text-white shadow-xl shadow-purple-950/40 bg-gradient-to-br from-[#b79df7] via-[#a58bf5] to-[#8b6ff0]" aria-label="Daily goal">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="text-[26px] leading-7 font-extrabold">{t.dash.goal}</h2>
          <p class="mt-0.5 text-[15px] font-medium text-white/90">{t.dash.perDay}</p>
          <p class="text-[15px] font-bold"><span data-dash-todayv>0</span>/<span data-dash-dailygoal>1</span></p>
        </div>
        <div class="text-end shrink-0">
          <p class="flex items-center justify-end gap-1.5 text-[15px] font-extrabold"><span aria-hidden="true">👥</span><span data-dash-livecount>–</span></p>
          <p class="text-[13px] font-semibold text-white/90">{t.dash.live} <span class="text-emerald-300" aria-hidden="true">●</span></p>
        </div>
      </div>
      <p class="mt-3 text-[15px] font-semibold text-white/95">
        <a data-dash-resume href={readUrl} class="hover:underline"><span data-dash-resumelabel>{t.dash.startReading}</span></a>
        <a href={habitUrl} class="ms-1 hover:underline" title="Edit plan" aria-label="Edit plan">✏️</a>
      </p>
      <div class="mt-2 h-3.5 rounded-full bg-[#5b3fa8]/60 overflow-hidden" role="progressbar" aria-label="Daily goal progress"><div data-dash-goalbar class="h-full w-0 rounded-full bg-gradient-to-r from-[#2e2069] to-[#17103a] transition-all duration-500"></div></div>
      <div class="mt-1.5 flex items-center justify-between text-[15px] font-bold">
        <span data-dash-juz>{t.dash.juz} –/30</span><span data-dash-pct>0%</span>
      </div>
      <a data-dash-read href={readUrl} class="mt-3 flex items-center justify-center rounded-full bg-[#7c5cf0] hover:bg-[#6d4fd8] active:scale-[0.99] transition text-white text-lg font-extrabold px-6 py-3.5 min-h-[56px] shadow-lg shadow-purple-950/30">{t.dash.readQuran}</a>
    </section>

    {/* meaning challenge hero */}
    <section class="relative overflow-hidden rounded-[28px] border border-fuchsia-300/20 bg-[#12071f] text-white shadow-xl shadow-black/50" aria-label="The Meaning Challenge">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 80% 20%, rgba(217,70,239,.35), transparent 45%), radial-gradient(circle at 15% 85%, rgba(139,92,246,.4), transparent 50%), radial-gradient(circle at 50% 50%, rgba(245,201,76,.08), transparent 60%);"></div>
      <span data-dash-cd class="hidden absolute top-3 end-3 items-center gap-1.5 bg-[#f5b04c] text-night-900 text-[13px] font-extrabold rounded-full px-3 py-1.5 shadow">🕐 <span data-dash-cdtext></span></span>
      <a data-dash-chgo href={readUrl} class="relative block p-5 pt-6">
        <h2 class="text-[26px] leading-8 font-extrabold pe-24">{t.dash.meaningT}</h2>
        <p class="mt-1 text-[15px] leading-6 text-white/85">{t.dash.meaningD}</p>
        <p class="mt-3 flex items-center gap-2 text-[15px]"><span class="text-xl" aria-hidden="true">👥</span><b data-dash-parts class="text-lg">–</b><span class="text-white/80 font-medium">{t.dash.participants}</span></p>
        <div class="mt-2 h-3.5 rounded-full bg-white/25 overflow-hidden" role="progressbar" aria-label="Challenge progress"><div data-dash-chbar class="h-full w-0 rounded-full bg-gradient-to-r from-brand-300 to-gold-300 transition-all duration-500"></div></div>
        <div class="mt-1.5 flex items-center justify-between text-[15px] font-bold">
          <span data-dash-chjuz>1/30 {t.dash.juz}</span><span data-dash-chpct>0%</span>
        </div>
      </a>
    </section>

    {/* range tabs */}
    <div class="flex items-center gap-1" role="tablist" aria-label="Range">
      {[[ 'today', t.dash.today ], [ 'week', t.dash.week ], [ 'all', t.dash.all ]].map(([r, label], i) => (
        <button data-dash-range={r} role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={`flex-1 rounded-full px-4 py-2.5 text-[17px] transition min-h-[48px] ${i === 0 ? 'bg-[#5b3ba8] text-white font-extrabold shadow-lg shadow-purple-950/40' : 'text-ink-300 font-semibold hover:text-white'}`}>{label}</button>
      ))}
    </div>
    <div data-dash-tiles class="grid grid-cols-2 gap-3"></div>

    {/* more challenges */}
    <h2 id="challenges" class="text-xl font-extrabold text-white pt-1 scroll-mt-32">🏆 {t.dash.challenges}</h2>
    <div data-dash-challenges class="space-y-3"></div>
  </div>
</div>

{/* daily streak popup */}
<div data-dash-streakmodal class="hidden fixed inset-0 z-[80]" role="dialog" aria-modal="true" aria-label="Daily streak">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-dash-mclose></div>
  <div class="absolute inset-x-8 top-[32%] mx-auto max-w-sm bg-[#2e2e33] rounded-[26px] p-7 text-center shadow-2xl shadow-black/60">
    <h2 class="text-[22px] font-extrabold text-white">{t.streak.title}</h2>
    <p class="mt-2 text-[15px] leading-7 text-ink-200">{t.streak.text}</p>
    <p data-dash-mcount class="mt-3 text-lg font-extrabold text-orange-400"></p>
    <button data-dash-mclose class="mt-5 w-full rounded-full border border-white/25 text-white font-bold px-6 py-3 min-h-[52px] hover:bg-white/10 transition">{t.streak.ok}</button>
  </div>
</div>

{/* quran journey calendar */}
<div data-dash-journey class="hidden fixed inset-0 z-[80] bg-night-950 overflow-y-auto" role="dialog" aria-modal="true" aria-label="My Quran journey">
  <div class="max-w-md mx-auto px-4 py-5 min-h-full">
    <div class="flex items-center gap-3">
      <button data-dash-jclose aria-label="Back" class="w-12 h-9 grid place-items-center rounded-full border border-white/25 text-white text-lg hover:bg-white/10 transition">←</button>
      <h2 class="flex-1 text-center text-[20px] font-extrabold text-white">{t.journey.title}</h2>
      <span class="w-12 text-center text-ink-500 text-xl" aria-hidden="true">ⓘ</span>
    </div>
    <div class="mt-4 rounded-[26px] bg-gradient-to-br from-[#b79df7] via-[#a58bf5] to-[#8b6ff0] p-5 text-white shadow-xl">
      <p class="flex items-center justify-between text-[15px] font-bold"><span>🔥 <span data-dash-jcount>0</span> day streak</span><span>🏆 Longest <span data-dash-jlong>0</span></span></p>
      <p class="mt-1 text-[13px] font-semibold text-white/85"><span data-dash-jmv>0</span> {t.journey.verses} • <span data-dash-jmh>0</span> {t.journey.hasanat} {t.journey.thisMonth}</p>
    </div>
    <div class="mt-4 rounded-[26px] bg-night-850 border border-white/10 p-5">
      <div class="flex items-center justify-between">
        <button data-dash-jprev aria-label="Previous month" class="w-10 h-10 grid place-items-center rounded-full hover:bg-white/10 text-ink-300 text-xl">‹</button>
        <p data-dash-jtitle class="font-extrabold text-white text-[17px]">Month</p>
        <button data-dash-jnext aria-label="Next month" class="w-10 h-10 grid place-items-center rounded-full hover:bg-white/10 text-ink-300 text-xl">›</button>
      </div>
      <div class="mt-3 grid grid-cols-7 gap-1.5 text-center text-[11px] font-extrabold text-ink-500">
        <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
      </div>
      <div data-dash-jgrid class="mt-1.5 grid grid-cols-7 gap-1.5"></div>
    </div>
    <p data-dash-jerr class="hidden mt-3 text-center text-sm font-bold text-red-300"></p>
  </div>
  {/* locked until a 7-day streak is reached */}
  <div data-dash-jlocked class="hidden absolute inset-0 z-10 grid place-items-center bg-black/70 backdrop-blur-sm p-8">
    <div class="w-full max-w-sm bg-[#2e2e33] rounded-[26px] p-7 text-center shadow-2xl">
      <h3 class="text-[20px] font-extrabold text-white">{t.journey.lockedT}</h3>
      <p class="mt-2 text-[15px] leading-7 text-ink-200">{t.journey.lockedD}</p>
      <button data-dash-jlockclose class="mt-5 w-full text-brand-300 font-bold px-6 py-3 min-h-[52px] border-t border-white/10 hover:bg-white/5 transition">{t.journey.close}</button>
    </div>
  </div>
</div>

<AuthModal locale={locale} />

<script define:vars={{ readUrl, habitUrl, surahShort, juzStarts, COUNTRY_TZ, tApp: t }}>
  (() => {
    const root = document.querySelector('[data-dash]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s) || document.querySelector(s);
    let H = null, range = 'today';
    let prefsCache = { daily_goal: 1, streak_goal: 7 };
    let streakCache = { current: 0, longest: 0 };

    const VERSE_COUNTS = surahShort.map((s) => s[1]);
    const CUM = [];
    VERSE_COUNTS.reduce((a, n, i) => (CUM[i] = a + n, a + n), 0);
    const TOTAL_VERSES = CUM[CUM.length - 1] || 6236;

    // Juz (1..30) containing (surah, verse), 1-indexed.
    const juzOf = (surah, verse) => {
      let j = 1;
      for (let i = 0; i < juzStarts.length; i++) {
        const [s, v] = juzStarts[i];
        if (s < surah || (s === surah && v <= verse)) j = i + 1;
        else break;
      }
      return Math.min(30, Math.max(1, j));
    };
    // Juz containing the Nth verse of the Quran (N>=1).
    const juzOfOrdinal = (n) => {
      n = Math.min(TOTAL_VERSES, Math.max(1, n || 1));
      let s = 1;
      for (let i = 0; i < CUM.length; i++) { if (CUM[i] >= n) { s = i + 1; break; } }
      let v = n - (s > 1 ? CUM[s - 2] : 0);
      return juzOf(s, v);
    };
    const surahName = (n) => (surahShort[n - 1] ? `${n} ${surahShort[n - 1][0]}` : `Surah ${n}`);
    const surahLen = (n) => (surahShort[n - 1] ? surahShort[n - 1][1] : 0);

    const setFace = (el, user) => {
      if (!el) return;
      try {
        if (H?.faceFor) {
          const html = H.faceFor(user);
          if (String(html).trim().startsWith('<')) { el.innerHTML = html; return; }
        }
      } catch {}
      el.innerHTML = '';
      el.textContent = (user?.avatar_emoji && !H?.AVATAR_SVGS?.[user.avatar_emoji]) ? user.avatar_emoji : (user?.name || 'R').trim().charAt(0).toUpperCase() || 'R';
    };

    const paintTiles = (s) => {
      const box = $('[data-dash-tiles]');
      if (!box) return;
      const all = [
        ['💗', tApp.dash.hasanat, H.fmtCompact(s.hasanat || 0)],
        ['📖', tApp.dash.verses, String(s.verses || 0)],
        ['⏱️', tApp.dash.time, H.fmtTime(s.seconds || 0)],
        ['📑', tApp.dash.pages, String(s.pages || 0)],
      ];
      // Settings → Hide Hasanat removes the tile everywhere on Home.
      const tiles = prefsCache.hide_hasanat ? all.filter((t) => t[1] !== tApp.dash.hasanat) : all;
      box.innerHTML = tiles.map(([i, t, v]) => `<div class="bg-night-850 border border-white/10 rounded-3xl px-3 py-5 text-center min-h-[150px] flex flex-col items-center justify-center gap-1"><div class="text-5xl leading-none">${i}</div><div class="font-extrabold text-2xl text-white mt-1">${v}</div><div class="text-sm font-semibold text-ink-300">${t}</div></div>`).join('');
    };

    const paintWeek = (days) => {
      const box = $('[data-dash-week]');
      if (!box) return;
      const set = new Set((days || []).map((d) => d.date));
      const labels = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
      const now = new Date();
      const monday = new Date(now);
      monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));
      const todayStr = now.toISOString().slice(0, 10);
      box.innerHTML = labels.map((d, i) => {
        const dt = new Date(monday);
        dt.setDate(monday.getDate() + i);
        const key = dt.toISOString().slice(0, 10);
        const on = set.has(key);
        const isToday = key === todayStr;
        const cls = on
          ? 'bg-emerald-400 text-night-900 border-emerald-400'
          : isToday
            ? 'bg-brand-500 text-white border-brand-400 ring-2 ring-brand-300/50'
            : 'bg-transparent text-ink-300 border-white/15';
        return `<span class="w-9 h-9 grid place-items-center rounded-full text-[15px] font-extrabold border transition ${cls}">${d}</span>`;
      }).join('');
    };

    // Streak pill: n/goal while building; once the goal is reached it
    // flips to the real day count with fire (7/7 → 8 🔥 → 9 🔥 …).
    const paintStreak = () => {
      const goal = Math.max(1, prefsCache.streak_goal || 7);
      const cur = streakCache.current || 0;
      const sEl = $('[data-dash-streak]');
      const gEl = $('[data-dash-goal]');
      const sep = $('[data-dash-sep]');
      if (sEl) sEl.textContent = cur;
      const done = cur >= goal;
      sep?.classList.toggle('hidden', done);
      if (gEl) {
        gEl.classList.toggle('hidden', done);
        if (!done) gEl.textContent = goal;
      }
    };

    // ---- daily streak popup ----
    const openStreakModal = () => {
      const m = $('[data-dash-streakmodal]');
      if (!m) return; // never lock scroll if the modal is missing
      const c = $('[data-dash-mcount]');
      if (c) {
        const cur = streakCache.current || 0;
        c.textContent = `🔥 ${cur} ${tApp.streak.dayStreak} • ${tApp.streak.longest} ${streakCache.longest || 0}`;
      }
      m.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };
    const closeStreakModal = () => {
      $('[data-dash-streakmodal]')?.classList.add('hidden');
      document.body.style.overflow = '';
    };
    $('[data-dash-streakbtn]')?.addEventListener('click', openStreakModal);
    document.querySelectorAll('[data-dash-mclose]').forEach((b) => b.addEventListener('click', closeStreakModal));

    // ---- quran journey calendar ----
    let jMonth = new Date().toISOString().slice(0, 7);
    const thisMonth = () => new Date().toISOString().slice(0, 7);
    const shiftMonth = (m, d) => {
      const [y, mo] = m.split('-').map(Number);
      const dt = new Date(Date.UTC(y, mo - 1 + d, 1));
      return dt.toISOString().slice(0, 7);
    };
    const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const renderJourney = (d) => {
      const [y, mo] = d.month.split('-').map(Number);
      const title = $('[data-dash-jtitle]');
      if (title) title.textContent = `${MONTH_NAMES[mo - 1]} ${y}`;
      if ($('[data-dash-jcount]')) $('[data-dash-jcount]').textContent = d.streak?.current || 0;
      if ($('[data-dash-jlong]')) $('[data-dash-jlong]').textContent = d.streak?.longest || 0;
      if ($('[data-dash-jmv]')) $('[data-dash-jmv]').textContent = d.totals?.verses || 0;
      if ($('[data-dash-jmh]')) $('[data-dash-jmh]').textContent = H.fmtCompact(d.totals?.hasanat || 0);
      const grid = $('[data-dash-jgrid]');
      if (grid) {
        const first = new Date(Date.UTC(y, mo - 1, 1));
        const lead = (first.getUTCDay() + 6) % 7; // Monday-start
        const dim = new Date(Date.UTC(y, mo, 1) - 864e5).getUTCDate();
        const todayStr = new Date().toISOString().slice(0, 10);
        const active = new Set(Object.keys(d.days || {}));
        let html = '';
        for (let i = 0; i < lead; i++) html += '<span></span>';
        for (let day = 1; day <= dim; day++) {
          const key = `${d.month}-${String(day).padStart(2, '0')}`;
          const on = active.has(key);
          const isToday = key === todayStr;
          const future = key > todayStr;
          const cls = on
            ? 'bg-emerald-400 text-night-900'
            : isToday
              ? 'bg-brand-500/25 text-white ring-2 ring-brand-400'
              : 'bg-white/5 text-ink-300';
          html += `<span class="aspect-square grid place-items-center rounded-full text-[13px] font-extrabold ${cls}${future && !on ? ' opacity-40' : ''}${isToday ? ' ring-2' : ''}" title="${on ? `${d.days[key].verses} verses` : key}">${day}</span>`;
        }
        grid.innerHTML = html;
      }
      // Locked until a 7-day streak is reached (longest keeps it unlocked).
      const locked = (d.streak?.longest || 0) < 7;
      $('[data-dash-jlocked]')?.classList.toggle('hidden', !locked);
    };
    const loadJourney = async (month) => {
      jMonth = month;
      const err = $('[data-dash-jerr]');
      err?.classList.add('hidden');
      const grid = $('[data-dash-jgrid]');
      if (grid) grid.innerHTML = `<p class="col-span-7 text-center text-sm text-ink-500 py-6">${tApp.journey.loading}</p>`;
      try {
        const res = await fetch(`/api/me/calendar?month=${encodeURIComponent(month)}`, { credentials: 'same-origin' });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'failed');
        renderJourney(d);
      } catch (e) {
        if (err) {
          err.textContent = tApp.journey.loadFail;
          err.classList.remove('hidden');
        }
      }
    };
    const openJourney = () => {
      const j = $('[data-dash-journey]');
      if (!j) return; // never lock scroll if the modal is missing
      j.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      loadJourney(thisMonth());
    };
    const closeJourney = () => {
      $('[data-dash-journey]')?.classList.add('hidden');
      document.body.style.overflow = '';
    };
    $('[data-dash-cal]')?.addEventListener('click', openJourney);
    $('[data-dash-jclose]')?.addEventListener('click', closeJourney);
    $('[data-dash-jlockclose]')?.addEventListener('click', closeJourney);
    $('[data-dash-jprev]')?.addEventListener('click', () => loadJourney(shiftMonth(jMonth, -1)));
    $('[data-dash-jnext]')?.addEventListener('click', () => {
      const next = shiftMonth(jMonth, 1);
      if (next <= thisMonth()) loadJourney(next);
    });

    const paintGoal = async (sessionUser) => {
      try {
        const [prefs, today, all, resume, community] = await Promise.all([
          H.Me.prefs().catch(() => ({ prefs: {} })),
          H.Me.stats('today').catch(() => ({ stats: {} })),
          H.Me.stats('all').catch(() => ({ stats: {} })),
          H.Me.resume().catch(() => ({ resume: null })),
          H.Me.community().catch(() => null),
        ]);
        prefsCache = { ...prefsCache, ...(prefs.prefs || {}) };
        const goal = Math.max(1, prefsCache.daily_goal || 1);
        const todayV = today.stats?.verses || 0;
        const allV = all.stats?.verses || 0;
        if ($('[data-dash-todayv]')) $('[data-dash-todayv]').textContent = todayV;
        if ($('[data-dash-dailygoal]')) $('[data-dash-dailygoal]').textContent = goal;
        if ($('[data-dash-goal]')) $('[data-dash-goal]').textContent = prefsCache.streak_goal || 7;
        const bar = $('[data-dash-goalbar]');
        if (bar) bar.style.width = `${Math.min(100, Math.round((todayV / goal) * 100))}%`;
        if ($('[data-dash-livecount]')) $('[data-dash-livecount]').textContent = community ? H.fmtCompact(community.readingToday || 0) : '–';
        const pct = ((allV / TOTAL_VERSES) * 100);
        if ($('[data-dash-pct]')) $('[data-dash-pct]').textContent = `${pct < 10 ? pct.toFixed(1) : Math.round(pct)}%`;
        const readBtn = $('[data-dash-read]');
        const resumeLink = $('[data-dash-resume]');
        const resumeLbl = $('[data-dash-resumelabel]');
        const juzEl = $('[data-dash-juz]');
        const r = resume?.resume;
        if (r && r.surah) {
          if (resumeLbl) resumeLbl.textContent = `${surahName(r.surah)} | ${r.verse}/${surahLen(r.surah)}`;
          const href = `${String(readUrl).replace(/\/$/, '')}/${r.surah}/?verse=${r.verse}`;
          if (readBtn) readBtn.href = href;
          if (resumeLink) resumeLink.href = href;
          if (juzEl) juzEl.textContent = `${tApp.dash.juz} ${juzOf(r.surah, r.verse)}/30`;
        } else {
          if (resumeLbl) resumeLbl.textContent = tApp.dash.startReading;
          if (juzEl) juzEl.textContent = `${tApp.dash.juz} –/30`;
        }
        return { allV };
      } catch { return { allV: 0 }; }
    };

    const paintHero = async (sessionUser, allV) => {
      try {
        const [saved, community] = await Promise.all([
          H.Me.challenges().catch(() => ({ challenges: [] })),
          H.Me.community().catch(() => null),
        ]);
        const target = 6236;
        const progress = Math.min(target, allV || 0);
        const pct = (progress / target) * 100;
        const bar = $('[data-dash-chbar]');
        if (bar) bar.style.width = `${pct}%`;
        if ($('[data-dash-chpct]')) $('[data-dash-chpct]').textContent = `${pct < 10 ? pct.toFixed(1) : Math.round(pct)}%`;
        if ($('[data-dash-chjuz]')) $('[data-dash-chjuz]').textContent = `${juzOfOrdinal(Math.max(1, progress))}/30 ${tApp.dash.juz}`;
        if ($('[data-dash-parts]')) $('[data-dash-parts]').textContent = community ? H.fmtCompact(community.readers || 0) : '–';
        // Countdown: challenge start (or account creation) + 30 days.
        const row = (saved.challenges || []).find((c) => c.slug === 'meaning-30day');
        const anchor = (row?.started_at || sessionUser?.created_at || Math.floor(Date.now() / 1000)) * 1000;
        const left = anchor + 30 * 864e5 - Date.now();
        const cd = $('[data-dash-cd]');
        const cdt = $('[data-dash-cdtext]');
        if (cd && cdt) {
          if (progress >= target) { cdt.textContent = tApp.dash.completed; cd.classList.remove('hidden'); cd.classList.add('inline-flex'); }
          else if (left <= 0) { cdt.textContent = tApp.dash.keepGoing; cd.classList.remove('hidden'); cd.classList.add('inline-flex'); }
          else {
            const d = Math.floor(left / 864e5), h = Math.floor((left % 864e5) / 36e5);
            cdt.textContent = `${d} d ${h} hr left`;
            cd.classList.remove('hidden'); cd.classList.add('inline-flex');
          }
        }
      } catch { /* hero optional */ }
    };

    const OTHER_CHALLENGES = [
      { slug: 'friday-kahf', title: tApp.dash.fridayT, sub: tApp.dash.fridayD, unit: 'verses', href: `${String(readUrl).replace(/\/$/, '')}/18/` },
      { slug: 'nightly', title: tApp.dash.nightlyT, sub: tApp.dash.nightlyD, unit: 'verses', href: readUrl },
      { slug: 'ramadan-khatm', title: tApp.dash.ramadanT, sub: tApp.dash.ramadanD, unit: 'juz', href: readUrl },
    ];
    const TARGETS = { 'friday-kahf': 110, nightly: 110, 'ramadan-khatm': 30 };

    // ---- challenge windows follow the user's COUNTRY time ----
    // Device time is the fallback (unset/unknown country).
    const NIGHT_START = 20; // Nightly Recitation opens 8 PM…
    const NIGHT_END = 5;    // …until 5 AM.
    // Expected Ramadan (1st) starts — approximate, moon sighting varies by ±1 day.
    const RAMADAN_STARTS = [[2026,2,18],[2027,2,7],[2028,1,27],[2029,1,16],[2030,1,5],[2030,12,26],[2031,12,15],[2032,12,4]];
    let userTz = null; // IANA zone from profile country; null = device time.
    // Offset (ms) of a zone vs the device clock, right now.
    const tzOffsetMs = (tz) => {
      try {
        const now = new Date();
        const shifted = new Date(now.toLocaleString('en-US', { timeZone: tz }));
        const plain = new Date(now.toLocaleString('en-US'));
        return Math.round((shifted - plain) / 60000) * 60000;
      } catch { return 0; }
    };
    // "Now" on the user's wall clock (a Date whose fields read as zone wall time).
    const znow = () => (userTz ? new Date(Date.now() + tzOffsetMs(userTz)) : new Date());
    // Wall-clock ms (built from znow) back to absolute ms.
    const toAbs = (wallMs) => (userTz ? wallMs - tzOffsetMs(userTz) : wallMs);
    const isFriday = () => znow().getDay() === 5;
    const isNight = () => { const h = znow().getHours(); return h >= NIGHT_START || h < NIGHT_END; };
    const hijriMonth = () => {
      try {
        const parts = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { ...(userTz ? { timeZone: userTz } : {}), month: 'numeric' }).formatToParts(new Date());
        const m = parts.find((p) => p.type === 'month');
        return m ? Number(m.value) : null;
      } catch { return null; }
    };
    const inRamadanTable = (d) => RAMADAN_STARTS.some(([y, m, day]) => {
      const s = new Date(y, m - 1, day);
      return d >= s && d < new Date(s.getTime() + 30 * 864e5);
    });
    const isRamadan = () => {
      const hm = hijriMonth();
      if (hm !== null && Number.isFinite(hm)) return hm === 9;
      return inRamadanTable(znow());
    };
    const fmtLeft = (ms) => {
      if (ms === null || ms === undefined) return '';
      if (ms <= 0) return tApp.dash.soon;
      const d = Math.floor(ms / 864e5), h = Math.floor((ms % 864e5) / 36e5), m = Math.floor((ms % 36e5) / 6e4);
      return d > 0 ? `${d}d ${h}h` : h > 0 ? `${h}h ${m}m` : `${m}m`;
    };
    const nextFridayIn = () => {
      const n = znow(); const d = new Date(n);
      d.setDate(n.getDate() + ((5 - n.getDay() + 7) % 7));
      d.setHours(0, 0, 0, 0);
      if (d.getTime() <= n.getTime()) d.setDate(d.getDate() + 7);
      return Math.max(0, toAbs(d.getTime()) - Date.now());
    };
    const nextNightIn = () => {
      const n = znow(); const d = new Date(n);
      d.setHours(NIGHT_START, 0, 0, 0);
      if (d.getTime() <= n.getTime()) d.setDate(d.getDate() + 1);
      return Math.max(0, toAbs(d.getTime()) - Date.now());
    };
    const nextRamadanIn = () => {
      const n = new Date();
      for (const [y, m, day] of RAMADAN_STARTS) {
        const s = new Date(y, m - 1, day);
        if (s > n) return s - n;
      }
      return null;
    };
    const challengeWindow = (slug) => {
      if (slug === 'friday-kahf') {
        return isFriday() ? { locked: false } : { locked: true, label: tApp.dash.fridayOnly, left: nextFridayIn() };
      }
      if (slug === 'nightly') {
        return isNight() ? { locked: false } : { locked: true, label: tApp.dash.opens8pm, left: nextNightIn() };
      }
      if (slug === 'ramadan-khatm') {
        if (isRamadan()) return { locked: false };
        return { locked: true, label: tApp.dash.ramadanOnly, left: nextRamadanIn() };
      }
      return { locked: false };
    };

    const paintChallenges = async () => {
      const box = $('[data-dash-challenges]');
      if (!box) return;
      const saved = await H.Me.challenges().catch(() => ({ challenges: [] }));
      const map = new Map((saved.challenges || []).map((c) => [c.slug, c]));
      const week = await H.Me.stats('week').catch(() => ({ stats: { verses: 0 } }));
      const auto = { nightly: week.stats?.verses || 0 };
      box.innerHTML = OTHER_CHALLENGES.map((c) => {
        const target = TARGETS[c.slug];
        const progress = Math.min(target, Math.max(map.get(c.slug)?.progress || 0, auto[c.slug] || 0));
        const pct = Math.round((progress / target) * 100);
        const win = challengeWindow(c.slug);
        const unit = c.unit === 'juz' ? tApp.dash.juzU : tApp.dash.versesU;
        const lockLine = win.locked
          ? `<p class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-extrabold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-full px-3 py-1.5">🔒 ${win.label}${win.left ? ` • ${tApp.dash.opensIn} ${fmtLeft(win.left)}` : ''}</p>`
          : `<p class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-extrabold text-emerald-300 bg-emerald-400/10 border border-emerald-300/30 rounded-full px-3 py-1.5">🔓 ${tApp.dash.openNow}</p>`;
        const inner = `
          <div class="flex items-start gap-2">
            <div class="min-w-0 flex-1">
              <p class="font-extrabold text-lg text-white">${c.title}</p>
              <p class="text-sm text-ink-300">${c.sub}</p>
            </div>
            <span class="text-2xl shrink-0" aria-hidden="true">${win.locked ? '🔒' : '🔓'}</span>
          </div>
          <div class="h-2.5 bg-white/10 rounded-full overflow-hidden mt-3"><div class="h-full bg-gradient-to-r from-brand-500 to-gold-300 rounded-full transition-all" style="width:${pct}%"></div></div>
          <div class="mt-1.5 flex justify-between text-xs font-bold text-ink-300"><span>${progress}/${target} ${unit}</span><span>${pct}%</span></div>
          ${lockLine}`;
        return win.locked
          ? `<div class="block bg-night-850 border border-white/10 rounded-3xl p-5" role="note" aria-label="${c.title} — locked, ${win.label}">${inner}</div>`
          : `<a href="${c.href}" class="block bg-night-850 border border-white/10 rounded-3xl p-5 hover:border-brand-500/50 transition">${inner}</a>`;
      }).join('');
    };

    const loadRange = async () => {
      const { stats, days } = await H.Me.stats(range).catch(() => ({ stats: {}, days: [] }));
      paintTiles(stats || {});
      if (range === 'week') paintWeek(days);
    };

    root.querySelectorAll('[data-dash-range]').forEach((btn) => btn.addEventListener('click', async () => {
      range = btn.dataset.dashRange;
      root.querySelectorAll('[data-dash-range]').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('bg-[#5b3ba8]', on);
        b.classList.toggle('text-white', on);
        b.classList.toggle('font-extrabold', on);
        b.classList.toggle('shadow-lg', on);
        b.classList.toggle('text-ink-300', !on);
        b.setAttribute('aria-selected', String(on));
      });
      await loadRange();
    }));

    $('[data-dash-login]')?.addEventListener('click', () => window.hnAuthModal?.open());
    document.addEventListener('hn:auth', () => window.location.reload());

    (async () => {
      H = await import('/habits/habit.js?v=5');
      const { user } = await H.Auth.session().catch(() => ({ user: null }));
      $('[data-dash-loading]')?.classList.add('hidden');
      if (!user) { $('[data-dash-gate]')?.classList.remove('hidden'); return; }
      $('[data-dash-live]')?.classList.remove('hidden');
      // Country drives challenge windows; nudge when missing.
      userTz = (user.country && COUNTRY_TZ[user.country]) || null;
      const nudge = $('[data-dash-countrynudge]');
      if (nudge) {
        const missing = !user.country;
        nudge.classList.toggle('hidden', !missing);
        nudge.classList.toggle('flex', missing);
      }
      setFace($('[data-dash-avatar]'), user);
      if (window.hnUpdateNav) window.hnUpdateNav(user);
      $('[data-dash-name]').textContent = (user.name || 'Reader').split(' ')[0];
      const [{ streak }, week] = await Promise.all([
        H.Me.streak().catch(() => ({ streak: { current: 0 } })),
        H.Me.stats('week').catch(() => ({ days: [] })),
      ]);
      streakCache = { current: streak?.current || 0, longest: streak?.longest || 0 };
      paintWeek(week.days);
      const { allV } = await paintGoal(user);
      paintStreak();
      // Fresh accounts (never onboarded) get the 7-step setup entry point.
      const ob = $('[data-dash-onboard]');
      if (ob) {
        const show = !prefsCache.onboarded;
        ob.classList.toggle('hidden', !show);
        ob.classList.toggle('flex', show);
      }
      await paintHero(user, allV);
      await loadRange();
      await paintChallenges();
    })();
  })();
</script>
