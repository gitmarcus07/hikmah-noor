---
/* Quiz hub: all quizzes -> per-quiz SEO player pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { QUIZZES, QUIZ_CATS } from '../data/quizzes';
import { localizeQuizList, localizeQuizCat } from '../lib/content-i18n';
import { secUI3, QUIZ_UI } from '../lib/site-ui-3';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI3(locale, QUIZ_UI);
const L = (p: string) => localizedPath(locale, p);
const QL = localizeQuizList(QUIZZES, locale);

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/quiz/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath="/quiz/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{QL.length} {T.badgeN}</span>
        <span class="hn-badge">{T.badgeQ}</span>
        <span class="hn-badge">{T.badgeA}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={dict.nav.search} aria-label={dict.nav.search} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.secPick} title={T.secPick} />
      <div class="mt-4 mb-3 max-w-3xl">
        <input id="quizfilter" class="hn-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={dict.nav.search} aria-label={dict.nav.search} />
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {QL.map((q) => {
          const cat = localizeQuizCat(QUIZ_CATS.find((c) => c.slug === q.cat), locale);
          return (
          <a href={L(`/quiz/${q.slug}/`)} data-search={`${q.title} ${q.desc} ${cat?.title ?? ''} ${q.keywords}`.toLowerCase()} class="hn-filterrow hn-card hn-card-hover hn-card-pad flex flex-col gap-3 min-h-[190px]">
            <span class="flex items-center gap-3">
              <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={q.icon as any || 'star'} size={22} /></span>
              <span class="min-w-0 flex-1">
                <span class="font-extrabold block text-[17px] leading-7">{cat?.title ?? 'Quiz'}</span>
                <span class="hn-badge mt-1">{T.qCount.replace('{n}', String(q.questions.length))}</span>
              </span>
            </span>
            <span class="text-sm leading-6" style="color:var(--hn-muted)">{q.desc}</span>
            <span class="text-[13px] font-bold mt-auto inline-flex items-center gap-1" style="color:var(--hn-primary)">{T.startL} <Icon name="arrow" size={14} /></span>
          </a>
          );
        })}
      </div>
    </div>
    <script is:inline>
      (() => {
        const input = document.getElementById('quizfilter');
        const rows = [...document.querySelectorAll('.hn-filterrow')];
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          rows.forEach((r) => r.classList.toggle('hidden', !!q && !(r.dataset.search || '').includes(q)));
        });
      })();
    </script>
    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <h2 class="text-xl md:text-2xl font-extrabold mb-3">{dict.article.faq}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
