---
/* Quiz hub: all quizzes -> per-quiz SEO player pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import { localizedPath } from '../i18n/utils';
import { QUIZZES, QUIZ_CATS } from '../data/quizzes';

interface Props { locale: string; }
const { locale } = Astro.props;
const L = (p: string) => localizedPath(locale, p);

const title = `Islamic Quizzes — Test Your Knowledge (${QUIZZES.length} quizzes)`;
const description = `Free Islamic quizzes with instant answers: prophets in order, Seerah of Muhammad ﷺ, Quran surahs & facts, plus kids, Ramadan and Hajj tracks. Score 8+ to pass — share your result.`;
const keywords = 'islamic quiz, quran quiz, seerah quiz, prophets quiz, ambiya quiz, muslim quiz questions answers, kids islamic quiz, ramadan quiz, hajj quiz';
const faq = [
  { q: 'How does scoring work?', a: 'Each quiz has 10 questions with 4 options. Answer all ten to get your score out of 10 — 8 or more passes. Your best score per quiz is saved on this device.' },
  { q: 'Where do the answers come from?', a: 'Every answer shows its explanation with the Quran reference or the site page it came from — prophet stories, seerah chapters, the Quran index, Ramadan guides and Hajj rites.' },
  { q: 'Are more quizzes coming?', a: 'Six tracks live now — prophets, seerah, Quran, kids, Ramadan and Hajj. Duas and finance quizzes are planned next.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Quiz', path: '/quiz/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/quiz/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{QUIZZES.length} quizzes</span>
        <span class="hn-badge">10 questions each</span>
        <span class="hn-badge">Instant answers</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Islamic Quizzes</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Test yourself — every answer comes with its explanation and source. Score 8+ to pass, then share your result.</p>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Quizzes" title="Pick a quiz" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {QUIZZES.map((q) => {
          const cat = QUIZ_CATS.find((c) => c.slug === q.cat);
          return (
          <a href={L(`/quiz/${q.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex flex-col gap-3 min-h-[190px]">
            <span class="flex items-center gap-3">
              <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={q.icon as any || 'star'} size={22} /></span>
              <span class="min-w-0 flex-1">
                <span class="font-extrabold block text-[17px] leading-7">{cat?.title ?? 'Quiz'}</span>
                <span class="hn-badge mt-1">{q.questions.length} questions</span>
              </span>
            </span>
            <span class="text-sm leading-6" style="color:var(--hn-muted)">{q.desc}</span>
            <span class="text-[13px] font-bold mt-auto inline-flex items-center gap-1" style="color:var(--hn-primary)">Start quiz <Icon name="arrow" size={14} /></span>
          </a>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
