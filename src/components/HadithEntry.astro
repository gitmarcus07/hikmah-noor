---
/* Canonical hadith entry page — shows ONLY verified dataset fields:
 * collection, book, stable number, full Arabic matn, English translation,
 * source reference and provenance. No grade/narrator/chapter is shown
 * because the source dataset does not provide them as fields.
 * Neutral `website` type (NOT Article): a recorded saying is not an article. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import RelatedContent from './RelatedContent.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { secUI2, HADEES_UI } from '../lib/site-ui-2';
import {
  hadithCountOf, prevHadith, nextHadith, studySlugFor,
  collectionPath, bookPath, entryPath,
} from '../data/hadith-collections';
import type { HadithCollection, HadithBook, HadithEntry } from '../data/hadith-collections';

interface Props { collection: HadithCollection; book: HadithBook; entry: HadithEntry; locale: string; }
const { collection, book, entry, locale } = Astro.props;
const dict = getDict(locale);
const T = (secUI2(locale, HADEES_UI) as any).coll;
const H = secUI2(locale, HADEES_UI) as any;
const L = (p: string) => localizedPath(locale, p);
const total = hadithCountOf(collection.id);
const collPath = collectionPath(collection.slug);
const bPath = bookPath(collection.slug, book.slug);
const ePath = entryPath(collection.slug, book.slug, entry.num);
const prev = prevHadith(entry);
const next = nextHadith(entry);
const studySlug = studySlugFor(collection.id, entry.num);

const title = T.entryTitle.replace('{short}', collection.short).replace('{n}', String(entry.num));
let description = `${entry.reference}: ${entry.english}`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${collection.slug} hadith ${entry.num}, forty hadith ${collection.slug} ${entry.num}, ${collection.slug} ${entry.num} english arabic`;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: H.crumb, path: '/hadees/' },
  { name: collection.name, path: collPath },
  { name: book.title, path: bPath },
  { name: T.hadithOf.replace('{n}', String(entry.num)).replace('{t}', String(total)), path: ePath },
];
const faq = [
  { q: T.faqWhatQ.replace('{n}', String(entry.num)), a: T.faqWhatA.replace('{n}', String(entry.num)).replace('{t}', String(total)).replace('{name}', collection.name).replace('{b}', String(book.num)) },
  { q: T.faqFullQ, a: T.faqFullA.replace('{t}', String(total)) },
  { q: T.faqLangQ, a: T.faqLangA },
];
const relCat = `${collection.slug}/${book.slug}`;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} faq={faq} crumbs={crumbs} canonicalPath={ePath}>
  <div class="hn-read hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 4)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{T.hadithOf.replace('{n}', String(entry.num)).replace('{t}', String(total))}</span>
      <span class="hn-badge hn-badge-gold">{book.title}</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{collection.short} Hadith {entry.num}</h1>
    <p class="mt-2 text-[13px] font-bold" style="color:var(--hn-muted)">{T.refL}: <strong style="color:var(--hn-ink)">{entry.reference}</strong></p>

    <div class="hn-reading-card mt-4">
      <p class="hn-block-label">{T.arabicL}</p>
      <p class="arabic-block text-[20px] md:text-[22px]" lang="ar" dir="rtl">{entry.arabic}</p>
      <hr class="hn-divider" />
      <p class="hn-block-label">{T.englishL}</p>
      <p class="leading-8 text-[16px]" lang="en">{entry.english}</p>
    </div>

    <p class="mt-3 text-[12px] leading-6" style="color:var(--hn-muted)">{T.provL}: {collection.provenanceLine}</p>

    {studySlug && (
      <div class="mt-6">
        <SectionHeader eyebrow={T.studyT} title={T.studyT} href={L('/hadees/')} linkLabel={H.allHadees} />
        <div class="grid gap-3 sm:grid-cols-2">
          <a href={L(`/hadees/${studySlug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{T.studyT}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{T.studyD}</span>
          </a>
        </div>
      </div>
    )}

    <RelatedContent type="hadith-entry" slug={String(entry.num)} category={relCat} locale={locale} />

    <section class="mt-8" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="grid gap-3 sm:grid-cols-2 mt-6">
      <a href={L(bPath)} class="hn-card hn-card-hover hn-card-pad block">
        <span class="font-bold block text-[15px] leading-6">{T.backBookL}</span>
        <span class="text-[13px]" style="color:var(--hn-muted)">{book.title}</span>
      </a>
      <a href={L(collPath)} class="hn-card hn-card-hover hn-card-pad block">
        <span class="font-bold block text-[15px] leading-6">{collection.name}</span>
        <span class="text-[13px]" style="color:var(--hn-muted)">{T.countBadge.replace('{b}', '1').replace('{t}', String(total))}</span>
      </a>
    </div>

    {(prev || next) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More hadith">
        {prev ? (
          <a href={L(entryPath(collection.slug, book.slug, prev.num))} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.prevL}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{collection.short} Hadith {prev.num}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={L(entryPath(collection.slug, book.slug, next.num))} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.nextL}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{collection.short} Hadith {next.num}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
