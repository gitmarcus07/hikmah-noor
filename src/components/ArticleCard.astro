---
/* ONE card system for article teasers (related, popular, latest). */
import SiteArt from './SiteArt.astro';
import { artFor } from '../lib/art';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: string;
  category: string;
  slug: string;
  title: string;
  description: string;
  date?: string | Date;
  image?: string;
  /** Actual article locale — links + badge follow it when it differs from the page locale. */
  entryLocale?: string;
}
const { locale, category, slug, title, description, date, image, entryLocale } = Astro.props;
const realLocale = entryLocale ?? locale;
const isFallback = realLocale !== locale;
const href = localizedPath(realLocale, `/${category}/${slug}/`);
const img = artFor(image, category);
const d = date ? new Date(date).toLocaleDateString(locale === 'hi' ? 'hi-IN' : locale === 'ur' ? 'ur-PK' : locale === 'ar' ? 'ar-SA' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---
<a href={href} class="hn-card hn-card-hover overflow-hidden flex flex-col">
  <span class="block h-40 overflow-hidden"><SiteArt name={img} title={title} /></span>
  <div class="hn-card-pad flex flex-col gap-2 flex-1">
    <span class="flex items-center gap-1.5 self-start">
      <span class="hn-badge hn-badge-primary">{category}</span>
      {isFallback && <span class="hn-badge" title="English — translation coming soon">EN</span>}
    </span>
    <h3 class="font-bold text-[16px] leading-6">{title}</h3>
    <p class="text-sm leading-6 line-clamp-2" style="color:var(--hn-muted)">{description}</p>
    {d && <span class="text-xs mt-auto pt-2" style="color:var(--hn-muted)">{d}</span>}
  </div>
</a>
