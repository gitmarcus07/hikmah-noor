---
/* Account Settings hub (Quranly-style) — avatar + rows that expand into
 * editors: Alerts, Notifications, Hide Hasanat, Reciter, Quran Script,
 * Daily Quran Goal, Change Password, Change Email, Change Name, Gender,
 * Font Size, Translation (+ Username, Country, Photo). Privacy toggles and
 * Session (logout/delete) below. Uses AuthModal + /habits/habit.js.
 */
import AuthModal from './AuthModal.astro';
import { localizedPath, getDict } from '../i18n/utils';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = getDict(locale).app;
const progressUrl = localizedPath(locale, '/tools/my-progress/');
const leaderboardUrl = localizedPath(locale, '/leaderboard/');
---

<div class="max-w-md mx-auto px-4 py-5" data-settings>
  {/* loading */}
  <div data-s-loading class="animate-pulse space-y-3">
    <div class="h-24 bg-night-850 border border-white/10 rounded-3xl"></div>
    <div class="h-64 bg-night-850 border border-white/10 rounded-3xl"></div>
  </div>

  {/* logged-out gate */}
  <div data-s-gate class="hidden text-center bg-night-850 border border-white/10 rounded-3xl p-8 shadow-xl shadow-black/30">
    <div class="mx-auto w-20 h-20 grid place-items-center rounded-full bg-brand-500/15 border border-brand-500/30 text-5xl" aria-hidden="true">👤</div>
    <h1 class="text-2xl font-extrabold text-white mt-4">{t.account.gateT}</h1>
    <p class="mt-2 text-ink-300 text-[15px] leading-7">{t.account.gateD}</p>
    <div class="mt-5 flex flex-col sm:flex-row gap-3 justify-center">
      <button data-s-open-login class="bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">{t.auth.loginBtn}</button>
      <button data-s-open-register class="bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">{t.auth.signupBtn}</button>
    </div>
  </div>

  {/* logged-in view */}
  <div data-s-live class="hidden space-y-4">
    <div class="flex items-center gap-3">
      <button data-s-back aria-label="Back" class="w-12 h-9 shrink-0 grid place-items-center rounded-full border border-white/25 text-white text-lg hover:bg-white/10 transition">←</button>
      <h1 class="flex-1 text-center text-[20px] font-extrabold text-white">{t.account.title}</h1>
      <span class="w-12" aria-hidden="true"></span>
    </div>

    {/* identity */}
    <div class="flex flex-col items-center text-center">
      <button data-s-photo aria-label="Change profile photo" class="relative w-24 h-24 grid place-items-center rounded-full overflow-hidden bg-emerald-300 text-night-900 text-4xl font-extrabold ring-2 ring-white/20 hover:ring-brand-400 transition">
        <span data-s-face class="block w-full h-full grid place-items-center overflow-hidden">👤</span>
        <span class="absolute bottom-1 end-1 w-7 h-7 grid place-items-center rounded-full bg-brand-500 text-night-900 text-sm border-2 border-night-950" aria-hidden="true">📷</span>
      </button>
      <h2 data-s-name class="mt-2 text-lg font-extrabold text-white">Reader</h2>
      <p data-s-email class="text-sm text-ink-500 truncate max-w-full"></p>
      <span data-s-provider class="mt-1.5 text-[11px] font-extrabold uppercase tracking-wide bg-white/5 border border-white/10 rounded-full px-3 py-1 text-ink-300"></span>
    </div>

    <div data-s-rows class="space-y-2.5">
      {/* photo editor */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="photo" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.photo}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="photo" class="hidden px-4 pb-4">
          <div data-s-gallery class="grid grid-cols-6 gap-2" role="radiogroup" aria-label="Avatar gallery"></div>
          <div class="mt-3 flex gap-2">
            <label class="flex-1 inline-flex items-center justify-center gap-2 cursor-pointer border-2 border-dashed border-white/15 hover:border-brand-400 rounded-2xl px-4 py-3 min-h-[52px] text-sm font-extrabold text-ink-200 transition">
              {t.account.upload}
              <input data-s-file type="file" accept="image/*" class="sr-only" />
            </label>
            <button type="button" data-s-photorm class="hidden items-center justify-center gap-2 text-sm font-bold text-red-300 border border-red-400/30 rounded-2xl px-4 py-3 min-h-[52px]">{t.account.remove}</button>
          </div>
          <input data-s-photourl type="url" inputmode="url" maxlength="500" placeholder={t.account.photoLink}
            class="mt-2 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 text-sm" />
          <p data-s-msg-photo class="hidden mt-2 text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* username */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="username" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.username}</span>
          <span data-s-sum-username class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="username" class="hidden px-4 pb-4">
          <p class="text-xs text-ink-500 leading-5">{t.account.usernameD}</p>
          <input data-s-username maxlength="30" autocapitalize="none" spellcheck="false" placeholder="e.g. ahmed_reads"
            class="mt-2 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 disabled:opacity-50" />
          <button data-s-save="username" class="mt-2 w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-username class="hidden mt-2 text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* country */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="country" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.country}</span>
          <span data-s-sum-country class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="country" class="hidden px-4 pb-4">
          <p class="text-xs text-ink-500 leading-5">{t.account.countryD}</p>
          <select data-s-country class="mt-2 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400 disabled:opacity-50">
            <option value="">{t.account.selectCountry ?? t.lb.selectCountry}</option>
          </select>
          <button data-s-save="country" class="mt-2 w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-country class="hidden mt-2 text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* alerts */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="alerts" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.alerts}</span>
          <span data-s-sum-alerts class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="alerts" class="hidden px-4 pb-4 space-y-2">
          <label class="block text-xs font-extrabold uppercase tracking-widest text-ink-500">{t.account.reminderL}</label>
          <select data-s-reminder class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400">
            <option value="">{t.account.noReminder}</option>
            <option value="09:00">09:00</option>
            <option value="12:00">12:00</option>
            <option value="15:00">15:00</option>
            <option value="18:00">18:00</option>
          </select>
          <label class="flex items-center gap-3 cursor-pointer">
            <input data-s-second type="checkbox" class="w-5 h-5 accent-brand-500" />
            <span class="text-sm font-bold text-ink-200">{t.account.secondRem}</span>
          </label>
          <button data-s-save="alerts" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-alerts class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* notifications */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="notifications" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.notif}</span>
          <span data-s-sum-notifications class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="notifications" class="hidden px-4 pb-4 space-y-2">
          <label class="flex items-center gap-3 cursor-pointer">
            <input data-s-alertson type="checkbox" class="w-5 h-5 accent-brand-500" />
            <span class="text-sm font-bold text-ink-200">{t.account.notifL}</span>
          </label>
          <button data-s-save="notifications" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-notifications class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* hide hasanat */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="hide" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.hide}</span>
          <span data-s-sum-hide class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="hide" class="hidden px-4 pb-4 space-y-2">
          <label class="flex items-center gap-3 cursor-pointer">
            <input data-s-hideh type="checkbox" class="w-5 h-5 accent-brand-500" />
            <span class="text-sm font-bold text-ink-200">{t.account.hideL}</span>
          </label>
          <button data-s-save="hide" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-hide class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* reciter */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="reciter" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.reciter}</span>
          <span data-s-sum-reciter class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="reciter" class="hidden px-4 pb-4 space-y-2">
          <select data-s-reciter class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400">
            <option value="Alafasy_128kbps">Sheikh Mishary Al Afasy</option>
          </select>
          <label class="block text-xs font-extrabold uppercase tracking-widest text-ink-500">{t.account.speedL}: <span data-s-speedval class="text-ink-200">1×</span></label>
          <input data-s-speed type="range" min="0.5" max="1.5" step="0.25" value="1" class="w-full accent-brand-500" aria-label="Recitation speed" />
          <p class="text-[11px] text-ink-500">{t.account.reciterNote}</p>
          <button data-s-save="reciter" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-reciter class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* quran script */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="script" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.script}</span>
          <span data-s-sum-script class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="script" class="hidden px-4 pb-4 space-y-2">
          <p data-s-scriptprev class="font-arabic text-center text-white" lang="ar" dir="rtl">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
          <input data-s-fsscript type="range" min="1.25" max="3.5" step="0.25" value="2" class="w-full accent-brand-500" aria-label="Quranic script size" />
          <button data-s-save="script" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-script class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* daily goal */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="goal" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.goal}</span>
          <span data-s-sum-goal class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="goal" class="hidden px-4 pb-4 space-y-2">
          <label class="block text-xs font-extrabold uppercase tracking-widest text-ink-500">{t.account.goalL}</label>
          <input data-s-dailygoal type="number" min="1" max="110" value="1"
            class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400" />
          <button data-s-save="goal" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-goal class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* password */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="password" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.password}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="password" class="hidden px-4 pb-4 space-y-2">
          <div data-s-pwform class="space-y-2">
            <input data-s-currentpw type="password" autocomplete="current-password" placeholder={t.account.currentPw}
              class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400" />
            <input data-s-newpw type="password" minlength="8" autocomplete="new-password" placeholder={t.account.newPw}
              class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400" />
            <button data-s-save="password" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.updatePw}</button>
          </div>
          <p data-s-pwnote class="hidden text-xs text-ink-500 leading-5">{t.account.pwGoogle}</p>
          <p data-s-msg-password class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* email */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="email" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.email}</span>
          <span data-s-sum-email class="text-xs font-bold text-ink-500 truncate max-w-[140px]"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="email" class="hidden px-4 pb-4 space-y-2">
          <input data-s-emailinput type="email" autocomplete="email" placeholder={t.account.emailPh}
            class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400" />
          <button data-s-save="email" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-email class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* name */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="name" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.name}</span>
          <span data-s-sum-name class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="name" class="hidden px-4 pb-4 space-y-2">
          <input data-s-nameinput type="text" maxlength="60" autocomplete="name" placeholder={t.account.namePh}
            class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400" />
          <button data-s-save="name" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-name class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* gender */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="gender" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.gender}</span>
          <span data-s-sum-gender class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="gender" class="hidden px-4 pb-4 space-y-2">
          <p data-s-genderlock class="hidden text-xs font-bold text-gold-300">{t.account.genderLocked}</p>
          <select data-s-gender class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400 disabled:opacity-50">
            <option value="">{t.account.genderN}</option>
            <option value="male">{t.account.male}</option>
            <option value="female">{t.account.female}</option>
            <option value="other">{t.account.other}</option>
          </select>
          <button data-s-save="gender" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-gender class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* bio */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="bio" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.vis.bio}</span>
          <span data-s-sum-bio class="text-xs font-bold text-ink-500 truncate max-w-[140px]"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="bio" class="hidden px-4 pb-4 space-y-2">
          <textarea data-s-bioinput rows="2" maxlength="280" placeholder={t.account.bioPh}
            class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[64px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 resize-y"></textarea>
          <button data-s-save="bio" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-bio class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* font size */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="fontsize" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.fontsize}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="fontsize" class="hidden px-4 pb-4 space-y-2">
          <label class="block text-xs font-extrabold uppercase tracking-widest text-ink-500">{t.account.tranSize}</label>
          <input data-s-fstran type="range" min="0.875" max="1.5" step="0.125" value="1" class="w-full accent-brand-500" aria-label="Translation size" />
          <label class="block text-xs font-extrabold uppercase tracking-widest text-ink-500">{t.account.trlitSize}</label>
          <input data-s-fstrlit type="range" min="0.875" max="1.5" step="0.125" value="1" class="w-full accent-brand-500" aria-label="Transliteration size" />
          <button data-s-save="fontsize" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-fontsize class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>

      {/* translation */}
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <button data-s-toggle="translation" class="w-full flex items-center gap-3 px-4 py-4 min-h-[56px] text-left hover:bg-white/5 transition">
          <span class="flex-1 font-bold text-ink-50 text-[15px]">{t.account.translation}</span>
          <span data-s-sum-translation class="text-xs font-bold text-ink-500"></span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div data-s-panel="translation" class="hidden px-4 pb-4 space-y-2">
          <select data-s-translation class="w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400">
            <option value="ur">Urdu — Fateh Muhammad Jalandhry</option>
            <option value="en">English — Dr. Mustafa Khattab</option>
            <option value="hi">Hindi — Suhel Farooq Khan</option>
          </select>
          <button data-s-save="translation" class="w-full bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">{t.account.save}</button>
          <p data-s-msg-translation class="hidden text-xs font-bold leading-5" role="status"></p>
        </div>
      </div>
    </div>

    {/* privacy */}
    <section class="bg-night-850 border border-white/10 rounded-3xl p-5" aria-label="Profile visibility">
      <h2 class="text-[17px] font-extrabold text-white">{t.account.privacyT}</h2>
      <p class="text-xs text-ink-500 mt-0.5 leading-5">{t.account.privacyD}</p>
      <p data-s-vismsg class="hidden mt-2 text-xs font-bold leading-5" role="status"></p>
      <div class="mt-3 grid gap-2">
        {[
          ['show_name', t.vis.name, t.vis.nameD],
          ['show_avatar', t.vis.pic, t.vis.picD],
          ['show_country', t.vis.country, t.vis.countryD],
          ['show_city', t.vis.city, t.vis.cityD],
          ['show_bio', t.vis.bio, t.vis.bioD],
          ['show_gender', t.vis.gender, t.vis.genderD],
          ['show_stats', t.vis.stats, t.vis.statsD],
        ].map(([k, vt, vs]) => (
          <label class="flex items-center gap-3 bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[56px] cursor-pointer">
            <input type="checkbox" name={k} checked class="w-5 h-5 shrink-0 accent-brand-500" />
            <span class="min-w-0"><span class="block text-sm font-bold text-ink-200">{vt}</span><span class="block text-[11px] text-ink-500">{vs}</span></span>
          </label>
        ))}
      </div>
    </section>

    {/* quick links */}
    <div class="flex gap-2">
      <a href={progressUrl} class="flex-1 inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-5 py-3 min-h-[52px]">{t.account.myProgress}</a>
      <a href={leaderboardUrl} class="flex-1 inline-flex items-center justify-center gap-2 border-2 border-white/15 hover:border-brand-400 text-ink-50 font-extrabold rounded-full px-5 py-3 min-h-[52px]">{t.account.leaderboard}</a>
    </div>

    {/* session */}
    <section class="bg-night-850 border border-white/10 rounded-3xl p-5">
      <h2 class="text-[17px] font-extrabold text-white">{t.account.sessionT}</h2>
      <div class="mt-3 flex flex-col gap-2">
        <button data-s-logout class="w-full bg-white/5 hover:bg-white/10 border border-white/15 text-ink-50 font-extrabold rounded-full px-5 py-3 min-h-[52px]">{t.account.logout}</button>
      </div>
      <details class="mt-4 text-sm">
        <summary class="cursor-pointer font-bold text-red-300 min-h-[44px] inline-flex items-center">{t.account.deleteSum}</summary>
        <p class="mt-2 text-ink-300 leading-6">{t.account.deleteD}</p>
        <button data-s-delete class="mt-3 bg-red-500/15 hover:bg-red-500/25 border border-red-400/40 text-red-200 font-extrabold rounded-full px-5 py-3 min-h-[52px]">{t.account.deleteBtn}</button>
      </details>
    </section>
  </div>
</div>

<AuthModal locale={locale} />

<script define:vars={{ progressUrl, tAcc: t }}>
  (() => {
    const root = document.querySelector('[data-settings]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);

    const COUNTRIES = ['Afghanistan','Algeria','Australia','Austria','Azerbaijan','Bahrain','Bangladesh','Belgium','Bosnia & Herzegovina','Brazil','Brunei','Bulgaria','Cambodia','Canada','Chad','China','Denmark','Djibouti','Egypt','Ethiopia','Fiji','Finland','France','Gambia','Germany','Ghana','Greece','Guinea','Guyana','India','Indonesia','Iran','Iraq','Ireland','Italy','Japan','Jordan','Kazakhstan','Kenya','Kosovo','Kuwait','Kyrgyzstan','Lebanon','Libya','Malaysia','Maldives','Mali','Malta','Mauritania','Mauritius','Morocco','Mozambique','Myanmar','Nepal','Netherlands','New Zealand','Niger','Nigeria','Norway','Oman','Pakistan','Palestine','Philippines','Poland','Portugal','Qatar','Romania','Russia','Saudi Arabia','Senegal','Singapore','Somalia','South Africa','South Korea','Spain','Sri Lanka','Sudan','Suriname','Sweden','Switzerland','Syria','Taiwan','Tajikistan','Tanzania','Thailand','Trinidad & Tobago','Tunisia','Turkey','Turkmenistan','Uganda','Ukraine','United Arab Emirates','United Kingdom','United States','Uzbekistan','Yemen','Zimbabwe','Other'];

    let H = null, profile = null, prefs = null, picked = '', photo = '';

    const withTimeout = (p, ms = 25000) =>
      Promise.race([
        p,
        new Promise((_, reject) => setTimeout(() => reject(new Error(tAcc.account.saveFail)), ms)),
      ]);

    const msg = (sel, ok, text) => {
      const el = $(sel);
      if (!el) return;
      el.textContent = text;
      el.classList.remove('hidden', 'text-emerald-300', 'text-red-300');
      el.classList.add(ok ? 'text-emerald-300' : 'text-red-300');
      if (ok) setTimeout(() => el.classList.add('hidden'), 3000);
    };

    const faceHTML = (u) => {
      try {
        if (H?.faceFor) return H.faceFor(u);
      } catch { /* fallback */ }
      if (u?.avatar) return `<img src="${String(u.avatar).replace(/"/g, '')}" alt="" style="width:100%;height:100%;object-fit:cover;display:block" />`;
      return (u?.avatar_emoji || (u?.name || 'R').trim().charAt(0).toUpperCase() || 'R');
    };
    const paintFace = () => {
      const el = $('[data-s-face]');
      if (!el) return;
      const html = faceHTML({ ...(profile || {}), avatar_emoji: picked, avatar: photo || '' });
      if (String(html).trim().startsWith('<')) el.innerHTML = html;
      else { el.innerHTML = ''; el.textContent = html; }
    };

    const renderGallery = () => {
      const box = $('[data-s-gallery]');
      if (!box || !H?.AVATAR_IDS || box.dataset.done) return;
      box.dataset.done = '1';
      H.AVATAR_IDS.forEach((id) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.avatarId = id;
        b.title = (H.AVATAR_NAMES && H.AVATAR_NAMES[id]) || id;
        b.setAttribute('aria-label', b.title);
        b.className = 'relative aspect-square overflow-hidden rounded-2xl border-2 border-white/10 bg-white/5 hover:border-brand-400 transition min-h-[44px]';
        b.innerHTML = H.AVATAR_SVGS[id];
        b.addEventListener('click', () => selectAvatar(id));
        box.appendChild(b);
      });
      paintGallery();
    };
    const paintGallery = () => {
      root.querySelectorAll('[data-s-gallery] button').forEach((b) => {
        const on = b.dataset.avatarId === picked;
        b.classList.toggle('border-gold-300', !!on);
        b.classList.toggle('ring-2', !!on);
        b.classList.toggle('ring-gold-300/60', !!on);
        b.classList.toggle('border-white/10', !on);
      });
    };
    const savePhoto = async () => {
      try {
        const data = await withTimeout(H.Me.saveProfile({ avatar_emoji: picked, avatar_url: photo }));
        if (data?.user) profile = data.user;
        // Re-read server truth so a silently-dropped pick can't masquerade as saved.
        try {
          const fresh = await withTimeout(H.Me.profile());
          if (fresh?.user) profile = fresh.user;
        } catch { /* keep PUT response */ }
        picked = profile.avatar_emoji || '';
        photo = profile.avatar || '';
        const urlInput = $('[data-s-photourl]');
        if (urlInput) urlInput.value = /^https:\/\//.test(photo) ? photo : '';
        paintGallery();
        syncPhotoUI();
        fillIdentity();
        msg('[data-s-msg-photo]', true, tAcc.account.photoReady);
        if (window.hnUpdateNav) window.hnUpdateNav(profile);
      } catch (err) {
        msg('[data-s-msg-photo]', false, err?.hint || err?.message || tAcc.account.saveFail);
      }
    };
    const selectAvatar = (id) => {
      picked = picked === id ? '' : id;
      if (picked) {
        photo = '';
        const urlInput = $('[data-s-photourl]');
        if (urlInput) urlInput.value = '';
        syncPhotoUI();
      }
      paintGallery();
      paintFace();
      savePhoto();
    };
    const syncPhotoUI = () => {
      const rm = $('[data-s-photorm]');
      if (rm) { rm.classList.toggle('hidden', !photo); rm.classList.toggle('inline-flex', !!photo); }
    };

    const fillIdentity = () => {
      if (!profile) return;
      if ($('[data-s-name]')) $('[data-s-name]').textContent = profile.name || 'Reader';
      if ($('[data-s-email]')) $('[data-s-email]').textContent = profile.email || '';
      if ($('[data-s-provider]')) $('[data-s-provider]').textContent = profile.provider === 'google' ? '◉ Google' : '✉ Email';
      paintFace();
    };

    const sum = (sel, text) => {
      const el = $(sel);
      if (el) el.textContent = text || '';
    };

    const fillAll = () => {
      if (!profile) return;
      // Preview picks must sync from the profile BEFORE any face paint,
      // otherwise the preview override wipes the real photo with ''.
      picked = profile.avatar_emoji || '';
      photo = profile.avatar || '';
      fillIdentity();
      const urlInput = $('[data-s-photourl]');
      if (urlInput) urlInput.value = /^https:\/\//.test(photo) ? photo : '';
      renderGallery();
      paintGallery();
      syncPhotoUI();
      // summaries
      sum('[data-s-sum-username]', profile.username ? `@${profile.username}` : tAcc.account.notSet);
      sum('[data-s-sum-country]', profile.country || tAcc.account.notSet);
      sum('[data-s-sum-name]', profile.name || '');
      sum('[data-s-sum-email]', profile.email || '');
      sum('[data-s-sum-gender]', profile.gender || tAcc.account.notSet);
      const uname = $('[data-s-username]');
      if (uname) {
        uname.value = profile.username || '';
        uname.disabled = !!profile.username;
      }
      const countrySel = $('[data-s-country]');
      if (countrySel && !countrySel.dataset.done) {
        countrySel.dataset.done = '1';
        COUNTRIES.forEach((c) => {
          const o = document.createElement('option');
          o.value = c; o.textContent = c;
          countrySel.appendChild(o);
        });
      }
      if (countrySel) {
        if (profile.country && !COUNTRIES.includes(profile.country)) {
          const o = document.createElement('option');
          o.value = profile.country; o.textContent = profile.country;
          countrySel.appendChild(o);
        }
        countrySel.value = profile.country || '';
        countrySel.disabled = !!profile.country;
      }
      const gSel = $('[data-s-gender]');
      if (gSel) {
        gSel.value = ['male', 'female', 'other'].includes(profile.gender) ? profile.gender : '';
        gSel.disabled = !!profile.gender;
      }
      $('[data-s-genderlock]')?.classList.toggle('hidden', !profile.gender);
      if ($('[data-s-nameinput]')) $('[data-s-nameinput]').value = profile.name || '';
      if ($('[data-s-emailinput]')) $('[data-s-emailinput]').value = profile.email || '';
      if ($('[data-s-bioinput]')) $('[data-s-bioinput]').value = profile.bio || '';
      sum('[data-s-sum-bio]', profile.bio ? (profile.bio.length > 24 ? `${profile.bio.slice(0, 24)}…` : profile.bio) : tAcc.account.notSet);
      // password section only for email accounts
      const isEmail = profile.provider === 'email';
      $('[data-s-pwform]')?.classList.toggle('hidden', !isEmail);
      $('[data-s-pwnote]')?.classList.toggle('hidden', isEmail);
      // prefs editors
      const p = prefs || {};
      if ($('[data-s-reminder]')) $('[data-s-reminder]').value = p.reminder_time || '';
      if ($('[data-s-second]')) $('[data-s-second]').checked = !!p.second_reminder;
      if ($('[data-s-alertson]')) $('[data-s-alertson]').checked = !!p.alerts_on;
      if ($('[data-s-hideh]')) $('[data-s-hideh]').checked = !!p.hide_hasanat;
      if ($('[data-s-reciter]')) $('[data-s-reciter]').value = p.reciter || 'Alafasy_128kbps';
      if ($('[data-s-speed]')) {
        $('[data-s-speed]').value = p.reciter_speed || 1;
        if ($('[data-s-speedval]')) $('[data-s-speedval]').textContent = `${p.reciter_speed || 1}×`;
      }
      if ($('[data-s-fsscript]')) {
        $('[data-s-fsscript]').value = p.font_size_script || 2;
        paintScriptPrev();
      }
      if ($('[data-s-dailygoal]')) $('[data-s-dailygoal]').value = p.daily_goal || 1;
      if ($('[data-s-fstran]')) $('[data-s-fstran]').value = p.font_size_translation || 1;
      if ($('[data-s-fstrlit]')) $('[data-s-fstrlit]').value = p.font_size_translit || 1;
      if ($('[data-s-translation]')) $('[data-s-translation]').value = ['ur', 'en', 'hi'].includes(p.translation) ? p.translation : 'ur';
      sum('[data-s-sum-alerts]', p.reminder_time ? `⏰ ${p.reminder_time}` : tAcc.account.off);
      sum('[data-s-sum-notifications]', p.alerts_on ? tAcc.account.on : tAcc.account.off);
      sum('[data-s-sum-hide]', p.hide_hasanat ? tAcc.account.hiddenW : tAcc.account.shown);
      sum('[data-s-sum-reciter]', 'Al Afasy');
      sum('[data-s-sum-script]', `${p.font_size_script || 2}rem`);
      sum('[data-s-sum-goal]', `${p.daily_goal || 1} ${tAcc.ob.aDay}`);
      sum('[data-s-sum-translation]', ({ ur: 'اردو', en: 'English', hi: 'हिन्दी' })[p.translation] || 'اردو');
      // privacy toggles
      ['show_name', 'show_avatar', 'show_country', 'show_city', 'show_bio', 'show_gender', 'show_stats'].forEach((k) => {
        const c = root.querySelector(`[name="${k}"]`);
        if (c) c.checked = profile[k] !== 0;
      });
    };

    const paintScriptPrev = () => {
      const r = $('[data-s-fsscript]');
      const el = $('[data-s-scriptprev]');
      if (r && el) el.style.fontSize = `${r.value}rem`;
    };
    $('[data-s-fsscript]')?.addEventListener('input', paintScriptPrev);
    $('[data-s-speed]')?.addEventListener('input', () => {
      if ($('[data-s-speedval]')) $('[data-s-speedval]').textContent = `${$('[data-s-speed]').value}×`;
    });

    // accordion
    root.querySelectorAll('[data-s-toggle]').forEach((btn) => btn.addEventListener('click', () => {
      const panel = root.querySelector(`[data-s-panel="${btn.dataset.sToggle}"]`);
      panel?.classList.toggle('hidden');
    }));
    // avatar button jumps to the photo editor
    $('[data-s-photo]')?.addEventListener('click', () => {
      root.querySelector('[data-s-panel="photo"]')?.classList.remove('hidden');
      root.querySelector('[data-s-panel="photo"]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    $('[data-s-back]')?.addEventListener('click', () => {
      try { if (window.history.length > 1) window.history.back(); else window.location.href = progressUrl; }
      catch { window.location.href = progressUrl; }
    });

    // photo upload
    $('[data-s-file]')?.addEventListener('change', (e) => {
      const file = e.currentTarget.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) { msg('[data-s-msg-photo]', false, tAcc.account.needImage); return; }
      const img = new Image();
      const objUrl = URL.createObjectURL(file);
      img.onload = () => {
        try {
          const S = 160;
          const scale = Math.max(S / img.width, S / img.height);
          const cw = document.createElement('canvas');
          cw.width = S; cw.height = S;
          const ctx = cw.getContext('2d');
          const w = img.width * scale, h = img.height * scale;
          ctx.drawImage(img, (S - w) / 2, (S - h) / 2, w, h);
          photo = cw.toDataURL('image/jpeg', 0.82);
          picked = '';
          const urlInput = $('[data-s-photourl]');
          if (urlInput) urlInput.value = '';
          URL.revokeObjectURL(objUrl);
          paintGallery();
          paintFace();
          syncPhotoUI();
          savePhoto();
        } catch { msg('[data-s-msg-photo]', false, tAcc.account.photoFail); }
      };
      img.onerror = () => { URL.revokeObjectURL(objUrl); msg('[data-s-msg-photo]', false, tAcc.account.photoFail); };
      img.src = objUrl;
    });
    $('[data-s-photourl]')?.addEventListener('change', (e) => {
      const v = String(e.currentTarget.value || '').trim();
      if (!v) return;
      if (!/^https:\/\//.test(v)) { msg('[data-s-msg-photo]', false, tAcc.account.needHttps); return; }
      photo = v;
      picked = '';
      paintGallery();
      paintFace();
      syncPhotoUI();
      savePhoto();
    });
    $('[data-s-photorm]')?.addEventListener('click', () => {
      photo = '';
      const urlInput = $('[data-s-photourl]');
      if (urlInput) urlInput.value = '';
      const fileInput = $('[data-s-file]');
      if (fileInput) fileInput.value = '';
      paintFace();
      syncPhotoUI();
      savePhoto();
    });

    // per-row savers
    const val = (sel) => String($(sel)?.value ?? '').trim();
    const SAVERS = {
      username: async () => {
        const v = val('[data-s-username]').toLowerCase();
        const data = await withTimeout(H.Me.saveProfile({ username: v }));
        profile = data.user;
      },
      country: async () => {
        const v = val('[data-s-country]');
        if (!v) throw new Error(tAcc.account.needCountry);
        const data = await withTimeout(H.Me.saveProfile({ country: v }));
        profile = data.user;
      },
      alerts: async () => {
        const reminder = val('[data-s-reminder]') || null;
        const second = $('[data-s-second]')?.checked ? 1 : 0;
        // Enabling any reminder needs the browser permission first — this
        // popup lets us send reminders, verses and challenge alerts.
        if ((reminder || second) && 'Notification' in window && Notification.permission === 'default') {
          try { await Notification.requestPermission(); } catch {}
        }
        const data = await withTimeout(H.Me.savePrefs({
          reminder_time: reminder,
          second_reminder: second,
        }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      notifications: async () => {
        if ('Notification' in window && $('[data-s-alertson]')?.checked && Notification.permission === 'default') {
          try { await Notification.requestPermission(); } catch {}
        }
        const data = await withTimeout(H.Me.savePrefs({ alerts_on: $('[data-s-alertson]')?.checked ? 1 : 0 }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      hide: async () => {
        const data = await withTimeout(H.Me.savePrefs({ hide_hasanat: $('[data-s-hideh]')?.checked ? 1 : 0 }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      reciter: async () => {
        const data = await withTimeout(H.Me.savePrefs({
          reciter: val('[data-s-reciter]') || 'Alafasy_128kbps',
          reciter_speed: Number($('[data-s-speed]')?.value || 1),
        }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      script: async () => {
        const data = await withTimeout(H.Me.savePrefs({ font_size_script: Number($('[data-s-fsscript]')?.value || 2) }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      goal: async () => {
        const data = await withTimeout(H.Me.savePrefs({ daily_goal: Number($('[data-s-dailygoal]')?.value || 1) }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      password: async () => {
        await withTimeout(H.Me.saveProfile({
          current_password: val('[data-s-currentpw]'),
          new_password: val('[data-s-newpw]'),
        }));
        if ($('[data-s-currentpw]')) $('[data-s-currentpw]').value = '';
        if ($('[data-s-newpw]')) $('[data-s-newpw]').value = '';
      },
      email: async () => {
        const v = val('[data-s-emailinput]').toLowerCase();
        const data = await withTimeout(H.Me.saveProfile({ email: v }));
        profile = data.user;
      },
      name: async () => {
        const v = val('[data-s-nameinput]');
        const data = await withTimeout(H.Me.saveProfile({ name: v }));
        profile = data.user;
      },
      gender: async () => {
        const data = await withTimeout(H.Me.saveProfile({ gender: val('[data-s-gender]') }));
        profile = data.user;
      },
      bio: async () => {
        const data = await withTimeout(H.Me.saveProfile({ bio: val('[data-s-bioinput]') }));
        profile = data.user;
      },
      fontsize: async () => {
        const data = await withTimeout(H.Me.savePrefs({
          font_size_translation: Number($('[data-s-fstran]')?.value || 1),
          font_size_translit: Number($('[data-s-fstrlit]')?.value || 1),
        }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
      translation: async () => {
        const data = await withTimeout(H.Me.savePrefs({ translation: val('[data-s-translation]') || 'ur' }));
        prefs = { ...prefs, ...(data.prefs || {}) };
      },
    };
    root.querySelectorAll('[data-s-save]').forEach((btn) => btn.addEventListener('click', async () => {
      const key = btn.dataset.sSave;
      const orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        await SAVERS[key]();
        const fresh = await withTimeout(H.Me.profile()).catch(() => null);
        if (fresh?.user) profile = fresh.user;
        try {
          const p = await withTimeout(H.Me.prefs()).catch(() => null);
          if (p?.prefs) prefs = { ...prefs, ...p.prefs };
        } catch { /* keep */ }
        fillAll();
        if (window.hnUpdateNav) window.hnUpdateNav(profile);
        msg(`[data-s-msg-${key}]`, true, tAcc.account.saved);
      } catch (err) {
        msg(`[data-s-msg-${key}]`, false, err?.hint || err?.message || tAcc.account.saveFail);
      } finally {
        btn.disabled = false;
        btn.textContent = orig;
      }
    }));

    // privacy toggles save instantly
    ['show_name', 'show_avatar', 'show_country', 'show_city', 'show_bio', 'show_gender', 'show_stats'].forEach((key) => {
      const box = root.querySelector(`[name="${key}"]`);
      box?.addEventListener('change', async () => {
        const on = box.checked;
        box.disabled = true;
        msg('[data-s-vismsg]', true, 'Saving…');
        try {
          const data = await withTimeout(H.Me.saveProfile({ [key]: on }));
          if (data?.user) { profile = data.user; fillIdentity(); }
          msg('[data-s-vismsg]', true, tAcc.account.saved);
        } catch (err) {
          box.checked = !on;
          msg('[data-s-vismsg]', false, err?.hint || err?.message || tAcc.account.saveFail);
        } finally {
          box.disabled = false;
        }
      });
    });

    $('[data-s-open-login]')?.addEventListener('click', () => window.hnAuthModal?.open('login'));
    $('[data-s-open-register]')?.addEventListener('click', () => window.hnAuthModal?.open('register'));
    $('[data-s-logout]')?.addEventListener('click', async () => {
      try { await H.Auth.logout(); } finally { window.location.reload(); }
    });
    $('[data-s-delete]')?.addEventListener('click', async () => {
      if (!window.hnConfirm) return;
      const ok = await window.hnConfirm({
        title: tAcc.account.deleteBtn,
        body: tAcc.account.deleteD,
        ok: tAcc.account.deleteBtn,
        cancel: tAcc.settings.cancel,
        danger: true,
      });
      if (!ok) return;
      try {
        await H.Me.deleteAccount();
        window.location.href = '/';
      } catch {
        await window.hnAlert(tAcc.account.saveFail);
      }
    });
    document.addEventListener('hn:auth', () => window.location.reload());

    (async () => {
      H = await import('/habits/habit.js?v=5');
      let user = null;
      try {
        const s = await H.Auth.session();
        user = s.user;
      } catch { user = null; }
      $('[data-s-loading]')?.classList.add('hidden');
      if (!user) { $('[data-s-gate]')?.classList.remove('hidden'); return; }
      try {
        const [full, p] = await Promise.all([
          H.Me.profile().catch(() => ({ user })),
          H.Me.prefs().catch(() => ({ prefs: {} })),
        ]);
        profile = full.user || user;
        prefs = p.prefs || {};
      } catch { profile = user; prefs = {}; }
      $('[data-s-live]')?.classList.remove('hidden');
      fillAll();
      if (window.hnUpdateNav) window.hnUpdateNav(profile);
    })();
  })();
</script>
