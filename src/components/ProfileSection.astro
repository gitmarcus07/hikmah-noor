---
/* Profile section — login / signup / logout + editable details
 * (name, username, avatar, country, city, bio, gender, language).
 * Works standalone on /profile/ pages. Uses AuthModal + /habits/habit.js.
 */
import AuthModal from './AuthModal.astro';
import { localizedPath } from '../i18n/utils';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const progressUrl = localizedPath(locale, '/tools/my-progress/');
const readUrl = localizedPath(locale, '/tools/read/');
const homeUrl = localizedPath(locale, '/');
const leaderboardUrl = localizedPath(locale, '/leaderboard/');
---

<div class="max-w-3xl mx-auto px-4 py-8" data-profile>
  {/* loading */}
  <div data-p-loading class="animate-pulse space-y-3">
    <div class="h-40 bg-night-850 border border-white/10 rounded-3xl"></div>
    <div class="h-64 bg-night-850 border border-white/10 rounded-3xl"></div>
  </div>

  {/* logged-out gate */}
  <div data-p-gate class="hidden text-center bg-night-850 border border-white/10 rounded-3xl p-8 shadow-xl shadow-black/30">
    <div class="mx-auto w-20 h-20 grid place-items-center rounded-full bg-brand-500/15 border border-brand-500/30 text-5xl" aria-hidden="true">👤</div>
    <p class="mt-4 text-[11px] font-extrabold uppercase tracking-[0.18em] text-brand-300">Your profile</p>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white mt-1">Login or create a free account</h1>
    <p class="mt-2 text-ink-300 text-[15px] leading-7 max-w-md mx-auto">Save your name, country and reading progress. Pick up your Quran habit on any device — 100% free, forever.</p>
    <div class="mt-5 flex flex-col sm:flex-row gap-3 justify-center">
      <button data-p-open-login class="bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">Login →</button>
      <button data-p-open-register class="bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">Create free account</button>
    </div>
    <div class="mt-5 flex flex-wrap justify-center gap-2 text-xs font-bold text-ink-300">
      <span class="bg-white/5 border border-white/10 rounded-full px-3 py-1.5">🔥 Streaks</span>
      <span class="bg-white/5 border border-white/10 rounded-full px-3 py-1.5">📖 Resume reading</span>
      <span class="bg-white/5 border border-white/10 rounded-full px-3 py-1.5">🔖 Saved verses</span>
    </div>
  </div>

  {/* logged-in view */}
  <div data-p-live class="hidden space-y-4">
    {/* header card */}
    <section class="bg-night-850 border border-white/10 rounded-3xl p-6 shadow-xl shadow-black/30">
      <div class="flex items-start gap-4">
        <div data-p-avatar class="w-20 h-20 shrink-0 grid place-items-center rounded-full bg-brand-500/15 border-2 border-brand-500/40 text-4xl overflow-hidden" aria-hidden="true">👤</div>
        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-brand-300">Asalam Alaykum</p>
          <h1 data-p-name class="text-2xl font-extrabold text-white truncate">Reader</h1>
          <p class="text-sm text-ink-300 truncate"><span data-p-username class="font-bold text-brand-300"></span> <span data-p-email class="text-ink-500"></span></p>
          <p data-p-meta class="mt-1 text-xs text-ink-500 leading-5"></p>
          <p data-p-bio class="mt-2 text-sm text-ink-200 leading-6"></p>
        </div>
        <span data-p-provider class="shrink-0 text-[11px] font-extrabold uppercase tracking-wide bg-white/5 border border-white/10 rounded-full px-3 py-1.5 text-ink-300"></span>
      </div>
      {/* mini stats */}
      <div data-p-stats class="mt-4 grid grid-cols-3 gap-2 text-center"></div>
      <div class="mt-4 flex flex-col sm:flex-row gap-2">
        <a data-p-read href={readUrl} class="flex-1 inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-night-900 font-extrabold rounded-full px-5 py-3 min-h-[52px]">📖 Continue reading</a>
        <a href={progressUrl} class="flex-1 inline-flex items-center justify-center gap-2 border-2 border-white/15 hover:border-brand-400 text-ink-50 font-extrabold rounded-full px-5 py-3 min-h-[52px]">📊 My progress</a>
      </div>
      <a href={leaderboardUrl} class="mt-2 flex items-center justify-center gap-2 text-sm font-extrabold text-gold-300 hover:text-amber-200 min-h-[44px]">🏆 Global leaderboard →</a>
    </section>

    {/* edit form */}
    <section class="bg-night-850 border border-white/10 rounded-3xl p-6 shadow-xl shadow-black/30" aria-label="Edit profile">
      <h2 class="text-lg font-extrabold text-white">✏️ Profile details</h2>
      <p class="text-sm text-ink-500 mt-0.5">Shown on your progress page and greetings. Email stays private.</p>

      <p class="mt-4 text-xs font-extrabold uppercase tracking-widest text-ink-500">Choose an avatar</p>
      <p class="mt-1 text-xs text-ink-500">Pick a design below — or use your own photo. Your choice shows here instantly.</p>
      <div data-p-gallery class="mt-2 grid grid-cols-4 sm:grid-cols-6 gap-2" role="radiogroup" aria-label="Avatar gallery">
        {/* filled by script from habit.js (single source of truth) */}
      </div>

      <div class="mt-4 rounded-2xl border border-white/10 bg-night-800 p-4">
        <p class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Custom photo <span class="normal-case font-bold">(optional)</span></p>
        <div class="mt-2 flex flex-col sm:flex-row gap-2">
          <label data-p-upload class="flex-1 inline-flex items-center justify-center gap-2 cursor-pointer border-2 border-dashed border-white/15 hover:border-brand-400 rounded-2xl px-4 py-3 min-h-[52px] text-sm font-extrabold text-ink-200 transition">
            📷 Upload photo
            <input data-p-file type="file" accept="image/*" class="sr-only" />
          </label>
          <button type="button" data-p-photorm class="hidden items-center justify-center gap-2 text-sm font-bold text-red-300 hover:text-red-200 border border-red-400/30 rounded-2xl px-4 py-3 min-h-[52px]">Remove</button>
        </div>
        <input data-p-photourl type="url" inputmode="url" maxlength="500" placeholder="…or paste an https:// image link"
          class="mt-2 w-full bg-night-850 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 text-sm" />
        <p class="mt-1.5 text-[11px] text-ink-500 leading-4">Uploads are resized on your device before saving. A photo replaces the gallery avatar.</p>
      </div>

      <form data-p-form class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Display name *</span>
          <input name="name" required minlength="2" maxlength="60" autocomplete="name" placeholder="Your name"
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400" />
        </label>
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Username <span data-p-lock-u class="hidden text-gold-300 normal-case tracking-normal">🔒 set once</span></span>
          <input name="username" data-p-uname maxlength="30" autocomplete="username" placeholder="e.g. ahmed_reads" autocapitalize="none" spellcheck="false"
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 disabled:opacity-50" />
          <span data-p-unamestatus class="mt-1 hidden text-[11px] font-bold leading-4" role="status"></span>
          <span class="mt-1 block text-[11px] text-ink-500 leading-4">3–30 chars: a–z, 0–9, . and _ — must start &amp; end with a letter or number. Set once, never changeable. No two people can share one. Set it to appear on the <a href={leaderboardUrl} class="font-bold text-gold-300 hover:text-amber-200">global leaderboard</a>.</span>
        </label>
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Country * <span data-p-lock-c class="hidden text-gold-300 normal-case tracking-normal">🔒 set once</span></span>
          <select name="country" data-p-country
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400 disabled:opacity-50">
            <option value="">Select country…</option>
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">City</span>
          <input name="city" maxlength="60" autocomplete="address-level2" placeholder="City"
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400" />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Bio <span data-p-biocount class="text-ink-500 normal-case font-bold"></span></span>
          <textarea name="bio" rows="2" maxlength="280" placeholder="A line about you — e.g. learning Quran daily, from Delhi 🤲"
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[64px] text-ink-50 placeholder:text-ink-500 outline-none focus:ring-2 ring-brand-400 resize-y"></textarea>
        </label>
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Gender <span data-p-lock-g class="hidden text-gold-300 normal-case tracking-normal">🔒 set once</span></span>
          <select name="gender" class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400 disabled:opacity-50">
            <option value="">Prefer not to say</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
          </select>
        </label>
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Language</span>
          <select name="language" class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400">
            <option value="en">English</option>
            <option value="hi">हिन्दी (Hindi)</option>
            <option value="ur">اردو (Urdu)</option>
            <option value="ar">العربية (Arabic)</option>
          </select>
        </label>
        <p data-p-msg class="hidden sm:col-span-2 text-sm font-bold leading-6 rounded-2xl px-4 py-3" role="status"></p>
        <button type="submit" data-p-save class="sm:col-span-2 w-full bg-brand-500 hover:bg-brand-400 disabled:opacity-60 text-night-900 font-extrabold rounded-2xl px-5 py-3.5 min-h-[56px]">Save profile ✓</button>
      </form>
    </section>

    {/* visibility — name, username & photo are always public */}
    <section class="bg-night-850 border border-white/10 rounded-3xl p-6 shadow-xl shadow-black/30" aria-label="Profile visibility">
      <h2 class="text-lg font-extrabold text-white">👁️ Who sees what</h2>
      <p class="text-sm text-ink-500 mt-0.5">Your name, username and photo are always public. Toggle the rest on your public profile &amp; leaderboard.</p>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <label class="flex items-center gap-3 bg-night-800 border border-white/10 rounded-2xl px-4 py-3.5 min-h-[56px] cursor-pointer">
          <input type="checkbox" name="show_country" checked class="w-5 h-5 shrink-0 accent-brand-500" />
          <span class="text-sm font-bold text-ink-200">Country</span>
        </label>
        <label class="flex items-center gap-3 bg-night-800 border border-white/10 rounded-2xl px-4 py-3.5 min-h-[56px] cursor-pointer">
          <input type="checkbox" name="show_city" checked class="w-5 h-5 shrink-0 accent-brand-500" />
          <span class="text-sm font-bold text-ink-200">City</span>
        </label>
        <label class="flex items-center gap-3 bg-night-800 border border-white/10 rounded-2xl px-4 py-3.5 min-h-[56px] cursor-pointer">
          <input type="checkbox" name="show_bio" checked class="w-5 h-5 shrink-0 accent-brand-500" />
          <span class="text-sm font-bold text-ink-200">Bio</span>
        </label>
        <label class="flex items-center gap-3 bg-night-800 border border-white/10 rounded-2xl px-4 py-3.5 min-h-[56px] cursor-pointer">
          <input type="checkbox" name="show_gender" checked class="w-5 h-5 shrink-0 accent-brand-500" />
          <span class="text-sm font-bold text-ink-200">Gender</span>
        </label>
        <label class="flex items-center gap-3 bg-night-800 border border-white/10 rounded-2xl px-4 py-3.5 min-h-[56px] cursor-pointer sm:col-span-2">
          <input type="checkbox" name="show_stats" checked class="w-5 h-5 shrink-0 accent-brand-500" />
          <span class="text-sm font-bold text-ink-200">Reading stats <span class="font-normal text-ink-500">(verses, hasanat, streak &amp; rank)</span></span>
        </label>
      </div>
    </section>

    {/* security (email accounts) */}
    <section data-p-security class="hidden bg-night-850 border border-white/10 rounded-3xl p-6 shadow-xl shadow-black/30" aria-label="Password">
      <h2 class="text-lg font-extrabold text-white">🔑 Change password</h2>
      <form data-p-pw class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">Current password</span>
          <input name="current_password" type="password" autocomplete="current-password" placeholder="••••••••"
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400" />
        </label>
        <label class="block">
          <span class="text-xs font-extrabold uppercase tracking-widest text-ink-500">New password (min 8)</span>
          <input name="new_password" type="password" minlength="8" autocomplete="new-password" placeholder="New password"
            class="mt-1.5 w-full bg-night-800 border border-white/10 rounded-2xl px-4 py-3 min-h-[52px] text-ink-50 outline-none focus:ring-2 ring-brand-400" />
        </label>
        <p data-p-pwmsg class="hidden sm:col-span-2 text-sm font-bold leading-6 rounded-2xl px-4 py-3" role="status"></p>
        <button class="sm:col-span-2 border-2 border-white/15 hover:border-brand-400 text-ink-50 font-extrabold rounded-2xl px-5 py-3 min-h-[52px]">Update password</button>
      </form>
    </section>

    {/* session */}
    <section class="bg-night-850 border border-white/10 rounded-3xl p-6 shadow-xl shadow-black/30">
      <h2 class="text-lg font-extrabold text-white">⚙️ Session</h2>
      <div class="mt-3 flex flex-col sm:flex-row gap-2">
        <button data-p-logout class="flex-1 bg-white/5 hover:bg-white/10 border border-white/15 text-ink-50 font-extrabold rounded-full px-5 py-3 min-h-[52px]">Logout</button>
        <a href={homeUrl} class="flex-1 inline-flex items-center justify-center text-sm font-bold text-ink-500 hover:text-brand-300 min-h-[52px]">← Back home</a>
      </div>
      <details class="mt-4 text-sm">
        <summary class="cursor-pointer font-bold text-red-300 min-h-[44px] inline-flex items-center">Delete my account…</summary>
        <p class="mt-2 text-ink-300 leading-6">This permanently removes your profile, streaks, stats and bookmarks. This cannot be undone.</p>
        <button data-p-delete class="mt-3 bg-red-500/15 hover:bg-red-500/25 border border-red-400/40 text-red-200 font-extrabold rounded-full px-5 py-3 min-h-[52px]">Delete account permanently</button>
      </details>
    </section>
  </div>
</div>

<AuthModal />

<script define:vars={{ readUrl, progressUrl }}>
  (() => {
    const root = document.querySelector('[data-profile]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s);

    const COUNTRIES = ['Afghanistan','Algeria','Australia','Austria','Azerbaijan','Bahrain','Bangladesh','Belgium','Bosnia & Herzegovina','Brazil','Brunei','Bulgaria','Cambodia','Canada','Chad','China','Denmark','Djibouti','Egypt','Ethiopia','Fiji','Finland','France','Gambia','Germany','Ghana','Greece','Guinea','Guyana','India','Indonesia','Iran','Iraq','Ireland','Italy','Japan','Jordan','Kazakhstan','Kenya','Kosovo','Kuwait','Kyrgyzstan','Lebanon','Libya','Malaysia','Maldives','Mali','Malta','Mauritania','Mauritius','Morocco','Mozambique','Myanmar','Nepal','Netherlands','New Zealand','Niger','Nigeria','Norway','Oman','Pakistan','Palestine','Philippines','Poland','Portugal','Qatar','Romania','Russia','Saudi Arabia','Senegal','Singapore','Somalia','South Africa','South Korea','Spain','Sri Lanka','Sudan','Suriname','Sweden','Switzerland','Syria','Taiwan','Tajikistan','Tanzania','Thailand','Trinidad & Tobago','Tunisia','Turkey','Turkmenistan','Uganda','Ukraine','United Arab Emirates','United Kingdom','United States','Uzbekistan','Yemen','Zimbabwe','Other'];

    // Populate country select
    const countrySel = $('[data-p-country]');
    COUNTRIES.forEach((c) => {
      const o = document.createElement('option');
      o.value = c; o.textContent = c;
      countrySel?.appendChild(o);
    });

    let H = null, profile = null, picked = '', photo = '';

    const showMsg = (sel, ok, text) => {
      const el = $(sel);
      if (!el) return;
      el.textContent = text;
      el.classList.remove('hidden', 'bg-emerald-400/15', 'text-emerald-200', 'border', 'border-emerald-300/30', 'bg-red-400/10', 'text-red-200');
      el.classList.add(ok ? 'bg-emerald-400/15' : 'bg-red-400/10', ok ? 'text-emerald-200' : 'text-red-200');
    };

    // Guarantees the user always sees a result — a hanging request
    // becomes a timeout message instead of a dead button.
    const withTimeout = (p, ms = 25000) =>
      Promise.race([
        p,
        new Promise((_, reject) => setTimeout(() => reject(new Error('Request timed out — check your connection and retry.')), ms)),
      ]);

    // Instagram-like username rules (mirrors functions/api username logic).
    const UNAME_RE = /^[a-z0-9][a-z0-9._]{1,28}[a-z0-9]$/;
    const UNAME_BLOCKED = new Set(['admin', 'administrator', 'support', 'official', 'hikmahnoor', 'hikmah_noor', 'root', 'system']);
    const unameLocalError = (v) => {
      if (!v) return null;
      if (v.length < 3) return 'Username needs at least 3 characters.';
      if (v.length > 30) return 'Username can be at most 30 characters.';
      if (!UNAME_RE.test(v)) return 'Use a–z, 0–9, . and _ — start & end with a letter or number.';
      if (v.includes('..')) return 'Username cannot contain consecutive dots.';
      if (UNAME_BLOCKED.has(v)) return 'That username is reserved — pick another.';
      return null;
    };
    const paintUnameStatus = (kind, text) => {
      const st = $('[data-p-unamestatus]');
      if (!st) return;
      st.textContent = text || '';
      st.classList.toggle('hidden', !text);
      st.classList.remove('text-emerald-300', 'text-red-300', 'text-ink-500');
      st.classList.add(kind === 'ok' ? 'text-emerald-300' : kind === 'bad' ? 'text-red-300' : 'text-ink-500');
    };
    let unameTimer = null;
    const checkUsernameLive = async () => {
      const input = $('[data-p-uname]');
      const v = String(input?.value || '').trim();
      if (!v) { paintUnameStatus('', ''); return 'empty'; }
      const local = unameLocalError(v);
      if (local) { paintUnameStatus('bad', `✗ ${local}`); return 'invalid'; }
      paintUnameStatus('', 'Checking…');
      try {
        const r = await fetch(`/api/username-check?u=${encodeURIComponent(v)}`, { credentials: 'same-origin' });
        const d = await r.json();
        if (d.available) {
          paintUnameStatus('ok', d.mine ? '✓ This is your username.' : '✓ Username available!');
          return 'ok';
        }
        paintUnameStatus('bad', d.reason === 'taken' ? '✗ Username already taken — try another.' : '✗ That username is not allowed.');
        return 'taken';
      } catch {
        paintUnameStatus('', '');
        return 'unknown';
      }
    };

    // Visible face via habit.js (photo → SVG → emoji → initial).
    const faceHTML = (u) => {
      try {
        if (H?.faceFor) return H.faceFor(u);
      } catch { /* fall through to local fallback */ }
      if (u?.avatar) return `<img src="${String(u.avatar).replace(/"/g, '')}" alt="" style="width:100%;height:100%;object-fit:cover;display:block" />`;
      return (u?.avatar_emoji || (u?.name || 'R').trim().charAt(0).toUpperCase() || 'R');
    };
    const setFace = (el, html) => {
      if (!el) return;
      if (String(html).trim().startsWith('<')) { el.innerHTML = html; }
      else { el.innerHTML = ''; el.textContent = html; }
    };
    // Live preview (unsaved) combining the current picks.
    const previewUser = () => ({ ...(profile || {}), avatar_emoji: picked, avatar: photo || '' });
    const paintPreview = () => setFace($('[data-p-avatar]'), faceHTML(previewUser()));

    const renderGallery = () => {
      const box = $('[data-p-gallery]');
      if (!box || !H?.AVATAR_IDS || box.dataset.done) return;
      box.dataset.done = '1';
      H.AVATAR_IDS.forEach((id) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.avatar = id;
        b.setAttribute('role', 'radio');
        b.setAttribute('aria-checked', 'false');
        b.title = (H.AVATAR_NAMES && H.AVATAR_NAMES[id]) || id;
        b.setAttribute('aria-label', b.title);
        b.className = 'relative aspect-square overflow-hidden rounded-2xl border-2 border-white/10 bg-white/5 hover:border-brand-400 hover:scale-[1.03] active:scale-95 transition min-h-[52px]';
        b.innerHTML = H.AVATAR_SVGS[id];
        b.addEventListener('click', () => selectAvatar(id));
        box.appendChild(b);
      });
      paintGallery();
    };
    const paintGallery = () => {
      root.querySelectorAll('[data-avatar]').forEach((b) => {
        const on = b.dataset.avatar === picked;
        b.classList.toggle('border-gold-300', on);
        b.classList.toggle('ring-2', on);
        b.classList.toggle('ring-gold-300/60', on);
        b.classList.toggle('border-white/10', !on);
        b.setAttribute('aria-checked', String(on));
      });
    };
    const selectAvatar = (id) => {
      picked = picked === id ? '' : id;
      if (picked) {
        // Gallery choice replaces any custom photo.
        photo = '';
        const urlInput = $('[data-p-photourl]');
        if (urlInput) urlInput.value = '';
        syncPhotoUI();
      }
      paintGallery();
      paintPreview();
    };
    const syncPhotoUI = () => {
      const rm = $('[data-p-photorm]');
      if (rm) { rm.classList.toggle('hidden', !photo); rm.classList.toggle('inline-flex', !!photo); }
    };

    const paintHeader = (u) => {
      setFace($('[data-p-avatar]'), faceHTML(u));
      if ($('[data-p-name]')) $('[data-p-name]').textContent = u.name || 'Reader';
      if ($('[data-p-username]')) $('[data-p-username]').textContent = u.username ? `@${u.username}` : '';
      if ($('[data-p-email]')) $('[data-p-email]').textContent = u.email || '';
      const loc = [u.city, u.country].filter(Boolean).join(', ');
      const since = u.created_at ? new Date(u.created_at * 1000).toLocaleDateString(undefined, { month: 'short', year: 'numeric' }) : '';
      if ($('[data-p-meta]')) $('[data-p-meta]').textContent = [loc, since ? `Member since ${since}` : ''].filter(Boolean).join(' • ');
      if ($('[data-p-bio]')) { $('[data-p-bio]').textContent = u.bio || ''; $('[data-p-bio]').classList.toggle('hidden', !u.bio); }
      if ($('[data-p-provider]')) $('[data-p-provider]').textContent = u.provider === 'google' ? '◉ Google' : '✉ Email';
      if (window.hnUpdateNav) window.hnUpdateNav(u);
    };

    const fillForm = (u) => {
      const f = $('[data-p-form]');
      if (!f) return;
      f.name.value = u.name || '';
      f.username.value = u.username || '';
      if (countrySel) countrySel.value = COUNTRIES.includes(u.country) ? u.country : (u.country ? '' : '');
      if (u.country && !COUNTRIES.includes(u.country)) {
        const o = document.createElement('option');
        o.value = u.country; o.textContent = u.country; o.selected = true;
        countrySel?.appendChild(o);
      }
      f.city.value = u.city || '';
      f.bio.value = u.bio || '';
      f.gender.value = ['male', 'female', 'other'].includes(u.gender) ? u.gender : '';
      f.language.value = ['en', 'hi', 'ur', 'ar'].includes(u.language) ? u.language : 'en';
      // One-time fields lock after their first set.
      const setLocked = (sel, badgeSel, locked) => {
        const el = f.querySelector(sel);
        if (el) { el.disabled = locked; el.classList.toggle('opacity-50', locked); }
        const badge = root.querySelector(badgeSel);
        if (badge) badge.classList.toggle('hidden', !locked);
      };
      setLocked('[name="username"]', '[data-p-lock-u]', !!(u.username));
      setLocked('[name="country"]', '[data-p-lock-c]', !!(u.country));
      setLocked('[name="gender"]', '[data-p-lock-g]', !!(u.gender));
      // Visibility toggles (default: visible).
      const vis = (k) => u[k] !== 0;
      ['show_country', 'show_city', 'show_bio', 'show_gender', 'show_stats'].forEach((k) => {
        const c = root.querySelector(`[name="${k}"]`);
        if (c) c.checked = vis(k);
      });
      picked = u.avatar_emoji || '';
      photo = u.avatar || '';
      const urlInput = $('[data-p-photourl]');
      if (urlInput) urlInput.value = /^https:\/\//.test(photo) ? photo : '';
      renderGallery();
      paintGallery();
      syncPhotoUI();
      const bc = $('[data-p-biocount]');
      if (bc) bc.textContent = `(${(u.bio || '').length}/280)`;
    };

    const paintStats = async () => {
      const box = $('[data-p-stats]');
      if (!box) return;
      try {
        const [{ streak }, all] = await Promise.all([
          H.Me.streak().catch(() => ({ streak: { current: 0, longest: 0 } })),
          H.Me.stats('all').catch(() => ({ stats: { verses: 0, hasanat: 0 } })),
        ]);
        const tiles = [
          ['🔥', `${streak?.current || 0}`, 'day streak'],
          ['📖', `${all?.stats?.verses || 0}`, 'verses'],
          ['💗', H.fmtCompact(all?.stats?.hasanat || 0), 'hasanat'],
        ];
        box.innerHTML = tiles.map(([i, v, t]) => `<div class="bg-night-800 border border-white/10 rounded-2xl px-2 py-3"><div class="text-xl">${i}</div><div class="font-extrabold text-lg text-white">${v}</div><div class="text-[11px] font-bold text-ink-500">${t}</div></div>`).join('');
      } catch { /* stats optional */ }
    };

    $('[data-p-open-login]')?.addEventListener('click', () => window.hnAuthModal?.open('login'));
    $('[data-p-open-register]')?.addEventListener('click', () => window.hnAuthModal?.open('register'));

    const bioInput = $('[data-p-form]')?.querySelector('[name="bio"]');
    bioInput?.addEventListener('input', () => {
      const bc = $('[data-p-biocount]');
      if (bc) bc.textContent = `(${bioInput.value.length}/280)`;
    });

    // Username: force lowercase + Instagram charset, live availability.
    const unameInput = $('[data-p-uname]');
    unameInput?.addEventListener('input', () => {
      if (unameInput.disabled) return;
      const clean = unameInput.value.toLowerCase().replace(/[^a-z0-9._]/g, '').slice(0, 30);
      if (clean !== unameInput.value) unameInput.value = clean;
      clearTimeout(unameTimer);
      unameTimer = setTimeout(checkUsernameLive, 450);
    });

    // Custom photo: upload (resized on-device) or https link.
    $('[data-p-file]')?.addEventListener('change', (e) => {
      const file = e.currentTarget.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) { showMsg('[data-p-msg]', false, 'Please choose an image file.'); return; }
      const img = new Image();
      const objUrl = URL.createObjectURL(file);
      img.onload = () => {
        try {
          const S = 160;
          const scale = Math.max(S / img.width, S / img.height);
          const cw = document.createElement('canvas');
          cw.width = S; cw.height = S;
          const ctx = cw.getContext('2d');
          const w = img.width * scale, h = img.height * scale;
          ctx.drawImage(img, (S - w) / 2, (S - h) / 2, w, h);
          photo = cw.toDataURL('image/jpeg', 0.82);
          picked = '';
          const urlInput = $('[data-p-photourl]');
          if (urlInput) urlInput.value = '';
          URL.revokeObjectURL(objUrl);
          paintGallery();
          paintPreview();
          syncPhotoUI();
          showMsg('[data-p-msg]', true, '✓ Photo ready — hit Save profile to keep it.');
          setTimeout(() => $('[data-p-msg]')?.classList.add('hidden'), 3000);
        } catch { showMsg('[data-p-msg]', false, 'Could not read that image.'); }
      };
      img.onerror = () => { URL.revokeObjectURL(objUrl); showMsg('[data-p-msg]', false, 'Could not read that image.'); };
      img.src = objUrl;
    });

    $('[data-p-photourl]')?.addEventListener('change', (e) => {
      const v = String(e.currentTarget.value || '').trim();
      if (!v) return;
      if (!/^https:\/\//.test(v)) { showMsg('[data-p-msg]', false, 'Photo link must start with https://'); return; }
      photo = v;
      picked = '';
      paintGallery();
      paintPreview();
      syncPhotoUI();
    });

    $('[data-p-photorm]')?.addEventListener('click', () => {
      photo = '';
      const urlInput = $('[data-p-photourl]');
      if (urlInput) urlInput.value = '';
      const fileInput = $('[data-p-file]');
      if (fileInput) fileInput.value = '';
      paintPreview();
      syncPhotoUI();
    });

    const saveForm = $('[data-p-form]');
    saveForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget;
      const btn = form.querySelector('[data-p-save]') || form.querySelector('button');
      const origLabel = btn ? btn.textContent : '';
      try {
        if (!H?.Me?.saveProfile) throw new Error('App updated — please hard-refresh (Ctrl+Shift+R) and try again.');
        if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
        const fd = new FormData(form);
        const str = (k) => String(fd.get(k) ?? '');
        // Locked (one-time) fields are omitted so the server keeps them.
        const lockedU = !!(profile && profile.username);
        const lockedC = !!(profile && profile.country);
        const lockedG = !!(profile && profile.gender);
        let unameVal = '';
        if (!lockedU) {
          unameVal = str('username').trim().toLowerCase();
          const unameErr = unameLocalError(unameVal);
          if (unameErr) {
            paintUnameStatus('bad', `✗ ${unameErr}`);
            throw new Error(unameErr);
          }
        }
        // Country is compulsory — challenge windows follow country time.
        let ctryVal = '';
        if (!lockedC) {
          ctryVal = str('country').trim();
          if (!ctryVal) {
            const sel = form.querySelector('[data-p-country]');
            sel?.focus();
            throw new Error('Please select your country — challenges unlock on your country time.');
          }
        }
        const visBox = (k) => {
          const c = root.querySelector(`[name="${k}"]`);
          return c ? !!c.checked : undefined;
        };
        console.log('[profile] saving…');
        const data = await withTimeout(H.Me.saveProfile({
          name: str('name'),
          username: lockedU ? undefined : unameVal,
          country: lockedC ? undefined : ctryVal,
          city: str('city'), bio: str('bio'),
          gender: lockedG ? undefined : str('gender'),
          language: str('language'), avatar_emoji: picked, avatar_url: photo,
          show_country: visBox('show_country'), show_city: visBox('show_city'),
          show_bio: visBox('show_bio'), show_gender: visBox('show_gender'),
          show_stats: visBox('show_stats'),
        }));
        if (!data?.user) throw new Error('Server returned an empty response — please retry.');
        profile = data.user;
        // Re-read server truth so the screen always matches the database.
        try {
          const fresh = await withTimeout(H.Me.profile());
          if (fresh?.user) profile = fresh.user;
        } catch { /* keep PUT response */ }
        paintHeader(profile);
        fillForm(profile);
        paintPreview();
        paintUnameStatus('', '');
        if (window.hnUpdateNav) window.hnUpdateNav(profile);
        console.log('[profile] saved ok');
        showMsg('[data-p-msg]', true, '✓ Profile saved.');
      } catch (err) {
        console.error('[profile] save failed:', err);
        showMsg('[data-p-msg]', false, err?.hint || err?.message || 'Could not save — try again.');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = origLabel; }
        setTimeout(() => $('[data-p-msg]')?.classList.add('hidden'), 5000);
      }
    });

    $('[data-p-pw]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!H?.Me?.saveProfile) {
        showMsg('[data-p-pwmsg]', false, 'App updated — please hard-refresh (Ctrl+Shift+R) and try again.');
        return;
      }
      const form = e.currentTarget;
      const fd = new FormData(form);
      try {
        await withTimeout(H.Me.saveProfile({
          current_password: String(fd.get('current_password') ?? ''),
          new_password: String(fd.get('new_password') ?? ''),
        }));
        showMsg('[data-p-pwmsg]', true, '✓ Password updated.');
        form.reset();
      } catch (err) {
        showMsg('[data-p-pwmsg]', false, err.hint || 'Could not update password.');
      } finally {
        setTimeout(() => $('[data-p-pwmsg]')?.classList.add('hidden'), 4000);
      }
    });

    $('[data-p-logout]')?.addEventListener('click', async () => {
      try { await H.Auth.logout(); } finally { window.location.reload(); }
    });

    $('[data-p-delete]')?.addEventListener('click', async () => {
      if (!H?.Me?.deleteAccount) {
        alert('App updated — please hard-refresh (Ctrl+Shift+R) and try again.');
        return;
      }
      if (!confirm('Delete your account and all progress permanently?')) return;
      if (!confirm('Last chance — this cannot be undone. Delete?')) return;
      try {
        await H.Me.deleteAccount();
        window.location.href = '/';
      } catch {
        alert('Could not delete — try again.');
      }
    });

    // Fresh login via modal: take the user Home (dashboard). If the member
    // view is already on screen, just refresh the nav chip — never reload
    // (a reload would wipe the just-shown success message).
    document.addEventListener('hn:auth', async (e) => {
      try {
        if (document.querySelector('[data-p-live]:not(.hidden)')) {
          if (window.hnUpdateNav && e.detail?.user) window.hnUpdateNav(e.detail.user);
          return;
        }
        window.location.href = progressUrl;
      } catch { /* modal flow */ }
    });

    (async () => {
      H = await import('/habits/habit.js?v=4');
      let user = null;
      try {
        const s = await H.Auth.session();
        user = s.user;
      } catch { user = null; }
      $('[data-p-loading]')?.classList.add('hidden');
      if (!user) { $('[data-p-gate]')?.classList.remove('hidden'); return; }
      try {
        const full = await H.Me.profile().catch(() => ({ user }));
        profile = full.user || user;
      } catch { profile = user; }
      $('[data-p-live]')?.classList.remove('hidden');
      paintHeader(profile);
      fillForm(profile);
      if (profile.provider === 'email') $('[data-p-security]')?.classList.remove('hidden');
      paintStats();
      // Continue-reading deep link
      try {
        const { resume } = await H.Me.resume().catch(() => ({ resume: null }));
        if (resume) {
          const a = $('[data-p-read]');
          if (a) { const base = String(readUrl).replace(/\/$/, ''); a.href = `${base}/${resume.surah}/?verse=${resume.verse}`; }
        }
      } catch {}
    })();
  })();
</script>
