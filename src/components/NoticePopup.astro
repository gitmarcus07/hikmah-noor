---
// Global site-notice popup (managed from /al-mushrif/).
// Fetches GET /api/notices/active on every page load.
// Timing: first show 10s after visit, then repeat every 5 mins after dismiss.
// Throttled with localStorage so page navigations don't re-spam the popup.
// All text is injected via textContent (never innerHTML) — admin input
// cannot execute scripts. No props: styling is pre-built (emerald/gold).
//
// NOTE: styles MUST stay is:global — the whole card is built at runtime by
// JavaScript, and Astro's default scoped styles never match runtime-created
// elements (that bug once rendered the popup as unstyled inline content).
---
<div id="hn-notice-root" hidden></div>

<style is:global>
  #hn-notice-root {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem calc(1.5rem + env(safe-area-inset-bottom));
    pointer-events: none;
  }
  #hn-notice-root[hidden] { display: none !important; }
  .hn-notice-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 32, 27, 0.5);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    pointer-events: auto;
    animation: hn-notice-fade 0.2s ease;
  }
  .hn-notice-card {
    position: relative;
    pointer-events: auto;
    width: 100%;
    max-width: 22rem;
    max-height: min(86vh, 30rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--hn-card);
    border: 1px solid var(--hn-border);
    border-top: 4px solid var(--hn-primary);
    box-shadow: var(--hn-shadow-lg);
    padding: 1.25rem 1.15rem 1.1rem;
    border-radius: 20px;
    animation: hn-notice-up 0.25s ease;
  }
  @media (min-width: 640px) {
    .hn-notice-card { padding: 1.35rem 1.3rem 1.2rem; }
  }
  .hn-notice-card[data-kind="donate"] { border-top-color: var(--hn-gold); }
  .hn-notice-close {
    position: absolute;
    top: 0.7rem;
    inset-inline-end: 0.7rem;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--hn-border);
    background: var(--hn-bg-soft);
    color: var(--hn-muted);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }
  .hn-notice-close:hover { border-color: var(--hn-primary); color: var(--hn-primary); }
  .hn-notice-card h2 {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.45;
    color: var(--hn-ink);
    margin: 0.6rem 0 0;
    padding-inline-end: 2.75rem;
  }
  .hn-notice-card p {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--hn-muted);
  }
  .hn-notice-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .hn-share-menu {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--hn-border);
    animation: hn-notice-fade 0.18s ease;
  }
  .hn-share-opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.65rem 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 12px;
    border: 1px solid var(--hn-border);
    background: var(--hn-bg-soft);
    color: var(--hn-ink);
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
  }
  .hn-share-opt:hover { border-color: var(--hn-primary); color: var(--hn-primary); }
  .hn-donate-mini {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--hn-border);
    display: grid;
    gap: 0.55rem;
    justify-items: center;
    text-align: center;
  }
  .hn-donate-qr-frame {
    position: relative;
    padding: 0.45rem;
    border-radius: 16px;
    background: #fff;
    border: 2px solid var(--hn-gold);
    box-shadow: 0 6px 18px rgba(15, 81, 50, 0.12);
  }
  .hn-donate-qr-frame img {
    display: block;
    width: 150px;
    height: 150px;
    border-radius: 10px;
  }
  @media (max-width: 480px) {
    .hn-donate-qr-frame img { width: 118px; height: 118px; }
    .hn-donate-mini { gap: 0.45rem; }
  }
  .hn-donate-qr-crescent {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--hn-primary-deep);
    color: #fff;
    font-size: 1.1rem;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }
  .hn-donate-mask {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--hn-muted);
    background: var(--hn-bg-soft);
    border: 1px dashed var(--hn-border);
    border-radius: 999px;
    padding: 0.28rem 0.7rem;
  }
  .hn-donate-row { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .hn-donate-note { font-size: 0.76rem; line-height: 1.6; color: var(--hn-muted); margin: 0; }
  /* Collapsible QR keeps the popup short on phones — no forced scroll. */
  .hn-donate-qr-toggle { width: 100%; }
  .hn-donate-qr-toggle > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--hn-border);
    background: var(--hn-bg-soft);
    color: var(--hn-ink);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .hn-donate-qr-toggle > summary::-webkit-details-marker { display: none; }
  .hn-donate-qr-toggle > summary::marker { content: ''; }
  .hn-donate-qr-toggle > summary:hover { border-color: var(--hn-primary); color: var(--hn-primary); }
  .hn-donate-qr-body {
    display: grid;
    gap: 0.45rem;
    justify-items: center;
    padding-top: 0.6rem;
    animation: hn-notice-fade 0.18s ease;
  }
  @keyframes hn-notice-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hn-notice-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hn-notice-backdrop, .hn-notice-card, .hn-share-menu { animation: none; }
  }
  @media print {
    #hn-notice-root { display: none !important; }
  }
</style>

<script is:inline>
  (() => {
    const ROOT_ID = 'hn-notice-root';
    const FIRST_DELAY = 10_000; // first show: 10s after visit
    const REPEAT_DELAY = 5 * 60_000; // re-show: every 5 mins after dismiss
    const KEY_SHOWN = 'hn-notice-last-shown';
    const KEY_CLOSED = 'hn-notice-last-closed';
    // Never pop over the admin panel itself.
    if (location.pathname.replace(/\/$/, '') === '/al-mushrif') return;
    const root = document.getElementById(ROOT_ID);
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';

    let showTimer = 0;
    let current = null;

    function now() { return Date.now(); }
    function readKey(k) {
      try { return Number(localStorage.getItem(k)) || 0; } catch { return 0; }
    }
    function writeKey(k, v) {
      try { localStorage.setItem(k, String(v)); } catch { /* private mode */ }
    }
    function lastActivity() {
      return Math.max(readKey(KEY_SHOWN), readKey(KEY_CLOSED));
    }

    const KIND_LABEL = { share: 'Share the reward', donate: 'Support us', info: 'Notice' };

    // Donation UPI — full ID never shown as visible text (masked label only).
    // NOTE: view-source still contains the VPA inside the upi:// href + QR
    // payload (unavoidable). For a fully number-free address, create an alias
    // VPA (e.g. hikmahnoor@ybl) and update the parts below + /donate-qr.svg.
    const DONATE_VPA = ['9906273197', '-2', '@ybl'].join('');
    const DONATE_MASKED = '•••••• ••••@ybl';
    function donatePageHref() {
      const m = location.pathname.match(/^\/(hi|ur|ar)(?=\/|$)/);
      return (m ? '/' + m[1] : '') + '/donate/';
    }
    function upiIntent() {
      // Raw `@` in pa — PhonePe rejects the %40-encoded form.
      return 'upi://pay?pa=' + DONATE_VPA
        + '&pn=' + encodeURIComponent('Hikmah Noor')
        + '&cu=INR&tn=' + encodeURIComponent('Hikmah Noor Donation');
    }
    function isMobileUpi() {
      try {
        if (/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) return true;
        if (window.matchMedia && matchMedia('(pointer:coarse)').matches) return true;
      } catch {}
      return false;
    }
    function buildDonateMini() {
      const box = document.createElement('div');
      box.className = 'hn-donate-mini';
      const mask = document.createElement('div');
      mask.className = 'hn-donate-mask';
      mask.textContent = 'Hikmah Noor • UPI ' + DONATE_MASKED;
      const row = document.createElement('div');
      row.className = 'hn-donate-row';
      const pay = document.createElement('a');
      pay.className = 'hn-btn hn-btn-primary !min-h-[48px] text-sm';
      pay.textContent = 'Donate via UPI app';
      pay.href = upiIntent();
      // Desktop browsers have no UPI apps — a dead click looks broken.
      // Intercept and explain instead; phones navigate normally.
      pay.addEventListener('click', (e) => {
        if (isMobileUpi()) return;
        e.preventDefault();
        deskHint.hidden = false;
      });
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'hn-btn hn-btn-secondary !min-h-[48px] text-sm';
      copy.textContent = 'Copy UPI ID';
      copy.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(DONATE_VPA); copy.textContent = 'Copied ✓'; }
        catch { try { window.prompt('Copy UPI ID:', DONATE_VPA); } catch {} }
        setTimeout(() => { copy.textContent = 'Copy UPI ID'; }, 2200);
      });
      row.append(pay, copy);
      const deskHint = document.createElement('p');
      deskHint.className = 'hn-donate-note';
      deskHint.hidden = true;
      deskHint.textContent = 'UPI apps live on your phone — please scan the QR below or open this page on mobile.';
      // QR behind a toggle so phones never have to scroll the popup.
      // Open by default on desktop, closed on touch devices.
      const toggle = document.createElement('details');
      toggle.className = 'hn-donate-qr-toggle';
      if (!isMobileUpi()) toggle.open = true;
      const sum = document.createElement('summary');
      sum.textContent = 'Show QR to scan';
      toggle.addEventListener('toggle', () => {
        sum.textContent = toggle.open ? 'Hide QR' : 'Show QR to scan';
      });
      const body = document.createElement('div');
      body.className = 'hn-donate-qr-body';
      const frame = document.createElement('div');
      frame.className = 'hn-donate-qr-frame';
      const img = document.createElement('img');
      img.src = '/donate-qr.svg';
      img.alt = 'Scan to donate to Hikmah Noor via UPI';
      img.width = 150; img.height = 150;
      img.loading = 'lazy'; img.decoding = 'async';
      const badge = document.createElement('span');
      badge.className = 'hn-donate-qr-crescent';
      badge.setAttribute('aria-hidden', 'true');
      badge.textContent = '☪';
      frame.append(img, badge);
      const apps = document.createElement('p');
      apps.className = 'hn-donate-note';
      apps.textContent = 'Scan with PhonePe / GPay / Paytm / BHIM.';
      body.append(frame, apps);
      toggle.append(sum, body);
      const note = document.createElement('p');
      note.className = 'hn-donate-note';
      // The VPA is registered to the owner personally — UPI always shows the
      // real account name at payment time, so ask donors to verify it.
      note.textContent = 'In your UPI app, verify the payee name before paying. ' +
        'Full details on the donate page:';
      const more = document.createElement('a');
      more.className = 'hn-donate-note';
      more.href = donatePageHref();
      more.style.fontWeight = '800';
      more.textContent = 'Open donate page →';
      box.append(mask, row, deskHint, toggle, note, more);
      return box;
    }

    function close() {
      root.hidden = true;
      root.innerHTML = '';
      document.removeEventListener('keydown', onKey);
      writeKey(KEY_CLOSED, now());
      // Re-show 5 mins after dismiss (same tab).
      scheduleShow(REPEAT_DELAY);
    }
    function onKey(e) {
      if (e.key === 'Escape') close();
    }

    function shareData() {
      return {
        title: 'Hikmah Noor',
        text: 'Assalamu alaikum! Hikmah Noor has the Quran with translation, 300 duas and Islamic guides — free in 4 languages. Sharing beneficial knowledge is Sadaqah Jariyah:',
        url: location.origin + '/',
      };
    }

    function shareSite(anchor) {
      const data = shareData();
      if (navigator.share) {
        try {
          const p = navigator.share(data);
          if (p && p.catch) {
            // User cancelled the sheet (AbortError) → stay quiet.
            // Any real failure → show the in-card app grid instead.
            p.catch((err) => {
              if (err && err.name !== 'AbortError') toggleShareMenu(anchor, data);
            });
          }
          return;
        } catch {
          // Fall through to the in-card grid.
        }
      }
      // Laptops/desktops (no native sheet): inline picker with every share app.
      toggleShareMenu(anchor, data);
    }

    function toggleShareMenu(anchor, data) {
      const card = anchor.closest('.hn-notice-card');
      if (!card) return;
      const old = card.querySelector('.hn-share-menu');
      if (old) { old.remove(); return; }
      const enc = encodeURIComponent;
      const menu = document.createElement('div');
      menu.className = 'hn-share-menu';
      menu.setAttribute('role', 'group');
      menu.setAttribute('aria-label', 'Share via');
      const links = [
        { t: 'WhatsApp', h: 'https://wa.me/?text=' + enc(data.text + ' ' + data.url) },
        { t: 'Telegram', h: 'https://t.me/share/url?url=' + enc(data.url) + '&text=' + enc(data.text) },
        { t: 'Facebook', h: 'https://www.facebook.com/sharer/sharer.php?u=' + enc(data.url) },
        { t: 'X', h: 'https://twitter.com/intent/tweet?text=' + enc(data.text) + '&url=' + enc(data.url) },
        { t: 'Email', h: 'mailto:?subject=' + enc(data.title) + '&body=' + enc(data.text + '\n' + data.url) },
      ];
      for (const l of links) {
        const a = document.createElement('a');
        a.className = 'hn-share-opt';
        a.textContent = l.t;
        a.href = l.h;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        menu.appendChild(a);
      }
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'hn-share-opt';
      copy.textContent = 'Copy link';
      copy.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(data.url); copy.textContent = 'Copied ✓'; }
        catch { copy.textContent = data.url; }
      });
      menu.appendChild(copy);
      anchor.after(menu);
    }

    function render(n) {
      root.innerHTML = '';
      const dir = document.documentElement.dir || 'ltr';
      const backdrop = document.createElement('div');
      backdrop.className = 'hn-notice-backdrop';
      backdrop.addEventListener('click', close);

      const card = document.createElement('div');
      card.className = 'hn-notice-card';
      card.dataset.kind = n.kind || 'info';
      card.setAttribute('role', 'dialog');
      card.setAttribute('aria-modal', 'true');
      card.setAttribute('aria-label', n.title);
      card.dir = dir === 'rtl' ? 'rtl' : 'ltr';

      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'hn-notice-close';
      x.setAttribute('aria-label', 'Dismiss');
      x.textContent = '×';
      x.addEventListener('click', close);

      const badge = document.createElement('span');
      badge.className = 'hn-badge ' + (n.kind === 'donate' ? 'hn-badge-gold' : 'hn-badge-primary');
      badge.textContent = KIND_LABEL[n.kind] || KIND_LABEL.info;

      const title = document.createElement('h2');
      title.textContent = n.title;

      const msg = document.createElement('p');
      msg.textContent = n.message;

      const actions = document.createElement('div');
      actions.className = 'hn-notice-actions';

      if (n.kind === 'share') {
        // Share appeals show ONLY the Share button — no donation/CTA button.
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'hn-btn hn-btn-primary !min-h-[48px] text-sm';
        b.textContent = 'Share';
        b.addEventListener('click', () => shareSite(b));
        actions.appendChild(b);
      } else {
        if (n.cta_url) {
          const a = document.createElement('a');
          a.className = 'hn-btn hn-btn-primary !min-h-[48px] text-sm';
          a.textContent = n.cta_label || (n.kind === 'donate' ? 'Donate any amount' : 'Learn more');
          a.href = n.cta_url;
          // Internal donate page stays in-tab; external links open new tab.
          if (/^https?:/i.test(n.cta_url) && !n.cta_url.includes(location.host)) {
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
          }
          actions.appendChild(a);
        } else if (n.kind === 'donate') {
          // No CTA configured — deep-link to the beautiful donate page.
          const a = document.createElement('a');
          a.className = 'hn-btn hn-btn-primary !min-h-[48px] text-sm';
          a.textContent = n.cta_label || 'Donate any amount';
          a.href = donatePageHref();
          actions.appendChild(a);
        }
      }

      card.append(x, badge, title, msg);
      if (actions.childNodes.length) card.appendChild(actions);
      // Donation appeals always carry the UPI QR block (masked ID, no digits shown).
      if (n.kind === 'donate') {
        try { card.appendChild(buildDonateMini()); } catch {}
      }
      root.append(backdrop, card);
      root.hidden = false;
      writeKey(KEY_SHOWN, now());
      document.addEventListener('keydown', onKey);
      x.focus({ preventScroll: true });
    }

    async function fetchAndShow() {
      // Don't stack: if already open, wait for dismiss (close() reschedules).
      if (!root.hidden) return;
      let data = null;
      try {
        const r = await fetch('/api/notices/active', { headers: { accept: 'application/json' }, cache: 'no-store' });
        if (!r.ok) return;
        data = await r.json();
      } catch {
        return;
      }
      const n = data && data.notice;
      if (!n || !n.id) return;
      current = n;
      render(n);
    }

    function scheduleShow(delayMs) {
      if (showTimer) clearTimeout(showTimer);
      showTimer = setTimeout(fetchAndShow, Math.max(0, delayMs));
    }

    function boot() {
      const last = lastActivity();
      let delay;
      if (!last) {
        // First visit: show 10s after load (never blocks first paint).
        delay = FIRST_DELAY;
      } else {
        const remaining = REPEAT_DELAY - (now() - last);
        // Already waited 5+ mins (e.g. navigated back later): show quickly.
        // Otherwise wait out the remainder so navigations don't re-spam.
        delay = remaining <= 0 ? 2000 : remaining;
      }
      scheduleShow(delay);
    }

    if (document.readyState === 'complete') boot();
    else window.addEventListener('load', boot);
  })();
</script>
