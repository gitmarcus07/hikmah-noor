---
/* Sahaba artwork — own branding for the /sahaba/ hub.
 * Same premium inline-SVG language, distinct maroon-night background,
 * gold accents, per-companion motifs + emblem calligraphy. */
interface Props {
  motif: string;
  arabic: string;
  prophet: string;
  accent?: string;
}
const { motif, arabic, prophet, accent = '#E3B94E' } = Astro.props;
const label = `Companion ${prophet}`;
const uid = `${(prophet ?? motif ?? 'art').toLowerCase().replace(/[^a-z0-9]+/g, '')}-${String(arabic ?? '').length}-${String(prophet ?? '').length}`;
---
<svg viewBox="0 0 800 450" class="w-full h-auto block" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`sbg-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2A0F14" />
      <stop offset="0.55" stop-color="#1D0A0E" />
      <stop offset="1" stop-color="#0E0507" />
    </linearGradient>
    <radialGradient id={`sglow-${uid}`} cx="0.5" cy="0.4" r="0.55">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.10" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`svig-${uid}`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.6" stop-color="#000000" stop-opacity="0" />
      <stop offset="1" stop-color="#000000" stop-opacity="0.45" />
    </radialGradient>
    <pattern id={`spat-${uid}`} width="96" height="96" patternUnits="userSpaceOnUse" patternTransform="rotate(12)">
      <g fill="none" stroke="#D4AF37" stroke-opacity="0.15" stroke-width="1.2">
        <g transform="translate(48,48)">
          <rect x="-15" y="-15" width="30" height="30" />
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45)" />
          <circle r="2.2" fill="#D4AF37" fill-opacity="0.5" stroke="none" />
        </g>
      </g>
    </pattern>
  </defs>

  <rect width="800" height="450" fill={`url(#sbg-${uid})`} />
  <rect width="800" height="450" fill={`url(#spat-${uid})`} />
  <rect width="800" height="450" fill={`url(#sglow-${uid})`} />

  <g fill="none" stroke="#D4AF37" stroke-opacity="0.55" stroke-width="1.6">
    <g transform="translate(40,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(40,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
  </g>

  <g fill="#F7E08B">
    <circle cx="150" cy="130" r="2.4" opacity="0.6" />
    <circle cx="650" cy="120" r="2" opacity="0.5" />
    <circle cx="120" cy="330" r="2" opacity="0.5" />
    <circle cx="680" cy="340" r="2.4" opacity="0.6" />
  </g>

  {/* companion motif */}
  <g transform="translate(350,36)" fill="none" stroke={accent} stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    {motif === 'door' && (
      <g>
        <path d="M25 80 V45 C25 25 35 15 45 15 C55 15 65 25 65 45 V80" />
        <path d="M15 80 H75" stroke-width="3" />
        <circle cx="58" cy="55" r="2.6" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'scales' && (
      <g>
        <path d="M45 10 V70 M20 70 H70" />
        <path d="M45 18 L20 26 M45 18 L70 26" stroke-width="3" />
        <path d="M12 26 L20 44 L28 26 M62 26 L70 44 L78 26" stroke-width="3" />
      </g>
    )}
    {motif === 'manuscript' && (
      <g>
        <path d="M45 30 C35 24 25 24 15 28 V66 C25 62 35 62 45 68 C55 62 65 62 75 66 V28 C65 24 55 24 45 30 Z" />
        <path d="M45 30 V68" stroke-width="3" />
      </g>
    )}
    {motif === 'sword' && (
      <g>
        <path d="M28 72 L62 20" />
        <path d="M62 20 L70 12 M62 20 L54 22" stroke-width="4" />
        <path d="M22 62 L34 74" stroke-width="6" />
        <path d="M20 76 L28 68" stroke-width="4" />
      </g>
    )}
    {motif === 'bow' && (
      <g>
        <path d="M30 10 C55 25 55 65 30 80" />
        <path d="M30 10 V80" stroke-width="3" />
        <path d="M30 45 H68 M68 45 L60 38 M68 45 L60 52" stroke-width="3" />
      </g>
    )}
    {motif === 'minaret' && (
      <g>
        <path d="M38 78 V30 M52 78 V30 M38 30 H52" stroke-width="4" />
        <path d="M45 30 C38 22 38 14 45 8 C52 14 52 22 45 30 Z" stroke-width="3" />
        <path d="M34 50 H56" stroke-width="3" />
      </g>
    )}
    {motif === 'shield' && (
      <g>
        <path d="M45 8 L68 18 V44 C68 60 58 70 45 78 C32 70 22 60 22 44 V18 Z" />
        <circle cx="45" cy="42" r="7" stroke-width="3" />
      </g>
    )}
    {motif === 'horse' && (
      <g>
        <path d="M25 78 C25 60 32 52 45 52 C58 52 65 60 65 78" />
        <path d="M35 78 V66 M45 78 V64 M55 78 V66" stroke-width="3" />
        <circle cx="33" cy="58" r="2.4" fill={accent} stroke="none" />
        <circle cx="45" cy="56" r="2.4" fill={accent} stroke="none" />
        <circle cx="57" cy="58" r="2.4" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'coin' && (
      <g>
        <circle cx="45" cy="48" r="28" />
        <rect x="33" y="36" width="24" height="24" transform="rotate(45 45 48)" stroke-width="3" />
      </g>
    )}
    {motif === 'arrow' && (
      <g>
        <path d="M12 66 L62 30" />
        <polygon points="62,30 50,30 54,40" stroke-width="3" />
        <path d="M12 66 L20 58 M16 70 L24 62" stroke-width="3" />
      </g>
    )}
    {motif === 'flag' && (
      <g>
        <path d="M28 10 V80" />
        <path d="M28 16 H66 L58 28 L66 40 H28" />
      </g>
    )}
    {motif === 'key' && (
      <g>
        <circle cx="30" cy="34" r="12" />
        <path d="M40 44 L70 74" />
        <path d="M58 62 L64 56 M64 68 L70 62" stroke-width="3" />
      </g>
    )}
    {motif === 'lantern' && (
      <g>
        <circle cx="45" cy="12" r="4" stroke-width="3" />
        <path d="M45 16 V24 M32 24 H58 L52 66 H38 Z" />
        <path d="M38 40 H52" stroke-width="3" />
        <path d="M34 72 H56" stroke-width="4" />
      </g>
    )}
    {motif === 'scroll' && (
      <g>
        <rect x="22" y="24" width="46" height="40" rx="4" />
        <path d="M30 34 H60 M30 44 H60 M30 54 H50" stroke-width="3" />
      </g>
    )}
    {motif === 'inkpot' && (
      <g>
        <path d="M32 48 H58 L54 76 H36 Z" />
        <path d="M28 48 H62" stroke-width="4" />
        <path d="M52 48 L66 18" />
        <circle cx="67" cy="15" r="2.4" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'staff' && (
      <g>
        <path d="M45 80 V26" />
        <path d="M45 26 C45 16 52 14 58 16 C62 18 62 24 58 26" stroke-width="4" />
        <path d="M20 80 H70" stroke-width="3" />
      </g>
    )}
    {motif === 'voice' && (
      <g>
        <circle cx="30" cy="50" r="5" fill={accent} stroke="none" />
        <path d="M44 36 C54 44 54 56 44 64" stroke-width="4" />
        <path d="M56 28 C72 42 72 58 56 72" stroke-width="4" />
      </g>
    )}
    {motif === 'ewer' && (
      <g>
        <path d="M36 40 H56 V66 C56 74 50 78 45 78 C40 78 34 74 34 66 Z" />
        <path d="M56 48 C64 46 68 50 66 58" stroke-width="3" />
        <path d="M36 48 C28 46 26 52 30 58" stroke-width="3" />
        <path d="M42 30 H48 V40 H42 Z" stroke-width="3" />
      </g>
    )}
    {motif === 'book' && (
      <g>
        <rect x="26" y="18" width="38" height="52" rx="3" />
        <path d="M52 18 L58 30 L52 42" stroke-width="3" />
        <path d="M34 30 H48" stroke-width="3" />
      </g>
    )}
    {motif === 'banner' && (
      <g>
        <path d="M45 8 V80" />
        <path d="M45 14 H70 V44 H45" stroke-width="4" />
        <path d="M50 44 L50 52 M58 44 L58 52 M66 44 L66 52" stroke-width="3" />
      </g>
    )}
    {motif === 'helmet' && (
      <g>
        <path d="M20 58 C20 36 32 24 45 24 C58 24 70 36 70 58" />
        <path d="M14 58 H76" stroke-width="4" />
        <path d="M45 24 V12" stroke-width="3" />
        <circle cx="45" cy="10" r="2.4" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'dome' && (
      <g>
        <path d="M22 62 C22 40 32 30 45 30 C58 30 68 40 68 62" />
        <path d="M45 30 V20" stroke-width="3" />
        <circle cx="45" cy="16" r="3" stroke-width="3" />
        <path d="M16 62 H74 M16 62 V74 M74 62 V74" stroke-width="3" />
      </g>
    )}
    {motif === 'tablet' && (
      <g>
        <polygon points="30,14 60,14 66,24 66,70 24,70 24,24" />
        <path d="M34 34 H56 M34 44 H56 M34 54 H48" stroke-width="3" />
      </g>
    )}
    {motif === 'crescent' && (
      <g>
        <path d="M60 10 A30 30 0 1 0 60 70 A24 24 0 1 1 60 10 Z" />
        <circle cx="66" cy="20" r="3" fill={accent} stroke="none" />
      </g>
    )}
  </g>

  {/* emblem calligraphy */}
  <text x="400" y="218" text-anchor="middle" dominant-baseline="central" font-size="30" fill="#F7F3E3" font-family="'Amiri Quran','Noto Naskh Arabic',serif">{arabic}</text>
  <text x="400" y="292" text-anchor="middle" font-size="24" letter-spacing="8" fill={accent} font-family="Inter,sans-serif" font-weight="800">{prophet.toUpperCase()}</text>
  <g stroke={accent} stroke-width="1.4" opacity="0.9">
    <line x1="300" y1="322" x2="388" y2="322" />
    <line x1="412" y1="322" x2="500" y2="322" />
    <rect x="394" y="316" width="12" height="12" transform="rotate(45 400 322)" fill={accent} stroke="none" />
  </g>
  <text x="400" y="360" text-anchor="middle" font-size="15" letter-spacing="4" fill="#ffffff" fill-opacity="0.7" font-family="Inter,sans-serif" font-weight="600">COMPANION • SAHABI</text>

  <rect width="800" height="450" fill={`url(#svig-${uid})`} />
</svg>
