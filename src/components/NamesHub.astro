---
/* 99 Names hub — Allah and Prophet Muhammad (shared template, EN + locale).
 * Cards link to individual name pages; chrome localized via NAMES_UI. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { ALLAH, PROPHET } from '../data/names';
import { localizeAllahName, localizeProphetName } from '../lib/content-i18n';
import { secUI, ALLAH_UI, PROPHET_UI_NAMES } from '../lib/site-ui-1';

interface Props { locale: string; kind: 'allah' | 'prophet'; }
const { locale, kind } = Astro.props;
const dict = getDict(locale);
const T = secUI(locale, kind === 'allah' ? ALLAH_UI : PROPHET_UI_NAMES);
const L = (p: string) => localizedPath(locale, p);
const isAllah = kind === 'allah';
const names = isAllah ? ALLAH : PROPHET;
const path = isAllah ? '/names-of-allah/' : '/names-muhammad/';
const otherPath = isAllah ? '/names-muhammad/' : '/names-of-allah/';

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path },
];
const loc = (nm: any) => isAllah ? localizeAllahName(nm, locale) : localizeProphetName(nm, locale);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath={path}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badgeN}</span>
        <span class="hn-badge">{T.badge2}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <div class="mt-4 max-w-xl">
        <input id="namefilter" class="hn-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search"
          placeholder={T.filterPh} aria-label={T.filterPh} />
      </div>
    </div>

    <p id="namecount" class="mt-6 mb-3 text-sm" style="color:var(--hn-muted)">99 names</p>
    <div id="namegrid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {names.map((nm: any) => {
        const l: any = loc(nm);
        const meaning = l.meaning ?? nm.meaning;
        return (
          <a href={L(`${path}${nm.slug}/`)} class="namerow hn-card hn-card-hover hn-card-pad block" data-search={`${nm.translit} ${nm.meaning} ${meaning}`.toLowerCase()}>
            <div class="flex items-start gap-3">
              <span class="hn-verse-num shrink-0">{nm.n}</span>
              <div class="min-w-0 flex-1">
                <p class="font-arabic text-[26px] leading-[1.9]" lang="ar" dir="rtl">{nm.arabic}</p>
                <p class="font-extrabold text-[15px] leading-6 mt-1">{nm.translit}</p>
                <p class="text-[13.5px] leading-5" style="color:var(--hn-muted)">{meaning}</p>
              </div>
            </div>
          </a>
        );
      })}
    </div>
    <script is:inline>
      (() => {
        const input = document.getElementById('namefilter');
        const count = document.getElementById('namecount');
        const rows = [...document.querySelectorAll('.namerow')];
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          let n = 0;
          rows.forEach((r) => {
            const show = !q || (r.dataset.search || '').includes(q);
            r.classList.toggle('hidden', !show);
            if (show) n++;
          });
          if (count) count.textContent = `${n} name${n === 1 ? '' : 's'}`;
        });
      })();
    </script>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title={T.faqTitle} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-label="Related">
      <SectionHeader eyebrow="Related" title={T.keepTitle} />
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={L(otherPath)} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-bold block text-[15px] leading-6">{T.otherH1}</span>
          <span class="text-[13px]" style="color:var(--hn-muted)">{T.otherSub}</span>
        </a>
        <a href={L('/duas/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-bold block text-[15px] leading-6">{T.duasH1}</span>
          <span class="text-[13px]" style="color:var(--hn-muted)">{T.duasSub}</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
