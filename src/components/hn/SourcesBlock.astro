---
/* SourcesBlock — unified sources + trust footer for guide/dua/seerah/surah pages. */
import { localizedPath } from '../../i18n/utils';
import { widgetUI } from '../../lib/dua-ui-i18n';
import ReviewedBadge from './ReviewedBadge.astro';

interface Props {
  locale: string;
  source: string;
  narrator?: string | null;
  grade?: string | null;
  originLabel?: string | null;
  reviewedDate?: string;
  reviewer?: string;
}
const { locale, source, narrator, grade, originLabel, reviewedDate, reviewer } = Astro.props;
const L = (p: string) => localizedPath(locale, p);
const W = widgetUI(locale);
---
<div class="hn-card hn-card-pad mt-6" aria-label={W.sourcesTitle}>
  <p class="hn-block-label">{W.sourcesTitle}</p>
  <p class="text-[15px] font-semibold leading-6">{source}</p>
  <p class="mt-1 text-[13px] leading-6" style="color:var(--hn-muted)">
    {originLabel && <span>{originLabel} • </span>}
    {narrator && <span>{W.narratedBy} <strong style="color:var(--hn-ink)">{narrator}</strong> • </span>}
    {grade && <span>{W.gradeWord}: <strong style="color:var(--hn-ink)">{grade}</strong> • </span>}
    <span>{W.learnNote}</span>
  </p>
  <p class="mt-1 text-[13px] leading-6" style="color:var(--hn-muted)">
    {W.eduNote} <a href={L('/methodology/')} class="font-bold underline underline-offset-2" style="color:var(--hn-primary)">{W.methodology}</a>
    {' '}and <a href={L('/disclaimer/')} class="font-bold underline underline-offset-2" style="color:var(--hn-primary)">{W.disclaimer}</a>.
  </p>
  <ReviewedBadge locale={locale} date={reviewedDate} reviewer={reviewer} />
</div>
