---
/* Reusable reading block: Arabic (focus) + transliteration + meaning + reference.
 * Only renders sections when data exists. Includes copy/share actions (progressive). */
import Icon from '../Icon.astro';
import { getDict } from '../../i18n/utils';
import { widgetUI } from '../../lib/dua-ui-i18n';

interface Props {
  arabic?: string;
  translit?: string;
  translation?: string;
  reference?: string;
  id?: string;
  locale?: string;
}
const { arabic, translit, translation, reference, id = 'reading', locale = 'en' } = Astro.props;
const dict = getDict(locale);
const W = widgetUI(locale);
const shareText = [arabic, translation].filter(Boolean).join('\n\n');
---
<div class="hn-reading-card" id={id}>
  {arabic && (
    <div>
      <p class="hn-block-label">{dict.article.arabic}</p>
      <p class="arabic-block" lang="ar" dir="rtl">{arabic}</p>
    </div>
  )}
  {translit && (
    <div>
      <hr class="hn-divider" />
      <p class="hn-block-label">{dict.article.transliteration}</p>
      <p class="translit-block">{translit}</p>
    </div>
  )}
  {translation && (
    <div>
      <hr class="hn-divider" />
      <p class="hn-block-label">{dict.article.meaning}</p>
      <p class="meaning-block">{translation}</p>
    </div>
  )}
  {reference && (
    <div>
      <hr class="hn-divider" />
      <p class="hn-block-label">{W.reference}</p>
      <p class="text-sm font-semibold">{reference}</p>
    </div>
  )}
  <hr class="hn-divider" />
  <div class="flex flex-wrap gap-2" data-reading-actions>
    <button type="button" class="hn-btn hn-btn-secondary !min-h-[44px] !py-2.5 !px-4 text-sm" data-copy={shareText} data-copied={W.copied} aria-label={W.copy}>
      <Icon name="copy" size={17} /> {W.copy}
    </button>
    <button type="button" class="hn-btn hn-btn-secondary !min-h-[44px] !py-2.5 !px-4 text-sm" data-share={shareText} data-copied={W.copied} aria-label={W.share}>
      <Icon name="share" size={17} /> {W.share}
    </button>
  </div>
</div>
<script>
  (() => {
    document.querySelectorAll('[data-reading-actions]').forEach((wrap) => {
      const copyBtn = wrap.querySelector('[data-copy]');
      const shareBtn = wrap.querySelector('[data-share]');
      copyBtn?.addEventListener('click', async () => {
        const text = copyBtn.getAttribute('data-copy') ?? '';
        try {
          await navigator.clipboard.writeText(text);
          const orig = copyBtn.innerHTML;
          copyBtn.innerHTML = copyBtn.getAttribute('data-copied') ?? 'Copied';
          setTimeout(() => { copyBtn.innerHTML = orig; }, 1600);
        } catch {}
      });
      shareBtn?.addEventListener('click', async () => {
        const text = shareBtn.getAttribute('data-share') ?? '';
        try {
          if (navigator.share) await navigator.share({ text });
          else {
            await navigator.clipboard.writeText(text);
            const orig = shareBtn.innerHTML;
            shareBtn.innerHTML = shareBtn.getAttribute('data-copied') ?? 'Copied';
            setTimeout(() => { shareBtn.innerHTML = orig; }, 1600);
          }
        } catch {}
      });
    });
  })();
</script>
