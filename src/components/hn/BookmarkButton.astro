---
/* Save-to-favourites heart. Works with BookmarkScript (included once here);
 * favourites pages re-render on the `hn:bm` event it dispatches. */
import BookmarkScript from './BookmarkScript.astro';

interface Props { kind: string; bmRef: string; title: string; }
const { kind, bmRef, title } = Astro.props;
---
<button type="button" data-bm data-bm-kind={kind} data-bm-ref={bmRef} data-bm-title={title} aria-label="Save to favourites" aria-pressed="false" class="hn-icon-btn !w-11 !h-11 !border-0" style="font-size:20px;line-height:1">♡</button>
<BookmarkScript />
