---
/* Premium inline-SVG artwork for prophet stories — zero image requests.
 * Same design language as MeaningArt, story motifs + emblem calligraphy. */
interface Props {
  motif: string;
  arabic: string;
  prophet: string;
  accent?: string;
}
const { motif, arabic, prophet, accent = '#E3B94E' } = Astro.props;
const label = `Story of ${prophet}`;
const uid = `${(prophet ?? motif ?? 'art').toLowerCase().replace(/[^a-z0-9]+/g, '')}-${String(arabic ?? '').length}-${String(prophet ?? '').length}`;
---
<svg viewBox="0 0 800 450" class="w-full h-auto block" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`wbg-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B3B2E" />
      <stop offset="0.55" stop-color="#07352A" />
      <stop offset="1" stop-color="#04241C" />
    </linearGradient>
    <radialGradient id={`wglow-${uid}`} cx="0.5" cy="0.4" r="0.55">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.10" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`wvig-${uid}`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.6" stop-color="#000000" stop-opacity="0" />
      <stop offset="1" stop-color="#000000" stop-opacity="0.45" />
    </radialGradient>
    <linearGradient id={`wgold-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F7E08B" />
      <stop offset="0.5" stop-color="#D4AF37" />
      <stop offset="1" stop-color="#9A7B1E" />
    </linearGradient>
    <pattern id={`wpat-${uid}`} width="96" height="96" patternUnits="userSpaceOnUse" patternTransform="rotate(12)">
      <g fill="none" stroke="#D4AF37" stroke-opacity="0.15" stroke-width="1.2">
        <g transform="translate(48,48)">
          <rect x="-15" y="-15" width="30" height="30" />
          <rect x="-15" y="-15" width="30" height="30" transform="rotate(45)" />
          <circle r="2.2" fill="#D4AF37" fill-opacity="0.5" stroke="none" />
        </g>
      </g>
    </pattern>
  </defs>

  <rect width="800" height="450" fill={`url(#wbg-${uid})`} />
  <rect width="800" height="450" fill={`url(#wpat-${uid})`} />
  <rect width="800" height="450" fill={`url(#wglow-${uid})`} />

  <g fill="none" stroke="#D4AF37" stroke-opacity="0.55" stroke-width="1.6">
    <g transform="translate(40,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,40)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(40,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
    <g transform="translate(760,410)"><rect x="-9" y="-9" width="18" height="18" /><rect x="-9" y="-9" width="18" height="18" transform="rotate(45)" /></g>
  </g>

  <g fill="#F7E08B">
    <circle cx="150" cy="130" r="2.4" opacity="0.6" />
    <circle cx="650" cy="120" r="2" opacity="0.5" />
    <circle cx="120" cy="330" r="2" opacity="0.5" />
    <circle cx="680" cy="340" r="2.4" opacity="0.6" />
  </g>

  {/* story motif */}
  <g transform="translate(350,36)" fill="none" stroke={accent} stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    {motif === 'well' && (
      <g>
        <ellipse cx="45" cy="26" rx="26" ry="9" />
        <path d="M19 26 V64 M71 26 V64" />
        <ellipse cx="45" cy="64" rx="26" ry="9" />
        <path d="M45 4 V32" stroke-width="3" />
        <rect x="36" y="32" width="18" height="12" />
        <path d="M36 32 Q45 24 54 32" stroke-width="3" />
      </g>
    )}
    {motif === 'fire' && (
      <g>
        <path d="M45 6 C56 22 66 32 66 48 A21 21 0 1 1 24 48 C24 36 32 28 36 22 C38 30 42 32 42 32 C42 24 43 14 45 6 Z" />
        <path d="M45 44 C50 50 53 54 53 59 A8 8 0 1 1 37 59 C37 54 40 50 45 44 Z" stroke-width="3" />
      </g>
    )}
    {motif === 'waves' && (
      <g>
        <path d="M8 34 Q16 26 24 34 T40 34 T56 34 T72 34 T84 34" />
        <path d="M8 56 Q16 48 24 56 T40 56 T56 56 T72 56 T84 56" />
        <circle cx="66" cy="12" r="5" stroke-width="3" />
      </g>
    )}
    {motif === 'ship' && (
      <g>
        <path d="M45 58 V22" />
        <polygon points="45,22 45,50 66,50" />
        <path d="M20 58 H70 M28 58 L34 72 H56 L62 58" />
        <path d="M12 78 Q20 72 28 78 T44 78 T60 78 T76 78" stroke-width="3" />
      </g>
    )}
    {motif === 'whale' && (
      <g>
        <path d="M10 48 C22 34 44 32 58 42 L74 32 L70 46 L74 60 L58 52 C44 62 22 60 10 48 Z" />
        <circle cx="24" cy="45" r="2.6" fill={accent} stroke="none" />
        <path d="M8 70 Q16 65 24 70 T40 70 T56 70 T72 70 T84 70" stroke-width="3" />
      </g>
    )}
    {motif === 'mountain' && (
      <g>
        <polygon points="6,74 30,28 54,74" />
        <polygon points="36,74 58,32 80,74" />
        <circle cx="66" cy="16" r="6" stroke-width="3" />
      </g>
    )}
    {motif === 'crown' && (
      <g>
        <polygon points="22,66 22,32 34,44 45,26 56,44 68,32 68,66" />
        <path d="M22 72 H68" />
        <circle cx="22" cy="27" r="3.4" fill={accent} stroke="none" />
        <circle cx="45" cy="21" r="3.4" fill={accent} stroke="none" />
        <circle cx="68" cy="27" r="3.4" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'sling' && (
      <g>
        <path d="M45 80 V50 M45 50 L28 26 M45 50 L62 26" />
        <circle cx="45" cy="30" r="5.5" />
        <path d="M16 62 L24 56 M74 62 L66 56" stroke-width="3" />
      </g>
    )}
    {motif === 'palm' && (
      <g>
        <path d="M45 84 C43 68 43 58 45 48" />
        <path d="M45 48 C35 40 25 38 15 42" />
        <path d="M45 48 C55 40 65 38 75 42" />
        <path d="M45 48 C38 34 30 28 20 28" />
        <path d="M45 48 C52 34 60 28 70 28" />
        <path d="M45 48 C45 36 45 30 45 22" stroke-width="3" />
        <circle cx="39" cy="53" r="3" fill={accent} stroke="none" />
        <circle cx="51" cy="53" r="3" fill={accent} stroke="none" />
        <circle cx="45" cy="58" r="3" fill={accent} stroke="none" />
      </g>
    )}
    {motif === 'cave' && (
      <g>
        <path d="M10 80 C10 50 25 30 45 30 C65 30 80 50 80 80" />
        <path d="M30 80 C30 58 37 46 45 46 C53 46 60 58 60 80" stroke-width="3" />
        <circle cx="41" cy="62" r="2.2" fill={accent} stroke="none" />
        <circle cx="50" cy="68" r="2.2" fill={accent} stroke="none" />
        <path d="M4 80 H86" stroke-width="3" />
      </g>
    )}
  </g>

  {/* emblem calligraphy */}
  <text x="400" y="218" text-anchor="middle" dominant-baseline="central" font-size="30" fill="#F7F3E3" font-family="'Amiri Quran','Noto Naskh Arabic',serif">{arabic}</text>
  <text x="400" y="292" text-anchor="middle" font-size="24" letter-spacing="8" fill={accent} font-family="Inter,sans-serif" font-weight="800">{prophet.toUpperCase()}</text>
  <g stroke={accent} stroke-width="1.4" opacity="0.9">
    <line x1="300" y1="322" x2="388" y2="322" />
    <line x1="412" y1="322" x2="500" y2="322" />
    <rect x="394" y="316" width="12" height="12" transform="rotate(45 400 322)" fill={accent} stroke="none" />
  </g>
  <text x="400" y="360" text-anchor="middle" font-size="15" letter-spacing="4" fill="#ffffff" fill-opacity="0.7" font-family="Inter,sans-serif" font-weight="600">PROPHET STORY • QISSA</text>

  <rect width="800" height="450" fill={`url(#wvig-${uid})`} />
</svg>
