---
/* Dua detail — the reusable reading template for SEO landing pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import ReadingCard from './hn/ReadingCard.astro';
import BookmarkButton from './hn/BookmarkButton.astro';
import ShareButtons from './hn/ShareButtons.astro';
import SourcesBlock from './hn/SourcesBlock.astro';
import RelatedContent from './RelatedContent.astro';
import HistoryScript from './hn/HistoryScript.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { duasByCat } from '../data/duas';
import { localizeDua, localizeList } from '../lib/duas-i18n';
import { localizeDuaCat, originLabel as originLabelL, gradeLabel as gradeLabelL, duaUI, widgetUI } from '../lib/dua-ui-i18n';

interface Props { dua: any; cat: any; locale: string; }
const { cat, locale } = Astro.props;
const dua = localizeDua((Astro.props as any).dua, locale);
const catL = localizeDuaCat(cat, locale);
const dict = getDict(locale);
const T = duaUI(locale);
const W = widgetUI(locale);
const L = (p: string) => localizedPath(locale, p);
const duaPath = `/duas/${dua.cat}/${dua.slug}/`;
const catPath = `/duas/${dua.cat}/`;
const originLabel = originLabelL(dua.origin, locale) ?? (dua.origin ? (dua.origin as string) : null);
const gradeLabel = gradeLabelL(dua.grade, locale);
const narratorLabel = dua.narrator ?? null;
const aliasList = (dua.aliases ?? []) as string[];

const title = T.detailTitle.replace('{t}', dua.title);
let description = `${dua.title} — ${dua.use}. ${T.whenLabel}: ${dua.when} (${dua.repeat}). ${T.virtueLabel}: ${dua.virtue}`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${dua.title.toLowerCase()}, dua in arabic, transliteration, english meaning, ${T.whenLabel.toLowerCase()}, ${catL.title.toLowerCase()}${originLabel ? `, ${(originLabel as string).toLowerCase()}` : ''}${gradeLabel ? `, ${(gradeLabel as string).toLowerCase()}` : ''}${(dua as any).hisnNo ? `, hisn al muslim ${(dua as any).hisnNo}` : ''}${aliasList.length ? `, ${aliasList.join(', ')}` : ''}`;

const repText = dua.repeat !== 'Often' && dua.repeat !== 'Once' ? dua.repeat + '.' : dua.repeat;
const faq = [
  { q: T.faq.whenQ.replace('{t}', dua.title), a: `${dua.when}. ${repText}` },
  { q: T.faq.virtueQ.replace('{t}', dua.title), a: dua.virtue },
  { q: T.faq.srcQ.replace('{t}', dua.title), a: `${dua.source}${narratorLabel ? ` (${narratorLabel})` : ''}${gradeLabel ? `. ${gradeLabel}` : ''}.` },
  { q: T.faq.arQ.replace('{t}', dua.title), a: dua.translation },
  { q: T.faq.repQ, a: `${repText}` },
];
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: dict.nav.duas, path: '/duas/' },
  { name: catL.title, path: catPath },
  { name: dua.title, path: duaPath },
];
const related = localizeList(duasByCat(dua.cat).filter((d) => d.slug !== dua.slug).slice(0, 4), locale);
const siblings = localizeList(duasByCat(dua.cat), locale);
const sIdx = siblings.findIndex((d) => d.slug === dua.slug);
const prevDua = sIdx > 0 ? siblings[sIdx - 1] : null;
const nextDua = sIdx >= 0 && sIdx < siblings.length - 1 ? siblings[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={duaPath}>
  <div class="hn-read hn-section" data-hn-history data-hn-kind="dua" data-hn-ref={duaPath} data-hn-title={dua.title}>
    <HistoryScript />
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 3)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">{T.badgeDua}</span>
      <span class="hn-badge">{catL.title}</span>
      {originLabel && <span class="hn-badge hn-badge-gold">{originLabel}</span>}
      {gradeLabel && <span class="hn-badge">{gradeLabel}</span>}
      {(dua as any).hisnNo && <span class="hn-badge hn-badge-gold">Hisn #{(dua as any).hisnNo}</span>}
      <span class="ms-auto"><BookmarkButton kind="dua" bmRef={duaPath} title={dua.title} locale={locale} /></span>
      <span class="no-print"><button onclick="window.print()" class="hn-icon-btn !w-11 !h-11 !border-0" aria-label={W.printLabel} title={W.printLabel}>🖨</button></span>
      <ShareButtons title={dua.title} path={duaPath} locale={locale} />
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{dua.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{dua.use}</p>
    {aliasList.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">{T.alsoSearched} {aliasList.map((a, i) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="mt-5">
      <ReadingCard arabic={dua.arabic} translit={dua.translit} translation={dua.translation} reference={dua.source} locale={locale} />
    </div>

    {(dua.when || dua.virtue) && (
      <div class="grid gap-3 sm:grid-cols-2 mt-3">
        {dua.when && (
          <div class="hn-card hn-card-pad">
            <p class="hn-block-label">{T.whenLabel}</p>
            <p class="text-[15px] font-semibold leading-6">{dua.when}{dua.repeat ? ` • ${dua.repeat}` : ''}</p>
          </div>
        )}
        {dua.virtue && (
          <div class="hn-card hn-card-pad">
            <p class="hn-block-label">{T.virtueLabel}</p>
            <p class="text-[15px] leading-6" style="color:var(--hn-muted)">{dua.virtue}</p>
          </div>
        )}
      </div>
    )}
    <SourcesBlock locale={locale} source={dua.source} narrator={narratorLabel} grade={gradeLabel} originLabel={originLabel} reviewedDate="2026-01-01" />

    <section class="mt-8" aria-label={T.faqTitle}>
      <SectionHeader eyebrow="FAQ" title={T.faqTitle} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedContent type="dua" slug={dua.slug} category={dua.cat} locale={locale} />

    {related.length > 0 && (
      <section class="mt-8" aria-label={T.relatedEyebrow}>
        <SectionHeader eyebrow={T.relatedEyebrow} title={T.relatedTitle.replace('{c}', catL.title)} href={L(catPath)} linkLabel={T.relatedLink.replace('{c}', catL.title)} />
        <div class="grid gap-3 sm:grid-cols-2">
          {related.map((r) => (
            <a href={L(`/duas/${r.cat}/${r.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">{r.title}</span>
              <span class="text-[13px]" style="color:var(--hn-muted)">{r.use}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {(prevDua || nextDua) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More duas">
        {prevDua ? (
          <a href={L(`/duas/${prevDua.cat}/${prevDua.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.prevLabel}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevDua.title}</span>
          </a>
        ) : <span />}
        {nextDua && (
          <a href={L(`/duas/${nextDua.cat}/${nextDua.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">{T.nextLabel}</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextDua.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
