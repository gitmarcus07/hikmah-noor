---
/* Dua detail — the reusable reading template for SEO landing pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import ReadingCard from './hn/ReadingCard.astro';
import BookmarkButton from './hn/BookmarkButton.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { duasByCat, DUA_ORIGIN_LABEL } from '../data/duas';

interface Props { dua: any; cat: any; locale: string; }
const { dua, cat, locale } = Astro.props;
const dict = getDict(locale);
const L = (p: string) => localizedPath(locale, p);
const duaPath = `/duas/${dua.cat}/${dua.slug}/`;
const catPath = `/duas/${dua.cat}/`;
const originLabel = dua.origin ? (DUA_ORIGIN_LABEL as any)[dua.origin] : null;
const gradeLabel = dua.grade ?? null;
const narratorLabel = dua.narrator ?? null;
const aliasList = (dua.aliases ?? []) as string[];

const title = `${dua.title} in Arabic with Transliteration & Meaning`;
let description = `${dua.title}: Arabic dua, transliteration, English meaning, when to recite and virtue. Source: ${dua.source}${gradeLabel ? ` (${gradeLabel})` : ''}.`;
if (description.length > 160) description = description.slice(0, 157) + '…';
const keywords = `${dua.title.toLowerCase()}, dua in arabic, transliteration, english meaning, when to recite, virtue, ${dua.source.toLowerCase()}, ${cat.title.toLowerCase()} duas${originLabel ? `, ${originLabel.toLowerCase()}` : ''}${gradeLabel ? `, ${gradeLabel.toLowerCase()}` : ''}${aliasList.length ? `, ${aliasList.join(', ')}` : ''}`;

const faq = [
  { q: `When should I recite ${dua.title}?`, a: `${dua.when}. ${dua.repeat !== 'Often' && dua.repeat !== 'Once' ? 'Repeat: ' + dua.repeat + '.' : dua.repeat === 'Once' ? 'Recite it once.' : 'Recite it often.'}` },
  { q: `What is the virtue of ${dua.title}?`, a: dua.virtue },
  { q: `Where is ${dua.title} from?`, a: `Source: ${dua.source}${narratorLabel ? ` (narrated by ${narratorLabel})` : ''}${gradeLabel ? `. Grade: ${gradeLabel}` : ''}. As always, learn the wording from a teacher and consult scholars for rulings.` },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Duas', path: '/duas/' },
  { name: cat.title, path: catPath },
  { name: dua.title, path: duaPath },
];
const related = duasByCat(dua.cat).filter((d) => d.slug !== dua.slug).slice(0, 4);
const siblings = duasByCat(dua.cat);
const sIdx = siblings.findIndex((d) => d.slug === dua.slug);
const prevDua = sIdx > 0 ? siblings[sIdx - 1] : null;
const nextDua = sIdx >= 0 && sIdx < siblings.length - 1 ? siblings[sIdx + 1] : null;
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath={duaPath}>
  <div class="hn-read hn-section">
    <Breadcrumbs locale={locale} items={crumbs.slice(0, 3)} />
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="hn-badge hn-badge-primary">Dua</span>
      <span class="hn-badge">{cat.title}</span>
      {originLabel && <span class="hn-badge hn-badge-gold">{originLabel}</span>}
      {gradeLabel && <span class="hn-badge">{gradeLabel}</span>}
      <span class="ms-auto"><BookmarkButton kind="dua" bmRef={duaPath} title={dua.title} /></span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3">{dua.title}</h1>
    <p class="mt-2 leading-7" style="color:var(--hn-muted)">{dua.use}</p>
    {aliasList.length > 0 && (
      <p class="mt-2 text-[13px] leading-6" style="color:var(--hn-muted)">Also searched as: {aliasList.map((a, i) => (
        <span>{i > 0 && ' • '}<em class="not-italic font-semibold" style="color:var(--hn-ink)">{a}</em></span>
      ))}</p>
    )}

    <div class="mt-5">
      <ReadingCard arabic={dua.arabic} translit={dua.translit} translation={dua.translation} reference={dua.source} />
    </div>

    {(dua.when || dua.virtue) && (
      <div class="grid gap-3 sm:grid-cols-2 mt-3">
        {dua.when && (
          <div class="hn-card hn-card-pad">
            <p class="hn-block-label">When to recite</p>
            <p class="text-[15px] font-semibold leading-6">{dua.when}{dua.repeat ? ` • ${dua.repeat}` : ''}</p>
          </div>
        )}
        {dua.virtue && (
          <div class="hn-card hn-card-pad">
            <p class="hn-block-label">Virtue</p>
            <p class="text-[15px] leading-6" style="color:var(--hn-muted)">{dua.virtue}</p>
          </div>
        )}
      </div>
    )}
    <p class="mt-3 text-[13px]" style="color:var(--hn-muted)">Source: <strong style="color:var(--hn-ink)">{dua.source}</strong>{narratorLabel && <span> • Narrated by <strong style="color:var(--hn-ink)">{narratorLabel}</strong></span>}{gradeLabel && <span> • Grade: <strong style="color:var(--hn-ink)">{gradeLabel}</strong></span>}</p>
    <p class="mt-1 text-[13px]" style="color:var(--hn-muted)">Verify wording with a teacher; rulings differ — consult scholars.</p>

    <section class="mt-8" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {related.length > 0 && (
      <section class="mt-8" aria-label="Related duas">
        <SectionHeader eyebrow="Related" title={`More ${cat.title} duas`} href={L(catPath)} linkLabel={`All ${cat.title} duas`} />
        <div class="grid gap-3 sm:grid-cols-2">
          {related.map((r) => (
            <a href={L(`/duas/${r.cat}/${r.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
              <span class="font-bold block text-[15px] leading-6">{r.title}</span>
              <span class="text-[13px]" style="color:var(--hn-muted)">{r.use}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {(prevDua || nextDua) && (
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="More duas">
        {prevDua ? (
          <a href={L(`/duas/${prevDua.cat}/${prevDua.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">← Previous dua</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{prevDua.title}</span>
          </a>
        ) : <span />}
        {nextDua && (
          <a href={L(`/duas/${nextDua.cat}/${nextDua.slug}/`)} class="hn-card hn-card-hover hn-card-pad block text-right">
            <span class="text-xs font-bold" style="color:var(--hn-muted)">Next dua →</span>
            <span class="font-bold block text-[15px] leading-6 mt-0.5">{nextDua.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
