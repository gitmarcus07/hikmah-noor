---
/* Quranic Gems — topic tiles that open pre-filled searches
 * (Search Quran screen). No curated verse data needed: each topic
 * is a query against the translation search index.
 */
import { localizedPath } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const searchBase = localizedPath(locale, '/tools/search-quran/');

const GEMS: [string, string][] = [
  // [label, search query]
  ['Dhikr', 'remembrance'],
  ['Justice', 'justice'],
  ['Love', 'love'],
  ['Parents', 'parents'],
  ['Charity', 'charity'],
  ['No regrets', 'grief'],
  ['Problems', 'hardship'],
  ['Forgiveness', 'forgiveness'],
  ['Kind', 'kind'],
  ['Fearless', 'fear'],
  ['Confidence', 'trust'],
  ['Access', 'ask'],
  ['Control', 'anger'],
  ['Money', 'wealth'],
  ['Good', 'good'],
  ['Lie', 'lie'],
  ['Fear', 'fear'],
  ['Patience', 'patience'],
  ['Gratitude', 'gratitude'],
  ['Depression and sadness', 'sad'],
  ['Watched', 'watchful'],
  ['Signs', 'signs'],
  ['Master', 'lord'],
  ['Rope', 'rope'],
  ['Heart', 'heart'],
  ['Blind', 'blind'],
  ['Dawah', 'invite'],
  ['Time', 'time'],
];
---

<div class="max-w-md mx-auto px-4 py-5">
  <div class="grid grid-cols-2 gap-3">
    {GEMS.map(([label, q]) => (
      <a href={`${searchBase}?q=${encodeURIComponent(q)}&from=gems`} class="hn-card hn-card-hover hn-card-pad flex flex-col items-center text-center gap-2 min-h-[132px] justify-center">
        <span class="w-11 h-11 grid place-items-center rounded-full" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="star" size={22} /></span>
        <span class="font-bold text-[16px] leading-6">{label}</span>
        <span class="text-xs font-semibold" style="color:var(--hn-muted)">Tap to read verses</span>
      </a>
    ))}
  </div>
</div>
