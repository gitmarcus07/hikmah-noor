---
/* Settings hub (Quranly-style) — avatar + search, grouped rows:
 * Saved Content (Favourites, Bookmarks, Personal Notes),
 * Account & Legal (Account Settings, Support, Terms, Privacy, Purchase),
 * Preferences (Appearance, Language),
 * Account Management (Reset/Delete, Logout, logged-in only).
 */
import { localizedPath, getDict, locales, localeNames } from '../i18n/utils';
import pkg from '../../package.json';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const t = getDict(locale).app;
const s = t.settings;

const favUrl = localizedPath(locale, '/tools/favourites/');
const marksUrl = localizedPath(locale, '/tools/bookmarks/');
const notesUrl = localizedPath(locale, '/tools/notes/');
const accountUrl = localizedPath(locale, '/profile/');
const supportUrl = localizedPath(locale, '/contact/');
const termsUrl = localizedPath(locale, '/terms/');
const privacyUrl = localizedPath(locale, '/privacy/');

const CHIP = 'w-11 h-11 shrink-0 grid place-items-center rounded-2xl text-[22px]';
---

<div class="max-w-md mx-auto px-4 py-5" data-hub>
  <div class="grid grid-cols-[48px_1fr_48px] items-center gap-2">
    <a href={accountUrl} aria-label="My profile" data-hub-avatar class="w-12 h-12 grid place-items-center rounded-full overflow-hidden bg-emerald-300 text-night-900 text-lg font-extrabold ring-2 ring-white/20">👤</a>
    <h1 class="text-center text-[22px] leading-7 font-extrabold text-white">{s.title}</h1>
    <span aria-hidden="true"></span>
  </div>

  <div class="mt-4 flex items-center gap-2.5 rounded-2xl bg-white/5 border border-white/5 px-4 focus-within:border-brand-400/60 transition">
    <span class="text-xl text-ink-500" aria-hidden="true">🔍</span>
    <input data-hub-q type="search" autocomplete="off" placeholder={s.searchPh}
      class="w-full bg-transparent py-3 min-h-[52px] text-ink-50 placeholder:text-ink-500 outline-none text-[16px]" />
  </div>

  <div class="mt-5 space-y-5" data-hub-groups>
    <section data-hub-sec>
      <p class="px-4 text-[15px] font-medium text-ink-500">{s.savedContent}</p>
      <div class="mt-2 space-y-2.5">
        <a href={favUrl} data-hub-row={s.favourites} class="flex items-center gap-3.5 rounded-2xl bg-[#2a1e22] hover:bg-[#35262b] border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-red-500/90`} aria-hidden="true">❤️</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.favourites}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
        <a href={marksUrl} data-hub-row={s.bookmarks} class="flex items-center gap-3.5 rounded-2xl bg-[#2b2145] hover:bg-[#352a55] border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-violet-500/90`} aria-hidden="true">🔖</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.bookmarks}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
        <a href={notesUrl} data-hub-row={s.notes} class="flex items-center gap-3.5 rounded-2xl bg-[#1d2f2a] hover:bg-[#263d36] border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-emerald-400/90`} aria-hidden="true">📝</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.notes}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
      </div>
    </section>

    <section data-hub-sec>
      <p class="px-4 text-[15px] font-medium text-ink-500">{s.accountLegal}</p>
      <div class="mt-2 space-y-2.5">
        <a href={accountUrl} data-hub-row={s.accountSettings} class="flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-violet-500/90`} aria-hidden="true">👤</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.accountSettings}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
        <a href={supportUrl} data-hub-row={s.support} class="flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-green-500/90`} aria-hidden="true">💚</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.support}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
        <a href={termsUrl} data-hub-row={s.terms} class="flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-orange-500/90`} aria-hidden="true">📜</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.terms}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
        <a href={privacyUrl} data-hub-row={s.privacy} class="flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition">
          <span class={`${CHIP} bg-indigo-500/90`} aria-hidden="true">🛡️</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.privacy}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </a>
        <button data-hub-purchase data-hub-row={s.purchase} class="w-full flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition text-left">
          <span class={`${CHIP} bg-blue-500/90`} aria-hidden="true">👑</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.purchase}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <section data-hub-sec>
      <p class="px-4 text-[15px] font-medium text-ink-500">{s.prefs}</p>
      <div class="mt-2 space-y-2.5">
        <button data-hub-appearance data-hub-row={s.appearance} class="w-full flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition text-left">
          <span class={`${CHIP} bg-rose-400/90`} aria-hidden="true">🎨</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.appearance}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <div class="rounded-2xl bg-white/5 border border-white/5 overflow-hidden">
          <button data-hub-langs data-hub-row={s.language} class="w-full flex items-center gap-3.5 px-4 py-3 min-h-[60px] transition text-left hover:bg-white/5">
            <span class={`${CHIP} bg-violet-500/90`} aria-hidden="true">🌐</span>
            <span class="flex-1 text-[17px] font-medium text-ink-50">{s.language}</span>
            <span data-hub-curlang class="text-xs font-extrabold text-brand-300 uppercase"></span>
            <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
          </button>
          <div data-hub-langpanel class="hidden px-4 pb-3 grid grid-cols-2 gap-2">
            {locales.map((l) => (
              <button data-hub-lang={l} class="rounded-2xl border border-white/10 hover:border-brand-400 bg-night-800 px-3 py-3 min-h-[52px] text-sm font-extrabold text-ink-50 transition">{localeNames[l]}</button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section data-hub-sec data-hub-mgmt class="hidden">
      <p class="px-4 text-[15px] font-medium text-ink-500">{s.acctMgmt}</p>
      <div class="mt-2 space-y-2.5">
        <button data-hub-reset data-hub-row={s.resetDelete} class="w-full flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition text-left">
          <span class={`${CHIP} bg-red-500/90`} aria-hidden="true">🗑️</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.resetDelete}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
        <button data-hub-logout data-hub-row={s.logout} class="w-full flex items-center gap-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 px-4 py-3 min-h-[60px] transition text-left">
          <span class={`${CHIP} bg-orange-500/90`} aria-hidden="true">🚪</span>
          <span class="flex-1 text-[17px] font-medium text-ink-50">{s.logout}</span>
          <span class="text-ink-500 text-xl" aria-hidden="true">›</span>
        </button>
      </div>
    </section>
  </div>

  <p class="mt-6 text-center text-sm font-semibold text-ink-500">{pkg.version}</p>
</div>

{/* purchase info */}
<div data-hub-pmodal class="hidden fixed inset-0 z-[80]" role="dialog" aria-modal="true" aria-label="Purchase">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-hub-pclose></div>
  <div class="absolute inset-x-8 top-[32%] mx-auto max-w-sm bg-[#2e2e33] rounded-[26px] p-7 text-center shadow-2xl">
    <h2 class="text-[20px] font-extrabold text-white">{s.purchaseT}</h2>
    <p class="mt-2 text-[15px] leading-7 text-ink-200">{s.purchaseD}</p>
    <button data-hub-pclose class="mt-5 w-full rounded-full border border-white/25 text-white font-bold px-6 py-3 min-h-[52px] hover:bg-white/10 transition">{s.ok}</button>
  </div>
</div>

{/* appearance */}
<div data-hub-amodal class="hidden fixed inset-0 z-[80]" role="dialog" aria-modal="true" aria-label="Appearance">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-hub-aclose></div>
  <div class="absolute inset-x-8 top-[28%] mx-auto max-w-sm bg-[#2e2e33] rounded-[26px] p-7 shadow-2xl">
    <h2 class="text-center text-[20px] font-extrabold text-white">{s.appearanceT}</h2>
    <div class="mt-4 space-y-2">
      <div class="flex items-center gap-3 rounded-2xl border-2 border-brand-500 bg-brand-500/10 px-4 py-3.5">
        <span class="text-2xl" aria-hidden="true">🌙</span>
        <span class="flex-1"><span class="block font-extrabold text-white">{s.dark}</span><span class="block text-xs text-ink-500">{s.darkD}</span></span>
        <span class="text-brand-300 text-xl" aria-hidden="true">✓</span>
      </div>
      <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3.5 opacity-60">
        <span class="text-2xl" aria-hidden="true">☀️</span>
        <span class="flex-1"><span class="block font-extrabold text-white">{s.light}</span><span class="block text-xs text-ink-500">{s.lightD}</span></span>
      </div>
    </div>
    <button data-hub-aclose class="mt-5 w-full rounded-full border border-white/25 text-white font-bold px-6 py-3 min-h-[52px] hover:bg-white/10 transition">{s.ok}</button>
  </div>
</div>

{/* reset / delete */}
<div data-hub-rmodal class="hidden fixed inset-0 z-[80]" role="dialog" aria-modal="true" aria-label="Reset or delete">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-hub-rclose></div>
  <div class="absolute inset-x-8 top-[24%] mx-auto max-w-sm bg-[#2e2e33] rounded-[26px] p-7 text-center shadow-2xl">
    <h2 class="text-[20px] font-extrabold text-white">{s.resetT}</h2>
    <p class="mt-2 text-[14px] leading-6 text-ink-300">{s.resetD}</p>
    <p data-hub-rmsg class="hidden mt-2 text-sm font-bold leading-6" role="status"></p>
    <button data-hub-rreset class="mt-4 w-full bg-gold-300 hover:bg-amber-200 text-night-900 font-extrabold rounded-full px-6 py-3 min-h-[52px]">{s.resetBtn}</button>
    <button data-hub-rdelete class="mt-2 w-full bg-red-500/15 hover:bg-red-500/25 border border-red-400/40 text-red-200 font-extrabold rounded-full px-6 py-3 min-h-[52px]">{s.deleteBtn}</button>
    <button data-hub-rclose class="mt-2 w-full text-ink-300 font-bold px-6 py-3 min-h-[48px] hover:text-white transition">{s.cancel}</button>
  </div>
</div>

<script define:vars={{ curlang: locale, tHub: s }}>
  (() => {
    const root = document.querySelector('[data-hub]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const $ = (s) => root.querySelector(s) || document.querySelector(s);
    let H = null, loggedIn = false;

    const lockScroll = (on) => { document.body.style.overflow = on ? 'hidden' : ''; };
    const openM = (sel) => { document.querySelector(sel)?.classList.remove('hidden'); lockScroll(true); };
    const closeM = (sel) => { document.querySelector(sel)?.classList.add('hidden'); lockScroll(false); };

    // search filters rows (and hides emptied sections)
    $('[data-hub-q]')?.addEventListener('input', (e) => {
      const q = String(e.currentTarget.value || '').trim().toLowerCase();
      root.querySelectorAll('[data-hub-sec]').forEach((sec) => {
        let visible = 0;
        sec.querySelectorAll('[data-hub-row]').forEach((row) => {
          const hit = !q || String(row.dataset.hubRow || '').toLowerCase().includes(q);
          // The language row lives with its panel in a wrapper — hide that.
          const el = row.hasAttribute('data-hub-langs') ? (row.closest('div.rounded-2xl') || row) : row;
          el.classList.toggle('hidden', !hit);
          if (hit) visible += 1;
        });
        sec.classList.toggle('hidden', visible === 0);
      });
    });

    // header avatar face
    const setFace = async () => {
      try {
        const { user } = await H.Auth.session().catch(() => ({ user: null }));
        loggedIn = !!user;
        root.querySelector('[data-hub-mgmt]')?.classList.toggle('hidden', !loggedIn);
        if (!user) return;
        const el = root.querySelector('[data-hub-avatar]');
        if (!el) return;
        try {
          const html = H.faceFor(user);
          if (String(html).trim().startsWith('<')) el.innerHTML = html;
          else el.textContent = html;
        } catch { /* keep */ }
        if (window.hnUpdateNav) window.hnUpdateNav(user);
      } catch { /* guest hub */ }
    };

    // purchase + appearance modals
    $('[data-hub-purchase]')?.addEventListener('click', () => openM('[data-hub-pmodal]'));
    root.querySelectorAll('[data-hub-pclose]').forEach((b) => b.addEventListener('click', () => closeM('[data-hub-pmodal]')));
    $('[data-hub-appearance]')?.addEventListener('click', () => openM('[data-hub-amodal]'));
    root.querySelectorAll('[data-hub-aclose]').forEach((b) => b.addEventListener('click', () => closeM('[data-hub-amodal]')));

    // language: expand, pick → save profile language (members) + go localized
    const cur = $('[data-hub-curlang]');
    if (cur) cur.textContent = String(curlang || 'en').toUpperCase();
    $('[data-hub-langs]')?.addEventListener('click', () => {
      root.querySelector('[data-hub-langpanel]')?.classList.toggle('hidden');
    });
    root.querySelectorAll('[data-hub-lang]').forEach((b) => b.addEventListener('click', async () => {
      const l = b.dataset.hubLang;
      const target = l === 'en' ? '/settings/' : `/${l}/settings/`;
      if (loggedIn) {
        try { await H.Me.saveProfile({ language: l }); } catch { /* navigate anyway */ }
      }
      window.location.href = target;
    }));

    // reset / delete modal
    const rmsg = (ok, text) => {
      const el = document.querySelector('[data-hub-rmsg]');
      if (!el) return;
      el.textContent = text;
      el.classList.remove('hidden', 'text-emerald-300', 'text-red-300');
      el.classList.add(ok ? 'text-emerald-300' : 'text-red-300');
    };
    $('[data-hub-reset]')?.addEventListener('click', () => openM('[data-hub-rmodal]'));
    root.querySelectorAll('[data-hub-rclose]').forEach((b) => b.addEventListener('click', () => closeM('[data-hub-rmodal]')));
    document.querySelector('[data-hub-rreset]')?.addEventListener('click', async () => {
      const btn = document.querySelector('[data-hub-rreset]');
      try {
        if (btn) { btn.disabled = true; }
        const res = await fetch('/api/me/reset', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ confirm: true }),
        });
        if (!res.ok) throw new Error('reset_failed');
        window.location.href = curlang === 'en' ? '/tools/my-progress/' : `/${curlang}/tools/my-progress/`;
      } catch {
        rmsg(false, tHub.resetFail);
      } finally {
        if (btn) btn.disabled = false;
      }
    });
    document.querySelector('[data-hub-rdelete]')?.addEventListener('click', async () => {
      if (!H?.Me?.deleteAccount) return;
      if (!confirm(`${tHub.deleteBtn}?`)) return;
      if (!confirm(tHub.resetD)) return;
      try {
        await H.Me.deleteAccount();
        window.location.href = '/';
      } catch {
        rmsg(false, tHub.resetFail);
      }
    });

    // logout
    $('[data-hub-logout]')?.addEventListener('click', async () => {
      try { await H.Auth.logout(); } finally { window.location.reload(); }
    });

    (async () => {
      H = await import('/habits/habit.js?v=5');
      await setFace();
    })();
  })();
</script>
