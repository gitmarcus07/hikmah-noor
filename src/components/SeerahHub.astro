---
/* Seerat hub: 16 chronological chapters (Makkah era + Madinah era) -> per-chapter SEO detail pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './hn/Breadcrumbs.astro';
import SectionHeader from './hn/SectionHeader.astro';
import Icon from './Icon.astro';
import WaqiahArt from './WaqiahArt.astro';
import { getDict, localizedPath } from '../i18n/utils';
import { SEERAH, seerahByEra } from '../data/seerah';
import { localizeSeerahList } from '../lib/content-i18n';
import { secUI2, SEERAH_UI } from '../lib/site-ui-2';

interface Props { locale: string; }
const { locale } = Astro.props;
const dict = getDict(locale);
const T = secUI2(locale, SEERAH_UI);
const L = (p: string) => localizedPath(locale, p);

const title = T.hubTitle;
const description = T.hubDesc;
const keywords = T.hubKw;
const faq = T.hubFaq;
const crumbs = [
  { name: dict.nav.home, path: '/' },
  { name: T.crumb, path: '/seerat/' },
];
const makkah = localizeSeerahList(seerahByEra('Makkah'), locale);
const madinah = localizeSeerahList(seerahByEra('Madinah'), locale);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/seerat/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{T.badgeN}</span>
        <span class="hn-badge">{T.badge2}</span>
        <span class="hn-badge">{T.badge3}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">{T.hubH1}</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">{T.hubSub}</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">{T.sahabaLine} <a href={L('/sahaba/')} class="font-bold" style="color:var(--hn-primary)">{T.sahabaLink}</a></p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder={T.searchPh} aria-label={T.searchPh} />
          <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
    </div>

    <div class="mt-6 max-w-3xl">
      <input id="seerahfilter" class="hn-input" placeholder={T.filterPh} aria-label={T.filterPh} />
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.era1} title={T.era1T} sub={T.era1S} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {makkah.map((s) => (
          <a href={L(`/seerat/${s.slug}/`)} data-search={`${s.num} ${s.title} ${s.summary} ${(s.aliases || []).join(' ')}`.toLowerCase()} class="seerahrow hn-card hn-card-hover overflow-hidden block">
            <span class="block overflow-hidden"><WaqiahArt motif={s.motif} arabic={s.arabic} prophet={`${T.chShort} ${s.num}`} accent={s.accent} /></span>
            <span class="block hn-card-pad">
              <span class="hn-badge hn-badge-primary">{T.chBadge.replace('{n}', String(s.num))}</span>
              <span class="font-extrabold block text-[17px] leading-7 mt-2">{s.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{s.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow={T.era2} title={T.era2T} sub={T.era2S} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {madinah.map((s) => (
          <a href={L(`/seerat/${s.slug}/`)} data-search={`${s.num} ${s.title} ${s.summary} ${(s.aliases || []).join(' ')}`.toLowerCase()} class="seerahrow hn-card hn-card-hover overflow-hidden block">
            <span class="block overflow-hidden"><WaqiahArt motif={s.motif} arabic={s.arabic} prophet={`${T.chShort} ${s.num}`} accent={s.accent} /></span>
            <span class="block hn-card-pad">
              <span class="hn-badge hn-badge-primary">{T.chBadge.replace('{n}', String(s.num))}</span>
              <span class="font-extrabold block text-[17px] leading-7 mt-2">{s.title}</span>
              <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{s.summary}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <script is:inline>
      (() => {
        const input = document.getElementById('seerahfilter');
        const rows = [...document.querySelectorAll('.seerahrow')];
        input?.addEventListener('input', () => {
          const q = (input.value || '').toLowerCase().trim();
          rows.forEach((r) => r.classList.toggle('hidden', !!q && !(r.dataset.search || '').includes(q)));
        });
      })();
    </script>

    <section class="mt-8 max-w-3xl" aria-label={dict.article.faq}>
      <SectionHeader eyebrow="FAQ" title={dict.article.faq} />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
