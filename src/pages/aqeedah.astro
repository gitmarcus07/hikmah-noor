---
/* Aqeedah hub — beliefs aggregator over guides + duas.
 * No new infra: links existing six-pillars/shirk guides plus 8 new aqeedah guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/hn/Breadcrumbs.astro';
import SectionHeader from '../components/hn/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { localizedPath } from '../i18n/utils';
import { GUIDES } from '../data/guides';
import { DUAS } from '../data/duas';

const locale = 'en';
const L = (p: string) => localizedPath(locale, p);

const title = `Aqeedah Guide — Six Pillars, Tawhid, Shirk, Qadr & the Last Day`;
const description = `Learn Islamic beliefs simply: what aqeedah is, six pillars of Iman, Tawhid categories, angels and books, messengers and finality, Qadr and free will, Bidah vs Sunnah, Tawakkul and Allah's names.`;
const keywords = 'aqeedah guide, aqeedah kya hai, six pillars iman, tawhid categories, shirk types, belief in angels, belief in messengers, qadr decree, bidah vs sunnah, tawakkul, allah names attributes';
const faq = [
  { q: 'What is aqeedah?', a: 'The firm belief of the heart: Allah, His angels, books, messengers, Last Day and divine decree. Belief comes before practice — learn foundations first, with a teacher.' },
  { q: 'What are the six pillars of Iman?', a: 'Belief in Allah, His angels, His books, His messengers, the Last Day, and divine decree (Qadr) — all in Quran 2:285 and the Jibril hadith.' },
  { q: 'What breaks Tawhid?', a: 'Shirk: directing worship (dua, sacrifice, vows, ultimate trust) to other than Allah. Major shirk nullifies deeds if unrepented; minor shirk (showing off) wounds them.' },
  { q: 'How do decree and free will fit?', a: 'Allah decreed all things; humans still choose willingly and earn reward or blame. Take full means, then trust Allah — never use Qadr as an excuse.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Aqeedah', path: '/aqeedah/' },
];
const foundationSlugs = ['what-is-aqeedah-basics', 'six-pillars-iman-explained', 'tawhid-three-categories', 'names-attributes-course', 'shirk-types-explained'];
const detailSlugs = ['belief-angels-books', 'belief-in-messengers', 'belief-in-qadr-decree', 'grave-barzakh-after-death', 'signs-day-of-judgment'];
const practiceSlugs = ['bidah-vs-sunnah', 'tawakkul-trust-balance', 'madhab-differences-explained'];
const foundations = foundationSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const details = detailSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const practices = practiceSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const duaSlugs = ['amantu-billah-doubts', 'steadfast-heart', 'refuge-hidden-shirk', 'sayyidul-istighfar', 'hasbunallah', 'seeking-knowledge'];
const duas = duaSlugs.map((s) => DUAS.find((d) => d.slug === s)).filter(Boolean);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/aqeedah/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">Aqeedah hub</span>
        <span class="hn-badge">Beliefs + Duas</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Aqeedah — Islamic Beliefs</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">What every Muslim must believe: the six pillars, Tawhid, shirk-protection, Qadr, and the Last Day — with neutral Sunni voice and school differences noted.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/learn/aqeedah/what-is-aqeedah-basics/')} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">Start: what is aqeedah</a>
        <a href={L('/names-of-allah/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">99 Names of Allah</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Foundations" title="Belief foundations" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {foundations.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Details" title="Angels, messengers, decree & Last Day" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {details.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Practice" title="Living the belief" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {practices.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Duas" title="Duas of faith" href={L('/duas/')} linkLabel="All duas" />
      <div class="grid gap-3 sm:grid-cols-2">
        {duas.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{d.use}</span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
