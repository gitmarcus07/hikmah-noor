---
/* Search discovery page — grouped by content type, fast, mobile-friendly.
 * Engine: deterministic tiered search over compact build-time indexes
 * (core always; ayah chunk lazily for Quran-reference queries). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/hn/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { getDict } from '../i18n/utils';
const locale = 'en';
const dict = getDict(locale);
const S = (dict as any).search;
const popular = ['dua', 'quran', 'zakat', 'fitrana', 'surah yaseen', 'mahr', 'wudu', 'livestock'];
const T = {
  resultsFor: S.resultsFor, resultFor: S.resultFor, typeToFilter: S.typeToFilter,
  noResults: S.noResults, tryDefault: S.tryDefault, orBrowse: S.orBrowse,
  allTools: S.allTools, surahs114: S.surahs114, quranParas: S.quranParas,
  didYouMean: S.didYouMean,
  fAll: S.fAll, fQuran: S.fQuran, fDuas: S.fDuas, fHadith: S.fHadith,
  fGuides: S.fGuides, fNames: S.fNames, fTools: S.fTools, fKalimas: S.fKalimas,
};
const FILTERS = [
  { label: T.fAll, cats: '' },
  { label: T.fDuas, cats: 'duas' },
  { label: T.fQuran, cats: 'quran,surahs' },
  { label: T.fHadith, cats: 'hadees' },
  { label: T.fGuides, cats: 'learn' },
  { label: T.fNames, cats: 'names' },
  { label: T.fKalimas, cats: 'kalimas' },
  { label: T.fTools, cats: 'tools' },
];
---
<BaseLayout title="Search — Hikmah Noor" description="Search Islamic articles on Quran, duas, kalimas." locale={locale} canonicalPath="/search/" noindex={true} crumbs={[{ name: 'Home', path: '/' }, { name: 'Search', path: '/search/' }]}>
<div class="hn-read hn-section" data-searchpage data-locale={locale} data-index-url="/search-index.json" data-ayah-url="/search-ayahs.json" data-t={JSON.stringify(T)}>
  <Breadcrumbs locale={locale} items={[{ name: 'Home', path: '/' }, { name: 'Search', path: '/search/' }]} />
  <h1 class="text-3xl font-extrabold mt-3">Search</h1>
  <p class="mt-1 text-[15px]" style="color:var(--hn-muted)">Search duas, surahs, topics, tools and guides.</p>
  <form method="get" action="/search/" class="mt-4" role="search">
    <div class="hn-searchwrap">
      <Icon name="search" size={19} />
      <input id="q" name="q" placeholder={dict.nav.search} autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" aria-label="Search" />
      <button class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
    </div>
  </form>
  <div class="mt-3 flex flex-wrap gap-2" id="chips">
    {popular.map(p => <button data-q={p} class="hn-badge hn-card-hover" style="padding:0.5rem 1rem;font-size:0.85rem;cursor:pointer">{p}</button>)}
  </div>
  <div class="mt-4 flex flex-wrap gap-2" id="typefilter" role="group" aria-label="Filter by type">
    {FILTERS.map((f, i) => <button data-cats={f.cats} class={`hn-btn ${i === 0 ? 'hn-btn-primary' : 'hn-btn-secondary'} !min-h-[40px] !py-2 !px-4 text-sm`}>{f.label}</button>)}
  </div>
  <p id="count" class="mt-4 text-sm" style="color:var(--hn-muted)" aria-live="polite"></p>
  <div id="dym" class="mt-2"></div>
  <div id="results" class="mt-3 space-y-6" aria-live="polite"></div>
</div>
<script>
  import { createIndex, search, didYouMean, ayahNeeded, groupByCategory, escHtml, highlight } from '../lib/search-engine.js';
  (() => {
    const root = document.querySelector('[data-searchpage]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const locale = root.dataset.locale || 'en';
    const indexUrl = root.dataset.indexUrl || '/search-index.json';
    const ayahUrl = root.dataset.ayahUrl || '/search-ayahs.json';
    const T = JSON.parse(root.dataset.t || '{}');
    const box = root.querySelector('#q');
    const out = root.querySelector('#results');
    const count = root.querySelector('#count');
    const dym = root.querySelector('#dym');
    const chips = root.querySelector('#chips');
    const typeFilter = root.querySelector('#typefilter');
    const typeBtns = [...root.querySelectorAll('#typefilter button')];
    let cats = '';
    let corePayload = null;
    let core = null;
    let ayahsLoaded = false;
    let ayahsLoading = null;
    const loadCore = async () => {
      if (!core) {
        try { corePayload = await (await fetch(indexUrl)).json(); }
        catch { corePayload = null; }
        if (!corePayload) corePayload = { v: 1, locale, cats: [], docs: [], surahs: [], aliases: {} };
        core = createIndex(corePayload, null);
      }
      return core;
    };
    const ensureAyahs = async (q) => {
      const idx = await loadCore();
      if (ayahsLoaded || !ayahNeeded(idx, q)) return;
      if (!ayahsLoading) {
        ayahsLoading = (async () => {
          try {
            const payload = await (await fetch(ayahUrl)).json();
            core = createIndex(corePayload, payload);
          } catch { /* keep core-only */ }
          ayahsLoaded = true;
          ayahsLoading = null;
        })();
      }
      await ayahsLoading;
    };
    const activeTypes = () => cats ? new Set(cats.split(',')) : null;
    const fill = (tpl, m) => tpl.replace(/\{(\w+)\}/g, (_, k) => m[k] ?? '');
    const render = (grouped, total, q, correction) => {
      count.textContent = q ? (total === 1 ? fill(T.resultFor, { q }) : fill(T.resultsFor, { n: total, q })) : fill(T.typeToFilter, { n: core ? core.docs.length : 0 });
      dym.innerHTML = '';
      if (correction) {
        const b = document.createElement('button');
        b.className = 'hn-btn hn-btn-secondary !min-h-[40px] !py-2 !px-4 text-sm';
        b.textContent = fill(T.didYouMean, { q: correction });
        b.addEventListener('click', () => { box.value = correction; box.focus(); run(); });
        dym.appendChild(b);
      }
      if (!grouped.length) {
        out.innerHTML = `<div class="hn-card hn-card-pad"><p class="font-bold">${escHtml(fill(T.noResults, { q }))}</p>` +
          `<p class="text-sm mt-1" style="color:var(--hn-muted)">${escHtml('Try: ' + T.tryDefault + ' — ' + T.orBrowse)}</p>` +
          `<div class="mt-3 flex flex-wrap gap-2">` +
          `<a href="/tools/" class="hn-btn hn-btn-primary !min-h-[44px] text-sm">${escHtml(T.allTools)}</a>` +
          `<a href="/surahs/" class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">${escHtml(T.surahs114)}</a>` +
          `<a href="/quran/" class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">${escHtml(T.quranParas)}</a></div></div>`;
        return;
      }
      out.innerHTML = '';
      for (const [cat, docs] of grouped) {
        if (cat) {
          const h = document.createElement('h2');
          h.className = 'text-sm font-extrabold uppercase tracking-wide';
          h.style.color = 'var(--hn-muted)';
          h.textContent = `${cat} (${docs.length})`;
          out.appendChild(h);
        }
        const wrap = document.createElement('div');
        wrap.className = 'space-y-3 mt-2';
        for (const it of docs.slice(0, 8)) {
          const a = document.createElement('a');
          a.href = it.u;
          a.className = 'hn-card hn-card-hover hn-card-pad block';
          a.innerHTML = `<span class="flex items-center gap-1.5"><span class="hn-badge hn-badge-primary">${escHtml(it.c)}</span>` +
            (it.docLocale && it.docLocale !== locale ? `<span class="hn-badge">EN</span>` : '') +
            `</span><span class="font-bold block leading-6 mt-2">${highlight(it.t, q)}</span><span class="text-sm" style="color:var(--hn-muted)">${highlight(it.d || '', q)}</span>`;
          wrap.appendChild(a);
        }
        out.appendChild(wrap);
      }
    };
    let t = null;
    const run = async () => {
      const raw = box.value.trim();
      const q = raw.toLowerCase().trim();
      if (chips) chips.style.display = q ? 'none' : '';
      if (typeFilter) typeFilter.style.display = q ? 'none' : '';
      await loadCore();
      if (q) await ensureAyahs(q);
      if (!q) {
        const all = core.docs.filter((d) => !cats || activeTypes().has(d.c)).slice(0, 10);
        render([[ '', all ]].filter(([, docs]) => docs.length), all.length, '', null);
        const url = new URL(window.location.href);
        url.searchParams.delete('q');
        history.replaceState(null, '', url.pathname);
        return;
      }
      const ranked = search(core, q, { limit: 48, types: activeTypes() });
      const grouped = groupByCategory(ranked.map((r) => ({ d: r.d })));
      const correction = didYouMean(core, q, ranked[0]?.tier);
      render(grouped, ranked.length, raw, correction);
      const url = new URL(window.location.href);
      url.searchParams.set('q', raw);
      history.replaceState(null, '', url.search);
    };
    typeBtns.forEach((b) => b.addEventListener('click', () => {
      cats = b.dataset.cats || '';
      typeBtns.forEach((x) => {
        const on = x === b;
        x.classList.toggle('hn-btn-primary', on);
        x.classList.toggle('hn-btn-secondary', !on);
      });
      run();
    }));
    box.addEventListener('input', () => { clearTimeout(t); t = setTimeout(run, 150); });
    chips?.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => { box.value = b.dataset.q; box.focus(); run(); }));
    box.value = new URLSearchParams(window.location.search).get('q') ?? '';
    run();
  })();
</script>
</BaseLayout>
