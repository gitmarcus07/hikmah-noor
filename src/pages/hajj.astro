---
/* Hajj hub — aggregator for Hajj & Umrah rites.
 * No new data: guides, duas and tools linked by slug. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/hn/Breadcrumbs.astro';
import SectionHeader from '../components/hn/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { localizedPath } from '../i18n/utils';
import { GUIDES } from '../data/guides';
import { DUAS } from '../data/duas';

const locale = 'en';
const L = (p: string) => localizedPath(locale, p);

const title = `Hajj & Umrah Guide — Ihram, Tawaf, Sai, Arafah, Stoning & Farewell Tawaf`;
const description = `Complete Hajj & Umrah guide: ihram, tawaf, sai, Mina, Arafah, Muzdalifah, stoning, sacrifice, day-by-day timeline, packing checklist, common mistakes and essential duas.`;
const keywords = 'hajj guide, umrah ka tarika, hajj steps, ihram ka tarika, tawaf ka tarika, sai ka tarika, wuquf e arafah, muzdalifah, rami stoning, hajj day by day, umrah day plan, hajj packing list, talbiyah, arafah dua';
const faq = [
  { q: 'What are the steps of Umrah in order?', a: 'Ihram at the miqat with talbiyah, tawaf (7 circuits), 2 rakahs + Zamzam, sai (7 passages Safa-Marwa), then haircut. See our Umrah day plan for timings and crowd tips.' },
  { q: 'What are the days of Hajj?', a: '8th Tarwiyah (Mina), 9th Arafah standing (the essence of Hajj) + Muzdalifah night, 10th stoning + sacrifice + tawaf al-ifadah, 11th-13th stoning all pillars + farewell tawaf.' },
  { q: 'What invalidates Hajj?', a: 'Missing the Arafah standing from noon to Fajr invalidates that year’s Hajj. Other violations (ihram restrictions, missed rites) need fidyah — consult scholars.' },
  { q: 'Which duas do I need for Hajj & Umrah?', a: 'Talbiyah, Arafah dua (La ilaha illallah...), Rabbana atina in tawaf, Safa-Marwa dhikr, Zamzam dua, Eid takbir and Kaaba-sight dua — all linked below with Arabic and meaning.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Hajj & Umrah', path: '/hajj/' },
];
const riteSlugs = ['hajj-umrah-basics', 'ihram-how-to', 'tawaf-how-to', 'sai-how-to', 'mina-arafah-muzdalifah', 'hajj-day-by-day', 'umrah-day-plan'];
const planSlugs = ['hajj-packing-checklist', 'hajj-common-mistakes', 'hajj-umrah-badal-deceased', 'umrah-kids-elderly-nusuk'];
const rites = riteSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const plans = planSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const duaSlugs = ['talbiyah', 'ihram-niyyah', 'arafah-dua', 'tawaf-corner', 'safa-marwa-dhikr', 'zamzam-dua', 'kaaba-sight-dua', 'rami-takbir'];
const duas = duaSlugs.map((s) => DUAS.find((d) => d.slug === s)).filter(Boolean);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/hajj/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">Hajj hub</span>
        <span class="hn-badge">Rites + Duas + Planning</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Hajj & Umrah Guide</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Ihram, tawaf, sai, Arafah, Muzdalifah, stoning and farewell tawaf — rites in order, duas with Arabic, and packing + mistake guides.</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">Travelling for Eid al-Adha? See the <a href={L('/eid/')} class="font-bold" style="color:var(--hn-primary)">Eid & Qurbani Guide →</a></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/learn/duties/umrah-day-plan/')} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">Umrah day plan</a>
        <a href={L('/learn/duties/hajj-day-by-day/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">Hajj day by day</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Rites" title="Hajj & Umrah rites in order" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {rites.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Planning" title="Packing, mistakes & special cases" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {plans.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Duas" title="Essential Hajj & Umrah duas" href={L('/duas/hajj-umrah/')} linkLabel="All Hajj duas" />
      <div class="grid gap-3 sm:grid-cols-2">
        {duas.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{d.use}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Tools" title="Hajj tools" href={L('/tools/')} linkLabel="All tools" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { t: 'Qibla Finder', d: 'Face the Kaaba from anywhere', h: '/tools/qibla/', i: 'quran' },
          { t: 'Prayer Times', d: 'Prayer times for Makkah & Madinah', h: '/tools/prayer-times/', i: 'sun' },
          { t: 'Hijri Converter', d: 'Dhul-Hijjah dates & Hajj days', h: '/tools/hijri-converter/', i: 'moon' },
          { t: 'Tasbih Counter', d: 'Talbiyah & dhikr counts', h: '/tools/tasbih/', i: 'tools' },
        ].map((c) => (
          <a href={L(c.h)} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.i as any} size={22} /></span>
            <span class="min-w-0">
              <span class="block font-extrabold text-[16px] leading-6">{c.t}</span>
              <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">{c.d}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
