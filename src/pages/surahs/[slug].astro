---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SurahReader from '../../components/SurahReader.astro';
import SiteArt from '../../components/SiteArt.astro';
import { artFor } from '../../lib/art';
import { getCollection, render } from 'astro:content';
import { getDict, localizedPath } from '../../i18n/utils';
import surahsMeta from '../../data/surahs-meta.json';
import { tafsirFor } from '../../data/tafsir';

const surahFiles = import.meta.glob('../../data/surahs/*.json');
const locale = 'en';

export async function getStaticPaths() {
  const paths: any[] = [];
  const all = await getCollection('articles', ({ data }) => !data.draft && data.locale === 'en' && data.category === 'surahs');
  for (const entry of all) {
    const parts = entry.id.split('/');
    const slug = parts[parts.length - 1].replace(/\.mdx?$/, '');
    paths.push({ params: { slug }, props: { entry } });
  }
  for (const s of surahsMeta as any[]) {
    paths.push({ params: { slug: s.slug }, props: { surahNum: s.num } });
  }
  return paths;
}

const { slug } = Astro.params;
const dict = getDict(locale);
const slugOf = (id: string) => id.split('/').pop()!.replace(/\.mdx?$/, '');

const surahNum = (Astro.props as any).surahNum as number | undefined;
let surah: any = null;
let prevMeta: any = null;
let nextMeta: any = null;
if (surahNum) {
  const loader = (surahFiles as any)[`../../data/surahs/${surahNum}.json`];
  const mod = await loader();
  surah = (mod as any).default ?? mod;
  const idx = (surahsMeta as any[]).findIndex((s) => s.num === surahNum);
  prevMeta = idx > 0 ? (surahsMeta as any[])[idx - 1] : null;
  nextMeta = idx < (surahsMeta as any[]).length - 1 ? (surahsMeta as any[])[idx + 1] : null;
}
const tafsir = surahNum ? tafsirFor(surahNum) : null;

const entry = (Astro.props as any).entry;
let Content: any = null;
let related: any[] = [];
let popular: any[] = [];
let pub = '';
if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
  const allSameLocale = await getCollection('articles', ({ data }) => !data.draft && data.locale === 'en');
  related = allSameLocale.filter((e) => e.id !== entry.id && e.data.category === entry.data.category).slice(0, 3);
  popular = allSameLocale.filter((e) => e.id !== entry.id).sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 4);
  pub = new Date(entry.data.pubDate).toLocaleDateString();
}
---
{surah ? (
<BaseLayout
  title={`Surah ${surah.name} (${surah.englishName}) with Urdu, English & Hindi Translation`}
  description={`Read Surah ${surah.name} (${surah.englishName}) — ${surah.verseCount} verses in Arabic (Uthmani) with Urdu, English and Hindi meaning, transliteration and audio recitation.`}
  locale={locale}
  keywords={`surah ${surah.name.toLowerCase()}, surah ${surah.num}, ${surah.slug}, surah ${surah.name.toLowerCase()} in urdu, surah ${surah.name.toLowerCase()} english translation, surah ${surah.name.toLowerCase()} hindi meaning, surah ${surah.name.toLowerCase()} transliteration, surah ${surah.name.toLowerCase()} with audio, surah ${surah.name.toLowerCase()} recitation${tafsir ? `, surah ${surah.name.toLowerCase()} tafsir, ${tafsir.themes.join(', ').toLowerCase()}` : ''}`}
  type="article"
  canonicalPath={`/surahs/${surah.slug}/`}
  faq={[
    { q: `How many verses are in Surah ${surah.name}?`, a: `Surah ${surah.name} (${surah.englishName}) has ${surah.verseCount} verses and is ${surah.revelation === 'Mecca' ? 'Makki (revealed in Mecca)' : 'Madani (revealed in Medina)'}.` },
    { q: `Can I read Surah ${surah.name} with translation?`, a: `Yes. This page shows every verse of Surah ${surah.name} in Arabic with Urdu, English and Hindi meaning. Use the language buttons above the verses to switch translation.` },
    { q: `Is audio available for Surah ${surah.name}?`, a: `Yes. Press play on any verse for Arabic recitation — choose from 5 reciters (Alafasy, Abdul Basit, Husary, Muaiqly, Minshawi) in the 🎙 menu — or use Play surah to listen continuously. Urdu and English translation audio is available from the dropdown.` },
    ...(tafsir ? [{ q: `What is Surah ${surah.name} about?`, a: `${tafsir.intro} Key themes: ${tafsir.themes.join(', ')}.` }] : []),
  ]}
>
  <div class="max-w-4xl mx-auto px-4 py-6 md:py-8">
    <SurahReader surah={surah} prev={prevMeta} next={nextMeta} locale={locale} />
    <section class="mt-8 bg-night-850 border border-white/10 rounded-2xl p-5 md:p-6 prose-islamic">
      <h2>About Surah {surah.name} ({surah.englishName})</h2>
      <p>Surah {surah.name} is surah {surah.num} of 114 — {surah.verseCount} verses, {surah.revelation === 'Mecca' ? 'Makki' : 'Madani'}. Read it above in Arabic with Urdu, English and Hindi translation, transliteration and audio, or continue to <a class="font-bold text-brand-300 hover:text-brand-200" href={localizedPath(locale, '/surahs/')}>all 114 surahs</a> and the <a class="font-bold text-brand-300 hover:text-brand-200" href={localizedPath(locale, '/quran/')}>full Quran with 30 paras</a>.</p>
      {tafsir && (
        <>
          <h3 class="mt-4">Tafsir summary</h3>
          <p>{tafsir.intro}</p>
          <p class="mt-2"><strong>Key themes:</strong> {tafsir.themes.join(' • ')}</p>
          {tafsir.keyVerses.length > 0 && (
            <ul class="mt-2 space-y-1.5">
              {tafsir.keyVerses.map((k: any) => (
                <li><strong>Verse {k.v}:</strong> {k.note}</li>
              ))}
            </ul>
          )}
          <p class="mt-2 text-sm opacity-80">Summary: Hikmah Noor editorial. For rulings and detail see classical tafsir (Ibn Kathir, Jalalayn) and consult scholars — <a class="font-bold text-brand-300 hover:text-brand-200" href={localizedPath(locale, '/methodology/')}>our methodology</a>.</p>
        </>
      )}
    </section>
  </div>
</BaseLayout>
) : (
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  keywords={entry.data.keywords}
  type="article"
  pubDate={new Date(entry.data.pubDate).toISOString()}
  faq={entry.data.faq}
  canonicalPath={`/${entry.data.category}/${slug}/`}
>
  <div class="max-w-7xl mx-auto px-4 py-6 md:py-8 grid gap-8 lg:grid-cols-[1fr_320px]">
    <article class="min-w-0">
      <nav class="text-xs text-ink-500 mb-3">
        <a href={localizedPath(locale, '/')} class="hover:text-brand-300">{dict.nav.home}</a> /
        <a href={localizedPath(locale, `/${entry.data.category}/`)} class="capitalize hover:text-brand-300"> {entry.data.category}</a> /
        <span> {entry.data.title.slice(0, 40)}...</span>
      </nav>
      <span class="text-[11px] font-bold uppercase tracking-wide text-brand-300 bg-brand-500/15 px-2.5 py-1 rounded-full">{entry.data.category}</span>
      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mt-3 mb-2 text-white">{entry.data.title}</h1>
      <p class="text-sm text-ink-500 mb-4">{dict.article.by} <b>{entry.data.author}</b> • {pub}</p>
      <div class="rounded-2xl border border-white/10 overflow-hidden mb-2"><SiteArt name={artFor(entry.data.image, entry.data.category)} title={entry.data.title} /></div>
      {entry.data.arabic && (
        <div class="bg-night-850 border border-white/10 rounded-2xl p-5 md:p-6 my-5">
          <div class="text-xs font-bold text-gold-300 mb-2">{dict.article.arabic}</div>
          <p class="arabic-block" lang="ar" dir="rtl">{entry.data.arabic}</p>
          {entry.data.transliteration && <p class="mt-4 text-ink-200 italic leading-7 text-[15px]">{entry.data.transliteration}</p>}
        </div>
      )}
      <div class="bg-night-850 border border-white/10 rounded-2xl p-5 md:p-7 prose-islamic">
        <Content />
      </div>
      {entry.data.faq?.length ? (
        <section class="mt-8">
          <h2 class="text-xl font-extrabold mb-3 text-white">❓ {dict.article.faq}</h2>
          <div class="space-y-3">
            {entry.data.faq.map(f => (
              <details class="bg-night-850 border border-white/10 rounded-2xl p-4">
                <summary class="font-bold cursor-pointer text-ink-50">{f.q}</summary>
                <p class="mt-2 text-ink-300 leading-7">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      ) : null}
      {related.length ? (
        <section class="mt-10">
          <h2 class="text-xl font-extrabold mb-4 text-white">📖 {dict.article.related}</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {related.map(r => <ArticleCard locale={locale} category={r.data.category} slug={slugOf(r.id)} title={r.data.title} description={r.data.description} date={r.data.pubDate} />)}
          </div>
        </section>
      ) : null}
    </article>
    <aside class="space-y-5 lg:sticky lg:top-24 self-start w-full">
      <form action={localizedPath(locale, '/search/')} method="get" class="bg-night-850 border border-white/10 rounded-3xl p-3 flex gap-2 shadow-lg shadow-black/30">
        <input name="q" placeholder={dict.nav.search} class="flex-1 min-w-0 bg-night-800 text-ink-50 placeholder:text-ink-500 rounded-2xl px-4 py-3 min-h-[52px] text-[15px] outline-none focus:ring-2 ring-brand-400" />
        <button class="bg-brand-500 hover:bg-brand-400 text-night-900 rounded-2xl w-[52px] min-h-[52px] grid place-items-center shrink-0 font-bold" aria-label="Search">🔍</button>
      </form>
      <div class="bg-night-850 border border-white/10 rounded-3xl p-5 sm:p-6 shadow-lg shadow-black/30">
        <h3 class="flex items-center gap-2.5 font-extrabold text-[17px]"><span class="w-9 h-9 grid place-items-center rounded-xl bg-gradient-to-br from-amber-500 to-amber-400 text-white text-lg shadow-sm">🔥</span>{dict.article.popular}<span class="ms-auto text-[11px] font-extrabold bg-brand-500/15 text-brand-300 rounded-full px-2.5 py-1">{popular.length}</span></h3>
        <ol class="mt-4 divide-y divide-white/10">
          {popular.map((p, i) => <li class="flex gap-3 py-3 first:pt-0 last:pb-0"><span class="w-7 h-7 shrink-0 grid place-items-center rounded-full bg-brand-500/15 text-brand-300 text-[13px] font-extrabold">{i + 1}</span><a class="font-semibold text-[14px] leading-6 text-ink-200 hover:text-brand-300 line-clamp-2" href={localizedPath(locale, `/${p.data.category}/${slugOf(p.id)}/`)}>{p.data.title}</a></li>)}
        </ol>
      </div>
      <div class="bg-night-850 border border-white/10 rounded-3xl p-5 sm:p-6 shadow-lg shadow-black/30 relative overflow-hidden">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 88% 8%, rgba(139,124,246,.25), transparent 45%);"></div>
        <h3 class="relative flex items-center gap-2.5 font-extrabold text-[17px]"><span class="w-9 h-9 grid place-items-center rounded-xl bg-white/10 border border-white/15 text-gold-300">🗂️</span>{dict.article.categories}</h3>
        <div class="relative grid grid-cols-2 gap-2 mt-4">
          {[{ slug: 'surahs', label: dict.nav.surahs, count: '114' }, { slug: 'quran', label: dict.nav.quran, count: '30' }, { slug: 'duas', label: dict.nav.duas, count: '' }, { slug: 'kalimas', label: dict.nav.kalimas, count: '6' }, { slug: 'meanings', label: dict.nav.meanings, count: '' }, { slug: 'waqiat', label: dict.nav.waqiat, count: '' }].map((c) => (
            <a href={localizedPath(locale, `/${c.slug}/`)} class="group bg-white/5 hover:bg-white/10 border border-white/10 hover:border-brand-500/50 rounded-2xl px-3 py-2.5 min-h-[52px] flex items-center gap-2 transition">
              <span class="font-bold text-[13px] leading-5 text-ink-200 group-hover:text-brand-300 truncate">{c.label}</span>
              {c.count && <span class="ms-auto shrink-0 text-[10px] font-extrabold bg-gold-300 group-hover:bg-night-900 group-hover:text-gold-300 text-night-900 rounded-full px-1.5 py-0.5">{c.count}</span>}
            </a>
          ))}
        </div>
      </div>
      <a href={localizedPath(locale, '/tools/')} class="group bg-gold-300 hover:bg-amber-200 text-night-900 rounded-3xl p-5 flex items-center gap-3 shadow font-extrabold text-[15px] leading-6">🧰 {dict.nav.tools} →<span class="ms-auto w-9 h-9 grid place-items-center rounded-full bg-night-900 text-gold-300 group-hover:translate-x-1 transition">→</span></a>
    </aside>
  </div>
</BaseLayout>
)}
