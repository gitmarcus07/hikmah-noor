---
/* Explore — quick access to Quran tools, in the unified system. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/hn/Breadcrumbs.astro';
import SectionHeader from '../components/hn/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { localizedPath, getDict } from '../i18n/utils';

const locale = 'en';
const t = getDict(locale).app;
const L = (p: string) => localizedPath(locale, p);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore/' },
];

const GROUPS = [
  { chip: 'Read', title: 'Read the Quran', cards: [
    { title: t.explore.gemsT, sub: t.explore.gemsD, href: L('/tools/gems/'), icon: 'star' },
  ] },
  { chip: 'Worship', title: 'Duas & worship', cards: [
    { title: 'Hadees', sub: '80 hadees: 40 for children + 40 of Imam Nawawi', href: L('/hadees/'), icon: 'book' },
    { title: 'Tasbih Counter', sub: 'Dhikr with 33/100 goals and daily totals', href: L('/tools/tasbih/'), icon: 'tools' },
    { title: 'Prayer Times', sub: 'Namaz times, Qibla compass & Hijri date', href: L('/tools/prayer-times/'), icon: 'sun' },
  ] },
  { chip: 'Learn', title: 'Stories, history & guides', cards: [
    { title: 'How-To Guides', sub: '93 step-by-step guides: prayer, fasting, ruqyah, family & more', href: L('/learn/'), icon: 'book' },
    { title: 'Aqeedah', sub: 'Six pillars, Tawhid, Qadr & Last Day', href: L('/aqeedah/'), icon: 'star' },
    { title: 'Self-Ruqyah Guide', sub: 'How to do ruqyah on yourself: Manzil routine step by step', href: L('/learn/duties/self-ruqyah-manzil-method/'), icon: 'star' },
    { title: 'New Muslim Guide', sub: 'Shahada to first prayer: the week-by-week starter path', href: L('/learn/family/new-muslim-starter-guide/'), icon: 'heart' },
    { title: 'Seerat un Nabi ﷺ', sub: 'Full biography in 16 chapters', href: L('/seerat/'), icon: 'star' },
    { title: 'Prophets', sub: 'All 25 prophets in chronological order', href: L('/prophets/'), icon: 'star' },
    { title: 'Sahaba', sub: 'Lives of the 24 popular companions', href: L('/sahaba/'), icon: 'book' },
    { title: 'Women in Islam', sub: 'Stories of 12 noble figures', href: L('/women/'), icon: 'heart' },
    { title: 'Islamic History', sub: '20 landmark events from Hijrah onward', href: L('/history/'), icon: 'book' },
    { title: 'Names of Allah', sub: 'All 99 names with meaning', href: L('/names-of-allah/'), icon: 'star' },
  ] },
  { chip: 'Seasonal', title: 'Ramadan, Hajj & Eid', cards: [
    { title: 'Islamic Calendar', sub: 'Hijri month view, Ramadan & Eid dates, sacred days with countdowns', href: L('/calendar/'), icon: 'moon' },
    { title: 'Ramadan Guide', sub: 'Fasting rules, duas, Taraweeh & countdown', href: L('/ramadan/'), icon: 'moon' },
    { title: 'Hajj & Umrah Guide', sub: 'Ihram, tawaf, sai, Arafah, stoning & duas', href: L('/hajj/'), icon: 'moon' },
    { title: 'Eid & Qurbani', sub: 'Both Eids, takbeer, Qurbani shares & Tashriq', href: L('/eid/'), icon: 'moon' },
  ] },
  { chip: 'Tools', title: 'Tools & quizzes', cards: [
    { title: 'Islamic Quizzes', sub: '10-question quizzes with instant answers', href: L('/quiz/'), icon: 'book' },
    { title: 'Mirath Calculator', sub: 'Islamic inheritance shares (Sunni)', href: L('/tools/family-finance/mirath-calculator/'), icon: 'tools' },
    { title: 'Favourites', sub: 'Your saved duas, stories and verses', href: L('/favourites/'), icon: 'heart' },
    { title: 'Tools', sub: 'Calculators with evidence', href: L('/tools/'), icon: 'tools' },
  ] },
];
---
<BaseLayout title="Explore — Quranic Gems, Quran, Duas & Tools" description="Explore Hikmah Noor: discover Quranic gems, read the Quran with translation, browse duas, and use Islamic tools." keywords="explore quran, quranic gems, duas, islamic tools" locale={locale} canonicalPath="/explore/" crumbs={crumbs}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3">
      <SectionHeader eyebrow="Explore" title="Explore the library" sub="Jump straight into reading, searching and tools." />
      {GROUPS.map((g) => (
        <div class="mt-6">
          <SectionHeader eyebrow={g.chip} title={g.title} />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-3">
            {g.cards.map((c) => (
              <a href={c.href} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
                <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any} size={22} /></span>
                <span class="min-w-0">
                  <span class="block font-extrabold text-[16px] leading-6">{c.title}</span>
                  <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">{c.sub}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
