---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { nonDefaultLocales, getDict, localizedPath } from '../../i18n/utils';
export async function getStaticPaths() { return nonDefaultLocales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const dict = getDict(locale);
const stats = [
  { n: '114', label: 'Surahs', href: '/surahs/', icon: 'surahs' },
  { n: '179', label: 'Duas', href: '/duas/', icon: 'duas' },
  { n: '6', label: 'Kalimas', href: '/kalimas/', icon: 'kalimas' },
  { n: '14', label: 'Meanings', href: '/meanings/', icon: 'meanings' },
  { n: '10', label: 'Stories', href: '/waqiat/', icon: 'waqiat' },
  { n: '20', label: 'Tools', href: '/tools/', icon: 'tools' },
];
---
<BaseLayout title="About Us — Hikmah Noor" description="Hikmah Noor shares authentic, easy Islamic knowledge: 114 surahs, 179 duas with sources, 6 kalimas, meanings, prophet stories and finance tools." locale={locale} type="article" canonicalPath="/about/">
  <section class="relative overflow-hidden bg-night-900 text-white">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 10%, rgba(139,124,246,.25), transparent 50%), radial-gradient(circle at 10% 90%, rgba(212,175,55,.12), transparent 40%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 pt-8 pb-9 md:pt-12 md:pb-12">
      <nav class="text-xs text-ink-500 mb-4"><a href={localizedPath(locale, '/')} class="hover:text-brand-300">{dict.nav.home}</a> / <span>About Us</span></nav>
      <span class="text-[11px] font-extrabold uppercase tracking-widest bg-gold-300 text-night-900 rounded-full px-3 py-1.5">☪ Our mission</span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mt-3 text-white">About Hikmah Noor</h1>
      <p class="mt-3 text-ink-300 leading-7 max-w-2xl md:text-lg">Assalamu Alaikum. <b>Hikmah Noor</b> (Wisdom Light) is an independent educational site — Quran, duas with Arabic and transliteration, kalimas, meanings, stories and tools, with honest sourcing on every page.</p>
      <p class="mt-3 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3 max-w-2xl">English guide — translation coming soon.</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <h2 class="text-xl md:text-2xl font-extrabold mb-4 text-white">📚 What you’ll find here</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {stats.map((s) => (
        <a href={localizedPath(locale, s.href)} class="group bg-night-850 border border-white/10 rounded-2xl p-5 flex gap-4 items-center shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 hover:-translate-y-0.5 transition">
          <span class="w-12 h-12 shrink-0 grid place-items-center rounded-2xl bg-brand-500/15 text-brand-300 font-extrabold text-lg">{s.n}</span>
          <span class="font-extrabold block leading-6 text-ink-50 group-hover:text-brand-300">{s.label} →</span>
          <span class="ms-auto shrink-0 text-ink-500 group-hover:text-brand-300 transition"><Icon name={s.icon as any} size={20} /></span>
        </a>
      ))}
    </div>

    <div class="mt-8 max-w-3xl bg-night-850 border border-white/10 rounded-2xl p-6 shadow-lg shadow-black/30 prose-islamic">
      <h2>Authenticity promise</h2>
      <p>We rely on the Quran, Sahih hadith (Bukhari, Muslim) and well-known tafsir. Every dua names its source and grade; weak reports are labelled weak. For fatwa, please ask a qualified scholar — see Disclaimer.</p>
      <h2>Contact</h2>
      <p>Questions or corrections? Reach us on the <a href={localizedPath(locale, '/contact/')}>Contact page</a> — accuracy is the whole point.</p>
    </div>
  </div>
</BaseLayout>
