---
/* Eid hub — aggregator for Eid al-Fitr, Eid al-Adha and Qurbani.
 * No new data: guides, duas and tools linked by slug. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/hn/Breadcrumbs.astro';
import SectionHeader from '../../components/hn/SectionHeader.astro';
import Icon from '../../components/Icon.astro';
import { nonDefaultLocales, localizedPath } from '../../i18n/utils';
import { GUIDES } from '../../data/guides';
import { DUAS } from '../../data/duas';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const L = (p: string) => localizedPath(locale, p);

const title = `Eid Guide — Eid ul-Fitr & Eid ul-Adha Prayer, Takbeer, Qurbani & Sunnahs`;
const description = `Both Eids in one place: Eid prayer method, day sunnahs, takbeer wording, khutbah rulings, Zakat al-Fitr, Qurbani rules, shares, meat distribution, Tashriq days and Eid duas.`;
const keywords = 'eid guide, eid ul fitr, eid ul adha, eid namaz ka tarika, eid takbeer, eid ki sunnatein, qurbani ka tarika, qurbani rules, bakra eid, eid ul adha qurbani, tashriq days, fitrana kitna hai, eid khutbah, eid mubarak greeting';
const faq = [
  { q: 'What is the difference between Eid al-Fitr and Eid al-Adha?', a: 'Fitr (1st Shawwal) celebrates completing Ramadan — dates before prayer, fitrana before prayer. Adha (10th Dhul-Hijjah) honours Ibrahim’s sacrifice — Qurbani after prayer, no eating till the sacrifice. Prayer, takbeer and khutbah structures are shared.' },
  { q: 'How is Eid prayer performed?', a: 'Two rakahs with extra takbirs behind the imam, then the khutbah. See our step-by-step Eid prayer guide for the school-wise takbir counts.' },
  { q: 'When is Qurbani slaughtered?', a: 'After the Eid prayer on the 10th through Maghrib of the 13th. Slaughter before the prayer counts as ordinary meat only.' },
  { q: 'What takbeer is recited on Eid?', a: 'Allahu akbar Allahu akbar la ilaha illallah — from the Shawwal moon (Fitr) or Arafah dawn (Adha, continuing after every fard till the 13th Asr). Wording and timings in our Eid takbeer guide.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Eid', path: '/eid/' },
];
const fitrSlugs = ['eid-prayer-method', 'eid-day-sunnahs', 'eid-takbeer-wording', 'eid-khutbah-rulings', 'moon-sighting-hilal', 'zakat-al-fitr', 'shawwal-six-fasts'];
const adhaSlugs = ['qurbani-rules', 'qurbani-shares-who', 'qurbani-meat-distribution', 'tashriq-days-takbeer', 'qurbani-mistakes', 'hajj-day-by-day', 'mina-arafah-muzdalifah'];
const fitr = fitrSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const adha = adhaSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const duas = ['eid-greeting-taqabbal', 'eid-takbir', 'qurbani-slaughter-dua', 'qurbani-intention', 'eat-feed-qurbani-verse', 'gathering-expiation-dua', 'new-clothes', 'ibrahim-taqabbal-minna'].map((s) => DUAS.find((d) => d.slug === s)).filter(Boolean);
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/eid/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">Eid hub</span>
        <span class="hn-badge">Fitr + Adha + Qurbani</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Eid Guide — Fitr & Adha</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Eid prayer, sunnahs, takbeer, khutbah, fitrana, Qurbani shares and distribution, Tashriq days — both Eids, one page.</p>
      <p class="mt-3 text-sm leading-6" style="color:var(--hn-muted)">For pilgrimage rites, see the <a href={L('/hajj/')} class="font-bold" style="color:var(--hn-primary)">Hajj & Umrah Guide →</a></p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/tools/qurbani-eid/qurbani-splitter/')} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">Qurbani share splitter</a>
        <a href={L('/tools/qurbani-eid/eid-day-checklist/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">Eid-day checklist</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Eid ul-Fitr" title="Fitr — prayer, sunnahs & Shawwal" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {fitr.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Eid ul-Adha" title="Adha & Qurbani — sacrifice & Tashriq" href={L('/learn/')} linkLabel="All guides" />
      <div class="grid gap-3 sm:grid-cols-2">
        {adha.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Duas" title="Eid & Qurbani duas" href={L('/duas/hajj-umrah/')} linkLabel="Hajj & Umrah duas" />
      <div class="grid gap-3 sm:grid-cols-2">
        {duas.map((d: any) => (
          <a href={L(`/duas/${d.cat}/${d.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-bold block text-[15px] leading-6">{d.title}</span>
            <span class="text-[13px]" style="color:var(--hn-muted)">{d.use}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Tools" title="Eid tools" href={L('/tools/')} linkLabel="All tools" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { t: 'Qurbani Share Splitter', d: '7-way cost & meat split', h: '/tools/qurbani-eid/qurbani-splitter/', i: 'moon' },
          { t: 'Eid-Day Checklist', d: 'Fitr & Adha hour by hour', h: '/tools/qurbani-eid/eid-day-checklist/', i: 'tools' },
          { t: 'Zakat al-Fitr', d: 'Fitrana per-person amount', h: '/tools/zakat/zakat-al-fitr/', i: 'tools' },
          { t: 'Prayer Times', d: 'Eid prayer time for your city', h: '/tools/prayer-times/', i: 'sun' },
        ].map((c) => (
          <a href={L(c.h)} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.i as any} size={22} /></span>
            <span class="min-w-0">
              <span class="block font-extrabold text-[16px] leading-6">{c.t}</span>
              <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">{c.d}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <p class="mx-auto max-w-2xl px-4 pb-2 text-sm font-semibold text-qg-green bg-qg-soft border border-qg-line rounded-2xl px-4 py-3">English guide — translation coming soon.</p>
</BaseLayout>
