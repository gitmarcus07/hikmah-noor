---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import PublicProfile from '../../components/PublicProfile.astro';
import AppTabBar from '../../components/AppTabBar.astro';
import { nonDefaultLocales } from '../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Leaderboard', path: '/leaderboard/' },
  { name: 'Profile', path: '/user/' },
];
---
<BaseLayout title="Reader Profile" description="View a Hikmah Noor reader's public profile — photo, name, details and reading stats they chose to share." locale={locale} canonicalPath="/user/" crumbs={crumbs} noindex={true} hideFooter>
  <AppHeader locale={locale} title="Profile" backHref="/leaderboard/" />
  <PublicProfile locale={locale} />
  <AppTabBar locale={locale} active="leaderboard" />
</BaseLayout>
