---
import HadithCollection from '../../../../components/HadithCollection.astro';
import { hadithCollectionBySlug } from '../../../../data/hadith-collections';
import { nonDefaultLocales } from '../../../../i18n/utils';

export async function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const collection = hadithCollectionBySlug('nawawi')!;
const { locale } = Astro.params;
---
<HadithCollection collection={collection} locale={locale} />
