---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { nonDefaultLocales, getDict, localizedPath } from '../../../i18n/utils';
import { CATS, toolsByCat, TOOLS } from '../../../lib/finance/tools.js';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const dict = getDict(locale);
const faq = [
  { q: 'Which Islamic finance tool do I need?', a: 'Start with the Obligations Guide: zakat tools for annual wealth dues, fidyah/kaffarah tools for fasts and oaths, family tools for mahr and maintenance, and classical references for khums, ushr, jizya and kharaj.' },
  { q: 'Are these calculators a fatwa?', a: 'No. Every tool gives an educational estimate with its evidence and school differences. For complex cases, consult a qualified scholar.' },
  { q: 'Do I owe jizya or kharaj today?', a: 'No. Those were historical state levies, not personal worship dues — their pages are educational references.' },
];
---
<BaseLayout title="Islamic Finance Tools — Zakat, Fidyah, Kaffarah, Mahr & Khums Calculators" description="Free Islamic finance tools: zakat (gold, silver, cash, business, agriculture, livestock, fitr), fidyah, kaffarah, mahr, nafaqah and khums calculators with evidence." keywords="islamic finance tools, zakat calculator, fidyah calculator, kaffarah calculator, mahr planner, khums calculator, ushr jizya kharaj" locale={locale} canonicalPath="/tools/" faq={faq} crumbs={[{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }]}>
  <section class="relative overflow-hidden bg-night-900 text-white">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 85% 10%, rgba(139,124,246,.25), transparent 50%), radial-gradient(circle at 10% 90%, rgba(212,175,55,.12), transparent 40%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 pt-8 pb-9 md:pt-12 md:pb-12">
      <nav class="text-xs text-ink-500 mb-4"><a href={localizedPath(locale, '/')} class="hover:text-brand-300">{dict.nav.home}</a> / <span>Tools</span></nav>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="text-[11px] font-extrabold uppercase tracking-widest bg-gold-300 text-night-900 rounded-full px-3 py-1.5">{TOOLS.length} free tools</span>
        <span class="text-[11px] font-extrabold uppercase tracking-widest bg-white/10 border border-white/15 text-white rounded-full px-3 py-1.5">EN</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">Islamic Finance Tools</h1>
      <p class="mt-3 text-ink-300 leading-7 max-w-2xl md:text-lg">Separate calculators for separate obligations — with evidence and school differences on every page.</p>
      <p class="mt-4 text-sm font-semibold text-night-900 bg-gold-300/95 rounded-2xl px-4 py-3 max-w-2xl">English tools — translation coming soon. Calculations work the same in every language.</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <p class="text-sm text-ink-500 mb-4">Pick a category — each opens a page with all its tools.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {CATS.map((c) => {
      const list = toolsByCat(c.slug);
      const preview = list.slice(0, 3).map((t) => t.title.split('—')[0].trim());
      return (
      <a href={localizedPath(locale, `/tools/${c.slug}/`)} class="group bg-night-850 border border-white/10 rounded-3xl p-5 md:p-6 flex flex-col gap-3 shadow-lg shadow-black/30 hover:shadow-xl hover:border-brand-500/50 hover:-translate-y-1 transition min-h-[220px]">
        <span class="flex items-center gap-3.5">
          <span class={`w-12 h-12 shrink-0 grid place-items-center rounded-2xl bg-gradient-to-br ${c.grad} text-white shadow`}><Icon name={c.icon || 'tools'} size={24} /></span>
          <span class="min-w-0 flex-1">
            <span class="font-extrabold block text-lg leading-7 text-ink-50 group-hover:text-brand-300">{c.title}</span>
            <span class="text-[11px] font-extrabold bg-white/10 text-ink-300 rounded-full px-2.5 py-1">{list.length} tools</span>
          </span>
          <span class="shrink-0 w-9 h-9 grid place-items-center rounded-full bg-white/10 text-ink-500 group-hover:bg-brand-500 group-hover:text-night-900 transition">→</span>
        </span>
        <span class="text-sm text-ink-300 leading-6">{c.desc}</span>
        <span class="flex flex-wrap gap-1.5 mt-auto pt-1">
          {preview.map((p) => <span class="text-[12px] font-semibold bg-white/5 border border-white/10 text-ink-300 rounded-full px-3 py-1.5 truncate max-w-full">{p}</span>)}
          {list.length > 3 && <span class="text-[12px] font-extrabold text-brand-300 px-2 py-1.5">+{list.length - 3} more →</span>}
        </span>
      </a>
      );
    })}
    </div>

    <h2 class="text-xl md:text-2xl font-extrabold mt-8 mb-3 text-white">More free tools</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      <a href={localizedPath(locale, '/tools/tasbih/')} class="group bg-night-850 border border-white/10 rounded-3xl p-5 flex items-center gap-3 hover:shadow-md hover:border-brand-500/50">
        <span class="w-10 h-10 shrink-0 grid place-items-center rounded-xl bg-brand-500 text-night-900 font-extrabold">◉</span>
        <span class="min-w-0">
          <span class="font-bold block leading-6 text-ink-50">Tasbih Counter</span>
          <span class="text-xs text-ink-500">Dhikr with 33/100 goals and daily totals</span>
        </span>
      </a>
      <a href={localizedPath(locale, '/tools/ramadan-countdown/')} class="group bg-night-850 border border-white/10 rounded-3xl p-5 flex items-center gap-3 hover:shadow-md hover:border-brand-500/50">
        <span class="w-10 h-10 shrink-0 grid place-items-center rounded-xl bg-brand-500 text-night-900 font-extrabold">☾</span>
        <span class="min-w-0">
          <span class="font-bold block leading-6 text-ink-50">Ramadan Countdown</span>
          <span class="text-xs text-ink-500">Days left with Hijri date</span>
        </span>
      </a>
    </div>

    <section class="py-5">
      <h2 class="text-xl md:text-2xl font-extrabold mb-3 text-white">❓ Frequently asked questions</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="bg-night-850 border border-white/10 rounded-2xl p-4 shadow-lg shadow-black/30">
            <summary class="font-bold cursor-pointer leading-6">{f.q}</summary>
            <p class="mt-2 text-ink-300 leading-7 text-[15px]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
<style>.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }</style>
