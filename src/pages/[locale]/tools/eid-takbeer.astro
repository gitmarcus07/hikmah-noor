---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppHeader from '../../../components/AppHeader.astro';
import { nonDefaultLocales, getDict, localizedPath } from '../../../i18n/utils';
export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const dict = getDict(locale);
const faq = [
  { q: 'What is the Eid Takbeer?', a: 'Fitr: from the Shawwal moon until the Eid prayer. Adha (Tashriq): aloud after every obligatory prayer from Fajr of 9 Dhul-Hijjah until Asr of 13 Dhul-Hijjah.' },
  { q: 'How many extra takbeers in Eid prayer?', a: 'Hanafi: 3 extra in rakah 1 and 3 before ruku in rakah 2. Others: 7+5. Follow your local imam.' },
];
---
<BaseLayout title="Eid Takbeer — Wording, Audio & Schedule" description="Eid Takbeer wording with transliteration, device-voice audio loop, and Tashriq schedule for Fitr and Adha." keywords="eid takbeer, eid takbir wording, eid takbeer audio, takbeer tashriq" locale={locale} canonicalPath="/tools/eid-takbeer/" faq={faq} crumbs={[{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }, { name: 'Eid Takbeer Studio', path: '/tools/eid-takbeer/' }]}>
  <AppHeader locale={locale} title="Eid Takbeer Studio" backHref="/tools/" />
  <div class="max-w-3xl mx-auto px-4 py-6" data-takbeer>
    <p class="text-sm font-semibold text-night-900 bg-gold-300/95 rounded-2xl px-4 py-3">English tools — translation coming soon. Calculations work the same in every language.</p>
    <div class="mt-4 hn-card hn-card-pad">
      <p class="hn-block-label">Eid al-Fitr</p>
      <p class="font-arabic text-2xl leading-[2.2] mt-2" lang="ar" dir="rtl">اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ لَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ وَلِلَّهِ الْحَمْدُ</p>
      <p class="mt-2 text-[14px] italic">Allahu Akbar (×3) — la ilaha illa Allah — wallahu Akbar, Allahu Akbar, wa lillahil-hamd.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button data-play="fitr" class="hn-btn hn-btn-primary !min-h-[48px] text-sm">▶ Play</button>
        <button data-stop class="hn-btn hn-btn-secondary !min-h-[48px] text-sm">⏹ Stop</button>
      </div>
    </div>
    <div class="mt-4 hn-card hn-card-pad">
      <p class="hn-block-label">Eid al-Adha / Tashriq</p>
      <p class="font-arabic text-2xl leading-[2.2] mt-2" lang="ar" dir="rtl">اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ لَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ وَلِلَّهِ الْحَمْدُ</p>
      <p class="mt-2 text-[14px] italic">Allahu Akbar (×2) — la ilaha illa Allah — wallahu Akbar, Allahu Akbar, wa lillahil-hamd.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button data-play="adha" class="hn-btn hn-btn-primary !min-h-[48px] text-sm">▶ Play</button>
        <label class="text-sm font-bold flex items-center gap-2">Loop
          <select data-loop class="hn-input !w-auto !min-h-[48px]"><option value="1">×1</option><option value="3" selected>×3</option><option value="10">×10</option></select>
        </label>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <a href={localizedPath(locale, '/learn/salah/eid-prayer-method/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">Eid prayer method →</a>
    </div>
    <section class="mt-8"><div class="space-y-3">{faq.map((f) => (<details class="hn-faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div></section>
  </div>
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-takbeer]');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = '1';
      const TEXT = {
        fitr: 'اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ لَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ وَلِلَّهِ الْحَمْدُ',
        adha: 'اللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ لَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ اللَّهُ أَكْبَرُ وَلِلَّهِ الْحَمْدُ',
      };
      const speak = (key, times) => {
        try { speechSynthesis.cancel(); } catch {}
        if (!('speechSynthesis' in window)) return;
        let n = 0;
        const one = () => {
          const u = new SpeechSynthesisUtterance(TEXT[key]);
          u.lang = 'ar-SA'; u.rate = 0.85;
          const vs = speechSynthesis.getVoices().filter((v) => (v.lang || '').toLowerCase().startsWith('ar'));
          if (vs.length) u.voice = vs[0];
          u.onend = () => { n++; if (n < times) setTimeout(one, 600); };
          speechSynthesis.speak(u);
        };
        one();
      };
      root.querySelectorAll('[data-play]').forEach((b) => b.addEventListener('click', () => {
        speak(b.dataset.play, Math.min(10, Math.max(1, Number(root.querySelector('[data-loop]')?.value || 3))));
      }));
      root.querySelector('[data-stop]')?.addEventListener('click', () => { try { speechSynthesis.cancel(); } catch {} });
    })();
  </script>
</BaseLayout>
