---
/* Ayah Video Maker — client-side 1:1 video generator: single ayah or short surah,
   Arabic recitation + translation voice, animated canvas, recorded, share/download. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppHeader from '../../../components/AppHeader.astro';
import { nonDefaultLocales } from '../../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const faq = [
  { q: 'What can I turn into a video?', a: 'One ayah (pick surah + ayah number, like Ayah Card) or a full short surah from the preset list (Fatiha, Ikhlas, Kawthar, Asr, Nas, Falaq and more). Long surahs are not offered so recordings stay short and shareable.' },
  { q: 'What audio is in the video?', a: 'Arabic recitation (Mishary Alafasy, needs internet) is recorded into the video. Urdu/English translation voice is also recorded when switched on. Hindi meaning appears as on-screen text and is spoken in preview only — browsers cannot record their Hindi voice into the file.' },
  { q: 'What format is the download?', a: 'MP4 wherever your browser supports it (plays in gallery + WhatsApp), otherwise WebM — both 1080×1080 square, perfect for status and posts.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: 'Ayah Video Maker', path: '/tools/ayah-video/' },
];
// Same colour themes as Ayah Card — ids must match THEMES in the script below.
const cardThemes = [
  { id: 'emerald', label: 'Emerald', dot: '#047C70' },
  { id: 'midnight', label: 'Midnight', dot: '#0F172A' },
  { id: 'gold', label: 'Gold', dot: '#D97706' },
  { id: 'rose', label: 'Rose', dot: '#E11D48' },
  { id: 'royal', label: 'Royal', dot: '#4F46E5' },
];
const shortSurahs = [
  { n: 1, name: 'Al-Fatiha', count: 7 },
  { n: 103, name: 'Al-Asr', count: 3 },
  { n: 108, name: 'Al-Kawthar', count: 3 },
  { n: 110, name: 'An-Nasr', count: 3 },
  { n: 106, name: 'Quraish', count: 4 },
  { n: 112, name: 'Al-Ikhlas', count: 4 },
  { n: 111, name: 'Al-Masad', count: 5 },
  { n: 105, name: 'Al-Fil', count: 5 },
  { n: 113, name: 'Al-Falaq', count: 5 },
  { n: 114, name: 'An-Nas', count: 6 },
];
---
<BaseLayout title="Ayah Video Maker — Short Surah & Verse Videos to Share" description="Create 1:1 square ayah videos: single verse or short surah with Arabic recitation and Urdu/English/Hindi meaning, themed like Ayah Card. Download or share the MP4/WebM." keywords="ayah video maker, quran video, surah video download, islamic video maker, ayah mp4, quran status video" locale={locale} canonicalPath="/tools/ayah-video/" faq={faq} crumbs={crumbs}>
  <AppHeader locale={locale} title="Ayah Video Maker" backHref="/tools/" />
  <style>
    .av-spin{width:44px;height:44px;border-radius:50%;border:4px solid rgba(255,255,255,.25);border-top-color:#fff;animation:avspin .9s linear infinite}
    @keyframes avspin{to{transform:rotate(360deg)}}
  </style>
  <div class="max-w-md mx-auto px-4 py-5" data-av>
    <div class="hn-card hn-card-pad space-y-3">
      <fieldset data-av-mode>
        <legend class="text-[13px] font-bold">Video type</legend>
        <div class="flex gap-2 mt-1.5">
          <label class="hn-theme-chip"><input type="radio" name="av-mode" value="single" class="sr-only" checked /><span>Single ayah</span></label>
          <label class="hn-theme-chip"><input type="radio" name="av-mode" value="surah" class="sr-only" /><span>Short surah</span></label>
        </div>
      </fieldset>
      <div data-av-single>
        <div class="grid grid-cols-2 gap-2">
          <label class="text-[13px] font-bold">Surah (1–114)<input data-av-surah inputmode="numeric" value="112" class="hn-input mt-1" aria-label="Surah number" /></label>
          <label class="text-[13px] font-bold">Ayah<input data-av-ayah inputmode="numeric" value="1" class="hn-input mt-1" aria-label="Ayah number" /></label>
        </div>
        <div class="flex gap-2 mt-2">
          <button data-av-load class="hn-btn hn-btn-primary flex-1 !min-h-[48px] text-sm">Load verse</button>
          <button data-av-random class="hn-btn hn-btn-secondary !min-h-[48px] text-sm">🎲 Random</button>
        </div>
      </div>
      <div data-av-surahbox class="hidden">
        <label class="text-[13px] font-bold block">Short surah
          <select data-av-preset class="hn-input mt-1">
            {shortSurahs.map((s) => (
              <option value={s.n} selected={s.n === 112}>{s.name} — {s.count} ayahs</option>
            ))}
          </select>
        </label>
        <button data-av-loadsurah class="hn-btn hn-btn-primary w-full !min-h-[48px] text-sm mt-2">Load surah</button>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <label class="text-[13px] font-bold block">Meaning
          <select data-av-lang class="hn-input mt-1"><option value="ur" selected>Urdu</option><option value="en">English</option><option value="hi">Hindi</option></select>
        </label>
        <label class="text-[13px] font-bold block">Meaning voice
          <select data-av-trvoice class="hn-input mt-1"><option value="on" selected>On (ur/en)</option><option value="off">Off</option></select>
        </label>
      </div>
      <fieldset class="hn-theme-set" data-av-themes>
        <legend class="text-[13px] font-bold">Color Theme</legend>
        <div class="flex flex-wrap gap-1.5 mt-1.5">
          {cardThemes.map((t) => (
            <label class="hn-theme-chip">
              <input type="radio" name="av-theme" value={t.id} class="sr-only" checked={t.id === 'midnight'} />
              <span class="hn-theme-dot" style={`background:${t.dot}`} aria-hidden="true"></span>
              {t.label}
            </label>
          ))}
        </div>
      </fieldset>
      <p class="text-[13px] font-bold hidden" style="color:#b3261e" data-av-err>Verse not found — check the numbers.</p>
      <p class="text-[12.5px]" style="color:var(--hn-muted)" data-av-info>Loading…</p>
    </div>

    <div class="mt-3 hn-card hn-card-pad text-center">
      <div class="relative">
        <canvas data-av-canvas width="1080" height="1080" class="w-full rounded-[12px]" style="border:1px solid var(--hn-border)"></canvas>
        <div data-av-veil class="hidden absolute inset-0 items-center justify-center rounded-[12px]" style="background:rgba(8,10,18,.78)">
          <div class="text-center px-6 w-full max-w-[280px]">
            <div class="av-spin mx-auto"></div>
            <p class="mt-3 font-extrabold text-white text-[15px]" data-av-veil-label>Exporting video…</p>
            <p class="mt-1 text-[13px]" style="color:rgba(255,255,255,.8)" data-av-veil-sub>Ayah 1 of 1</p>
            <div class="mt-3 h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,.2)"><div class="h-full rounded-full" data-av-veil-bar style="width:0%;background:#fff"></div></div>
            <p class="mt-2 text-[12px]" style="color:rgba(255,255,255,.7)">Preparing your file — keep this tab open.</p>
          </div>
        </div>
      </div>
      <video data-av-video controls playsinline class="w-full rounded-[12px] mt-2 hidden" style="border:1px solid var(--hn-border)"></video>
      <div class="flex gap-2 mt-3" data-av-row-run>
        <button data-av-preview class="hn-btn hn-btn-secondary flex-1 !min-h-[48px] text-sm">▶ Preview</button>
        <button data-av-stop class="hn-btn hn-btn-secondary !min-h-[48px] text-sm">⏹ Stop</button>
      </div>
      <div class="flex gap-2 mt-2">
        <button data-av-record class="hn-btn hn-btn-primary flex-1 !min-h-[48px] text-sm">Export video</button>
      </div>
      <div class="flex gap-2 mt-2 hidden" data-av-row-dl>
        <button data-av-dl class="hn-btn hn-btn-primary flex-1 !min-h-[48px] text-sm w-full" disabled>Download video</button>
      </div>
      <p class="text-[13px] font-bold mt-2 hidden" style="color:#b3261e" data-av-msg role="status" aria-live="polite"></p>
      <!-- WhatsApp/copy fallback removed: Share uses the system sheet now. -->
      <p class="mt-2 text-[12.5px]" style="color:var(--hn-muted)">1080×1080 square — Arabic recitation recorded in. Hindi voice: preview only. <span data-av-ver>v17</span></p>
    </div>

    <section class="mt-8" aria-label="Frequently asked questions">
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-av]');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = '1';
      try { console.info('[ayah-video] v17 duration-fix'); } catch {}
      const $ = (s) => root.querySelector(s);
      const cv = $('[data-av-canvas]');
      const cx = cv.getContext('2d');
      const video = $('[data-av-video]');
      const THEMES = {
        emerald: { bg1: '#047C70', bg2: '#05998B', gold: '#CCFBF1', ink: '#ffffff', mut: '#E6FFFB' },
        midnight: { bg1: '#0F172A', bg2: '#1E293B', gold: '#A5B4FC', ink: '#ffffff', mut: '#CBD5E1' },
        gold: { bg1: '#D97706', bg2: '#F59E0B', gold: '#431407', ink: '#431407', mut: '#4A2208' },
        rose: { bg1: '#BE123C', bg2: '#E11D48', gold: '#FFE4E6', ink: '#ffffff', mut: '#FECDD3' },
        royal: { bg1: '#4338CA', bg2: '#4F46E5', gold: '#E0E7FF', ink: '#ffffff', mut: '#C7D2FE' },
      };
      const DEFAULT_THEME = 'midnight';
      const themeName = () => {
        const picked = root.querySelector('input[name="av-theme"]:checked');
        return picked && THEMES[picked.value] ? picked.value : DEFAULT_THEME;
      };
      const SURAH_VERSES = [7,286,200,176,120,165,206,75,129,109,123,111,43,52,99,128,111,110,98,135,112,78,118,64,77,227,93,88,69,60,34,30,73,54,45,83,182,88,75,85,54,53,89,59,37,35,38,29,18,45,60,49,62,55,78,96,29,22,24,13,14,11,11,18,12,12,30,52,52,44,28,28,20,56,40,31,50,40,46,42,29,19,36,25,22,17,19,26,30,20,15,21,11,8,8,19,5,8,8,11,11,8,3,9,5,4,7,3,6,3,5,4,5,6];
      const pad3 = (n) => String(n).padStart(3, '0');
      const AR_BASE = 'https://everyayah.com/data/Alafasy_128kbps/';
      const TR_BASE = {
        ur: 'https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/',
        en: 'https://everyayah.com/data/English/Sahih_Intnl_Ibrahim_Walk_192kbps/',
      };
      const arUrl = (s, v) => AR_BASE + pad3(s) + pad3(v) + '.mp3';
      const trUrl = (lang, s, v) => TR_BASE[lang] ? TR_BASE[lang] + pad3(s) + pad3(v) + '.mp3' : null;

      let items = [{ ar: 'قُلْ هُوَ اللَّهُ أَحَدٌ', tr: 'Say: He is Allah, the One.', ref: 'Quran 112:1', s: 112, v: 1, dir: 'ltr' }];
      let seq = 0; // cancellation token for preview/record runs
      let loadSeq = 0; // cancellation token for verse loads
      let recBlob = null;
      let recExt = 'webm';
      let recMime = '';

      const err = $('[data-av-err]');
      const info = $('[data-av-info]');
      const msg = $('[data-av-msg]');
      const say = (text, bad) => {
        if (!msg) return;
        msg.textContent = text || '';
        msg.classList.toggle('hidden', !text);
        msg.style.color = bad ? '#b3261e' : 'var(--hn-muted)';
      };
      const showErr = (t) => { if (err) { err.textContent = t; err.classList.remove('hidden'); } };
      const hideErr = () => err?.classList.add('hidden');
      const setInfo = (t) => { if (info) info.textContent = t; };

      const wrap = (c, text, max, font) => {
        c.font = font;
        const words = String(text).split(/\s+/);
        const lines = [];
        let line = '';
        for (const w of words) {
          const t = line ? line + ' ' + w : w;
          if (c.measureText(t).width > max && line) { lines.push(line); line = w; }
          else line = t;
        }
        if (line) lines.push(line);
        return lines;
      };
      const AR_FONT = '44px "Amiri Quran", "Noto Naskh Arabic", serif';
      const TR_FONT = 'italic 40px Georgia, serif';
      const TR_UR_FONT = AR_FONT;
      const MW = 1080 - 220;
      const clamp01 = (x) => Math.max(0, Math.min(1, x));
      const scaleFont = (f, px) => f.replace(/\d+px/, px + 'px');
      // Fit long verses: shrink type until Arabic + meaning end above the
      // footer (EQ bars live at y≈875, reference at 930).
      const CONTENT_MAX_Y = 828;
      const linesFor = (item) => {
        if (!item._lines) {
          const trBase = item._dir === 'rtl' ? TR_UR_FONT : TR_FONT;
          let best = null, bestSc = 0;
          for (const sc of [1, 0.88]) {
            const arFont = scaleFont(AR_FONT, Math.max(24, Math.round(44 * sc)));
            const trFont = scaleFont(trBase, Math.max(22, Math.round(40 * sc)));
            const ar = wrap(cx, item.ar, MW, arFont).slice(0, 8);
            const tr = wrap(cx, '\u201C' + item.tr + '\u201D', MW, trFont).slice(0, 8);
            const arStep = Math.max(34, Math.round(64 * sc));
            const trStep = Math.max(32, Math.round(58 * sc));
            best = { ar, tr, arFont, trFont, arStep, trStep };
            bestSc = sc;
            if (310 + ar.length * arStep + 66 + tr.length * trStep <= CONTENT_MAX_Y) break;
          }
          const count = (ls) => ls.map((ln) => ln.split(/\s+/).filter(Boolean).length);
          if (bestSc >= 0.85 && 310 + best.ar.length * best.arStep + 66 + best.tr.length * best.trStep <= CONTENT_MAX_Y) {
            const arCounts = count(best.ar), trCounts = count(best.tr);
            item._lines = {
              mode: 'static',
              ar: best.ar, tr: best.tr, trFont: best.trFont, arFont: best.arFont,
              arStep: best.arStep, trStep: best.trStep, arCounts, trCounts,
              arTotal: arCounts.reduce((a, b) => a + b, 0) || 1,
              trTotal: trCounts.reduce((a, b) => a + b, 0) || 1,
            };
          } else {
            // Scroll mode: keep full readable size, slow vertical pan instead.
            const ar = wrap(cx, item.ar, MW, AR_FONT);
            const trFont = trBase;
            const tr = wrap(cx, '\u201C' + item.tr + '\u201D', MW, trFont);
            const arCounts = count(ar), trCounts = count(tr);
            item._lines = {
              mode: 'scroll',
              ar, tr, trFont, arFont: AR_FONT, arStep: 64, trStep: 58,
              arCounts, trCounts,
              arTotal: arCounts.reduce((a, b) => a + b, 0) || 1,
              trTotal: trCounts.reduce((a, b) => a + b, 0) || 1,
              scrollMax: 0, scrollF: 0.5,
            };
          }
        }
        return item._lines;
      };
      // Sounding progress 0..1 — updated every frame from the audio clock.
      // EveryAyah clips carry ~0.35s leading / ~0.45s trailing silence — skip it
      // so the highlight tracks the voice with no visible delay.
      let hlMode = null; // 'ar' | 'tr' | 'tts' | null
      let hlP = 0;
      let segLive = false; // true from ayah start through meaning end (covers gaps)
      const HL_LEAD = 0.35, HL_TAIL = 0.45;
      const syncHl = () => {
        const fit = (el) => {
          const d = el.duration;
          if (!(d > 0) || !isFinite(d)) return -1;
          const span = d - HL_LEAD - HL_TAIL;
          const p = span > 0.5 ? (el.currentTime - HL_LEAD) / span : el.currentTime / d;
          return clamp01(p);
        };
        if (hlMode === 'ar' && !arAudio.paused) {
          const p = fit(arAudio);
          if (p >= 0) hlP = p;
        } else if (hlMode === 'tr' && !trAudio.paused) {
          const p = fit(trAudio);
          if (p >= 0) hlP = p;
        }
      };
      // Whole-line karaoke: base line first (browser does bidi — same as Ayah Card),
      // then the sounded part re-drawn in accent through a progress clip growing
      // from the reading edge (right for RTL, left otherwise), plus a caret dot.
      const drawHlLine = (text, y, rtl, font, base, accent, prog, alpha, now) => {
        cx.textAlign = 'center';
        cx.font = font;
        cx.globalAlpha = alpha;
        cx.fillStyle = base;
        cx.fillText(text, 1080 / 2, y);
        if (prog > 0.005) {
          const w = cx.measureText(text).width;
          const cx0 = 1080 / 2;
          cx.save();
          cx.beginPath();
          if (rtl) cx.rect(cx0 + w / 2 - prog * w, y - 46, prog * w, 62);
          else cx.rect(cx0 - w / 2, y - 46, prog * w, 62);
          cx.clip();
          cx.fillStyle = accent;
          cx.shadowColor = accent;
          cx.shadowBlur = 16 + 8 * Math.sin(now / 120);
          cx.fillText(text, cx0, y);
          cx.fillText(text, cx0, y);
          cx.restore();
          const ex = rtl ? cx0 + w / 2 - prog * w : cx0 - w / 2 + prog * w;
          cx.fillStyle = accent;
          cx.beginPath();
          cx.arc(ex, y + 14, 7, 0, Math.PI * 2);
          cx.fill();
        }
      };

      // ---- Scroll mode for very long verses: full readable size, slow pan ----
      const VW_TOP = 230, VW_H = 600;
      const scrollCv = document.createElement('canvas');
      let scrollKey = '';
      let scrollY = 0, scrollTarget = 0;
      const renderScroll = (item) => {
        const L = linesFor(item);
        if (!L || L.mode !== 'scroll') return;
        const T = THEMES[themeName()] || THEMES[DEFAULT_THEME];
        const pad = 48;
        const maxStep = Math.max(L.arStep, L.trStep);
        scrollCv.width = 1080;
        scrollCv.height = Math.ceil(pad * 2 + (L.ar.length + L.tr.length + 6) * maxStep + 120);
        const c = scrollCv.getContext('2d');
        c.clearRect(0, 0, scrollCv.width, scrollCv.height);
        c.textAlign = 'center';
        L.arY = []; L.trY = [];
        let y = pad + L.arStep;
        c.font = L.arFont || AR_FONT;
        c.fillStyle = T.ink;
        for (const ln of L.ar) { c.fillText(ln, 540, y); L.arY.push(y); y += L.arStep; }
        const arEnd = y;
        c.fillStyle = T.gold;
        c.fillRect(540 - 60, y - L.arStep + 44, 120, 3);
        y += 66;
        c.font = L.trFont || TR_FONT;
        c.fillStyle = T.mut;
        for (const ln of L.tr) { c.fillText(ln, 540, y); L.trY.push(y); y += L.trStep; }
        const usedH = y + pad;
        L.scrollF = (arEnd + 33) / usedH;
        L.scrollMax = Math.max(0, usedH - VW_H);
      };

      // ---- Animated view state (drives both live preview and recording) ----
      let viewItem = items[0], viewIdx = 0, viewTotal = 1;
      let uiLang = 'en';
      let enteredAt = 0;
      let prevSnap = null; // {item, idx, total, at}
      let isRec = false;
      let recT0 = 0;
      const setView = (item, idx, total) => {
        prevSnap = { item: viewItem, idx: viewIdx, total: viewTotal, at: performance.now() };
        viewItem = item; viewIdx = idx; viewTotal = total;
        enteredAt = performance.now();
        scrollY = 0; scrollTarget = 0;
        flashAt = performance.now();
        try {
          const L0 = linesFor(item);
          if (L0 && L0.mode === 'scroll') prevSnap = null;
        } catch {}
      };
      const refreshAnim = () => { enteredAt = performance.now(); prevSnap = null; scrollKey = ''; };
      const fade = (now, at, dur) => Math.max(0, Math.min(1, (now - at) / dur));

      const orb = (color, x, y, r, alpha) => {
        const g = cx.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, color);
        g.addColorStop(1, 'rgba(255,255,255,0)');
        cx.save();
        cx.globalAlpha = alpha;
        cx.fillStyle = g;
        cx.fillRect(x - r, y - r, r * 2, r * 2);
        cx.restore();
      };
      // Premium ambience: rising light motes + a soft flash on ayah change.
      const motes = [];
      for (let mi = 0; mi < 46; mi++) {
        motes.push({
          x: Math.random() * 1080,
          y: Math.random() * 1080,
          r: 1 + Math.random() * 2.6,
          sp: 6 + Math.random() * 16,
          ph: Math.random() * Math.PI * 2,
          a: 0.05 + Math.random() * 0.09,
        });
      }
      let flashAt = -1e9;
      const bokeh = [];
      for (let bi = 0; bi < 8; bi++) {
        bokeh.push({
          x: Math.random() * 1080,
          y: 200 + Math.random() * 680,
          r: 40 + Math.random() * 50,
          ph: Math.random() * Math.PI * 2,
          sp: 0.10 + Math.random() * 0.12,
        });
      }

      const drawContent = (item, idx, total, now, born, master) => {
        if (master <= 0.01) return;
        const T = THEMES[themeName()] || THEMES[DEFAULT_THEME];
        const W = 1080;
        const L = linesFor(item);
        const staticText = !L.mode || L.mode === 'static';
        cx.save();
        cx.globalAlpha = master;
        cx.textAlign = 'center';
        // ayah counter
        if (total > 1) {
          cx.globalAlpha = master * fade(now, born + 100, 400);
          cx.fillStyle = T.gold;
          cx.font = '700 32px Georgia, serif';
          cx.fillText((idx + 1) + ' / ' + total, W / 2, 196);
          cx.globalAlpha = master;
        }
        // Arabic lines — staggered rise, sounded part sweeps in accent
        let y = total > 1 ? 300 : 310;
        let aOff = 0;
        const aProg = hlMode === 'ar' ? hlP * L.arTotal : -1;
        (staticText ? L.ar.slice(0, 8) : []).forEach((ln, li) => {
          const k = fade(now, born + 150 + li * 110, 450);
          const c = L.arCounts[li] || 1;
          if (k <= 0) { y += (L.arStep || 64); aOff += c; return; }
          const lp = aProg < 0 ? -1 : clamp01((aProg - aOff) / c);
          drawHlLine(ln, y + (1 - k) * 26, true, (L.arFont || AR_FONT), T.ink, T.gold, lp, master * k, now);
          aOff += c;
          y += (L.arStep || 64);
        });
        cx.globalAlpha = master;
        if (staticText) {
        // divider — grows in, gently pulses
        const dk = fade(now, born + 500, 400);
        const pulse = 0.75 + 0.25 * Math.sin(now / 420);
        cx.globalAlpha = master * dk * pulse;
        cx.fillStyle = T.gold;
        const dw = 120 * (0.3 + 0.7 * dk);
        cx.fillRect(W / 2 - dw / 2, y + 6, dw, 3);
        cx.globalAlpha = master;
        y += 60;
        } // end static-only divider
        // translation lines — sounded part sweeps in accent (RTL aware)
        const trActive = hlMode === 'tr' || hlMode === 'tts';
        const tProg = trActive ? hlP * L.trTotal : -1;
        const trRtl = item._dir === 'rtl' || (!item._dir && uiLang === 'ur');
        let tOff = 0;
        (staticText ? L.tr.slice(0, 8) : []).forEach((ln, li) => {
          const k = fade(now, born + 650 + li * 110, 450);
          const c = L.trCounts[li] || 1;
          if (k <= 0) { y += (L.trStep || 58); tOff += c; return; }
          const lp = tProg < 0 ? -1 : clamp01((tProg - tOff) / c);
          drawHlLine(ln, y + (1 - k) * 22, trRtl, L.trFont || TR_FONT, T.mut, T.gold, lp, master * k * (hlMode === 'ar' ? 0.8 : 1), now);
          tOff += c;
          y += (L.trStep || 58);
        });
        // reference + branding
        cx.textAlign = 'center';
        const rk = fade(now, born + 900, 500);
        cx.globalAlpha = master * rk;
        cx.fillStyle = T.gold;
        cx.font = '700 40px Georgia, serif';
        cx.fillText(item.ref, W / 2, 1080 - 150);
        cx.font = '600 28px Georgia, serif';
        cx.fillText('hikmahnoor.in', W / 2, 1080 - 112);
        cx.restore();
      };

      const drawFrame = (now) => {
        const T = THEMES[themeName()] || THEMES[DEFAULT_THEME];
        try { syncHl(); } catch {}
        const W = 1080, H = 1080;
        const t = now / 1000;
        // background
        const g = cx.createLinearGradient(0, 0, W, H);
        g.addColorStop(0, T.bg1); g.addColorStop(1, T.bg2);
        cx.fillStyle = g; cx.fillRect(0, 0, W, H);
        // drifting light orbs — this is what makes it feel like video
        cx.save();
        cx.globalCompositeOperation = 'screen';
        orb(T.gold, W * (0.5 + 0.34 * Math.cos(t * 0.5)), H * (0.40 + 0.30 * Math.sin(t * 0.38)), 460, 0.17);
        orb('#ffffff', W * (0.5 + 0.38 * Math.cos(t * 0.36 + 2.1)), H * (0.58 + 0.32 * Math.sin(t * 0.3 + 1.3)), 360, 0.12);
        orb(T.gold, W * (0.5 + 0.40 * Math.cos(t * 0.28 + 4.2)), H * (0.5 + 0.36 * Math.sin(t * 0.42 + 0.6)), 300, 0.10);
        cx.restore();
        // soft drifting bokeh
        cx.save();
        cx.globalCompositeOperation = 'screen';
        for (const b of bokeh) {
          orb(T.gold, (b.x + Math.cos(t * b.sp + b.ph) * 90 + 1080) % 1080, b.y + Math.sin(t * b.sp * 1.3 + b.ph) * 60, b.r, 0.06);
        }
        orb('#ffffff', W * (0.5 + 0.3 * Math.cos(t * 0.11 + 1)), H * 0.5, 200, 0.05);
        cx.restore();
        // rising light motes
        cx.save();
        for (const m of motes) {
          const myy = (m.y - t * m.sp) % 1080;
          const yy2 = myy < 0 ? myy + 1080 : myy;
          const xx2 = m.x + Math.sin(t * 0.5 + m.ph) * 24;
          cx.globalAlpha = m.a * (0.7 + 0.3 * Math.sin(t * 1.3 + m.ph));
          cx.fillStyle = '#ffffff';
          cx.beginPath();
          cx.arc(xx2, yy2, m.r, 0, Math.PI * 2);
          cx.fill();
        }
        cx.restore();
        // frame + header (frame breathes, wordmark floats)
        cx.save();
        cx.globalAlpha = 0.82 + 0.18 * Math.sin(t * 0.8);
        cx.strokeStyle = T.gold; cx.lineWidth = 6; cx.strokeRect(48, 48, W - 96, H - 96);
        cx.lineWidth = 2; cx.strokeRect(64, 64, W - 128, H - 128);
        cx.restore();
        cx.textAlign = 'center'; cx.fillStyle = T.gold;
        cx.font = '700 44px Georgia, serif';
        cx.fillText('☪ Hikmah Noor', W / 2, 150 + Math.sin(t * 0.9) * 4);
        // previous ayah crossfades out, current fades in
        if (prevSnap && now - prevSnap.at < 450) {
          const k = (now - prevSnap.at) / 450;
          drawContent(prevSnap.item, prevSnap.idx, prevSnap.total, now, prevSnap.at - 10000, 1 - k);
          drawContent(viewItem, viewIdx, viewTotal, now, enteredAt, k);
        } else {
          if (prevSnap && now - prevSnap.at >= 450) prevSnap = null;
          drawContent(viewItem, viewIdx, viewTotal, now, enteredAt, 1);
        }
        // equalizer — dances high while audio sounds, breathes low when idle
        const sounding = hlMode !== null || segLive;
        const bars = 28, bw = 18, bgap = 10;
        let bx = W / 2 - (bars * bw + (bars - 1) * bgap) / 2;
        const by = H - 205;
        cx.fillStyle = T.gold;
        for (let bi = 0; bi < bars; bi++) {
          const amp = sounding ? 30 : 7;
          const bh = Math.max(4, 6 + amp * (0.5 + 0.5 * Math.sin(t * (sounding ? 7 : 1.6) + bi * 0.55)));
          cx.globalAlpha = sounding ? 0.85 : 0.30;
          cx.fillRect(bx, by - bh, bw, bh);
          bx += bw + bgap;
        }
        cx.globalAlpha = 1;
        // Scroll mode: pan the full-size page through a fixed window.
        const SL = viewItem && viewItem._lines;
        if (SL && SL.mode === 'scroll') {
          const key = (viewItem.s || 0) + ':' + (viewItem.v || 0) + ':' + themeName() + ':' + (viewItem._dir || '');
          if (key !== scrollKey) { try { renderScroll(viewItem); scrollKey = key; } catch {} }
          const maxS = Math.max(0, SL.scrollMax || 0);
          const sF = SL.scrollF != null ? SL.scrollF : 0.5;
          if (hlMode === 'ar') scrollTarget = hlP * sF;
          else if (hlMode === 'tr' || hlMode === 'tts') scrollTarget = sF + hlP * (1 - sF);
          scrollY += (scrollTarget * maxS - scrollY) * 0.08;
          const sy = Math.max(0, Math.min(maxS, scrollY));
          try { cx.drawImage(scrollCv, 0, sy, 1080, VW_H, 0, VW_TOP, 1080, VW_H); } catch {}
          // Karaoke overlay: re-draw only the sounding line with a sweep.
          const overlayLine = (ln, lineY, rtl, font, base, prog) => {
            const yy = VW_TOP + (lineY - sy);
            if (yy < VW_TOP - 70 || yy > VW_TOP + VW_H + 70) return;
            drawHlLine(ln, yy, rtl, font, base, T.gold, prog, 1, now);
          };
          if (hlMode === 'ar' && SL.arY) {
            const wp = hlP * SL.arTotal;
            let off = 0;
            for (let li = 0; li < SL.ar.length; li++) {
              const c = SL.arCounts[li] || 1;
              if (wp <= off + c || li === SL.ar.length - 1) {
                overlayLine(SL.ar[li], SL.arY[li], true, SL.arFont || AR_FONT, T.ink, clamp01((wp - off) / c));
                break;
              }
              off += c;
            }
          } else if ((hlMode === 'tr' || hlMode === 'tts') && SL.trY) {
            const wp = hlP * SL.trTotal;
            const rtl = (viewItem._dir === 'rtl') || (!viewItem._dir && uiLang === 'ur');
            let off = 0;
            for (let li = 0; li < SL.tr.length; li++) {
              const c = SL.trCounts[li] || 1;
              if (wp <= off + c || li === SL.tr.length - 1) {
                overlayLine(SL.tr[li], SL.trY[li], rtl, SL.trFont || TR_FONT, T.mut, clamp01((wp - off) / c));
                break;
              }
              off += c;
            }
          }
        }
        // progress bar (surah mode) with travelling sheen
        if (viewTotal > 1) {
          const pw = W - 256;
          cx.fillStyle = 'rgba(255,255,255,.28)';
          cx.fillRect(128, H - 88, pw, 8);
          cx.fillStyle = T.gold;
          cx.fillRect(128, H - 88, pw * ((viewIdx + 1) / viewTotal), 8);
          const sx = 128 + ((t * 140) % (pw + 160)) - 80;
          const sg = cx.createLinearGradient(sx, 0, sx + 60, 0);
          sg.addColorStop(0, 'rgba(255,255,255,0)');
          sg.addColorStop(0.5, 'rgba(255,255,255,.35)');
          sg.addColorStop(1, 'rgba(255,255,255,0)');
          cx.fillStyle = sg;
          cx.fillRect(sx, H - 88, 60, 8);
        }
        // cinematic finish: change flash, travelling sheen, vignette
        const fk = 1 - clamp01((now - flashAt) / 350);
        if (fk > 0) {
          cx.fillStyle = 'rgba(255,255,255,' + (0.10 * fk).toFixed(3) + ')';
          cx.fillRect(0, 0, W, H);
        }
        const cyc = (t % 7 + 7) % 7;
        if (cyc < 1.6) {
          const shx = -500 + (cyc / 1.6) * 2080;
          cx.save();
          cx.translate(shx, 540);
          cx.rotate(-0.35);
          const shg = cx.createLinearGradient(-90, 0, 90, 0);
          shg.addColorStop(0, 'rgba(255,255,255,0)');
          shg.addColorStop(0.5, 'rgba(255,255,255,0.07)');
          shg.addColorStop(1, 'rgba(255,255,255,0)');
          cx.fillStyle = shg;
          cx.fillRect(-90, -900, 180, 1800);
          cx.restore();
        }
        const vg = cx.createRadialGradient(W / 2, H / 2, 380, W / 2, H / 2, 760);
        vg.addColorStop(0, 'rgba(0,0,0,0)');
        vg.addColorStop(1, 'rgba(0,0,0,0.26)');
        cx.fillStyle = vg;
        cx.fillRect(0, 0, W, H);
      };
      const tick = (now) => { try { drawFrame(now || performance.now()); } catch {} requestAnimationFrame(tick); };
      requestAnimationFrame(tick);

      // ---- Verse loading: static /ayah-data first (works offline/locally),
      //      /api/verse fallback — same pattern as Ayah Card ----
      const surahCache = new Map();
      const staticSurah = async (n) => {
        if (!Number.isInteger(n) || n < 1 || n > 114) return null;
        try {
          let j = surahCache.get(n);
          if (!j) {
            const r = await fetch(`/ayah-data/${n}.json`);
            if (!r.ok) return null;
            j = await r.json();
            surahCache.set(n, j);
          }
          return j;
        } catch { return null; }
      };
      const fromRow = (j, n, row, lang) => ({
        ar: row.ar,
        tr: row[lang] || row.en || '',
        ref: `Quran ${n}:${row.v}${j.sname ? ` (${j.sname})` : ''}`,
        s: n, v: Number(row.v),
        dir: lang === 'ur' ? 'rtl' : 'ltr',
      });
      const staticVerse = async (s, v, lang) => {
        const n = Number(s);
        const j = await staticSurah(n);
        if (!j) return null;
        const row = (j.vs || []).find((x) => Number(x.v) === Number(v));
        if (!row || !row.ar) return null;
        return fromRow(j, n, row, lang);
      };
      const fetchVerse = async (s, v, lang) => {
        const r = await fetch(`/api/verse?surah=${encodeURIComponent(s)}&verse=${encodeURIComponent(v)}&lang=${encodeURIComponent(lang)}`);
        if (!r.ok) throw new Error(r.status === 404 ? 'notfound' : 'service');
        const j = await r.json();
        if (!j.ar) throw new Error('notfound');
        return { ar: j.ar, tr: j.text || '', ref: `Quran ${j.surah}:${j.verse}${j.sname ? ` (${j.sname})` : ''}`, s: j.surah, v: j.verse, dir: lang === 'ur' ? 'rtl' : 'ltr' };
      };
      const loadSingle = async (s, v) => {
        const my = ++loadSeq;
        hideErr(); say('');
        setInfo('Loading…');
        const lang = $('[data-av-lang]').value;
        uiLang = lang;
        const d = await staticVerse(s, v, lang);
        if (my !== loadSeq) return;
        if (d) {
          items = [d];
          setInfo('1 ayah loaded — press Preview, then Export video.');
          setView(items[0], 0, 1);
          resetResult();
          return;
        }
        try {
          const f = await fetchVerse(s, v, lang);
          if (my !== loadSeq) return;
          items = [f];
          setInfo('1 ayah loaded — press Preview, then Export video.');
          setView(items[0], 0, 1);
        } catch (e) {
          if (my !== loadSeq) return;
          setInfo('');
          showErr(e && e.message === 'notfound' ? 'Verse not found — check the surah and ayah numbers.' : 'Couldn\u2019t load this verse — check your internet and try again in a moment.');
        }
      };
      const loadSurah = async (n) => {
        const my = ++loadSeq;
        hideErr(); say('');
        const lang = $('[data-av-lang]').value;
        uiLang = lang;
        const count = SURAH_VERSES[n - 1] || 0;
        if (!count) { showErr('Verse not found — check the numbers.'); return; }
        setInfo('Loading ' + count + ' ayahs…');
        const j = await staticSurah(n);
        if (my !== loadSeq) return;
        if (j && (j.vs || []).length) {
          items = j.vs.map((row) => fromRow(j, n, row, lang)).filter((x) => x.ar);
          setInfo(items.length + ' ayahs loaded — press Preview, then Export video.');
          setView(items[0], 0, items.length);
          resetResult();
          return;
        }
        try {
          const out = [];
          for (let v = 1; v <= count; v++) out.push(await fetchVerse(n, v, lang));
          if (my !== loadSeq) return;
          items = out;
          setInfo(count + ' ayahs loaded — press Preview, then Export video.');
          setView(items[0], 0, items.length);
          resetResult();
        } catch (e) {
          if (my !== loadSeq) return;
          setInfo('');
          showErr('Couldn\u2019t load this surah — check your internet and try again in a moment.');
        }
      };

      // ---- Audio helpers ----
      const arAudio = new Audio();
      arAudio.preload = 'auto';
      arAudio.crossOrigin = 'anonymous';
      const trAudio = new Audio();
      trAudio.preload = 'auto';
      trAudio.crossOrigin = 'anonymous';
      const stopAudio = () => {
        try { arAudio.pause(); } catch {}
        try { trAudio.pause(); } catch {}
        try { speechSynthesis.cancel(); } catch {}
      };
      // Prime in background so the next clip starts instantly (this kills the
      // Arabic-end → translation-start lag: the mp3 is already buffered).
      const primeBg = (el, src) => {
        try {
          if (!src || el.getAttribute('src') === src) return;
          el.src = src;
          el.load();
        } catch {}
      };
      // Two-phase playback: wait for data first (big MP3s need time on slow
      // networks), then for the end. On timeout pause, so stray audio can't
      // overlap the next clip.
      const playNow = (el, src, my) => new Promise((res) => {
        if (my !== seq) return res(false);
        let done = false;
        let playTimer = null;
        const fin = (ok) => {
          if (done) return;
          done = true;
          if (playTimer) clearTimeout(playTimer);
          // Failed/clipped clips release their data so the next play refetches.
          if (!ok) { try { el.pause(); el.removeAttribute('src'); el.load(); } catch {} }
          res(ok);
        };
        el.onended = () => fin(true);
        el.onerror = () => fin(false);
        try {
          if (src && el.getAttribute('src') !== src) el.src = src;
          try { el.currentTime = 0; } catch {}
          const p = el.play();
          if (p && p.catch) p.catch(() => fin(false));
        } catch { fin(false); return; }
        // 25s to even start; once started, long recitations get ~3 minutes.
        playTimer = setTimeout(() => {
          try {
            if (el.readyState < 2 && el.paused) fin(false);
            else playTimer = setTimeout(() => fin(false), 170000);
          } catch { fin(false); }
        }, 25000);
      });
      const speakHi = (text, my) => new Promise((res) => {
        if (my !== seq) return res(false);
        try {
          if (!('speechSynthesis' in window)) return res(false);
          speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(text);
          u.lang = 'hi-IN'; u.rate = 0.95;
          try {
            u.onboundary = (e) => {
              try {
                const n = String(text).length || 1;
                hlP = Math.max(0, Math.min(1, (e.charIndex || 0) / n));
              } catch {}
            };
          } catch {}
          u.onend = () => res(true);
          u.onerror = () => res(false);
          speechSynthesis.speak(u);
          setTimeout(() => res(true), 20000);
        } catch { res(false); }
      });
      const wait = (ms, my) => new Promise((res) => {
        const t0 = Date.now();
        const tick2 = () => {
          if (my !== seq) return res(false);
          if (Date.now() - t0 >= ms) return res(true);
          setTimeout(tick2, 60);
        };
        tick2();
      });

      // ---- Recorder ----
      let mediaRec = null;
      let chunks = [];
      let actx = null;
      const pickMime = () => {
        const cands = ['video/mp4', 'video/mp4;codecs=avc1', 'video/webm;codecs=vp9', 'video/webm;codecs=vp8', 'video/webm', ''];
        for (const m of cands) {
          try {
            if (!m) return '';
            if (window.MediaRecorder && MediaRecorder.isTypeSupported(m)) return m;
          } catch {}
        }
        return '';
      };
      // Persistent audio graph (built once): each recitation element feeds the
      // recorder tap AND the speakers through a monitor gain. Export mutes the
      // monitors (silent file work); preview unmutes. A one-shot route used to
      // leave later previews permanently silent — this fixes that.
      let arSrc = null, trSrc = null, arMon = null, trMon = null, recDest = null;
      const ensureGraph = () => {
        try {
          if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
          if (actx.state === 'suspended') actx.resume().catch(() => {});
          if (!recDest) recDest = actx.createMediaStreamDestination();
          if (!arSrc) {
            arSrc = actx.createMediaElementSource(arAudio);
            arMon = actx.createGain(); arMon.gain.value = 1;
            arSrc.connect(recDest); arSrc.connect(arMon); arMon.connect(actx.destination);
          }
          if (!trSrc) {
            trSrc = actx.createMediaElementSource(trAudio);
            trMon = actx.createGain(); trMon.gain.value = 1;
            trSrc.connect(recDest); trSrc.connect(trMon); trMon.connect(actx.destination);
          }
        } catch {}
      };
      const setMonitor = (on) => {
        try {
          ensureGraph();
          const t = actx ? actx.currentTime : 0;
          if (arMon) arMon.gain.setValueAtTime(on ? 1 : 0, t);
          if (trMon) trMon.gain.setValueAtTime(on ? 1 : 0, t);
        } catch {}
      };
      const startRecording = () => {
        chunks = [];
        recBlob = null;
        recMime = pickMime();
        recExt = recMime.indexOf('mp4') >= 0 ? 'mp4' : 'webm';
        ensureGraph();
        setMonitor(false); // silent export — the file still gets full audio
        const stream = cv.captureStream(30);
        const tracks = [...stream.getVideoTracks()];
        try {
          for (const t of recDest.stream.getAudioTracks()) tracks.push(t);
        } catch {}
        const mixed = new MediaStream(tracks);
        mediaRec = recMime ? new MediaRecorder(mixed, { mimeType: recMime }) : new MediaRecorder(mixed);
        mediaRec.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
        mediaRec.start(250);
        isRec = true;
        recT0 = performance.now();
      };
      // Gallery apps read length from the container header. Chrome's WebM writer
      // leaves a wrong Duration there, so galleries clip the length while VLC
      // (which measures the stream) plays full — patch the header value.
      const patchWebmDuration = (blob, seconds) => new Promise((res) => {
        try {
          if (!blob || blob.size < 16) return res(blob);
          const fr = new FileReader();
          fr.onload = () => {
            try {
              const buf = new Uint8Array(fr.result);
              const end = Math.min(buf.length - 12, 8192);
              let infoAt = -1;
              for (let i = 0; i < end - 4; i++) {
                if (buf[i] === 0x15 && buf[i + 1] === 0x49 && buf[i + 2] === 0xA9 && buf[i + 3] === 0x66) { infoAt = i; break; }
              }
              const from = infoAt >= 0 ? infoAt : 0;
              for (let i = from; i < end; i++) {
                if (buf[i] === 0x44 && buf[i + 1] === 0x89 && (buf[i + 2] === 0x84 || buf[i + 2] === 0x88)) {
                  const v = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
                  if (buf[i + 2] === 0x84) v.setFloat32(i + 3, seconds, false);
                  else v.setFloat64(i + 3, seconds, false);
                  return res(new Blob([buf], { type: blob.type }));
                }
              }
              res(blob);
            } catch { res(blob); }
          };
          fr.onerror = () => res(blob);
          fr.readAsArrayBuffer(blob);
        } catch { res(blob); }
      });
      const stopRecording = () => new Promise((res) => {
        isRec = false;
        try {
          if (!mediaRec) return res();
          mediaRec.onstop = () => res();
          mediaRec.stop();
        } catch { res(); }
      });

      const setBusy = (busy, label) => {
        for (const sel of ['[data-av-preview]', '[data-av-record]', '[data-av-load]', '[data-av-loadsurah]', '[data-av-random]']) {
          const b = $(sel);
          if (b) b.disabled = busy;
        }
        if (busy) say(label || 'Working…');
      };
      const paintRecBtn = (label) => {
        const rb = $('[data-av-record]');
        if (rb) rb.textContent = label || 'Export video';
      };
      const showExportBtn = (show) => {
        const rb = $('[data-av-record]');
        if (!rb) return;
        // NOTE: .hn-btn sets display:inline-flex (unlayered), which beats the
        // `hidden` utility — so toggle inline display, not just the class.
        rb.classList.toggle('hidden', !show);
        rb.style.display = show ? '' : 'none';
      };
      const showRunRow = (show) => {
        const r = $('[data-av-row-run]');
        if (!r) return;
        r.classList.toggle('hidden', !show);
        r.style.display = show ? '' : 'none';
      };
      const showDlRow = (show) => {
        const r = $('[data-av-row-dl]');
        if (!r) return;
        r.classList.toggle('hidden', !show);
        r.style.display = show ? '' : 'none';
      };
      // Loading veil over the card while the file renders (HTML overlay —
      // never burned into the video itself).
      const veil = $('[data-av-veil]');
      const veilSub = $('[data-av-veil-sub]');
      const veilBar = $('[data-av-veil-bar]');
      const showVeil = (show, i, n) => {
        if (!veil) return;
        veil.classList.toggle('hidden', !show);
        veil.classList.toggle('flex', !!show);
        if (show) {
          if (veilSub) veilSub.textContent = 'Ayah ' + (i || 1) + ' of ' + (n || items.length);
          if (veilBar && n) veilBar.style.width = Math.round(((i || 1) - 1) / n * 100) + '%';
        }
      };
      const veilProgress = (i, n) => {
        if (veilSub) veilSub.textContent = 'Ayah ' + i + ' of ' + n;
        if (veilBar) veilBar.style.width = Math.round(i / n * 100) + '%';
      };
      const hideVeil = () => {
        if (!veil) return;
        veil.classList.add('hidden');
        veil.classList.remove('flex');
      };
      // New verses in → old exported file is stale: canvas + Export back on.
      const resetResult = () => {
        recBlob = null;
        cv?.classList.remove('hidden');
        if (video) { video.classList.add('hidden'); video.removeAttribute('src'); }
        const dl = $('[data-av-dl]');
        if (dl) dl.disabled = true;
        showExportBtn(true);
        paintRecBtn();
        hideVeil();
        showRunRow(true);
        showDlRow(false);
      };

      const runSequence = async (doRecord) => {
        const my = ++seq;
        stopAudio();
        say('');
        hideErr();
        if (video) { video.classList.add('hidden'); video.removeAttribute('src'); }
        cv?.classList.remove('hidden');
        showExportBtn(true);
        hideVeil();
        if (!doRecord) setMonitor(true);
        const lang = $('[data-av-lang]').value;
        uiLang = lang;
        const trOn = $('[data-av-trvoice]').value !== 'off';
        if (!items.length) { showErr('Load a verse or surah first.'); return; }
        if (doRecord) {
          if (!('MediaRecorder' in window) || !cv.captureStream) {
            say('Video export is not supported in this browser — try Chrome or Safari.', true);
            return;
          }
          setBusy(true, 'Exporting… ' + items.length + ' ayah(s). Keep this tab open and visible.');
          try { startRecording(); } catch {
            say('Could not start the export in this browser.', true);
            paintRecBtn();
            showRunRow(true);
            setBusy(false);
            return;
          }
        } else {
          setBusy(true, 'Previewing ' + items.length + ' ayah(s)…');
        }
        if (doRecord) { showVeil(true, 1, items.length); showRunRow(false); showDlRow(false); }
        // Lead-in so the opening animation is in the file. First Arabic is
        // primed during it so playback starts instantly.
        setView(items[0], 0, items.length);
        primeBg(arAudio, arUrl(items[0].s, items[0].v));
        await wait(900, my);
        for (let i = 0; i < items.length; i++) {
          if (my !== seq) return;
          const it = items[i];
          setView(it, i, items.length);
          segLive = true;
          if (doRecord) {
            setInfo('Exporting video… ayah ' + (i + 1) + ' of ' + items.length);
            paintRecBtn('Exporting… ' + (i + 1) + '/' + items.length);
            veilProgress(i + 1, items.length);
          }
          const turl = (trOn && it.tr && lang !== 'hi') ? trUrl(lang, it.s, it.v) : null;
          if (turl) primeBg(trAudio, turl); // buffer meaning while Arabic plays
          hlMode = 'ar'; hlP = 0;
          const okAr = await playNow(arAudio, arUrl(it.s, it.v), my);
          hlMode = null; hlP = 0;
          if (my !== seq) return;
          if (!okAr) say('Recitation audio needs internet — continuing with animation only.', false);
          await wait(250, my);
          if (my !== seq) return;
          if (trOn && it.tr) {
            if (lang === 'hi') {
              if (!doRecord) { hlMode = 'tts'; hlP = 0; await speakHi(it.tr, my); hlMode = null; hlP = 0; } // preview only: cannot be recorded
              else await wait(1200, my);
            } else if (turl) {
              hlMode = 'tr'; hlP = 0;
              await playNow(trAudio, turl, my);
              hlMode = null; hlP = 0;
            }
            if (my !== seq) return;
            const nxt = items[i + 1];
            if (nxt) primeBg(arAudio, arUrl(nxt.s, nxt.v)); // next Arabic buffers during the pause
            await wait(250, my);
          } else {
            const nxt = items[i + 1];
            if (nxt) primeBg(arAudio, arUrl(nxt.s, nxt.v));
          }
        }
        if (doRecord) {
          await wait(600, my);
          await stopRecording();
          stopAudio();
          hideVeil();
          setMonitor(true);
          if (my !== seq) return;
          try {
            recBlob = new Blob(chunks, { type: recMime || 'video/webm' });
            if (recExt !== 'mp4' && recBlob && recBlob.size) {
              try {
                const ms = Math.max(500, Math.round(performance.now() - recT0));
                recBlob = await patchWebmDuration(recBlob, ms / 1000);
              } catch {}
            }
            if (video && recBlob.size) {
              video.src = URL.createObjectURL(recBlob);
              video.classList.remove('hidden');
            }
            const dl = $('[data-av-dl]');
            if (dl) dl.disabled = !(recBlob && recBlob.size);
            if (recBlob && recBlob.size) {
              cv?.classList.add('hidden');
              showExportBtn(false);
              showRunRow(false);
              showDlRow(true);
            } else {
              paintRecBtn();
              showRunRow(true);
            }
            say(recBlob && recBlob.size ? 'Video ready — play it above, then press Download.' : 'Export failed — try again in Chrome.', !(recBlob && recBlob.size));
            if (recBlob && recBlob.size) setInfo(items.length + (items.length > 1 ? ' ayahs exported — play above, then press Download.' : ' ayah exported — play above, then press Download.'));
          } catch {
            say('Export failed — try again in Chrome.', true);
          }
        } else {
          stopAudio();
          say('');
        }
        paintRecBtn();
        segLive = false;
        setBusy(false);
      };

      // ---- Share / download (same pattern as Ayah Card) ----
      const SHARE_TEXT =
        '🕌 Make your own Ayah Video with Hikmah Noor\n' +
        '🔗 https://hikmahnoor.in/tools/ayah-video/\n\n' +
        '📖 If someone reads this Ayah, you will also be rewarded, so please don\u2019t remove this caption.';
      const SHARE_TITLE = 'Ayah Video — Hikmah Noor';
      const shareFileName = () => 'hikmah-noor-ayah-video.' + recExt;

      // ---- Wiring ----
      const modeRadios = root.querySelectorAll('input[name="av-mode"]');
      const paintMode = () => {
        const m = root.querySelector('input[name="av-mode"]:checked')?.value || 'single';
        $('[data-av-single]')?.classList.toggle('hidden', m !== 'single');
        $('[data-av-surahbox]')?.classList.toggle('hidden', m !== 'surah');
      };
      modeRadios.forEach((r) => r.addEventListener('change', paintMode));
      paintMode();

      $('[data-av-load]')?.addEventListener('click', () => loadSingle($('[data-av-surah]').value, $('[data-av-ayah]').value));
      $('[data-av-random]')?.addEventListener('click', () => {
        const s = 1 + Math.floor(Math.random() * 114);
        const v = 1 + Math.floor(Math.random() * (SURAH_VERSES[s - 1] || 10));
        $('[data-av-surah]').value = s; $('[data-av-ayah]').value = v;
        loadSingle(s, v);
      });
      $('[data-av-loadsurah]')?.addEventListener('click', () => loadSurah(Number($('[data-av-preset]').value)));
      $('[data-av-preset]')?.addEventListener('change', () => {
        const m = root.querySelector('input[name="av-mode"]:checked')?.value || 'single';
        if (m === 'surah') loadSurah(Number($('[data-av-preset]').value));
      });
      $('[data-av-lang]')?.addEventListener('change', () => {
        const m = root.querySelector('input[name="av-mode"]:checked')?.value || 'single';
        if (m === 'surah') loadSurah(Number($('[data-av-preset]').value));
        else loadSingle($('[data-av-surah]').value, $('[data-av-ayah]').value);
      });
      $('[data-av-themes]')?.addEventListener('change', refreshAnim);
      $('[data-av-preview]')?.addEventListener('click', () => runSequence(false));
      $('[data-av-record]')?.addEventListener('click', () => runSequence(true));
      $('[data-av-stop]')?.addEventListener('click', () => { seq++; stopAudio(); try { mediaRec?.stop(); } catch {} isRec = false; hlMode = null; hlP = 0; segLive = false; showExportBtn(true); paintRecBtn(); hideVeil(); setMonitor(true); showRunRow(true); setBusy(false); say(''); });

      $('[data-av-dl]')?.addEventListener('click', () => {
        if (!recBlob) return;
        const a = document.createElement('a');
        a.download = shareFileName();
        a.href = URL.createObjectURL(recBlob);
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 10000);
      });
      // Share removed — Download video is the only result action.
      setView(items[0], 0, 1);
      loadSingle(112, 1);
    })();
  </script>
</BaseLayout>
