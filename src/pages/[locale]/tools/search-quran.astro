---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SearchQuran from '../../../components/SearchQuran.astro';
import AppTabBar from '../../../components/AppTabBar.astro';
import { nonDefaultLocales } from '../../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore/' },
  { name: 'Search Quran', path: '/tools/search-quran/' },
];
---
<BaseLayout title="Search Quran — Translation & Ayaat" description="Search the Quran by translation or Arabic text — Urdu, English and Hindi. Tap any result to open it in the reader." locale={locale} canonicalPath="/tools/search-quran/" crumbs={crumbs} noindex={true} hideFooter>
  <SearchQuran locale={locale} />
  <p class="mx-auto max-w-md px-4 pb-2 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3">English guide — translation coming soon.</p>
  <AppTabBar locale={locale} active="explore" />
</BaseLayout>
