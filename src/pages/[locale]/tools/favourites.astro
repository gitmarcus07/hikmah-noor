---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppHeader from '../../../components/AppHeader.astro';
import SavedList from '../../../components/SavedList.astro';
import AppTabBar from '../../../components/AppTabBar.astro';
import { nonDefaultLocales, getDict } from '../../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = getDict(locale).app;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reading', path: '/tools/read/' },
  { name: 'Favourites', path: '/tools/favourites/' },
];
---
<BaseLayout title="My Favourites — Loved Verses" description="Verses you loved while reading the Quran — your personal favourites, saved to your free account." locale={locale} canonicalPath="/tools/favourites/" crumbs={crumbs} noindex={true} hideFooter>
  <AppHeader locale={locale} title={t.settings.favourites} backHref="/tools/read/" />
  <SavedList locale={locale} mode="favs" />
  <p class="mx-auto max-w-md px-4 pb-2 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3">English guide — translation coming soon.</p>
  <AppTabBar locale={locale} active="reading" />
</BaseLayout>
