---
import { nonDefaultLocales } from '../../../../i18n/utils';
export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const target = `/${locale}/tools/zakat/ushr-guide/`;
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <title>Ushr Guide — moved | Hikmah Noor</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={`https://hikmah-noor.pages.dev${target}`} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
</head>
<body>
  <p>The Ushr guide has moved into the Zakat section. <a href={target}>Continue →</a></p>
  <script define:vars={{ target }}>window.location.replace(target);</script>
</body>
</html>
