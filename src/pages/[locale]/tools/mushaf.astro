---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MushafReader from '../../../components/MushafReader.astro';
import AppTabBar from '../../../components/AppTabBar.astro';
import { nonDefaultLocales } from '../../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore/' },
  { name: 'Mushaf', path: '/tools/mushaf/' },
];
---
<BaseLayout title="Mushaf — Classic Quran Pages" description="Read the Holy Quran in classic Mushaf page format — 604 Madani pages with audio. Free, works offline-friendly." locale={locale} canonicalPath="/tools/mushaf/" crumbs={crumbs} noindex={true} hideFooter>
  <MushafReader locale={locale} />
  <p class="mx-auto max-w-md px-4 pb-2 text-sm font-semibold text-gold-300 bg-gold-300/10 border border-gold-300/30 rounded-2xl px-4 py-3">English guide — translation coming soon.</p>
  <AppTabBar locale={locale} active="explore" />
</BaseLayout>
