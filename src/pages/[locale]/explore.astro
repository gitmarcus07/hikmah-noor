---
/* Explore (locale) — quick access, unified system. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/hn/Breadcrumbs.astro';
import SectionHeader from '../../components/hn/SectionHeader.astro';
import Icon from '../../components/Icon.astro';
import { nonDefaultLocales, localizedPath, getDict } from '../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = getDict(locale).app;
const L = (p: string) => localizedPath(locale, p);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore/' },
];

const CARDS = [
  { title: t.explore.gemsT, sub: t.explore.gemsD, href: L('/tools/gems/'), icon: 'star' },
  { title: 'Quran', sub: '', href: L('/quran/'), icon: 'quran' },
  { title: 'Duas', sub: '', href: L('/duas/'), icon: 'duas' },
  { title: 'Tools', sub: '', href: L('/tools/'), icon: 'tools' },
];
---
<BaseLayout title="Explore — Quranic Gems, Quran, Duas & Tools" description="Explore Hikmah Noor: discover Quranic gems, read the Quran with translation, browse duas, and use Islamic tools." locale={locale} canonicalPath="/explore/" crumbs={crumbs}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3">
      <SectionHeader eyebrow="Explore" title={t.tabs.explore} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {CARDS.map((c) => (
          <a href={c.href} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any} size={22} /></span>
            <span class="min-w-0">
              <span class="block font-extrabold text-[16px] leading-6">{c.title}</span>
              {c.sub && <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">{c.sub}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
