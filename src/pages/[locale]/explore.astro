---
/* Explore (locale) — quick access, unified system. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/hn/Breadcrumbs.astro';
import SectionHeader from '../../components/hn/SectionHeader.astro';
import Icon from '../../components/Icon.astro';
import { nonDefaultLocales, localizedPath, getDict } from '../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = getDict(locale).app;
const L = (p: string) => localizedPath(locale, p);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore/' },
];

const GROUPS = [
  { chip: 'Read', title: 'Read the Quran', cards: [
    { title: t.explore.gemsT, sub: t.explore.gemsD, href: L('/tools/gems/'), icon: 'star' },
  ] },
  { chip: 'Worship', title: 'Duas & worship', cards: [
    { title: 'Hadees', sub: '', href: L('/hadees/'), icon: 'book' },
    { title: 'Tasbih Counter', sub: '', href: L('/tools/tasbih/'), icon: 'tools' },
    { title: 'Prayer Times', sub: '', href: L('/tools/prayer-times/'), icon: 'sun' },
  ] },
  { chip: 'Learn', title: 'Stories, history & guides', cards: [
    { title: 'Aqeedah', sub: '', href: L('/aqeedah/'), icon: 'star' },
    { title: 'Kids Zone', sub: '', href: L('/kids/'), icon: 'heart' },
    { title: 'Seerat un Nabi ﷺ', sub: '', href: L('/seerat/'), icon: 'star' },
    { title: 'Prophets', sub: '', href: L('/prophets/'), icon: 'star' },
    { title: 'Sahaba', sub: '', href: L('/sahaba/'), icon: 'book' },
    { title: 'Women in Islam', sub: '', href: L('/women/'), icon: 'heart' },
    { title: 'Islamic History', sub: '', href: L('/history/'), icon: 'book' },
    { title: 'Names of Allah', sub: '', href: L('/names-of-allah/'), icon: 'star' },
  ] },
  { chip: 'Seasonal', title: 'Ramadan, Hajj & Eid', cards: [
    { title: 'Islamic Calendar', sub: '', href: L('/calendar/'), icon: 'moon' },
    { title: 'Ramadan Guide', sub: '', href: L('/ramadan/'), icon: 'moon' },
    { title: 'Hajj & Umrah Guide', sub: '', href: L('/hajj/'), icon: 'moon' },
    { title: 'Eid & Qurbani', sub: '', href: L('/eid/'), icon: 'moon' },
  ] },
  { chip: 'Tools', title: 'Tools & quizzes', cards: [
    { title: 'Islamic Quizzes', sub: '', href: L('/quiz/'), icon: 'book' },
    { title: 'Mosque Finder', sub: '', href: L('/tools/mosque-finder/'), icon: 'quran' },
    { title: 'Ask a Question', sub: '', href: L('/ask/'), icon: 'book' },
    { title: 'Mirath Calculator', sub: '', href: L('/tools/family-finance/mirath-calculator/'), icon: 'tools' },
    { title: 'Favourites', sub: '', href: L('/favourites/'), icon: 'heart' },
    { title: 'Tools', sub: '', href: L('/tools/'), icon: 'tools' },
  ] },
];
---
<BaseLayout title="Explore — Quranic Gems, Quran, Duas & Tools" description="Explore Hikmah Noor: discover Quranic gems, read the Quran with translation, browse duas, and use Islamic tools." locale={locale} canonicalPath="/explore/" crumbs={crumbs}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3">
      <SectionHeader eyebrow="Explore" title={t.tabs.explore} />
      {GROUPS.map((g) => (
        <div class="mt-6">
          <SectionHeader eyebrow={g.chip} title={g.title} />
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-3">
            {g.cards.map((c) => (
              <a href={c.href} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
                <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any} size={22} /></span>
                <span class="min-w-0">
                  <span class="block font-extrabold text-[16px] leading-6">{c.title}</span>
                  {c.sub && <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">{c.sub}</span>}
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
