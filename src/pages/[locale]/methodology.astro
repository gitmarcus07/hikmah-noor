---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/hn/Breadcrumbs.astro';
import SectionHeader from '../../components/hn/SectionHeader.astro';
import { nonDefaultLocales, localizedPath } from '../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const L = (p: string) => localizedPath(locale, p);

const title = `Methodology — Sources, Grading & Review Process`;
const description = `How Hikmah Noor works: Quran first, named hadith collections with Sahih/Hasan/Daif grades, school differences noted, editorial review dates, and why this is education — not fatwa.`;
const keywords = 'hikmah noor methodology, sources, hadith grading, sahih hasan daif, editorial review, not a fatwa';
const faq = [
  { q: 'Is Hikmah Noor a fatwa site?', a: 'No. Every page is educational. Personal rulings need a qualified scholar who knows your situation — see our Disclaimer.' },
  { q: 'What does Sahih / Hasan / Daif mean?', a: 'Sahih = authentic chain, Hasan = fair/acceptable, Daif = weak. Quranic = direct Quran verse. Scholarly compilation = wording gathered by scholars rather than a hadith text.' },
  { q: 'Why are hadith numbers not listed?', a: 'Editions number hadith differently, so we name the collection qualitatively instead of inventing numbers that may not match your copy.' },
  { q: 'How are school differences handled?', a: 'The page gives the widely-practised position, then notes where schools differ — and asks you to follow your local teacher.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Methodology', path: '/methodology/' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="article" faq={faq} crumbs={crumbs} canonicalPath="/methodology/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">Trust</span>
        <span class="hn-badge">Education — not fatwa</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">How we source & review</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Quran first, named collections, honest grades, school differences noted, and a review date on every guide. If a ruling affects you personally, ask a qualified scholar.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/about/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">About us</a>
        <a href={L('/disclaimer/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">Disclaimer</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Sources" title="Source hierarchy" sub="What we quote, in order." />
      <div class="grid gap-3 sm:grid-cols-2 mt-3">
        <div class="hn-card hn-card-pad">
          <p class="font-extrabold">1. Quran</p>
          <p class="text-sm mt-1 leading-6" style="color:var(--hn-muted)">Verses quoted with surah and number. Translation credits on every Quran page.</p>
        </div>
        <div class="hn-card hn-card-pad">
          <p class="font-extrabold">2. Sahih hadith</p>
          <p class="text-sm mt-1 leading-6" style="color:var(--hn-muted)">Bukhari, Muslim first; then Tirmidhi, Abu Dawud, Nasai, Ibn Majah — collection named, never a fabricated number.</p>
        </div>
        <div class="hn-card hn-card-pad">
          <p class="font-extrabold">3. Companion & classical fiqh</p>
          <p class="text-sm mt-1 leading-6" style="color:var(--hn-muted)">Companion practice and well-known fiqh positions, with the school named where rulings differ.</p>
        </div>
        <div class="hn-card hn-card-pad">
          <p class="font-extrabold">4. Scholarly compilations</p>
          <p class="text-sm mt-1 leading-6" style="color:var(--hn-muted)">Intentions and summaries gathered by scholars — labelled as such, never passed off as hadith.</p>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Grades" title="What the badges mean" sub="Shown on every dua and hadees." />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-3">
        <div class="hn-card hn-card-pad"><span class="hn-badge hn-badge-gold">Quranic</span><p class="text-sm mt-2 leading-6" style="color:var(--hn-muted)">Direct Quran wording.</p></div>
        <div class="hn-card hn-card-pad"><span class="hn-badge">Sahih</span><p class="text-sm mt-2 leading-6" style="color:var(--hn-muted)">Authentic chain — highest confidence.</p></div>
        <div class="hn-card hn-card-pad"><span class="hn-badge">Hasan</span><p class="text-sm mt-2 leading-6" style="color:var(--hn-muted)">Fair and acceptable for practice.</p></div>
        <div class="hn-card hn-card-pad"><span class="hn-badge">Daif</span><p class="text-sm mt-2 leading-6" style="color:var(--hn-muted)">Weak — recite for love of worship, not guaranteed transactions.</p></div>
        <div class="hn-card hn-card-pad"><span class="hn-badge">Scholarly compilation</span><p class="text-sm mt-2 leading-6" style="color:var(--hn-muted)">Scholar-worded, not a hadith text.</p></div>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Review" title="Editorial process" sub="Every guide carries a review date." />
      <div class="hn-card hn-card-pad mt-3 space-y-2 text-[15px] leading-7">
        <p><strong>1. Draft from sources</strong> — writer collects Quran verses + named hadith + school positions.</p>
        <p><strong>2. Grade check</strong> — every dua/hadees gets origin + grade + narrator where confidently known.</p>
        <p><strong>3. Difference note</strong> — school differences added where they change practice.</p>
        <p><strong>4. Review stamp</strong> — page shows reviewed date; corrections via <a href={L('/contact/')} class="font-bold" style="color:var(--hn-primary)">Contact →</a> trigger re-review.</p>
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
  <p class="mx-auto max-w-2xl px-4 pb-2 text-sm font-semibold text-qg-green bg-qg-soft border border-qg-line rounded-2xl px-4 py-3">English guide — translation coming soon.</p>
</BaseLayout>
