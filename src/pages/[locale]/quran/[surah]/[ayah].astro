---
import AyahDetail from '../../../../components/AyahDetail.astro';
import { nonDefaultLocales } from '../../../../i18n/utils';
import { SURAHS, surahBySlug, prevAyah, nextAyah, paraForAyah } from '../../../../lib/quran';
import { TAFSIR } from '../../../../data/tafsir';

const surahFiles = import.meta.glob('../../../../data/surahs/*.json');

export async function getStaticPaths() {
  // Curated static prerender only (~390 pages across hi/ur/ar). Full coverage
  // is served dynamically at the SAME URLs via functions/{hi,ur,ar}/quran
  // (D1 verses_fts) — keeps deploys under the Pages 20k-file limit.
  const wanted = new Set<string>([
    '1:1', '1:2', '1:3', '1:4', '1:5', '1:6', '1:7',
    '2:255', '2:285', '2:286',
    '112:1', '112:2', '112:3', '112:4',
    '113:1', '114:1',
  ]);
  for (const s of SURAHS) wanted.add(s.num + ':1');
  const byNum = new Map(SURAHS.map((s) => [s.num, s]));
  const paths: any[] = [];
  for (const locale of nonDefaultLocales)
    for (const key of wanted) {
      const [sn, vv] = key.split(':');
      const s = byNum.get(Number(sn));
      if (s && Number(vv) >= 1 && Number(vv) <= s.verseCount) {
        paths.push({ params: { locale, surah: s.slug, ayah: String(vv) } });
      }
    }
  return paths;
}
const { locale, surah: surahSlug, ayah: ayahStr } = Astro.params;
const meta = surahBySlug(surahSlug as string)!;
const v = parseInt(ayahStr as string, 10);
const loader = (surahFiles as any)[`../../../../data/surahs/${meta.num}.json`];
const mod = await loader();
const data = (mod as any).default ?? mod;
const verse = data.verses[v - 1];
const prev = prevAyah(meta.num, v);
const next = nextAyah(meta.num, v);
const para = paraForAyah(meta.num, v);
const keyVerses = (TAFSIR as any)[meta.num]?.keyVerses ?? [];
const tafsirNote = keyVerses.find((k: any) => k.v === v)?.note ?? null;
---
<AyahDetail surah={meta} verse={verse} prev={prev} next={next} para={para} tafsirNote={tafsirNote} locale={locale} />
