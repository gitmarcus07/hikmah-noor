---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { nonDefaultLocales, getDict, localizedPath } from '../../i18n/utils';
export async function getStaticPaths() { return nonDefaultLocales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const dict = getDict(locale);
const S = (dict as any).search;
const popular = ['dua', 'quran', 'zakat', 'fitrana', 'surah yaseen', 'mahr', 'wudu', 'livestock'];
const searchUrl = localizedPath(locale, '/search/');
const indexUrl = localizedPath(locale, '/search-index.json');
const ayahUrl = localizedPath(locale, '/search-ayahs.json');
const T = {
  resultsFor: S.resultsFor, resultFor: S.resultFor, typeToFilter: S.typeToFilter,
  noResults: S.noResults, tryDefault: S.tryDefault, orBrowse: S.orBrowse,
  allTools: S.allTools, surahs114: S.surahs114, quranParas: S.quranParas,
  didYouMean: S.didYouMean,
  fAll: S.fAll, fQuran: S.fQuran, fDuas: S.fDuas, fHadith: S.fHadith,
  fGuides: S.fGuides, fNames: S.fNames, fTools: S.fTools, fKalimas: S.fKalimas,
  viewAll: S.viewAll, noMatches: S.noMatches,
};
const FILTERS = [
  { label: T.fAll, cats: '' },
  { label: T.fDuas, cats: 'duas' },
  { label: T.fQuran, cats: 'quran,surahs' },
  { label: T.fHadith, cats: 'hadees' },
  { label: T.fGuides, cats: 'learn' },
  { label: T.fNames, cats: 'names' },
  { label: T.fKalimas, cats: 'kalimas' },
  { label: T.fTools, cats: 'tools' },
];
---
<BaseLayout title={`Search — Hikmah Noor`} description={`Search Islamic articles on Quran, duas, kalimas in ${locale}.`} locale={locale} canonicalPath="/search/" noindex={true}>
<div class="max-w-3xl mx-auto px-4 py-8" data-searchpage data-locale={locale} data-index-url={indexUrl} data-ayah-url={ayahUrl} data-t={JSON.stringify(T)}>
  <h1 class="text-3xl font-extrabold mb-4 text-white">🔍 {dict.nav.search}</h1>
  <form method="get" action={searchUrl} class="flex gap-2" role="search">
    <input id="q" name="q" placeholder={dict.nav.search} autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" aria-label={dict.nav.search} class="flex-1 min-w-0 bg-night-800 border border-white/10 text-ink-50 placeholder:text-ink-500 rounded-2xl px-4 py-3.5 min-h-[52px] outline-none focus:ring-2 ring-brand-400" />
    <button class="bg-brand-500 hover:bg-brand-400 text-night-900 font-bold rounded-2xl px-6 min-h-[52px]">Go</button>
  </form>
  <div class="mt-3 flex flex-wrap gap-2" id="chips">
    {popular.map(p => <button data-q={p} class="text-sm font-semibold bg-night-800 border border-white/10 text-ink-200 hover:border-brand-400 hover:text-brand-300 rounded-full px-4 py-2 min-h-[40px]">{p}</button>)}
  </div>
  <div class="mt-3 flex flex-wrap gap-2" id="typefilter" role="group" aria-label="Filter by type">
    {FILTERS.map((f, i) => <button data-cats={f.cats} class={`text-sm font-bold rounded-full px-4 py-2 min-h-[40px] ${i === 0 ? 'bg-brand-500 text-night-900' : 'bg-night-800 border border-white/10 text-ink-200'}`}>{f.label}</button>)}
  </div>
  <p id="count" class="mt-5 text-sm text-ink-500" aria-live="polite"></p>
  <div id="dym" class="mt-2"></div>
  <div id="results" class="mt-3 space-y-6" aria-live="polite"></div>
</div>
<script>
  import { createIndex, search, didYouMean, ayahNeeded, groupByCategory, escHtml, highlight } from '../../lib/search-engine.js';
  (() => {
    const root = document.querySelector('[data-searchpage]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const locale = root.dataset.locale || 'en';
    const indexUrl = root.dataset.indexUrl || '/search-index.json';
    const ayahUrl = root.dataset.ayahUrl || '/search-ayahs.json';
    const T = JSON.parse(root.dataset.t || '{}');
    const box = root.querySelector('#q');
    const out = root.querySelector('#results');
    const count = root.querySelector('#count');
    const dym = root.querySelector('#dym');
    const chips = root.querySelector('#chips');
    const typeFilter = root.querySelector('#typefilter');
    const typeBtns = [...root.querySelectorAll('#typefilter button')];
    let cats = '';
    let corePayload = null;
    let core = null;
    let ayahsLoaded = false;
    let ayahsLoading = null;
    const loadCore = async () => {
      if (!core) {
        try { corePayload = await (await fetch(indexUrl)).json(); }
        catch { corePayload = null; }
        if (!corePayload) corePayload = { v: 1, locale, cats: [], docs: [], surahs: [], aliases: {} };
        core = createIndex(corePayload, null);
      }
      return core;
    };
    const ensureAyahs = async (q) => {
      const idx = await loadCore();
      if (ayahsLoaded || !ayahNeeded(idx, q)) return;
      if (!ayahsLoading) {
        ayahsLoading = (async () => {
          try {
            const payload = await (await fetch(ayahUrl)).json();
            core = createIndex(corePayload, payload);
          } catch { /* keep core-only */ }
          ayahsLoaded = true;
          ayahsLoading = null;
        })();
      }
      await ayahsLoading;
    };
    const activeTypes = () => cats ? new Set(cats.split(',')) : null;
    const fill = (tpl, m) => String(tpl || '').replace(/\{(\w+)\}/g, (_, k) => m[k] ?? '');
    const paint = (el, on) => {
      el.classList.toggle('bg-brand-500', on);
      el.classList.toggle('text-night-900', on);
      el.classList.toggle('bg-night-800', !on);
      el.classList.toggle('text-ink-200', !on);
    };
    const render = (grouped, total, q, correction) => {
      count.textContent = q ? (total === 1 ? fill(T.resultFor, { q }) : fill(T.resultsFor, { n: total, q })) : fill(T.typeToFilter, { n: core ? core.docs.length : 0 });
      dym.innerHTML = '';
      if (correction) {
        const b = document.createElement('button');
        b.className = 'text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2 min-h-[40px]';
        b.textContent = fill(T.didYouMean, { q: correction });
        b.addEventListener('click', () => { box.value = correction; box.focus(); run(); });
        dym.appendChild(b);
      }
      if (!grouped.length) {
        const L = `/${locale}`;
        out.innerHTML = `<div class="bg-night-850 border border-white/10 rounded-2xl p-5"><p class="font-bold text-ink-50">${escHtml(fill(T.noResults, { q }))}</p>` +
          `<p class="text-sm text-ink-500 mt-1">${escHtml('Try: ' + T.tryDefault + ' — ' + T.orBrowse)}</p>` +
          `<div class="mt-3 flex flex-wrap gap-2">` +
          `<a href="${L}/tools/" class="text-sm font-bold bg-brand-500 text-night-900 rounded-full px-4 py-2">🧰 ${escHtml(T.allTools)}</a>` +
          `<a href="${L}/tools/zakat/zakat-calculator/" class="text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2">Zakat calculator</a>` +
          `<a href="${L}/surahs/" class="text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2">${escHtml(T.surahs114)}</a>` +
          `<a href="${L}/quran/" class="text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2">${escHtml(T.quranParas)}</a></div></div>`;
        return;
      }
      out.innerHTML = '';
      for (const [cat, docs] of grouped) {
        if (cat) {
          const h = document.createElement('h2');
          h.className = 'text-xs font-extrabold uppercase tracking-wide text-ink-500';
          h.textContent = `${cat} (${docs.length})`;
          out.appendChild(h);
        }
        const wrap = document.createElement('div');
        wrap.className = 'space-y-3 mt-2';
        for (const it of docs.slice(0, 8)) {
          const a = document.createElement('a');
          a.href = it.u;
          a.className = 'block bg-night-850 border border-white/10 rounded-2xl p-4 hover:shadow-md hover:border-brand-500/50';
          a.innerHTML = `<span class="flex items-center gap-1.5"><span class="text-[11px] font-bold uppercase text-brand-300 bg-brand-500/15 px-2 py-1 rounded-full">${escHtml(it.c)}</span>` +
            (it.docLocale && it.docLocale !== locale ? `<span class="text-[11px] font-extrabold uppercase text-night-900 bg-gold-300 px-2 py-1 rounded-full">EN</span>` : '') +
            `</span><span class="font-bold block leading-6 mt-2 text-ink-50">${highlight(it.t, q)}</span><span class="text-sm text-ink-300">${highlight(it.d || '', q)}</span>`;
          wrap.appendChild(a);
        }
        out.appendChild(wrap);
      }
    };
    let t = null;
    const run = async () => {
      const raw = box.value.trim();
      const q = raw.toLowerCase().trim();
      if (chips) chips.style.display = q ? 'none' : '';
      if (typeFilter) typeFilter.style.display = q ? 'none' : '';
      await loadCore();
      if (q) await ensureAyahs(q);
      if (!q) {
        const all = core.docs.filter((d) => !cats || activeTypes().has(d.c)).slice(0, 10);
        render([[ '', all ]].filter(([, docs]) => docs.length), all.length, '', null);
        const url = new URL(window.location.href);
        url.searchParams.delete('q');
        history.replaceState(null, '', url.pathname);
        return;
      }
      const ranked = search(core, q, { limit: 48, types: activeTypes() });
      const grouped = groupByCategory(ranked.map((r) => ({ d: r.d })));
      const correction = didYouMean(core, q, ranked[0]?.tier);
      render(grouped, ranked.length, raw, correction);
      const url = new URL(window.location.href);
      url.searchParams.set('q', raw);
      history.replaceState(null, '', url.search);
    };
    typeBtns.forEach((b) => b.addEventListener('click', () => {
      cats = b.dataset.cats || '';
      typeBtns.forEach((x) => paint(x, x === b));
      run();
    }));
    box.addEventListener('input', () => { clearTimeout(t); t = setTimeout(run, 150); });
    chips?.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => { box.value = b.dataset.q; box.focus(); run(); }));
    box.value = new URLSearchParams(window.location.search).get('q') ?? '';
    run();
  })();
</script>
</BaseLayout>
