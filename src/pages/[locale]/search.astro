---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { nonDefaultLocales, getDict, localizedPath } from '../../i18n/utils';
export async function getStaticPaths() { return nonDefaultLocales.map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const dict = getDict(locale);
const popular = ['dua', 'quran', 'zakat', 'fitrana', 'surah yaseen', 'mahr', 'wudu', 'livestock'];
const searchUrl = localizedPath(locale, '/search/');
const indexUrl = localizedPath(locale, '/search-index.json');
---
<BaseLayout title={`Search — Hikmah Noor`} description={`Search Islamic articles on Quran, duas, kalimas in ${locale}.`} locale={locale} canonicalPath="/search/">
<div class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-extrabold mb-4 text-white">🔍 {dict.nav.search}</h1>
  <form method="get" action={searchUrl} class="flex gap-2" role="search">
    <input id="q" name="q" placeholder={dict.nav.search} autocomplete="off" class="flex-1 min-w-0 bg-night-800 border border-white/10 text-ink-50 placeholder:text-ink-500 rounded-2xl px-4 py-3.5 min-h-[52px] outline-none focus:ring-2 ring-brand-400" />
    <button class="bg-brand-500 hover:bg-brand-400 text-night-900 font-bold rounded-2xl px-6 min-h-[52px]">Go</button>
  </form>
  <div class="mt-3 flex flex-wrap gap-2" id="chips">
    {popular.map(p => <button data-q={p} class="text-sm font-semibold bg-night-800 border border-white/10 text-ink-200 hover:border-brand-400 hover:text-brand-300 rounded-full px-4 py-2 min-h-[40px]">{p}</button>)}
  </div>
  <p id="count" class="mt-5 text-sm text-ink-500"></p>
  <div id="results" class="mt-3 space-y-3"></div>
</div>
<script define:vars={{ locale, indexUrl }}>
  (() => {
    const box = document.getElementById('q');
    const out = document.getElementById('results');
    const count = document.getElementById('count');
    const chips = document.getElementById('chips');
    let items = [];
    const load = async () => {
      if (items.length) return items;
      try { items = await (await fetch(indexUrl)).json(); }
      catch { items = []; }
      return items;
    };
    const score = (it, q) => {
      const t = (it.title || '').toLowerCase();
      const d = (it.description || '').toLowerCase();
      let s = 0;
      if (t.startsWith(q)) s += 100;
      else if (t.includes(q)) s += 60;
      if ((it.category || '').toLowerCase().startsWith(q)) s += 25;
      if ((it.tags || []).some(t => String(t).toLowerCase() === q)) s += 40;
      for (const tag of (it.tags || [])) {
        const tl = String(tag).toLowerCase();
        if (tl.startsWith(q)) { s += 30; break; }
        if (tl.includes(q)) { s += 12; break; }
      }
      if (d.includes(q)) s += 8;
      return s;
    };
    const hi = (text, q) => {
      const i = text.toLowerCase().indexOf(q);
      if (i < 0) return text;
      return text.slice(0, i) + '<mark class="bg-gold-300 text-night-900 rounded-sm">' + text.slice(i, i + q.length) + '</mark>' + text.slice(i + q.length);
    };
    const render = (ranked, q) => {
      const list = ranked;
      count.textContent = q ? `${ranked.length} result${ranked.length === 1 ? '' : 's'} for “${q}”` : `${items.length} guides — type to filter`;
      if (list.length) { out.innerHTML = ''; }
      else {
        const L = `/${locale}`;
        out.innerHTML = `<div class="bg-night-850 border border-white/10 rounded-2xl p-5"><p class="font-bold text-ink-50">No results for “${q.replace(/</g, '&lt;')}”.</p>` +
          `<p class="text-sm text-ink-500 mt-1">Try: dua, quran, zakat, fitrana, surah yaseen — or browse:</p>` +
          `<div class="mt-3 flex flex-wrap gap-2">` +
          `<a href="${L}/tools/" class="text-sm font-bold bg-brand-500 text-night-900 rounded-full px-4 py-2">🧰 All finance tools</a>` +
          `<a href="${L}/tools/zakat/zakat-calculator/" class="text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2">Zakat calculator</a>` +
          `<a href="${L}/surahs/" class="text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2">114 Surahs</a>` +
          `<a href="${L}/quran/" class="text-sm font-bold bg-night-800 border border-white/10 text-ink-200 rounded-full px-4 py-2">Quran 30 paras</a></div></div>`;
        return;
      }
      for (const { it } of list) {
        const a = document.createElement('a');
        a.href = it.url;
        a.className = 'block bg-night-850 border border-white/10 rounded-2xl p-4 hover:shadow-md hover:border-brand-500/50';
        a.innerHTML = `<span class="flex items-center gap-1.5"><span class="text-[11px] font-bold uppercase text-brand-300 bg-brand-500/15 px-2 py-1 rounded-full">${it.category}</span>` +
          (it.locale && it.locale !== locale ? `<span class="text-[11px] font-extrabold uppercase text-night-900 bg-gold-300 px-2 py-1 rounded-full">EN</span>` : '') +
          `</span><span class="font-bold block leading-6 mt-2 text-ink-50">${hi(it.title, q)}</span><span class="text-sm text-ink-300">${hi(it.description, q)}</span>`;
        out.appendChild(a);
      }
    };
    let t = null;
    const run = async () => {
      const q = box.value.toLowerCase().trim();
      if (chips) chips.style.display = q ? 'none' : '';
      const all = await load();
      if (!q) {
        render(all.map(it => ({ it, s: 1 })).slice(0, 10), '');
        const url = new URL(window.location.href);
        url.searchParams.delete('q');
        history.replaceState(null, '', url.pathname);
        return;
      }
      const ranked = all.map(it => ({ it, s: score(it, q) })).filter(r => r.s > 0)
        .sort((a, b) => b.s - a.s || a.it.title.localeCompare(b.it.title));
      render(ranked, q);
      const url = new URL(window.location.href);
      url.searchParams.set('q', box.value.trim());
      history.replaceState(null, '', url.search);
    };
    box.addEventListener('input', () => { clearTimeout(t); t = setTimeout(run, 150); });
    document.getElementById('chips')?.querySelectorAll('button').forEach(b =>
      b.addEventListener('click', () => { box.value = b.dataset.q; box.focus(); run(); }));
    const start = new URLSearchParams(window.location.search).get('q') ?? '';
    box.value = start;
    run();
  })();
</script>
</BaseLayout>
