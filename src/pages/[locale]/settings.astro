---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SettingsHub from '../../components/SettingsHub.astro';
import AppTabBar from '../../components/AppTabBar.astro';
import { nonDefaultLocales, getDict } from '../../i18n/utils';

export async function getStaticPaths() { return nonDefaultLocales.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params;
const t = getDict(locale).app;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Settings', path: '/settings/' },
];
---
<BaseLayout title="Settings — Favourites, Notes, Account & Preferences" description="App settings: saved favourites and bookmarks, personal notes, account settings, appearance, language and logout. Free forever." locale={locale} canonicalPath="/settings/" crumbs={crumbs} noindex={true} hideFooter>
  <SettingsHub locale={locale} />
  <AppTabBar locale={locale} active="settings" />
</BaseLayout>
