---
import HadeesDetail from '../../components/HadeesDetail.astro';
import { HADEES, hadeesBySlug } from '../../data/hadees';
import { NAWAWI, nawawiBySlug } from '../../data/hadees-nawawi';
const locale = 'en';
export async function getStaticPaths() {
  return [...HADEES, ...NAWAWI].map((h) => ({ params: { slug: h.slug }, props: { hadeesSlug: h.slug } }));
}
const hadees = hadeesBySlug((Astro.props as any).hadeesSlug) ?? nawawiBySlug((Astro.props as any).hadeesSlug);
---
<HadeesDetail hadees={hadees} locale={locale} />
