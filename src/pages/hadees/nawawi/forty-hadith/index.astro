---
import HadithBook from '../../../../components/HadithBook.astro';
import { hadithCollectionBySlug, hadithBookBySlug } from '../../../../data/hadith-collections';

const collection = hadithCollectionBySlug('nawawi')!;
const book = hadithBookBySlug('nawawi', 'forty-hadith')!;
const locale = 'en';
---
<HadithBook collection={collection} book={book} locale={locale} />
