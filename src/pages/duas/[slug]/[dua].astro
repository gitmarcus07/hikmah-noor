---
import DuaDetail from '../../../components/DuaDetail.astro';
import { DUA_CATS, DUAS } from '../../../data/duas';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const c of DUA_CATS) for (const d of DUAS.filter((x) => x.cat === c.slug)) {
    paths.push({ params: { slug: c.slug, dua: d.slug }, props: { dua: d, cat: c } });
  }
  return paths;
}
const { dua, cat } = Astro.props;
---
<DuaDetail dua={dua} cat={cat} locale="en" />
