---
import DuaHub from '../../components/DuaHub.astro';
import { getCollection } from 'astro:content';
import { localizedPath } from '../../i18n/utils';

const locale = 'en';
const slugOf = (id: string) => id.split('/').pop()!.replace(/\.mdx?$/, '');
const guides = (await getCollection('articles', ({ data }) => !data.draft && data.locale === 'en' && data.category === 'duas'))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .map((a) => ({ title: a.data.title, desc: a.data.description, href: localizedPath('en', `/duas/${slugOf(a.id)}/`) }));
---
<DuaHub locale={locale} guides={guides} popularSlugs={['musa-clarity-speech', 'ask-jannah-refuge-hell', 'starting-journey', 'sayyidul-istighfar', 'ayatul-kursi-salah', 'seeking-knowledge', 'laylatul-qadr', 'for-parents', 'breaking-fast', 'for-the-deceased', 'hasbunallah', 'new-moon-sighting']} />
