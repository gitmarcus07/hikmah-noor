---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import GemsBoard from '../../components/GemsBoard.astro';
import AppTabBar from '../../components/AppTabBar.astro';

const locale = 'en';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Explore', path: '/explore/' },
  { name: 'Quranic Gems', path: '/tools/gems/' },
];
---
<BaseLayout title="Quranic Gems — Verses for Every Heart" description="Quranic gems by topic — patience, gratitude, forgiveness, fear, love and more. Tap a topic to read its verses." locale={locale} canonicalPath="/tools/gems/" crumbs={crumbs} noindex={true} hideFooter>
  <AppHeader locale={locale} title="Quranic Gems" />
  <GemsBoard locale={locale} />
  <AppTabBar locale={locale} active="explore" />
</BaseLayout>
