---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import { getDict } from '../../i18n/utils';

const locale = 'en';
const faq = [
  { q: 'Where do mosque locations come from?', a: 'OpenStreetMap places of worship tagged Muslim, fetched live for your area. Coverage is excellent in cities and thinner in villages — missing mosques can be added free at openstreetmap.org.' },
  { q: 'Is the distance exact?', a: 'Straight-line distance from your position. Roads and gates add walking time — tap a mosque to open walking directions.' },
  { q: 'Does this work offline?', a: 'No — finding nearby mosques needs internet for the live map data. Save this page while online; your last search stays visible.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: 'Mosque Finder', path: '/tools/mosque-finder/' },
];
---
<BaseLayout title="Mosque Finder — Nearby Masjids with Distance & Directions" description="Find mosques near you: live OpenStreetMap search by GPS or city, straight-line distance, prayer-time note and one-tap walking directions." keywords="mosque near me, masjid finder, nearby mosque, masjid directions, jumuah mosque near me" locale={locale} canonicalPath="/tools/mosque-finder/" faq={faq} crumbs={crumbs}>
  <AppHeader locale={locale} title="Mosque Finder" backHref="/tools/" />
  <div class="max-w-md mx-auto px-4 py-5" data-mf>
    <p class="text-center text-[15px] leading-6" style="color:var(--hn-muted)">Masjids near you, from the live OpenStreetMap — with distance and directions.</p>

    <div class="mt-4 hn-card hn-card-pad">
      <p class="hn-block-label">Location</p>
      <div class="flex gap-2">
        <button data-mf-gps class="hn-btn hn-btn-primary flex-1 !min-h-[48px] text-sm">📍 Use my location</button>
        <select data-mf-radius class="hn-input !w-[130px]" aria-label="Search radius">
          <option value="2000">2 km</option>
          <option value="5000" selected>5 km</option>
          <option value="10000">10 km</option>
          <option value="25000">25 km</option>
        </select>
      </div>
      <details class="mt-2">
        <summary class="text-[13px] font-bold cursor-pointer" style="color:var(--hn-primary)">Search by coordinates</summary>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <input data-mf-lat inputmode="decimal" placeholder="Latitude" class="hn-input" aria-label="Latitude" />
          <input data-mf-lng inputmode="decimal" placeholder="Longitude" class="hn-input" aria-label="Longitude" />
        </div>
        <button data-mf-custom class="hn-btn hn-btn-secondary w-full !min-h-[48px] text-sm mt-2">Search here</button>
      </details>
      <p class="mt-2 text-[13px] font-bold" style="color:var(--hn-muted)" data-mf-status>Allow location to begin.</p>
    </div>

    <div class="mt-3 grid gap-3" data-mf-list></div>

    <p class="mt-3 text-[12.5px] leading-5 text-center" style="color:var(--hn-muted)">Data: © OpenStreetMap contributors. Verify prayer times with the mosque — then save its location.</p>

    <section class="mt-8" aria-label="Frequently asked questions">
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-mf]');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = '1';
      const $ = (s) => root.querySelector(s);
      const status = $('[data-mf-status]');
      const list = $('[data-mf-list]');
      const say = (t) => { if (status) status.textContent = t; };
      const dist = (a, b, c, d) => {
        const R = 6371, D = Math.PI / 180;
        const h = Math.sin((c - a) * D / 2) ** 2 + Math.cos(a * D) * Math.cos(c * D) * Math.sin((d - b) * D / 2) ** 2;
        return 2 * R * Math.asin(Math.sqrt(h));
      };
      const esc = (s) => String(s || '').replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
      const render = (lat, lng, els) => {
        if (!els.length) {
          list.innerHTML = `<div class="hn-card hn-card-pad text-center text-[15px]" style="color:var(--hn-muted)">No tagged mosques in range — widen the radius, or add yours free at openstreetmap.org.</div>`;
          say(`Done — 0 mosques in range.`);
          return;
        }
        const rows = els
          .map((e) => ({ name: (e.tags && (e.tags.name || e.tags['name:en'])) || 'Masjid', lat: e.lat, lon: e.lon, d: dist(lat, lng, e.lat, e.lon) }))
          .sort((a, b) => a.d - b.d)
          .slice(0, 30);
        list.innerHTML = rows.map((r) => `
          <a class="hn-card hn-card-hover hn-card-pad flex items-center gap-3" target="_blank" rel="noopener" href="https://www.openstreetmap.org/directions?to=${r.lat}%2C${r.lon}">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px] font-extrabold" style="background:var(--hn-primary-soft);color:var(--hn-primary)">☪</span>
            <span class="min-w-0 flex-1">
              <span class="block font-extrabold text-[16px] leading-6 truncate">${esc(r.name)}</span>
              <span class="block mt-0.5 text-[13.5px]" style="color:var(--hn-muted)">${r.d < 1 ? Math.round(r.d * 1000) + ' m away' : r.d.toFixed(1) + ' km away'} · Directions →</span>
            </span>
          </a>`).join('');
        say(`Done — ${rows.length} mosque${rows.length === 1 ? '' : 's'} found.`);
        try { localStorage.setItem('hn.mosques.v1', list.innerHTML); } catch {}
      };
      const search = async (lat, lng) => {
        const r = Number($('[data-mf-radius]').value || 5000);
        say('Searching nearby mosques…');
        list.innerHTML = '';
        const q = `[out:json][timeout:20];(node[amenity=place_of_worship][religion=muslim](around:${r},${lat},${lng});way[amenity=place_of_worship][religion=muslim](around:${r},${lat},${lng}););out center 60;`;
        try {
          const res = await fetch('https://overpass-api.de/api/interpreter?data=' + encodeURIComponent(q));
          if (!res.ok) throw new Error('bad');
          const j = await res.json();
          const els = (j.elements || []).map((e) => e.type === 'node' ? e : { ...e, lat: e.center?.lat, lon: e.center?.lon }).filter((e) => e.lat != null);
          render(lat, lng, els);
        } catch {
          say('Search failed — check internet and try again.');
        }
      };
      try {
        const cached = localStorage.getItem('hn.mosques.v1');
        if (cached) { list.innerHTML = cached; say('Showing your last search (offline copy).'); }
      } catch {}
      $('[data-mf-gps]').addEventListener('click', () => {
        if (!navigator.geolocation) { say('Geolocation not supported on this device.'); return; }
        say('Locating…');
        navigator.geolocation.getCurrentPosition(
          (p) => search(p.coords.latitude, p.coords.longitude),
          () => say('Location denied — enter coordinates manually.'),
          { timeout: 12000 }
        );
      });
      $('[data-mf-custom]').addEventListener('click', () => {
        const la = parseFloat($('[data-mf-lat]').value), ln = parseFloat($('[data-mf-lng]').value);
        if (!isFinite(la) || !isFinite(ln) || Math.abs(la) > 90 || Math.abs(ln) > 180) { say('Enter valid coordinates.'); return; }
        search(la, ln);
      });
    })();
  </script>
</BaseLayout>
