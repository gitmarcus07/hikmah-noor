---
import { getDict } from '../../i18n/utils';
const locale = 'en';
const dict = getDict(locale);
const target = '/tools/zakat/zakat-calculator/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{dict.home.zakatTitle} — moved | Hikmah Noor</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={`https://hikmahnoor.in${target}`} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
</head>
<body>
  <p>Our zakat calculator has moved to a bigger tools section. <a href={target}>Continue to the new Zakat Calculator →</a></p>
  <script>window.location.replace('/tools/zakat/zakat-calculator/');</script>
</body>
</html>
