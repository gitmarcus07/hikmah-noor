---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/hn/Breadcrumbs.astro';
import SectionHeader from '../../components/hn/SectionHeader.astro';
import Icon from '../../components/Icon.astro';
import { localizedPath } from '../../i18n/utils';
import { CATS, toolsByCat, TOOLS } from '../../lib/finance/tools.js';

const locale = 'en';
const L = (p: string) => localizedPath(locale, p);
const faq = [
  { q: 'Which Islamic finance tool do I need?', a: 'Start with the Obligations Guide: zakat tools for annual wealth dues, fidyah/kaffarah tools for fasts and oaths, family tools for mahr and maintenance, and classical references for khums, ushr, jizya and kharaj.' },
  { q: 'Are these calculators a fatwa?', a: 'No. Every tool gives an educational estimate with its evidence and school differences. For complex cases, consult a qualified scholar.' },
  { q: 'Do I owe jizya or kharaj today?', a: 'No. Those were historical state levies, not personal worship dues — their pages are educational references.' },
];
---
<BaseLayout title="Islamic Finance Tools — Zakat, Fidyah, Kaffarah, Mahr & Khums Calculators" description="Free Islamic finance tools: zakat (gold, silver, cash, business, agriculture, livestock, fitr), fidyah, kaffarah, mahr, nafaqah and khums calculators with evidence." keywords="islamic finance tools, zakat calculator, fidyah calculator, kaffarah calculator, mahr planner, khums calculator, ushr jizya kharaj" locale={locale} canonicalPath="/tools/" faq={faq} crumbs={[{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }]}>
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={[{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }]} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">{TOOLS.length} free tools</span>
        <span class="hn-badge">{CATS.length} categories</span>
        <span class="hn-badge">With evidence</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Islamic Finance Tools</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Separate calculators for separate obligations — zakat by asset type, fidyah and kaffarah by situation, family planners, and classical references. Every result shows its breakdown, evidence and school differences.</p>
    </div>

    <div class="mt-6">
      <SectionHeader eyebrow="Tools" title="Pick a category" sub="Each opens a page with all its tools." />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {CATS.map((c) => {
        const list = toolsByCat(c.slug);
        const preview = list.slice(0, 3).map((t) => t.title.split('—')[0].trim());
        return (
        <a href={L(`/tools/${c.slug}/`)} class="hn-card hn-card-hover hn-card-pad flex flex-col gap-3 min-h-[200px]">
          <span class="flex items-center gap-3">
            <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={c.icon as any || 'tools'} size={22} /></span>
            <span class="min-w-0 flex-1">
              <span class="font-extrabold block text-[17px] leading-7">{c.title}</span>
              <span class="hn-badge mt-1">{list.length} tools</span>
            </span>
          </span>
          <span class="text-sm leading-6" style="color:var(--hn-muted)">{c.desc}</span>
          <span class="flex flex-wrap gap-1.5 mt-auto pt-1">
            {preview.map((p) => <span class="hn-badge">{p}</span>)}
            {list.length > 3 && <span class="text-[12px] font-extrabold px-2 py-1.5" style="color:var(--hn-primary)">+{list.length - 3} more →</span>}
          </span>
        </a>
        );
      })}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="More" title="More free tools" sub="Worship tools beyond finance — no account needed." />
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={L('/tools/prayer-times/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="sun" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Prayer Times</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Namaz times, Qibla & Hijri date</span>
          </span>
        </a>
        <a href={L('/tools/my-progress/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="star" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">My Progress</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Streak, hasanat and challenges</span>
          </span>
        </a>
        <a href={L('/tools/tasbih/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="tools" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Tasbih Counter</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Dhikr with 33/100 goals and daily totals</span>
          </span>
        </a>
        <a href={L('/tools/ramadan-countdown/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="moon" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Ramadan Countdown</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Days left to Ramadan with Hijri date</span>
          </span>
        </a>
        <a href={L('/tools/qibla/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="quran" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Qibla Finder</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Exact Qibla direction with live compass</span>
          </span>
        </a>
        <a href={L('/tools/prayer-tracker/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="clock" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Prayer Tracker</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Daily salah log with streaks</span>
          </span>
        </a>
        <a href={L('/tools/khatm-planner/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="book" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Khatm Planner</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Daily pages schedule to finish the Quran</span>
          </span>
        </a>
        <a href={L('/calendar/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="moon" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Islamic Calendar</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Hijri month view, sacred dates & countdowns</span>
          </span>
        </a>
        <a href={L('/tools/hijri-converter/')} class="hn-card hn-card-hover hn-card-pad flex items-center gap-3.5">
          <span class="w-11 h-11 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name="moon" size={22} /></span>
          <span class="min-w-0">
            <span class="block font-extrabold text-[16px] leading-6">Hijri Converter</span>
            <span class="block mt-0.5 text-[13.5px] leading-5" style="color:var(--hn-muted)">Gregorian to Islamic date with Hijri today</span>
          </span>
        </a>
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
