---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppHeader from '../../components/AppHeader.astro';
import { localizedPath, getDict } from '../../i18n/utils';
import surahsMeta from '../../data/surahs-meta.json';
import parasMeta from '../../data/paras-meta.json';

const locale = 'en';
const t = getDict(locale).app;
const readBase = localizedPath(locale, '/tools/read/');
const surahData = (surahsMeta as any[]).map((s) => [s.num, s.name, s.englishName, s.verseCount]);
const juzData = (parasMeta as any[]).map((p: any) => [p.num, p.start.surah, p.start.verse]);
const faq = [
  { q: 'Is reading free?', a: 'Yes — every surah is free to read with translation, transliteration and audio. No account needed.' },
  { q: 'Where do I continue from?', a: 'Pick your surah and verse below — the buttons remember your last spot on this device.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: 'Read', path: '/tools/read/' },
];
---
<BaseLayout title="Read Quran Online — All Surahs with Translation, Transliteration & Audio" description="Read all 114 surahs in Arabic with Urdu, English and Hindi translation, transliteration and audio recitation. Free to read, no signup needed." keywords="read quran online, surah with translation, quran transliteration, quran audio, read surah" locale={locale} canonicalPath="/tools/read/" faq={faq} crumbs={crumbs} hideFooter>
  <AppHeader locale={locale} title={t.tabs.reading} backHref="/tools/" />
  <div class="max-w-md mx-auto px-4 py-5" data-reading>
    <p class="text-center text-[17px] font-bold text-qg-ink leading-7">Choose a surah below — read in Arabic with translation, transliteration and audio.</p>

    {/* surah selector */}
    <button data-r-surahbtn class="mt-4 w-full flex items-center gap-3 text-start bg-white hover:bg-qg-soft active:scale-[0.99] border border-qg-line shadow-sm rounded-3xl p-5 min-h-[76px] transition">
      <span class="min-w-0 flex-1">
        <span data-r-surahtitle class="block text-[22px] font-extrabold text-qg-ink truncate">Al-Faatiha</span>
        <span data-r-surahsub class="block text-[15px] text-qg-muted">The Opening | 7 Verses</span>
      </span>
      <span class="text-qg-nav text-3xl leading-none" aria-hidden="true">›</span>
    </button>

    {/* verse selector */}
    <button data-r-versebtn class="mt-3 w-full flex items-center gap-3 text-start bg-white hover:bg-qg-soft active:scale-[0.99] border border-qg-line shadow-sm rounded-3xl p-5 min-h-[76px] transition">
      <span class="min-w-0 flex-1">
        <span class="block text-[22px] font-extrabold text-qg-ink">Start from Verse</span>
        <span data-r-versesub class="block text-[15px] text-qg-muted">1 Verse</span>
      </span>
      <span class="text-qg-nav text-3xl leading-none" aria-hidden="true">›</span>
    </button>

    {/* start */}
    <a data-r-start href={`${readBase}1/?verse=1`} class="mt-3 flex items-center justify-center rounded-full border-2 border-qg-green hover:bg-qg-soft active:scale-[0.99] text-qg-green text-lg font-bold px-6 py-3.5 min-h-[56px] transition">Start Reading Quran</a>

    {/* all surahs */}
    <h2 class="mt-8 text-xl font-extrabold text-qg-ink">All Surahs</h2>
    <input data-r-filter placeholder="Search surah — name or number…" class="mt-3 w-full bg-white border border-qg-line shadow-sm rounded-2xl px-5 py-3.5 min-h-[52px] text-qg-ink placeholder:text-qg-muted outline-none focus:ring-2 focus:ring-qg-green/40 focus:border-qg-green" />
    <div class="mt-3 space-y-2">
      {(surahsMeta as any[]).map((s) => (
        <a href={localizedPath(locale, `/tools/read/${s.num}/`)} data-search={`${s.num} ${s.name} ${s.englishName}`} class="rrow group bg-white border border-qg-line shadow-sm rounded-2xl px-4 py-3 min-h-[60px] flex items-center gap-3 hover:border-qg-green/50 transition">
          <span class="w-9 h-9 shrink-0 grid place-items-center rounded-xl bg-qg-deep text-white font-extrabold text-sm">{s.num}</span>
          <span class="min-w-0 flex-1">
            <span class="font-bold block leading-6 text-qg-ink group-hover:text-qg-green truncate">Surah {s.name}</span>
            <span class="text-xs text-qg-muted">{s.englishName} • {s.verseCount} verses</span>
          </span>
          <span class="text-qg-muted text-2xl leading-none" aria-hidden="true">›</span>
        </a>
      ))}
    </div>
  </div>

  {/* surah bottom sheet — Juz / Chapter picker */}
  <div data-r-surahsheet class="hidden fixed inset-0 z-[70]" role="dialog" aria-modal="true" aria-label="Choose Surah">
    <div class="absolute inset-0 bg-black/70" data-r-close></div>
    <div class="absolute inset-x-0 bottom-0 mx-auto max-w-md bg-white border border-qg-line rounded-t-[28px] p-4 max-h-[80dvh] flex flex-col" style="padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));">
      <div class="mx-auto w-10 h-1 rounded-full bg-qg-line mb-3" aria-hidden="true"></div>
      <div class="grid grid-cols-2 gap-0 rounded-full p-0" role="tablist" aria-label="Juz or Chapter">
        <button data-r-tab-juz role="tab" aria-selected="false" class="rounded-full px-4 py-2.5 text-[19px] font-extrabold transition min-h-[48px] text-qg-ink">Juz</button>
        <button data-r-tab-chapter role="tab" aria-selected="true" class="rounded-full px-4 py-2.5 text-[19px] font-extrabold transition min-h-[48px] bg-qg-deep/10 text-qg-deep">Chapter</button>
      </div>
      <div data-r-chapterlist class="mt-3 overflow-y-auto space-y-2.5 pe-1"></div>
      <div data-r-juzlist class="hidden mt-3 overflow-y-auto space-y-2.5 pe-1"></div>
    </div>
  </div>

  {/* verse bottom sheet — Select Verse with search */}
  <div data-r-versesheet class="hidden fixed inset-0 z-[70]" role="dialog" aria-modal="true" aria-label="Choose Verse">
    <div class="absolute inset-0 bg-black/70" data-r-close></div>
    <div class="absolute inset-x-0 bottom-0 mx-auto max-w-md bg-white border border-qg-line rounded-t-[28px] p-4 max-h-[80dvh] flex flex-col" style="padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));">
      <div class="mx-auto w-10 h-1 rounded-full bg-qg-line mb-3" aria-hidden="true"></div>
      <p class="text-center font-extrabold text-[19px] text-qg-ink">Select Verse</p>
      <div class="mt-3 relative">
        <span class="absolute start-4 top-1/2 -translate-y-1/2 text-qg-muted text-xl" aria-hidden="true">⌕</span>
        <input data-r-versefilter placeholder="Search" inputmode="numeric" class="w-full bg-transparent border border-qg-line rounded-full ps-11 pe-4 py-3 min-h-[52px] text-qg-ink placeholder:text-qg-muted outline-none focus:ring-2 focus:ring-qg-green/40 focus:border-qg-green" />
      </div>
      <div data-r-verselist class="mt-3 overflow-y-auto grid grid-cols-5 gap-2 pe-1"></div>
    </div>
  </div>

  <script define:vars={{ readBase, surahData, juzData }}>
    (() => {
      const root = document.querySelector('[data-reading]');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = '1';
      const $ = (s) => root.querySelector(s);
      const sheet$ = (s) => document.querySelector(s);
      let surah = 1, verse = 1, surahTab = 'chapter', verseQuery = '';

      const meta = (n) => {
        const m = surahData[n - 1];
        return m ? { num: m[0], name: m[1], english: m[2], count: m[3] } : { num: n, name: `Surah ${n}`, english: '', count: 0 };
      };
      const paintSelection = () => {
        const m = meta(surah);
        if ($('[data-r-surahtitle]')) $('[data-r-surahtitle]').textContent = m.name;
        if ($('[data-r-surahsub]')) $('[data-r-surahsub]').textContent = `${m.english} | ${m.count} Verses`;
        if ($('[data-r-versesub]')) $('[data-r-versesub]').textContent = `${verse} Verse${verse > 1 ? 's' : ''}`;
        const st = $('[data-r-start]');
        if (st) st.href = `${String(readBase).replace(/\/$/, '')}/${surah}/?verse=${verse}`;
      };

      const openSheet = (sel) => {
        const el = document.querySelector(sel);
        if (!el) return;
        el.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };
      const closeSheets = () => {
        document.querySelectorAll('[data-r-surahsheet],[data-r-versesheet]').forEach((el) => el.classList.add('hidden'));
        document.body.style.overflow = '';
      };
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheets(); });
      document.querySelectorAll('[data-r-close]').forEach((b) => b.addEventListener('click', closeSheets));

      const DL_ICON = '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>';

      const paintSurahTabs = () => {
        const tj = sheet$('[data-r-tab-juz]');
        const tc = sheet$('[data-r-tab-chapter]');
        const on = 'rounded-full px-4 py-2.5 text-[19px] font-extrabold transition min-h-[48px] bg-qg-deep/10 text-qg-deep';
        const off = 'rounded-full px-4 py-2.5 text-[19px] font-extrabold transition min-h-[48px] text-qg-ink';
        if (tj) { tj.className = surahTab === 'juz' ? on : off; tj.setAttribute('aria-selected', String(surahTab === 'juz')); }
        if (tc) { tc.className = surahTab === 'chapter' ? on : off; tc.setAttribute('aria-selected', String(surahTab === 'chapter')); }
        const cl = sheet$('[data-r-chapterlist]');
        const jl = sheet$('[data-r-juzlist]');
        if (cl) cl.classList.toggle('hidden', surahTab !== 'chapter');
        if (jl) jl.classList.toggle('hidden', surahTab !== 'juz');
      };

      const renderChapterList = () => {
        const box = sheet$('[data-r-chapterlist]');
        if (!box) return;
        box.innerHTML = surahData.map((m) => {
          const active = m[0] === surah;
          return `
          <button data-pick-surah="${m[0]}" class="w-full flex items-center gap-3 text-start rounded-2xl px-5 py-3.5 min-h-[72px] transition ${active ? 'bg-qg-deep/10 border-2 border-qg-green' : 'bg-qg-bg border-2 border-transparent hover:border-qg-line'}">
            <span class="min-w-0 flex-1">
              <span class="block font-extrabold text-[19px] leading-6 ${active ? 'text-qg-deep' : 'text-qg-ink'}">${m[0]}. ${m[1]}</span>
              <span class="block text-[15px] ${active ? 'text-qg-deep/80' : 'text-qg-muted'}">${m[2]}</span>
            </span>
            <span class="shrink-0 text-[15px] font-medium ${active ? 'text-qg-deep/90' : 'text-qg-muted'}">${m[3]} Verses</span>
            <span class="shrink-0 ${active ? 'text-qg-deep' : 'text-qg-green'}" aria-hidden="true">${DL_ICON}</span>
          </button>`;
        }).join('');
        box.querySelectorAll('[data-pick-surah]').forEach((b) => b.addEventListener('click', () => {
          surah = Number(b.dataset.pickSurah);
          verse = verse <= meta(surah).count ? verse : 1;
          paintSelection();
          renderChapterList();
          closeSheets();
        }));
      };

      const renderJuzList = () => {
        const box = sheet$('[data-r-juzlist]');
        if (!box) return;
        box.innerHTML = juzData.map((j) => `
          <button data-pick-juz="${j[0]}" class="w-full text-start rounded-2xl px-5 py-4 min-h-[60px] transition bg-qg-bg border-2 border-transparent hover:border-qg-line">
            <span class="block font-extrabold text-[19px] text-qg-ink">Juz ${j[0]}</span>
          </button>`).join('');
        box.querySelectorAll('[data-pick-juz]').forEach((b) => b.addEventListener('click', () => {
          const j = juzData.find((x) => x[0] === Number(b.dataset.pickJuz));
          if (j) { surah = Math.min(114, Math.max(1, j[1])); verse = Math.max(1, j[2] || 1); }
          paintSelection();
          renderChapterList();
          closeSheets();
        }));
      };

      const renderVerseGrid = (q = '') => {
        const box = sheet$('[data-r-verselist]');
        if (!box) return;
        const m = meta(surah);
        const query = String(q || '').trim();
        let nums = [];
        for (let v = 1; v <= m.count; v++) nums.push(v);
        if (query) nums = nums.filter((v) => String(v).includes(query));
        box.innerHTML = nums.length ? nums.map((v) => `
          <button data-pick-verse="${v}" class="min-h-[52px] rounded-2xl font-extrabold text-[19px] transition ${v === verse ? 'bg-qg-deep text-white border-2 border-qg-deep' : 'bg-qg-bg text-qg-ink border-2 border-transparent hover:border-qg-line'}">${v}</button>`
        ).join('') : `<p class="col-span-5 text-center text-sm text-qg-muted py-6">No verse matches “${query}”.</p>`;
        box.querySelectorAll('[data-pick-verse]').forEach((b) => b.addEventListener('click', () => {
          verse = Number(b.dataset.pickVerse);
          paintSelection();
          closeSheets();
        }));
      };

      sheet$('[data-r-tab-juz]')?.addEventListener('click', () => { surahTab = 'juz'; paintSurahTabs(); });
      sheet$('[data-r-tab-chapter]')?.addEventListener('click', () => { surahTab = 'chapter'; paintSurahTabs(); });
      $('[data-r-surahbtn]')?.addEventListener('click', () => {
        surahTab = 'chapter';
        paintSurahTabs();
        renderChapterList();
        renderJuzList();
        openSheet('[data-r-surahsheet]');
      });
      $('[data-r-versebtn]')?.addEventListener('click', () => {
        verseQuery = '';
        const f = sheet$('[data-r-versefilter]');
        if (f) f.value = '';
        renderVerseGrid('');
        openSheet('[data-r-versesheet]');
      });
      sheet$('[data-r-versefilter]')?.addEventListener('input', (e) => renderVerseGrid(e.target.value));
      root.querySelector('[data-r-filter]')?.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        root.querySelectorAll('.rrow').forEach((r) => r.classList.toggle('hidden', q !== '' && !(r.dataset.search || '').toLowerCase().includes(q)));
      });

      paintSelection();
      renderChapterList();
      renderJuzList();
    })();
  </script>
</BaseLayout>
