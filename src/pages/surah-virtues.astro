---
/* Surah Virtues (Fazail) hub — which surah to read and when, with authentic hadith.
 * Occasion matrix + virtue guides (new) + existing surah spotlight guides. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/hn/Breadcrumbs.astro';
import SectionHeader from '../components/hn/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { localizedPath } from '../i18n/utils';
import { GUIDES } from '../data/guides';

const locale = 'en';
const L = (p: string) => localizedPath(locale, p);

const title = `Surah Virtues (Fazail) — Which Surah to Read & When, With Authentic Hadith`;
const description = `Which surah should you read and when? Ayatul Kursi after salah, Kahf on Friday, Mulk at night, Waqiah for rizq, 3 Quls morning and evening — every virtue with its authentic hadith and grading.`;
const keywords = 'surah virtues, fazail e quran, which surah to read, surah benefits hadith, ayatul kursi benefits, surah kahf friday, surah mulk night, surah waqiah rizq, 3 qul benefits, last two baqarah, surah rahman benefits, sajda tilawat, fatiha virtues';
const faq = [
  { q: 'Which surah should I read every day?', a: 'Minimum Prophetic routine: Fatiha in every salah, Ayatul Kursi after each fard, the 3 Quls three times morning and evening, last two Baqarah verses plus Mulk at night, and Kahf every Friday.' },
  { q: 'Which surah is best for protection?', a: 'Ayatul Kursi, the last two verses of Baqarah, and the three Quls (Ikhlas, Falaq, Nas) form the core Prophetic protection system - with the first ten verses of Kahf memorized against Dajjal.' },
  { q: 'Which surah is for rizq (provision)?', a: 'Surah Al-Waqiah nightly is widely practiced for protection from poverty; pair it with gratitude reflection on Ar-Rahman and lawful effort - provision follows means plus trust.' },
  { q: 'Are all "surah benefits" narrations authentic?', a: 'No - and we say so plainly. Each virtue page labels its grading (Sahih, Hasan, or weak). Act on authentic ones; read weak ones only as general encouragement, never as fixed rites.' },
];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surah Virtues', path: '/surah-virtues/' },
];
const virtueSlugs = ['virtue-surah-fatiha', 'virtue-ayatul-kursi', 'virtue-baqarah-last-two', 'virtue-baqarah-aal-imran', 'virtue-three-quls', 'virtue-surah-rahman', 'virtue-surah-sajdah', 'virtue-kahf-first-ten', 'virtue-friday-eid-recitations', 'virtue-night-long-recitation', 'virtue-surah-kawthar', 'virtue-surah-asr'];
const spotlightSlugs = ['surah-yaseen-spotlight', 'surah-kahf-spotlight', 'surah-mulk-spotlight', 'surah-waqiah-spotlight'];
const virtues = virtueSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const spotlights = spotlightSlugs.map((s) => GUIDES.find((g) => g.slug === s)).filter(Boolean);
const matrix: { occ: string; read: string; href: string; why: string }[] = [
  { occ: 'Every salah', read: 'Surah Al-Fatiha', href: L('/learn/virtues/virtue-surah-fatiha/'), why: 'No prayer without the Opening (Bukhari/Muslim)' },
  { occ: 'After every fard', read: 'Ayatul Kursi', href: L('/learn/virtues/virtue-ayatul-kursi/'), why: 'Nothing blocks Paradise but death (Nasai, sahih)' },
  { occ: 'Morning & evening', read: '3 Quls × 3', href: L('/learn/virtues/virtue-three-quls/'), why: 'Suffice you against everything (Tirmidhi)' },
  { occ: 'Before sleep', read: 'Mulk + Sajdah + last-2 Baqarah', href: L('/learn/virtues/virtue-surah-sajdah/'), why: 'Nightly pair (Tirmidhi) + night sufficiency (Bukhari)' },
  { occ: 'Every Friday', read: 'Surah Al-Kahf', href: L('/learn/duties/surah-kahf-spotlight/'), why: 'Light between two Fridays (Hakim, sahih)' },
  { occ: 'Memorize once', read: 'Kahf first 10 verses', href: L('/learn/virtues/virtue-kahf-first-ten/'), why: 'Protection from Dajjal (Muslim, sahih)' },
  { occ: 'Friday Fajr', read: 'Sajdah + Insan', href: L('/learn/virtues/virtue-surah-sajdah/'), why: 'His Friday dawn recitation (Bukhari/Muslim)' },
  { occ: 'Friday / Eid prayer', read: 'Jumuah, Ala & Ghashiyah', href: L('/learn/virtues/virtue-friday-eid-recitations/'), why: 'His congregational pairs (Muslim)' },
  { occ: 'Rizq worries', read: 'Surah Al-Waqiah nightly', href: L('/learn/duties/surah-waqiah-spotlight/'), why: 'Poverty protection practice + gratitude' },
  { occ: 'Fear & ruqyah', read: 'Falaq + Nas', href: L('/learn/virtues/virtue-three-quls/'), why: 'Revealed as protection; Prophetic ruqyah' },
  { occ: 'Gratitude', read: 'Surah Ar-Rahman', href: L('/learn/virtues/virtue-surah-rahman/'), why: '"Which favours will you deny?" reflection' },
  { occ: 'Night prayer', read: 'Long chapters', href: L('/learn/virtues/virtue-night-long-recitation/'), why: 'Baqarah + Nisa in one night (Muslim)' },
  { occ: 'For the deceased', read: 'Surah Yaseen', href: L('/learn/duties/surah-yaseen-spotlight/'), why: 'Heart of the Quran (graded inside)' },
  { occ: 'Abundance', read: 'Surah Al-Kawthar', href: L('/learn/virtues/virtue-surah-kawthar/'), why: 'Al-Kawthar + the Hawd (Bukhari/Muslim)' },
];
---
<BaseLayout title={title} description={description} keywords={keywords} locale={locale} type="collection" faq={faq} crumbs={crumbs} canonicalPath="/surah-virtues/">
  <div class="hn-discover hn-section">
    <Breadcrumbs locale={locale} items={crumbs} />
    <div class="mt-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <span class="hn-badge hn-badge-primary">16 virtue guides</span>
        <span class="hn-badge">With hadith grading</span>
        <span class="hn-badge">Occasion matrix</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Surah Virtues — Which Surah, When</h1>
      <p class="mt-2 leading-7" style="color:var(--hn-muted)">Kahf on Friday, Mulk at night, Kursi after salah, Waqiah for rizq — every virtue traced to its hadith, graded honestly (Sahih, Hasan, or weak), so you act on certainty.</p>
      <form action={L('/search/')} method="get" class="mt-4" role="search">
        <div class="hn-searchwrap max-w-xl">
          <Icon name="search" size={19} />
          <input name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck={false} enterkeyhint="search" inputmode="search" placeholder="Search virtues — kahf, kursi, rizq…" aria-label="Search virtues" />
          <button type="submit" class="hn-btn hn-btn-primary !rounded-[10px]">Go</button>
        </div>
      </form>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={L('/learn/virtues/virtue-surah-fatiha/')} class="hn-btn hn-btn-primary !min-h-[44px] text-sm">Start: Surah Fatiha</a>
        <a href={L('/surahs/')} class="hn-btn hn-btn-secondary !min-h-[44px] text-sm">All 114 surahs</a>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Matrix" title="Occasion → surah" sub="The quick answer: what to read, when, and on what authority." />
      <div class="hn-card overflow-hidden">
        <table class="w-full text-[14px] leading-6">
          <thead>
            <tr style="background:var(--hn-bg-soft)">
              <th class="text-start font-extrabold px-4 py-3 whitespace-nowrap">Occasion</th>
              <th class="text-start font-extrabold px-4 py-3">Read</th>
              <th class="text-start font-extrabold px-4 py-3 hidden sm:table-cell">Why</th>
            </tr>
          </thead>
          <tbody>
            {matrix.map((m) => (
              <tr class="border-t" style="border-color:var(--hn-border)">
                <td class="px-4 py-2.5 font-bold whitespace-nowrap">{m.occ}</td>
                <td class="px-4 py-2.5"><a href={m.href} class="font-bold hover:underline" style="color:var(--hn-primary)">{m.read} →</a><span class="sm:hidden block text-[13px]" style="color:var(--hn-muted)">{m.why}</span></td>
                <td class="px-4 py-2.5 hidden sm:table-cell" style="color:var(--hn-muted)">{m.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Virtues" title="Verse & surah virtues" sub="Twelve deep-dives with grading — act on the authentic, note the weak." href={L('/learn/virtues/')} linkLabel="Virtues category" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {virtues.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Spotlights" title="Famous surah spotlights" sub="Yaseen, Kahf, Mulk and Waqiah — themes, occasions and honest grading." />
      <div class="grid gap-3 sm:grid-cols-2">
        {spotlights.map((g: any) => (
          <a href={L(`/learn/${g.cat}/${g.slug}/`)} class="hn-card hn-card-hover hn-card-pad block">
            <span class="font-extrabold block leading-6">{g.title}</span>
            <span class="text-sm leading-6 block mt-1 line-clamp-2" style="color:var(--hn-muted)">{g.intro}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8">
      <SectionHeader eyebrow="Read" title="Read the surahs" sub="Full Arabic text with translation, transliteration and audio." />
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={L('/surahs/1-al-faatiha/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-extrabold block leading-6">Surah Al-Fatiha — read now</span>
          <span class="text-sm leading-6 block mt-1" style="color:var(--hn-muted)">7 verses with Urdu, English & Hindi meaning + audio</span>
        </a>
        <a href={L('/surahs/18-al-kahf/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-extrabold block leading-6">Surah Al-Kahf — read now</span>
          <span class="text-sm leading-6 block mt-1" style="color:var(--hn-muted)">110 verses with Urdu, English & Hindi meaning + audio</span>
        </a>
        <a href={L('/surahs/36-yaseen/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-extrabold block leading-6">Surah Yaseen — read now</span>
          <span class="text-sm leading-6 block mt-1" style="color:var(--hn-muted)">83 verses with Urdu, English & Hindi meaning + audio</span>
        </a>
        <a href={L('/surahs/67-al-mulk/')} class="hn-card hn-card-hover hn-card-pad block">
          <span class="font-extrabold block leading-6">Surah Al-Mulk — read now</span>
          <span class="text-sm leading-6 block mt-1" style="color:var(--hn-muted)">30 verses with Urdu, English & Hindi meaning + audio</span>
        </a>
      </div>
    </div>

    <section class="mt-8 max-w-3xl" aria-label="Frequently asked questions">
      <SectionHeader eyebrow="FAQ" title="Frequently asked questions" />
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="hn-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
