---
import '../styles/global.css';
import { isRTL, localeNames, locales, getDict, localizedPath } from '../i18n/utils';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  locale: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  pubDate?: string;
  faq?: { q: string; a: string }[];
  crumbs?: { name: string; path: string }[];
  hideFooter?: boolean;
  /** Accepted for backward compat — ignored (site is light-theme only). */
  theme?: 'dark' | 'light';
}

const { title, description, locale, keywords, image = '/og-cover.jpg', canonicalPath = '', noindex = false, type = 'website', pubDate, faq = [], crumbs = [], hideFooter = false } = Astro.props;
const dict = getDict(locale);
const dir = isRTL(locale) ? 'rtl' : 'ltr';
const site = (Astro.site?.toString() ?? 'https://hikmah-noor.pages.dev').replace(/\/$/, '');
const canonical = `${site}${localizedPath(locale, canonicalPath || '/')}`;
const fontCss = 'https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;600;700&family=Noto+Nastaliq+Urdu:wght@400;600&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap';

const articleLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: locale,
  datePublished: pubDate,
  author: { '@type': 'Organization', name: 'Hikmah Noor' },
  publisher: { '@type': 'Organization', name: 'Hikmah Noor' },
} : null;

const faqLd = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;

const crumbLd = crumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${site}${localizedPath(locale, c.path)}` })),
} : null;

const L = (p: string) => localizedPath(locale, p);
const moreLinks = [
  { label: dict.nav.kalimas ?? 'Kalimas', href: L('/kalimas/'), icon: 'kalimas' },
  { label: 'Paras', href: L('/quran/'), icon: 'quran' },
  { label: dict.nav.meanings ?? 'Meanings', href: L('/meanings/'), icon: 'meanings' },
  { label: 'Names of Allah', href: L('/names-of-allah/'), icon: 'star' },
  { label: 'Names of Muhammad ﷺ', href: L('/names-muhammad/'), icon: 'heart' },
  { label: 'Guides', href: L('/learn/'), icon: 'book' },
  { label: dict.nav.waqiat ?? 'Stories', href: L('/waqiat/'), icon: 'waqiat' },
  { label: (dict.nav as any).prophets ?? 'Prophets', href: L('/prophets/'), icon: 'star' },
  { label: 'Hadees', href: L('/hadees/'), icon: 'book' },
  { label: 'History', href: L('/history/'), icon: 'book' },
  { label: 'Ramadan', href: L('/ramadan/'), icon: 'moon' },
  { label: 'Eid & Qurbani', href: L('/eid/'), icon: 'moon' },
  { label: dict.nav.surahs ?? 'Surahs', href: L('/surahs/'), icon: 'surahs' },
  { label: dict.nav.about ?? 'About', href: L('/about/'), icon: 'about' },
] as const;
---
<!doctype html>
<html lang={locale} dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} | Hikmah Noor</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  {locales.map(l => <link rel="alternate" hreflang={l} href={`${site}${localizedPath(l, canonicalPath || '/')}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}${localizedPath('en', canonicalPath || '/')}`} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Hikmah Noor" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site}${image}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#FAF8F2" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontCss} rel="stylesheet" />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
</head>
<body class="min-h-screen flex flex-col overflow-x-clip" style="background:var(--hn-bg);color:var(--hn-ink)">
  <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:p-2 focus:rounded-lg" style="background:var(--hn-primary);color:#fff">Skip to content</a>

  {/* ============ HEADER ============ */}
  <header class="sticky top-0 z-50 border-b" style="background:var(--hn-header);backdrop-filter:blur(12px);border-color:var(--hn-border)">
    <div class="hn-container flex items-center gap-1.5 sm:gap-2" style="height:3.75rem">
      <a href={L('/')} class="flex items-center gap-2 font-extrabold text-[17px] shrink-0 min-w-0" style="color:var(--hn-ink)" aria-label="Hikmah Noor home">
        <img src="/favicon.svg" alt="" width="28" height="28" class="w-7 h-7 shrink-0" />
        <span class="truncate">Hikmah Noor</span>
      </a>
      <nav class="hidden lg:flex items-center gap-5 text-[14.5px] font-semibold ms-6" aria-label="Primary" style="color:var(--hn-muted)">
        <a class="hover:opacity-100 transition" style="color:var(--hn-muted)" href={L('/quran/')}>Quran</a>
        <a class="hover:opacity-100 transition" style="color:var(--hn-muted)" href={L('/duas/')}>Duas</a>
        <a class="hover:opacity-100 transition" style="color:var(--hn-muted)" href={L('/duas/morning-evening/')}>Adhkar</a>
        <a class="hover:opacity-100 transition" style="color:var(--hn-muted)" href={L('/learn/')}>Learn</a>
        <a class="hover:opacity-100 transition font-bold" style="color:var(--hn-primary)" href={L('/tools/')}>{dict.nav.tools}</a>
        <div class="relative" id="moreWrap">
          <button id="moreBtn" class="inline-flex items-center gap-1 transition hover:opacity-100" style="color:var(--hn-muted)" aria-haspopup="true" aria-expanded="false" aria-controls="moreMenu">
            More <span id="moreChevron" class="text-[11px] opacity-70 inline-block transition-transform">▾</span>
          </button>
          <div id="moreMenu" class="hidden absolute start-0 top-full pt-2 z-50">
            <div class="hn-card w-60 py-1.5 overflow-hidden" style="box-shadow:var(--hn-shadow-lg)">
              {moreLinks.map(m => (
                <a href={m.href} class="flex items-center gap-3 px-4 py-2.5 min-h-[48px] text-[15px] font-medium transition hover:opacity-100" style="color:var(--hn-ink)" data-more-link>
                  <Icon name={m.icon as any} size={18} />
                  {m.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </nav>
      <div class="ms-auto flex items-center gap-1.5">
        <a href={L('/search/')} class="hn-icon-btn !w-10 !h-10 !border-0" aria-label="Search"><Icon name="search" size={20} /></a>
        <div class="relative" id="langWrap">
          <button id="langBtn" class="hn-btn hn-btn-primary !min-h-[40px] !py-2 !px-3.5 text-sm !rounded-full" aria-haspopup="true" aria-expanded="false" aria-controls="langMenu" aria-label="Language">
            <Icon name="globe" size={16} />
            <span class="uppercase hidden min-[380px]:inline">{locale}</span>
            <span class="hidden md:inline font-semibold opacity-80">{localeNames[locale as keyof typeof localeNames]}</span>
          </button>
          <div id="langMenu" class="hidden absolute end-0 top-full pt-2 z-50">
            <div class="hn-card w-64 py-1.5 overflow-hidden" style="box-shadow:var(--hn-shadow-lg)">
              {locales.map(l => (
                <a href={localizedPath(l, canonicalPath || '/')} class="flex items-center gap-3 px-4 py-2.5 min-h-[48px] text-[15px] font-medium" style={l === locale ? 'background:var(--hn-primary-soft);font-weight:800' : ''}>
                  <span class="w-9 h-9 shrink-0 grid place-items-center rounded-[10px] text-xs font-extrabold" style="background:var(--hn-primary-soft);color:var(--hn-primary)">{l.toUpperCase()}</span>
                  <span>{l === 'hi' ? 'हिन्दी' : l === 'en' ? 'English' : l === 'ur' ? 'اردو' : 'العربية'}</span>
                  {l === locale && <span class="ms-auto" style="color:var(--hn-primary)"><Icon name="check" size={18} /></span>}
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="relative lg:hidden" id="menuWrap">
          <button id="menuBtn" class="hn-icon-btn !w-10 !h-10 !border-0" aria-expanded="false" aria-controls="mobileMenu" aria-label="Menu">
            <span id="menuIcoOpen"><Icon name="menu" size={22} /></span>
            <span id="menuIcoClose" class="hidden"><Icon name="close" size={22} /></span>
          </button>
        </div>
      </div>
      {/* Mobile dropdown (tablet) */}
      <div id="mobileMenu" class="hidden lg:hidden absolute inset-x-3 top-full z-50">
        <nav class="hn-card overflow-hidden p-2" style="box-shadow:var(--hn-shadow-lg)" aria-label="Mobile">
          {[
            { label: 'Quran', href: L('/quran/'), icon: 'quran' },
            { label: 'Duas', href: L('/duas/'), icon: 'duas' },
            { label: 'Adhkar', href: L('/duas/morning-evening/'), icon: 'shield' },
            { label: 'Learn', href: L('/learn/'), icon: 'book' },
            { label: dict.nav.tools, href: L('/tools/'), icon: 'tools' },
            { label: dict.nav.kalimas ?? 'Kalimas', href: L('/kalimas/'), icon: 'kalimas' },
            { label: dict.nav.surahs ?? 'Surahs', href: L('/surahs/'), icon: 'surahs' },
            { label: dict.nav.waqiat ?? 'Stories', href: L('/waqiat/'), icon: 'waqiat' },
            { label: (dict.nav as any).prophets ?? 'Prophets', href: L('/prophets/'), icon: 'star' },
            { label: 'Hadees', href: L('/hadees/'), icon: 'book' },
            { label: 'History', href: L('/history/'), icon: 'book' },
            { label: 'Ramadan', href: L('/ramadan/'), icon: 'moon' },
            { label: 'Eid & Qurbani', href: L('/eid/'), icon: 'moon' },
            { label: dict.nav.about ?? 'About', href: L('/about/'), icon: 'about' },
          ].map(m => (
            <a href={m.href} class="flex items-center gap-3 px-2.5 py-2 rounded-[10px] min-h-[52px] font-semibold" style="color:var(--hn-ink)" data-more-link>
              <span class="w-10 h-10 shrink-0 grid place-items-center rounded-[10px]" style="background:var(--hn-primary-soft);color:var(--hn-primary)"><Icon name={m.icon as any} size={20} /></span>
              <span class="text-[16px]">{m.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </header>

  <script is:inline>
    (() => {
      const langBtn = document.getElementById('langBtn');
      const langMenu = document.getElementById('langMenu');
      const moreBtn = document.getElementById('moreBtn');
      const moreMenu = document.getElementById('moreMenu');
      const moreChevron = document.getElementById('moreChevron');
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const icoOpen = document.getElementById('menuIcoOpen');
      const icoClose = document.getElementById('menuIcoClose');
      const setLang = (open) => {
        if (!langMenu || !langBtn) return;
        langMenu.classList.toggle('hidden', !open);
        langBtn.setAttribute('aria-expanded', String(open));
      };
      const setMore = (open) => {
        if (!moreMenu || !moreBtn) return;
        moreMenu.classList.toggle('hidden', !open);
        moreBtn.setAttribute('aria-expanded', String(open));
        moreChevron?.classList.toggle('rotate-180', open);
      };
      const setMenu = (open) => {
        if (!mobileMenu || !menuBtn) return;
        mobileMenu.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
        icoOpen?.classList.toggle('hidden', open);
        icoClose?.classList.toggle('hidden', !open);
      };
      langBtn?.addEventListener('click', (e) => { e.stopPropagation(); const w = langMenu?.classList.contains('hidden'); setMenu(false); setMore(false); setLang(!!w); });
      moreBtn?.addEventListener('click', (e) => { e.stopPropagation(); const w = moreMenu?.classList.contains('hidden'); setLang(false); setMenu(false); setMore(!!w); });
      menuBtn?.addEventListener('click', (e) => { e.stopPropagation(); const w = mobileMenu?.classList.contains('hidden'); setLang(false); setMore(false); setMenu(!!w); });
      document.addEventListener('click', (e) => {
        if (!document.getElementById('langWrap')?.contains(e.target)) setLang(false);
        if (!document.getElementById('moreWrap')?.contains(e.target)) setMore(false);
        const menu = document.getElementById('mobileMenu');
        const wrap = document.getElementById('menuWrap');
        if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target) && !wrap?.contains(e.target)) setMenu(false);
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setLang(false); setMore(false); setMenu(false); } });
      document.querySelectorAll('[data-more-link]').forEach(a => a.addEventListener('click', () => { setMenu(false); setMore(false); }));
      window.addEventListener('resize', () => { if (window.innerWidth >= 1024) setMenu(false); });
    })();
  </script>

  <main id="content" class="flex-1 w-full">
    <slot />
  </main>

  {/* ============ MOBILE BOTTOM NAV ============ */}
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-50 border-t" style="background:var(--hn-header);backdrop-filter:blur(12px);border-color:var(--hn-border);padding-bottom:env(safe-area-inset-bottom)" aria-label="Quick">
    <div class="grid grid-cols-5 h-[64px]">
      {(() => {
        const raw = Astro.url.pathname.replace(/\/$/, '') || '/';
        const path = raw.replace(/^\/(hi|ur|ar)(?=\/|$)/, '') || '/';
        const isHome = path === '/';
        const isQuran = path === '/quran' || path.startsWith('/quran/') || path === '/surahs' || path.startsWith('/surahs/');
        const isDuas = path === '/duas' || path.startsWith('/duas/');
        const isSearch = path === '/search' || path.startsWith('/search/');
        const tabs = [
          { label: dict.nav.home ?? 'Home', href: L('/'), icon: 'home', active: isHome },
          { label: 'Quran', href: L('/quran/'), icon: 'quran', active: isQuran },
          { label: 'Duas', href: L('/duas/'), icon: 'duas', active: isDuas },
          { label: 'Search', href: L('/search/'), icon: 'search', active: isSearch },
          { label: 'More', href: L('/explore/'), icon: 'menu', active: !isHome && !isQuran && !isDuas && !isSearch },
        ];
        return tabs.map(m => (
          <a href={m.href} aria-current={m.active ? 'page' : undefined} class="relative flex flex-col items-center justify-center gap-0.5 text-[11px] min-h-[56px]" style={m.active ? 'color:var(--hn-primary);font-weight:800' : 'color:var(--hn-muted);font-weight:600'}>
            {m.active && <span aria-hidden="true" class="absolute top-0 h-[3px] w-10 rounded-b-full" style="background:var(--hn-primary)" />}
            <Icon name={m.icon as any} size={21} />
            {m.label}
          </a>
        ));
      })()}
    </div>
  </nav>

  {!hideFooter && (
  <footer class="border-t mt-12" style="background:var(--hn-card);border-color:var(--hn-border)">
    <div class="hn-container py-10 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <div class="font-extrabold text-lg" style="color:var(--hn-ink)">Hikmah Noor</div>
        <p class="text-sm leading-6 mt-2" style="color:var(--hn-muted)">{dict.footer.about}</p>
        <p class="text-xs mt-3" style="color:var(--hn-muted)">{dict.footer.disclaimer}</p>
      </div>
      <div>
        <div class="font-bold mb-3 text-sm uppercase tracking-wide" style="color:var(--hn-ink)">Explore</div>
        <ul class="space-y-2 text-sm" style="color:var(--hn-muted)">
          <li><a class="hover:underline" href={L('/quran/')}>Quran</a></li>
          <li><a class="hover:underline" href={L('/duas/')}>Duas</a></li>
          <li><a class="hover:underline" href={L('/duas/morning-evening/')}>Adhkar</a></li>
          <li><a class="hover:underline" href={L('/kalimas/')}>Kalimas</a></li>
          <li><a class="hover:underline" href={L('/hadees/')}>Hadees</a></li>
          <li><a class="hover:underline" href={L('/seerat/')}>Seerat</a></li>
          <li><a class="hover:underline" href={L('/prophets/')}>Prophets</a></li>
          <li><a class="hover:underline" href={L('/history/')}>History</a></li>
          <li><a class="hover:underline" href={L('/ramadan/')}>Ramadan</a></li>
          <li><a class="hover:underline" href={L('/eid/')}>Eid & Qurbani</a></li>
          <li><a class="hover:underline" href={L('/names-of-allah/')}>99 Names</a></li>
        </ul>
      </div>
      <div>
        <div class="font-bold mb-3 text-sm uppercase tracking-wide" style="color:var(--hn-ink)">Resources</div>
        <ul class="space-y-2 text-sm" style="color:var(--hn-muted)">
          <li><a class="hover:underline" href={L('/meanings/')}>Guides</a></li>
          <li><a class="hover:underline" href={L('/learn/')}>How-To Guides</a></li>
          <li><a class="hover:underline" href={L('/tools/')}>Tools</a></li>
          <li><a class="hover:underline" href={L('/search/')}>Search</a></li>
        </ul>
      </div>
      <div>
        <div class="font-bold mb-3 text-sm uppercase tracking-wide" style="color:var(--hn-ink)">Site</div>
        <ul class="space-y-2 text-sm" style="color:var(--hn-muted)">
          <li><a class="hover:underline" href={L('/about/')}>About</a></li>
          <li><a class="hover:underline" href={L('/contact/')}>Contact</a></li>
          <li><a class="hover:underline" href={L('/privacy/')}>Privacy</a></li>
          <li><a class="hover:underline" href={L('/terms/')}>Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t" style="border-color:var(--hn-border)">
      <div class="hn-container py-4 flex flex-col sm:flex-row gap-2 items-center justify-between text-xs" style="color:var(--hn-muted)">
        <span>© 2026 Hikmah Noor • {dict.footer.rights}</span>
        <span class="flex gap-3">{locales.map(l => <a class="hover:underline" href={localizedPath(l, '/')}>{localeNames[l]}</a>)}</span>
      </div>
    </div>
  </footer>
  )}
</body>
</html>
