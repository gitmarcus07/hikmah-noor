---
import '../styles/global.css';
import { isRTL, localeNames, localeFlags, locales, getDict, localizedPath } from '../i18n/utils';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  locale: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  pubDate?: string;
  faq?: { q: string; a: string }[];
  crumbs?: { name: string; path: string }[];
}

const { title, description, locale, keywords, image = '/og-cover.jpg', canonicalPath = '', noindex = false, type = 'website', pubDate, faq = [], crumbs = [] } = Astro.props;
const dict = getDict(locale);
const dir = isRTL(locale) ? 'rtl' : 'ltr';
const site = (Astro.site?.toString() ?? 'https://hikmah-noor.pages.dev').replace(/\/$/, '');
const canonical = `${site}${localizedPath(locale, canonicalPath || '/')}`;
const fontCss = 'https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;600;700&family=Noto+Nastaliq+Urdu:wght@400;600&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap';

const articleLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: locale,
  datePublished: pubDate,
  author: { '@type': 'Organization', name: 'Hikmah Noor' },
  publisher: { '@type': 'Organization', name: 'Hikmah Noor' },
} : null;

const faqLd = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;

const crumbLd = crumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${site}${localizedPath(locale, c.path)}` })),
} : null;
---
<!doctype html>
<html lang={locale} dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Hikmah Noor</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  {locales.map(l => <link rel="alternate" hreflang={l} href={`${site}${localizedPath(l, canonicalPath || '/')}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}${localizedPath('en', canonicalPath || '/')}`} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Hikmah Noor" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site}${image}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#100e1c" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontCss} rel="stylesheet" />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
</head>
<body class="bg-night-950 text-ink-50 font-sans min-h-screen flex flex-col overflow-x-clip">
  <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:p-2 focus:bg-brand-500 focus:text-night-900">Skip to content</a>

  <header class="sticky top-0 z-50 bg-night-900/95 backdrop-blur border-b border-white/10 shadow-lg shadow-black/30">
    <div class="relative max-w-7xl mx-auto px-3 sm:px-4 h-14 flex items-center gap-1.5 sm:gap-2">
      <a href={localizedPath(locale, '/')} class="flex items-center gap-2 font-extrabold text-[17px] shrink-0 text-white min-w-0" aria-label="Hikmah Noor home">
        <img src="/favicon.svg" alt="" width="28" height="28" class="w-7 h-7 shrink-0" />
        <span class="truncate">Hikmah Noor</span>
      </a>
      <nav class="hidden lg:flex items-center gap-4 text-sm font-medium text-ink-300 ms-6" aria-label="Primary">
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/')}><Icon name="home" size={17} />{dict.nav.home}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/surahs/')}><Icon name="surahs" size={17} />{dict.nav.surahs}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/quran/')}><Icon name="quran" size={17} />{dict.nav.quran}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/duas/')}><Icon name="duas" size={17} />{dict.nav.duas}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/kalimas/')}><Icon name="kalimas" size={17} />{dict.nav.kalimas}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/meanings/')}><Icon name="meanings" size={17} />{dict.nav.meanings}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/waqiat/')}><Icon name="waqiat" size={17} />{dict.nav.waqiat}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300 font-semibold text-brand-300" href={localizedPath(locale, '/tools/')}><Icon name="tools" size={17} />{dict.nav.tools}</a>
        <a class="inline-flex items-center gap-1.5 hover:text-brand-300" href={localizedPath(locale, '/about/')}><Icon name="about" size={17} />{dict.nav.about}</a>
      </nav>
      <div class="ms-auto flex items-center gap-1 sm:gap-2">
        <a href={localizedPath(locale, '/search/')} class="w-9 h-9 grid place-items-center rounded-full text-ink-300 hover:bg-white/10 shrink-0" aria-label="Search"><Icon name="search" size={20} /></a>
        <div class="relative" id="langWrap">
          <button id="langBtn" class="flex items-center gap-1.5 bg-brand-500 hover:bg-brand-400 text-night-900 font-bold rounded-full ps-2.5 pe-2 py-1.5 text-sm shadow shrink-0" aria-haspopup="true" aria-expanded="false" aria-controls="langMenu" aria-label="Language">
            <Icon name="globe" size={17} />
            <span class="uppercase">{locale}</span>
            <span class="hidden md:inline font-semibold opacity-80">{localeNames[locale as keyof typeof localeNames]}</span>
            <span id="langChevron" class="text-xs opacity-70 transition-transform duration-150 inline-block">▾</span>
          </button>
          <div id="langMenu" class="hidden absolute end-0 top-full pt-2 z-50">
            <div class="w-64 bg-night-850 text-ink-50 rounded-2xl shadow-xl border border-white/10 overflow-hidden py-1.5">
              {locales.map(l => (
                <a href={localizedPath(l, canonicalPath || '/')} class={`flex items-center gap-3 px-4 py-2.5 min-h-[48px] text-[15px] hover:bg-white/10 ${l===locale?'bg-white/10 font-bold':''}`}>
                  <span class="w-9 h-9 shrink-0 grid place-items-center rounded-xl bg-brand-500/15 text-brand-300 text-xs font-extrabold">{l.toUpperCase()}</span>
                  <span>{l === 'hi' ? 'हिन्दी' : l === 'en' ? 'English' : l === 'ur' ? 'اردو' : 'العربية'} <span class="text-ink-500 text-sm">({localeNames[l]})</span></span>
                  {l===locale && <span class="ms-auto text-brand-300"><Icon name="check" size={18} /></span>}
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="relative lg:hidden" id="menuWrap">
          <button id="menuBtn" class="w-9 h-9 grid place-items-center rounded-full hover:bg-white/10 text-ink-200 shrink-0" aria-expanded="false" aria-controls="mobileMenu" aria-label="Menu">
            <span id="menuIcoOpen"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span>
            <span id="menuIcoClose" class="hidden"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></span>
          </button>
        </div>
      </div>
      <div id="mobileMenu" class="hidden lg:hidden absolute inset-x-3 top-full z-50">
        <nav class="bg-night-850 rounded-3xl shadow-xl border border-white/10 overflow-hidden" aria-label="Mobile">
          <p class="px-4 pt-3.5 pb-1 text-[11px] font-extrabold uppercase tracking-widest text-ink-500">Browse</p>
          <div class="p-2">
            {([
              ['home', dict.nav.home, localizedPath(locale, '/')],
              ['surahs', dict.nav.surahs, localizedPath(locale, '/surahs/')],
              ['quran', dict.nav.quran, localizedPath(locale, '/quran/')],
              ['duas', dict.nav.duas, localizedPath(locale, '/duas/')],
              ['kalimas', dict.nav.kalimas, localizedPath(locale, '/kalimas/')],
              ['meanings', dict.nav.meanings, localizedPath(locale, '/meanings/')],
              ['waqiat', dict.nav.waqiat, localizedPath(locale, '/waqiat/')],
              ['tools', dict.nav.tools, localizedPath(locale, '/tools/')],
              ['about', dict.nav.about, localizedPath(locale, '/about/')],
            ] as const).map(([icon, label, href]) => (
              <a href={href} class="flex items-center gap-3 px-2.5 py-2 rounded-2xl min-h-[52px] hover:bg-white/10 active:bg-white/15">
                <span class="w-10 h-10 shrink-0 grid place-items-center rounded-xl bg-brand-500/15 text-brand-300 border border-white/10"><Icon name={icon} size={20} /></span>
                <span class="text-[16px] font-semibold text-ink-50">{label}</span>
                <span class="ms-auto text-ink-500"><Icon name="chevron" size={18} /></span>
              </a>
            ))}
          </div>
          <div class="border-t border-white/10 px-4 py-3 flex items-center gap-2">
            <span class="text-xs font-bold text-ink-500 uppercase tracking-wide">Languages</span>
            <span class="ms-auto flex gap-1.5">
              {locales.map(l => (
                <a href={localizedPath(l, canonicalPath || '/')} class={`w-9 h-9 grid place-items-center rounded-full text-xs font-extrabold border ${l===locale?'bg-brand-500 text-night-900 border-brand-500':'bg-white/5 text-brand-300 border-white/15'}`} aria-label={localeNames[l]}>{l.toUpperCase()}</a>
              ))}
            </span>
          </div>
        </nav>
      </div>
    </div>
  </header>
  <script>
    (() => {
      const langBtn = document.getElementById('langBtn');
      const langMenu = document.getElementById('langMenu');
      const langChevron = document.getElementById('langChevron');
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const icoOpen = document.getElementById('menuIcoOpen');
      const icoClose = document.getElementById('menuIcoClose');
      const setLang = (open) => {
        if (!langMenu || !langBtn) return;
        langMenu.classList.toggle('hidden', !open);
        langBtn.setAttribute('aria-expanded', String(open));
        langChevron?.classList.toggle('rotate-180', open);
      };
      const setMenu = (open) => {
        if (!mobileMenu || !menuBtn) return;
        mobileMenu.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
        icoOpen?.classList.toggle('hidden', open);
        icoClose?.classList.toggle('hidden', !open);
      };
      langBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = langMenu?.classList.contains('hidden');
        setMenu(false);
        setLang(!!willOpen);
      });
      menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = mobileMenu?.classList.contains('hidden');
        setLang(false);
        setMenu(!!willOpen);
      });
      document.addEventListener('click', (e) => {
        if (!document.getElementById('langWrap')?.contains(e.target)) setLang(false);
        const menu = document.getElementById('mobileMenu');
        const wrap = document.getElementById('menuWrap');
        if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target) && !wrap?.contains(e.target)) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { setLang(false); setMenu(false); }
      });
      mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) setMenu(false);
      });
    })();
  </script>

  <main id="content" class="flex-1 w-full">
    <slot />
  </main>

  <footer class="bg-[#0b0a15] text-ink-300 mt-12 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-2 lg:grid-cols-5">
      <div class="md:col-span-2">
        <div class="font-extrabold text-xl mb-2 text-white">☪ Hikmah Noor</div>
        <p class="text-sm text-ink-300 leading-6">{dict.footer.about}</p>
        <p class="text-xs mt-3 text-ink-500">{dict.footer.disclaimer}</p>
      </div>
      <div>
        <div class="font-bold mb-3 text-gold-300">{dict.footer.pages}</div>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/about/')}>About Us</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/contact/')}>Contact</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/privacy/')}>Privacy</a></li>
        </ul>
      </div>
      <div>
        <div class="font-bold mb-3 text-gold-300">{dict.footer.tools}</div>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/tools/')}>All Tools</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/tools/zakat/zakat-calculator/')}>Zakat Calculator</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/tools/ramadan-countdown/')}>Ramadan Countdown</a></li>
        </ul>
      </div>
      <div>
        <div class="font-bold mb-3 text-gold-300">{dict.footer.cats}</div>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/surahs/')}>Surahs</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/duas/')}>Duas</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/kalimas/')}>Kalimas</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/meanings/')}>Meanings</a></li>
          <li><a class="hover:text-gold-300" href={localizedPath(locale, '/waqiat/')}>Waqiat</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10">
      <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row gap-2 items-center justify-between text-xs text-ink-500">
        <span>© 2026 Hikmah Noor • {dict.footer.rights}</span>
        <span class="flex gap-3">{locales.map(l => <a class="hover:text-gold-300" href={localizedPath(l, '/')}>{localeFlags[l]} {localeNames[l]}</a>)}</span>
      </div>
    </div>
  </footer>
</body>
</html>
