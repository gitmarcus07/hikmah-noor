/*
  # HTML + JS: short cache so app updates (pages, habit.js URLs) reach
  # users within minutes. Long-lived files use versioned URLs (?v=).
  Cache-Control: public, max-age=300
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
